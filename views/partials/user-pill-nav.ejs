<%
  // 移动端药丸导航（≤960px 显示，替代被隐藏的教师端侧边栏；样式见 style.css .user-pill-tab-nav）
  var pillCurrent = typeof pillCurrent !== 'undefined' ? pillCurrent : '';
  var pillBandAccess = typeof pillBandAccess !== 'undefined' ? !!pillBandAccess : false;
  var pillTabs = [
    { key: 'records',  href: '/user?view=records',  icon: '📋', label: '体测记录' },
    { key: 'entry',    href: '/user?view=entry',    icon: '✏️', label: '数据录入' },
    { key: 'attention',href: '/user?view=attention',icon: '❤️', label: '晨检维护' },
    { key: 'venues',   href: '/user/venues',        icon: '🏟️', label: '场地预约' },
    { key: 'bands',    href: '/user/bands',         icon: '⌚', label: '手环监测' },
    { key: 'screen',   href: '/user/screen',        icon: '📊', label: '数据大屏' }
  ];
%>
<nav class="user-pill-tab-nav" aria-label="教师功能导航">
  <% pillTabs.forEach(function(t){ if ((t.key === 'bands' || t.key === 'screen') && !pillBandAccess) return; %>
  <a class="user-pill-tab <%= pillCurrent === t.key ? 'active' : '' %>" href="<%= t.href %>"><span class="pill-icon"><%= t.icon %></span><span class="pill-label"><%= t.label %></span></a>
  <% }); %>
</nav>
