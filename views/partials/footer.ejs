  </main>

<!-- 修改密码弹窗 -->
<% if (currentUser) { %>
<div id="changePwModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.45);align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:28px 24px;width:min(360px,90vw);box-shadow:0 8px 32px rgba(0,0,0,.18);">
    <h3 style="margin:0 0 18px;font-size:17px;color:#1a1a2e;">🔑 修改密码</h3>
    <form method="POST" action="/change-password" id="changePwForm">
      <div style="margin-bottom:12px;">
        <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">原密码</label>
        <input type="password" name="oldPassword" required autocomplete="current-password"
               style="width:100%;padding:8px 10px;border:1px solid #d0d0d0;border-radius:6px;font-size:14px;box-sizing:border-box;" />
      </div>
      <div style="margin-bottom:12px;">
        <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">新密码（至少6位）</label>
        <input type="password" name="newPassword" required minlength="6" autocomplete="new-password"
               style="width:100%;padding:8px 10px;border:1px solid #d0d0d0;border-radius:6px;font-size:14px;box-sizing:border-box;" />
      </div>
      <div style="margin-bottom:18px;">
        <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">确认新密码</label>
        <input type="password" name="confirmPassword" required minlength="6" autocomplete="new-password"
               style="width:100%;padding:8px 10px;border:1px solid #d0d0d0;border-radius:6px;font-size:14px;box-sizing:border-box;" />
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button type="button" onclick="document.getElementById('changePwModal').style.display='none';"
                style="padding:8px 18px;border:1px solid #d0d0d0;border-radius:6px;background:#f5f5f5;cursor:pointer;font-size:14px;">取消</button>
        <button type="submit"
                style="padding:8px 18px;border:none;border-radius:6px;background:#4f46e5;color:#fff;cursor:pointer;font-size:14px;">确认修改</button>
      </div>
    </form>
  </div>
</div>
<script>
(function(){
  var modal = document.getElementById('changePwModal');
  if (!modal) return;
  modal.addEventListener('click', function(e){ if(e.target === modal) modal.style.display='none'; });
  var form = document.getElementById('changePwForm');
  if (form) form.addEventListener('submit', function(e){
    var np = form.querySelector('[name=newPassword]').value;
    var cp = form.querySelector('[name=confirmPassword]').value;
    if (np !== cp) { e.preventDefault(); alert('两次输入的新密码不一致'); }
  });
})();
</script>
<script>
(function () {
  var currentVersion = '<%= typeof cssVersion !== "undefined" ? String(cssVersion) : "" %>';
  if (!currentVersion) return;

  var reloadingForUpdate = false;

  function reloadForUpdate() {
    if (reloadingForUpdate) return;
    reloadingForUpdate = true;
    window.location.reload();
  }

  function checkForAppUpdate() {
    if (reloadingForUpdate) return;
    fetch('/app-version', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'fetch'
      },
      credentials: 'same-origin',
      cache: 'no-store'
    }).then(function (response) {
      if (!response.ok) return null;
      return response.json();
    }).then(function (payload) {
      if (!payload || !payload.version) return;
      if (String(payload.version) !== String(currentVersion)) {
        reloadForUpdate();
      }
    }).catch(function () {});
  }

  window.addEventListener('focus', checkForAppUpdate);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) checkForAppUpdate();
  });
  setInterval(checkForAppUpdate, 45000);
})();
</script>
<% } %>
</body>
</html>
