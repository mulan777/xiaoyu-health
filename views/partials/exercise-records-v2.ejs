<% if(!displayRecords.length){ %><div class="ef-empty ef-record-empty"><h3>本周暂无观察记录</h3><p>记录活动观察后，教师沟通会一起显示在这里。</p></div><% } %>
<div class="ef-record-list"><% displayRecords.forEach(r=>{ const mayEdit=!isReadonly&&(teacher||hasPerm('booking.attention.edit'))&&enabled.includes(Number(r.class_id)); %>
  <article class="ef-record"><header><div class="ef-record-person"><div class="ef-avatar"><%= r.display_name.slice(0,1) %></div><div><strong><%= r.display_name %></strong><span><%= r.class_name %> · <%= r.date_text %> · <%= r.start_time %>—<%= r.end_time %></span></div></div><span class="ef-status <%= r.data.communication?'complete':'pending' %>"><%= r.data.communication?'已记录沟通':'尚未记录沟通' %></span></header><div class="ef-record-meta"><span><%= (r.data.activity||[]).join('、')||'活动内容未填写' %></span><span>平均心率 <%= r.metrics.avg==null?'暂无数据':r.metrics.avg+' 次/分' %></span><% if(r.data.intensity){ %><span><%= r.data.intensity %></span><% } %></div><p class="ef-record-talk"><%= r.data.communication||'教师沟通可稍后补充。' %></p><footer><span><%= r.author_name||'教师' %> · <%= r.updated_text %></span><div><button type="button" class="ef-text-button" data-open-dialog="ef-record-<%= r.id %>">查看完整记录</button><% if(mayEdit){ %><a class="ef-text-button" href="<%= base %>?week=<%= w %>&classId=<%= r.class_id %>&recordId=<%= r.id %>&view=write">编辑 / 补充</a><% } %></div></footer></article>
  <dialog id="ef-record-<%= r.id %>" class="ef-dialog ef-record-dialog"><div class="ef-dialog-heading"><div><h2><%= r.display_name %> · 观察记录</h2><span><%= r.class_name %> · <%= r.date_text %> <%= r.start_time %>—<%= r.end_time %></span></div><button type="button" class="ef-close" data-close-dialog aria-label="关闭记录">×</button></div><dl class="ef-record-values"><% groups.forEach(g=>{ const val=Array.isArray(r.data[g.key])?r.data[g.key].join('、'):r.data[g.key]; %><div><dt><%= g.label %></dt><dd><%= val||'未填写' %></dd></div><% }); %><div><dt>检查者</dt><dd><%= r.data.inspector||'未填写' %></dd></div><div><dt>带班教师</dt><dd><%= r.data.teacher||'未填写' %></dd></div><div><dt>保育员</dt><dd><%= r.data.caregiver||'未填写' %></dd></div><div><dt>心率采样</dt><dd><%= r.metrics.sample_count?r.metrics.sample_count+' 次；平均 '+r.metrics.avg+'，最低 '+r.metrics.min+'，最高 '+r.metrics.max+' 次/分':r.metrics.reason||'暂无数据' %></dd></div><div><dt>教师沟通</dt><dd><%= r.data.communication||'未填写' %></dd></div><div><dt>补充观察</dt><dd><%= r.data.notes||'未填写' %></dd></div></dl><% if(mayEdit){ %><a class="ef-button ef-primary" href="<%= base %>?week=<%= w %>&classId=<%= r.class_id %>&recordId=<%= r.id %>&view=write">编辑 / 补充</a><% } %></dialog>
<% }); %></div>
