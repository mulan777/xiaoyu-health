<%- include('partials/header', { pageClass: 'admin-page trace-page' }) %>
<% const _base = typeof traceBase === 'undefined' ? '/admin/bands/trace' : traceBase;
 const _data = data && !data.error ? data : null;
 const _segments = _data && _data.trace ? _data.trace.segments || [] : [];
 const _covered = _segments.filter(s => s.zone !== '覆盖外');
 const _child = bands.find(b => b.band_mac === selectedBand);
 const _duration = _covered.reduce((sum,s) => sum + (new Date(s.end.replace(' ','T')) - new Date(s.start.replace(' ','T'))) / 60000 + .5, 0);
 const _zones = ['1区(西)', '2区(中)', '3区(东)'];
 const _visited = new Set(_covered.map(s => s.zone)).size;
%>
<link rel="stylesheet" href="/static/band-trace.css?v=20261010b">
<main class="trace-wrap">
  <div class="trace-heading"><div><div class="trace-eyebrow">南操场 · <%= teacherView ? teacherClassName : '全园活动' %></div><h1>操场活动轨迹</h1><p>看见活动分区，了解孩子的户外活动。</p></div><a class="trace-link" href="<%= teacherView ? '/user/screen' : '/admin/screen' %>">查看感知大屏 →</a></div>
  <form class="trace-filters" action="<%= _base %>" method="get">
    <label>幼儿<select name="band_mac" aria-label="选择幼儿"><% bands.forEach(b => { %><option value="<%= b.band_mac %>" <%= selectedBand === b.band_mac ? 'selected' : '' %>><%= b.class_name %> · <%= b.display_name || b.child_name %></option><% }); %><% if (!bands.length) { %><option value="">本班暂无已绑定手环</option><% } %></select></label>
    <label>活动日期<input type="date" name="date" value="<%= queryDate %>" aria-label="活动日期"></label>
    <button class="trace-primary" type="submit" <%= !bands.length ? 'disabled' : '' %>>查看活动</button><a href="<%= _base %>" class="trace-link">最近一次活动</a>
  </form>
  <div class="trace-notice" role="status"><% if (data && data.error) { %>活动记录暂时加载失败，请稍后重试。<% } else if (autoLoaded && _covered.length) { %>已自动载入最近一次活动：<strong><%= queryDate %></strong><%= isHistorical ? '（历史记录）' : '（今天）' %>。可切换幼儿或日期查看。<% } else if (_covered.length) { %>正在查看 <strong><%= queryDate %></strong><%= isHistorical ? ' 的历史活动记录' : ' 的活动记录' %>。<% } else { %>该日期暂无操场定位记录，地图仍可查看。可选择其他日期，或点击“最近一次活动”。<% } %></div>
  <section class="trace-summary" aria-label="活动概览">
    <div><span>当前幼儿</span><strong><%= _child ? _child.display_name || _child.child_name : '尚未绑定' %></strong><small><%= _child ? _child.class_name : '绑定手环后自动显示活动' %></small></div>
    <div><span>覆盖内活动</span><strong id="traceDuration"><%= Math.round(_duration) %><em>分钟</em></strong><small>不含信号覆盖中断时段</small></div>
    <div><span>经过分区</span><strong id="traceVisited"><%= _visited %><em>/ 3 个</em></strong><small>器械区与跑道活动区域</small></div>
    <div><span>定位采样</span><strong id="traceSamples"><%= _data ? _data.sample_count || 0 : 0 %><em>条</em></strong><small>按信号强度归纳活动分区</small></div>
  </section>
  <div class="trace-layout">
    <section class="trace-card trace-map-card"><div class="trace-card-heading"><h2>操场分区回放</h2><span class="trace-date"><%= queryDate %><%= isHistorical ? ' · 历史' : ' · 今天' %></span></div>
      <div class="trace-map" id="mapBox">
        <svg class="trace-map-image" viewBox="0 420 1600 370" preserveAspectRatio="none" role="img" aria-label="南操场示意图：器械区、跑道中段、跑道东段"><image href="/static/img/playground-map.jpg" width="1600" height="1131" /></svg>
        <div class="trace-zone-overlays"><% _zones.forEach((z,i) => { %><div id="traceZone<%= i %>" class="trace-zone"><span><%= z %></span></div><% }); %></div>
        <div id="traceMarker" class="trace-marker" hidden><span>所在分区</span><b>●</b></div>
        <div id="traceMapEmpty" class="trace-map-empty" <%= _covered.length ? 'hidden' : '' %>>暂无活动记录<span>操场图已就绪，选择有记录的日期即可回放</span></div>
      </div>
      <div class="trace-current" id="traceCurrent" aria-live="polite">正在准备活动回放</div>
      <div class="trace-player"><button id="btnPlay" class="trace-primary" aria-label="播放活动回放" disabled>▶ 播放</button><span id="nowTime">--:--</span><input id="seekBar" type="range" min="0" max="1000" value="1000" aria-label="活动回放进度" disabled><label>速度<select id="speedSel" aria-label="回放速度"><option value="10">10 倍</option><option value="30" selected>30 倍</option><option value="60">60 倍</option></select></label><button id="btnLive" class="trace-secondary" <%= !selectedBand ? 'disabled' : '' %>>刷新记录</button></div>
      <p class="trace-caption">拖动进度条或点击下方时段可跳转。按信号推算活动分区；标记表示所在分区，不代表精确位置。</p>
    </section>
    <section class="trace-card"><div class="trace-card-heading"><h2>分区停留</h2><span>分钟</span></div><div id="traceStay" class="trace-stay"></div><div class="trace-legend"><% _zones.forEach((z,i) => { %><span><i class="trace-color-<%= i %>"></i><%= z %></span><% }); %><span><i class="trace-color-gap"></i>覆盖外 / 信号中断</span></div><p class="trace-caption">常规采集时段为 9:00–11:00，历史记录按实际采样显示。没有信号的时段不会补画为连续轨迹。</p></section>
  </div>
  <section class="trace-card"><div class="trace-card-heading"><h2>活动时间线</h2><span id="traceTimelineCount"><%= _segments.length %> 个时段</span></div><div id="traceRibbon" class="trace-ribbon" aria-label="活动分区时间线"></div><div id="traceTimeline" class="trace-timeline"></div></section>
</main>
<script id="tracePayload" type="application/json"><%- JSON.stringify({data:_data,base:_base,date:queryDate,bandMac:selectedBand,zones:_zones,isHistorical:isHistorical}).replace(/</g,'\\u003c') %></script>
<script src="/static/band-trace.js?v=20261010b" defer></script>
<%- include('partials/footer') %>
