<%- include('partials/header') %>

<section class="zen-auth-container">
  <div class="zen-login-box">
    <div class="zen-login-header">
      <div class="zen-login-logo">
        <span class="zen-pulse-dot"></span>
        <span>智慧健康物联平台</span>
      </div>
      <h1 class="zen-login-title">账号登录</h1>
      <p class="zen-login-sub">输入园所管理或教师账号进入系统</p>
    </div>

    <% if (error) { %><div class="alert error" style="margin-bottom:18px;padding:10px 14px;border-radius:10px;font-size:13px;"><%= error %></div><% } %>

    <form method="post" action="/login" class="zen-login-form" role="form" aria-label="登录表单">
      <div class="zen-form-group">
        <label for="login-username">用户名</label>
        <div class="zen-input-wrap">
          <input id="login-username" type="text" name="username" placeholder="请输入用户名" required autocomplete="username" />
        </div>
      </div>
      <div class="zen-form-group">
        <label for="login-password">密码</label>
        <div class="zen-input-wrap">
          <input id="login-password" type="password" name="password" placeholder="请输入密码" required autocomplete="current-password" />
        </div>
      </div>
      <button class="zen-login-btn" type="submit">登 录</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
