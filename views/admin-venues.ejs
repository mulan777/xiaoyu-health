<%- include('partials/header', { pageClass: isReadonly ? 'admin-page readonly-mode' : 'admin-page' }) %>

<%
  const readonlyMode = !!isReadonly;
  const adminHotspotConfig = {
    boardWidth: layoutBoardWidth,
    boardHeight: layoutBoardHeight,
    backgrounds: (backgrounds || []).map(function(bg) {
      return {
        id: bg.id,
        name: bg.name,
        image_path: bg.image_path || '',
        map_x: bg.map_x || 0,
        map_y: bg.map_y || 0,
        map_width: bg.map_width || 0,
        map_height: bg.map_height || 0,
        sort_order: bg.sort_order || 1,
        is_fixed: !!bg.is_fixed,
        enabled: !!bg.enabled
      };
    }),
    venues: (venues || []).map(function(venue) {
      return {
        id: venue.id,
        name: venue.name,
        hotspot_points: Array.isArray(venue.hotspot_points) ? venue.hotspot_points : [],
        hotspot_hint_x: venue.hotspot_hint_x == null ? null : venue.hotspot_hint_x,
        hotspot_hint_y: venue.hotspot_hint_y == null ? null : venue.hotspot_hint_y
      };
    })
  };
  const toJson = function(value) {
    return JSON.stringify(value || []);
  };
  const mediaList = function(values, fallback) {
    const output = [];
    const pushValue = function(value) {
      if (typeof value !== 'string') return;
      const trimmed = value.trim();
      if (trimmed) output.push(trimmed);
    };

    if (Array.isArray(values)) {
      values.forEach(pushValue);
    } else if (typeof values === 'string' && values.trim()) {
      try {
        const parsed = JSON.parse(values);
        if (Array.isArray(parsed)) parsed.forEach(pushValue);
        else pushValue(values);
      } catch (error) {
        pushValue(values);
      }
    }

    (Array.isArray(fallback) ? fallback : [fallback]).forEach(pushValue);
    return Array.from(new Set(output));
  };
%>

<style>
  .venue-round-section {
    margin-bottom: 20px;
  }

  .venue-round-create {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-bottom: 16px;
    padding: 18px;
    border-radius: 18px;
    background: linear-gradient(180deg, #f7fbff, #f2f7fd);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .venue-round-create-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .venue-round-table .status-badge {
    white-space: nowrap;
  }

  .venue-round-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .round-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 220px;
  }

  .round-actions .inline-form {
    margin: 0;
  }

  .round-action-btn {
    min-height: auto;
    padding: 8px 14px;
    border-radius: 999px;
  }

  .round-action-btn.is-primary {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  .round-action-btn.is-danger {
    color: var(--error-text);
  }

  .readonly-mode .round-actions > button.round-action-btn {
    display: none !important;
  }

  @media (max-width: 760px) {
    .venue-round-create-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .round-actions {
      min-width: 0;
      width: 100%;
    }

    .round-actions .inline-form,
    .round-actions .btn {
      width: auto;
    }
  }
</style>

<section class="admin-hero card">
  <div>
    <div class="eyebrow">场地预约管理</div>
    <h1><%= title %></h1>
    <% if (readonlyMode) { %>
      <p style="margin-bottom:10px;color:var(--primary);font-weight:600;">只读账号当前仅展示预约轮次和预约结果，场地布局与场地列表已隐藏。</p>
    <% } %>
    <p>管理场地信息、布局地图和预约轮次。点击场地卡片可编辑详细信息。</p>
  </div>
  <div class="admin-hero-actions">
    <a class="btn" href="/admin">返回后台</a>
    <a class="btn" href="/admin/venues/bookings">查看预约结果</a>
  </div>
</section>

<% if (message) { %>
  <div class="alert success"><%= message %></div>
<% } %>

<!-- 预约轮次 -->
<% if (readonlyMode) { %>
  <div class="card" style="margin-bottom:20px;border:1px solid rgba(0,113,227,0.12);background:linear-gradient(135deg, rgba(255,255,255,0.96), rgba(232,241,253,0.9));">
    <div class="section-head" style="margin-bottom:0;">
      <div>
        <div class="eyebrow">只读模式</div>
        <div class="muted">当前页面仅保留预约轮次和“查看预约”入口，编辑布局、维护场地和取消预约等写操作都已关闭。</div>
      </div>
      <span class="status-badge info">仅查看</span>
    </div>
  </div>
  <% } %>

<section class="card venue-round-section">
  <div class="section-head">
    <div>
      <div class="eyebrow">智能推荐</div>
      <h3>教师端区域推荐开关</h3>
      <div class="muted" style="margin-top:8px;">开启后，教师预约页会结合体测数据、容量和上次选择推荐最优/次优区域；关闭后不显示推荐。</div>
    </div>
    <span class="status-badge <%= venueRecommendationEnabled ? 'ok' : 'off' %>"><%= venueRecommendationEnabled ? '已开启' : '已关闭' %></span>
  </div>
  <% if (!readonlyMode) { %>
    <form method="post" action="/admin/venues/recommendation/toggle" class="venue-round-create" style="grid-template-columns:1fr auto;align-items:center;">
      <label class="setting-check-row" style="margin:0;">
        <input type="checkbox" name="venueRecommendationEnabled" value="1" <%= venueRecommendationEnabled ? 'checked' : '' %> />
        <span>开启教师端场地智能推荐</span>
        <small>保存后立即生效，不影响已有预约记录。</small>
      </label>
      <button class="btn primary" type="submit">保存开关</button>
    </form>
  <% } %>
</section>

<section class="card venue-round-section">
  <div class="section-head">
    <div>
      <div class="eyebrow">预约轮次</div>
      <h3>统一配置开放时间</h3>
      <div class="muted" style="margin-top:8px;">创建后可以随时编辑活动日期、开放时间和截止时间，不用再删掉重建轮次。</div>
    </div>
  </div>
  <% if (!readonlyMode) { %>
  <form method="post" action="/admin/venues/round/add" class="form-grid venue-round-create">
    <label><span>活动日期</span><input type="date" name="roundDate" required /></label>
    <label><span>开放时间</span><input type="datetime-local" name="openTime" required /></label>
    <label><span>截止时间</span><input type="datetime-local" name="closeTime" /></label>
    <div class="venue-round-create-actions">
      <button class="btn primary" type="submit">创建轮次</button>
      <div class="muted" style="margin-top:8px;">建议先确定开放窗口，再通知教师统一预约。</div>
    </div>
  </form>
  <% } %>
  <% if (rounds.length) { %>
    <div class="table-wrap venue-round-table">
      <table class="data-table admin-table">
        <thead><tr><th>活动日期</th><th>开放时间</th><th>截止时间</th><th>状态</th><th>预约概况</th><th>操作</th></tr></thead>
        <tbody>
          <% rounds.forEach(function(round) { %>
            <tr>
              <td><strong><%= round.round_date_text || new Date(round.round_date).toISOString().slice(0, 10) %></strong></td>
              <td><%= round.open_time_text || '-' %></td>
              <td><%= round.close_time_text || '-' %></td>
              <td><span class="status-badge <%= round.status === 'open' ? 'ok' : round.status === 'closed' ? 'off' : '' %>"><%= round.status === 'open' ? '开放中' : round.status === 'closed' ? '已关闭' : '待开放' %></span></td>
              <td>
                <div class="venue-round-summary">
                  <% if (true) { %>
                  <span class="status-badge" style="background:#eef4ff;color:#2156c4;">总预约 <%= round.bookingSummary.totalCount %></span>
                  <span class="status-badge ok">确认 <%= round.bookingSummary.confirmedCount %></span>
                  <span class="status-badge" style="background:#fff1f1;color:#d53c4b;">取消 <%= round.bookingSummary.cancelledCount %></span>
                <% } else { %>
                <a class="btn small round-action-btn is-primary readonly-keep" href="/admin/venues/bookings?roundId=<%= round.id %>">查看预约</a>
                <% } %>
                </div>
              </td>
              <td>
                <div class="round-actions">
                <button
                  class="btn small round-action-btn"
                  type="button"
                  onclick='openRoundEditor(<%- JSON.stringify({
                    id: round.id,
                    roundDate: round.round_date_text || '',
                    openTime: round.open_time_input || '',
                    closeTime: round.close_time_input || '',
                    status: round.status,
                    totalCount: round.bookingSummary.totalCount || 0,
                    confirmedCount: round.bookingSummary.confirmedCount || 0,
                    cancelledCount: round.bookingSummary.cancelledCount || 0
                  }) %>)'
                >编辑时间</button>
                <% if (round.status === 'pending') { %>
                  <form method="post" action="/admin/venues/round/<%= round.id %>/status" class="inline-form"><input type="hidden" name="status" value="open" /><button class="btn small round-action-btn is-primary" type="submit">立即开放</button></form>
                <% } %>
                <% if (round.status === 'open') { %>
                  <form method="post" action="/admin/venues/round/<%= round.id %>/status" class="inline-form"><input type="hidden" name="status" value="closed" /><button class="btn small round-action-btn" type="submit">关闭</button></form>
                <% } %>
                <% if (round.status === 'closed') { %>
                  <form method="post" action="/admin/venues/round/<%= round.id %>/status" class="inline-form"><input type="hidden" name="status" value="open" /><button class="btn small round-action-btn" type="submit">重新开放</button></form>
                <% } %>
                <a class="btn small round-action-btn is-primary" href="/admin/venues/bookings?roundId=<%= round.id %>">查看预约</a>
                <form method="post" action="/admin/venues/round/<%= round.id %>/delete" class="inline-form" onsubmit="return confirm('删除该轮次及对应预约记录？')"><button class="btn small round-action-btn is-danger" type="submit">删除</button></form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">还没有预约轮次。</div>
  <% } %>
</section>

<!-- 地图布局 -->
<% if (!readonlyMode) { %>
<section class="card" style="margin-bottom:20px;">
  <div class="section-head">
    <div>
      <div class="eyebrow">布局编辑</div>
      <h3>拖动模块位置，拖动右下角调整尺寸</h3>
    </div>
    <form id="venueLayoutForm" method="post" action="/admin/venues/layout">
      <input id="layoutJsonInput" type="hidden" name="layoutJson" value="" />
      <button id="saveLayoutBtn" class="btn primary" type="button">保存布局</button>
    </form>
  </div>
  <!-- 批量工具栏 -->
  <div class="layout-batch-toolbar" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px;padding:0 4px;">
    <label style="display:flex;align-items:center;gap:4px;cursor:pointer;font-size:13px;"><input type="checkbox" id="layoutSelectAll" /> 全选</label>
    <span style="color:var(--muted);font-size:12px;" id="layoutSelectedCount">已选 0 个</span>
    <span style="color:var(--border);font-size:12px;">|</span>
    <label style="font-size:12px;">宽 <input type="number" id="batchWidth" value="100" min="40" max="600" style="width:60px;" /></label>
    <label style="font-size:12px;">高 <input type="number" id="batchHeight" value="65" min="30" max="600" style="width:60px;" /></label>
    <button class="btn small" type="button" id="batchResizeBtn">统一大小</button>
    <button class="btn small" type="button" id="batchAutoArrangeBtn">自动排列</button>
  </div>
  <details class="card" style="margin-bottom:12px;padding:16px 18px;">
    <summary style="cursor:pointer;font-weight:600;">+ 新增背景层</summary>
    <form method="post" action="/admin/venues/backgrounds/add" enctype="multipart/form-data" class="form-grid compact-venue-form" style="margin-top:12px;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));" data-background-form="add">
      <label><span>名称</span><input type="text" name="name" value="背景层" /></label>
      <label><span>X</span><input type="number" name="mapX" value="0" min="0" /></label>
      <label><span>Y</span><input type="number" name="mapY" value="0" min="0" /></label>
      <label><span>宽</span><input type="number" name="mapWidth" value="<%= layoutBoardWidth %>" min="80" /></label>
      <label><span>高</span><input type="number" name="mapHeight" value="<%= layoutBoardHeight %>" min="80" /></label>
      <label><span>层级</span><input type="number" name="sortOrder" value="1" min="1" /></label>
      <label><span>固定</span><select name="isFixed"><option value="0">否</option><option value="1">是</option></select></label>
      <label><span>状态</span><select name="enabled"><option value="1">启用</option><option value="0">停用</option></select></label>
      <label style="grid-column:1/-1;"><span>背景图</span><input type="file" name="image" accept="image/*" data-background-image-input /></label>
      <div class="muted" style="grid-column:1/-1;font-size:12px;">选图后会按图片比例自动重算宽高，并默认贴到左上角；保存后画布会跟着背景层重新计算。</div>
      <div class="tool-row">
        <button class="btn small" type="button" onclick="fitBackgroundFormToImage(this)">按图片比例铺满画布</button>
        <button class="btn primary" type="submit">添加背景层</button>
      </div>
    </form>
  </details>
  <% if ((backgrounds || []).length) { %>
    <div class="layout-background-toolbar">
      <span class="muted">已有背景层：可直接点“编辑”修改图片、尺寸和位置。</span>
      <% backgrounds.forEach(function(bg) { %>
        <button class="btn small" type="button" onclick="openBackgroundEditor(<%= bg.id %>)">编辑：<%= bg.name || ('背景' + bg.id) %></button>
      <% }) %>
    </div>
  <% } %>
  <div class="venue-map-wrapper">
    <div id="layoutCanvas" class="layout-canvas" style="width:<%= layoutBoardWidth %>px;height:<%= layoutBoardHeight %>px;">
      <% (backgrounds || []).forEach(function(bg) { %>
        <article class="layout-block layout-background-block <%= bg.is_fixed ? 'is-fixed' : '' %>" data-type="background" data-id="<%= bg.id %>" data-sort-order="<%= bg.sort_order || 1 %>" data-enabled="<%= bg.enabled ? 1 : 0 %>" data-is-fixed="<%= bg.is_fixed ? 1 : 0 %>" style="left:<%= bg.map_x %>px;top:<%= bg.map_y %>px;width:<%= bg.map_width %>px;height:<%= bg.map_height %>px;z-index:<%= 1 + (bg.sort_order || 1) %>;">
          <input type="checkbox" class="layout-block-check" style="position:absolute;top:2px;left:2px;z-index:10;" />
          <div class="layout-block-bg" style="<%= bg.image_path ? 'background-image:url(' + bg.image_path + ');' : '' %>"></div>
          <div class="layout-block-overlay"></div>
          <button class="layout-block-action" type="button" aria-label="编辑背景层" onpointerdown="event.stopPropagation()" onclick="event.stopPropagation();openBackgroundEditor(<%= bg.id %>)">编辑</button>
          <div class="layout-drag-zone" ondblclick="openBackgroundEditor(<%= bg.id %>)">
            <div class="layout-block-head">
              <strong>背景：<%= bg.name || ('背景' + bg.id) %></strong>
              <span class="status-badge <%= bg.enabled ? 'ok' : 'off' %>"><%= bg.enabled ? (bg.is_fixed ? '固定' : '启用') : '停用' %></span>
            </div>
            <div class="layout-block-meta"><%= bg.map_width %>×<%= bg.map_height %> @ (<%= bg.map_x %>, <%= bg.map_y %>)</div>
          </div>
          <button class="layout-handle" type="button" aria-label="调整尺寸"></button>
        </article>
      <% }) %>
      <% venues.forEach(function(venue) { %>
        <article class="layout-block" data-id="<%= venue.id %>" style="left:<%= venue.map_x %>px;top:<%= venue.map_y %>px;width:<%= venue.map_width %>px;height:<%= venue.map_height %>px;">
          <input type="checkbox" class="layout-block-check" style="position:absolute;top:2px;left:2px;z-index:10;" />
          <div class="layout-block-bg" style="<%= venue.image_path ? 'background-image:url(' + venue.image_path + ');' : '' %>"></div>
          <div class="layout-block-overlay"></div>
          <div class="layout-drag-zone">
            <div class="layout-block-head">
              <strong><%= venue.name %></strong>
              <span class="status-badge <%= venue.enabled ? 'ok' : 'off' %>"><%= venue.enabled ? '启用' : '停用' %></span>
            </div>
            <div class="layout-block-meta"><%= venue.map_width %>×<%= venue.map_height %> @ (<%= venue.map_x %>, <%= venue.map_y %>)</div>
          </div>
          <% if (venue.elements && venue.elements.length) { %>
            <% venue.elements.forEach(function(element) { %>
              <span class="layout-pin <%= element.enabled ? '' : 'is-disabled' %>" style="left:<%= element.pos_x %>px;top:<%= element.pos_y %>px;width:<%= element.box_width %>px;height:<%= element.box_height %>px;" title="<%= element.element_name %>"><%= element.element_name.slice(0, 2) %></span>
            <% }) %>
          <% } %>
          <button class="layout-handle" type="button" aria-label="调整尺寸"></button>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- 场地卡片网格 + 侧边编辑面板 -->
<section class="card" style="margin-bottom:20px;">
  <div class="section-head">
    <div>
      <div class="eyebrow">场地列表</div>
      <h3>点击卡片编辑详细信息</h3>
    </div>
    <button class="btn primary" type="button" onclick="document.getElementById('addVenuePanel').classList.toggle('open')">+ 新增场地</button>
  </div>

  <!-- 新增场地面板（默认隐藏） -->
  <div id="addVenuePanel" class="venue-slide-panel">
    <form method="post" action="/admin/venues/add" enctype="multipart/form-data" class="form-grid compact-venue-form venue-hotspot-form" data-form-label="新增场地">
      <h4 style="grid-column:1/-1;margin:0 0 4px 0;">新增场地</h4>
      <label><span>名称 *</span><input type="text" name="name" required placeholder="如：东门" /></label>
      <label><span>小班名额</span><input type="number" name="capSmall" value="1" min="0" /></label>
      <label><span>中班名额</span><input type="number" name="capMiddle" value="2" min="0" /></label>
      <label><span>大班名额</span><input type="number" name="capLarge" value="2" min="0" /></label>
      <label><span>排序</span><input type="number" name="sortOrder" value="1" /></label>
      <label><span>背景图</span><input type="file" name="image" accept="image/*" /></label>
      <input type="hidden" name="hotspotPoints" value="[]" data-hotspot-points />
      <input type="hidden" name="hotspotHintX" value="" data-hotspot-hint-x />
      <input type="hidden" name="hotspotHintY" value="" data-hotspot-hint-y />
      <input type="hidden" name="hotspotHintLabel" value="" data-hotspot-hint-label />
      <input type="hidden" name="hotspotHintLabelSize" value="14" data-hotspot-hint-label-size />
      <input type="hidden" name="hotspotHintColor" value="#2563eb" data-hotspot-hint-color />
      <input type="hidden" name="hotspotHintSize" value="28" data-hotspot-hint-size />
      <input type="hidden" name="hotspotHintLength" value="54" data-hotspot-hint-length />
      <input type="hidden" name="hotspotHintBounceMs" value="1500" data-hotspot-hint-bounce />
      <label><span>全屏场景图</span><input type="file" name="detailImage" accept="image/*" /></label>
      <label><span>场景宽(px)</span><input type="number" name="detailViewWidth" value="960" min="480" max="1600" /></label>
      <label><span>场景高(px)</span><input type="number" name="detailViewHeight" value="640" min="320" max="1200" /></label>
      <div class="venue-hotspot-field" style="grid-column:1/-1;">
        <div class="venue-hotspot-field-head">
          <strong>背景热区</strong>
          <button class="btn small" type="button" onclick="openHotspotEditor(this)">在背景上绘制</button>
        </div>
        <div class="muted venue-hotspot-summary" data-hotspot-summary>未绘制热区，将继续使用普通矩形布局。</div>
        <div class="muted" style="margin-top:6px;font-size:12px;">箭头文字、颜色、大小、长度和跳动频率统一在这个弹窗里调整。</div>
      </div>
      <label><span>游戏材料</span><input type="text" name="equipment" placeholder="如：攀爬架、平衡木、秋千" /></label>
      <div style="grid-column:1/-1;"><label><span>小班模块说明</span><textarea name="playDescSmall" rows="2"></textarea></label></div>
      <div style="grid-column:1/-1;"><label><span>小班玩法图片</span><input type="file" name="playImagesSmall" accept="image/*" multiple /></label></div>
      <div style="grid-column:1/-1;"><label><span>中大班模块说明</span><textarea name="playDescMl" rows="2"></textarea></label></div>
      <div style="grid-column:1/-1;"><label><span>中大班玩法图片</span><input type="file" name="playImagesMl" accept="image/*" multiple /></label></div>
      <div class="venue-hotspot-field" style="grid-column:1/-1;">
        <div class="venue-hotspot-field-head">
          <strong>大循环运动指导</strong>
          <span class="muted">技能分级指导需要先创建场地后，再到编辑面板中逐项添加。</span>
        </div>
      </div>
      <label><span>循环示意图</span><input type="file" name="loopGuideImage" accept="image/*" multiple /></label>
      <label><span>指导站位图</span><input type="file" name="loopGuideStationImage" accept="image/*" multiple /></label>
      <label><span>指导视频</span><input type="file" name="loopGuideVideo" accept="video/*" multiple /></label>
      <label><span>视频自动播放</span><select name="loopGuideVideoAutoplay"><option value="0">否</option><option value="1">是</option></select></label>
      <div style="grid-column:1/-1;"><label><span>小班大循环指导</span><textarea name="loopGuideDescSmall" rows="3" placeholder="填写循环路线、教师站位和安全指导要点"></textarea></label></div>
      <div style="grid-column:1/-1;"><label><span>中大班大循环指导</span><textarea name="loopGuideDescMl" rows="3" placeholder="填写循环路线、站位分工和提升要求"></textarea></label></div>
      <button class="btn primary" type="submit">添加场地</button>
    </form>
  </div>

  <div class="venue-grid">
    <% venues.forEach(function(venue, vi) { %>
      <div class="venue-card" data-venue-id="<%= venue.id %>" onclick="openVenueEditor(<%= venue.id %>)">
        <div class="venue-card-thumb" style="<%= venue.image_path ? 'background-image:url(' + venue.image_path + ')' : '' %>">
          <% if (!venue.image_path) { %><span class="venue-card-no-img"><%= venue.name.slice(0,2) %></span><% } %>
        </div>
        <div class="venue-card-body">
          <div class="venue-card-title"><%= venue.name %></div>
          <div class="venue-card-info">
            <span class="status-badge <%= venue.enabled ? 'ok' : 'off' %>" style="font-size:11px;"><%= venue.enabled ? '启用' : '停用' %></span>
            <span class="muted" style="font-size:11px;">小<%= venue.cap_small %> 中<%= venue.cap_middle %> 大<%= venue.cap_large %></span>
          </div>
          <% if (venue.equipment) { %><div class="venue-card-equip muted" style="font-size:11px;margin-top:4px;">🎮 <%= venue.equipment %></div><% } %>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- 右侧滑出编辑面板 -->
<% } %>
<div id="venueEditorOverlay" class="venue-editor-overlay" onclick="closeVenueEditor()"></div>
<div id="venueEditorDrawer" class="venue-editor-drawer">
  <div class="venue-editor-header">
    <h3 id="venueEditorTitle">编辑场地</h3>
    <button class="btn small" type="button" onclick="closeVenueEditor()">✕ 关闭</button>
  </div>
  <div id="venueEditorContent" class="venue-editor-body">
    <!-- JS 动态填充 -->
  </div>
</div>

<div id="hotspotEditorOverlay" class="modal-overlay hotspot-editor-overlay" style="display:none;">
  <div class="modal-box hotspot-editor-modal">
    <div class="modal-header">
      <div>
        <h3 id="hotspotEditorTitle">编辑背景热区</h3>
        <div class="muted" id="hotspotEditorDesc">在背景图上点击添加顶点，拖动圆点可微调。</div>
      </div>
      <button class="modal-close" type="button" onclick="closeHotspotEditor()">&times;</button>
    </div>
    <div class="modal-body hotspot-editor-body">
      <div class="hotspot-editor-toolbar">
        <button class="btn small primary" type="button" id="hotspotModeDrawBtn">绘制顶点</button>
        <button class="btn small" type="button" id="hotspotModeHintBtn">放置提示按钮</button>
        <button class="btn small" type="button" id="hotspotUndoBtn">撤销一点</button>
        <button class="btn small" type="button" id="hotspotClearBtn">清空热区</button>
        <button class="btn small" type="button" id="hotspotAutoHintBtn">按钮放到中心</button>
        <span class="muted" id="hotspotPointCount">0 个顶点</span>
      </div>
      <div class="hotspot-editor-style-grid">
        <label><span>箭头文字</span><input id="hotspotStyleLabel" type="text" value="" placeholder="如：模块4" /></label>
        <label><span>文字大小</span><input id="hotspotStyleLabelSize" type="number" value="14" min="10" max="36" /></label>
        <label><span>箭头颜色</span><input id="hotspotStyleColor" type="color" value="#2563eb" /></label>
        <label><span>箭头大小</span><input id="hotspotStyleSize" type="number" value="28" min="12" max="96" /></label>
        <label><span>箭头长度</span><input id="hotspotStyleLength" type="number" value="54" min="16" max="200" /></label>
        <label><span>跳动频率</span><input id="hotspotStyleBounce" type="number" value="1500" min="400" max="4000" step="50" /></label>
      </div>
      <div class="hotspot-zoom-panel">
        <span class="muted">查看比例</span>
        <div class="hotspot-zoom-controls">
          <button class="btn small" type="button" data-hotspot-zoom="fit">适应全图</button>
          <button class="btn small" type="button" data-hotspot-zoom="1">100%</button>
          <button class="btn small" type="button" data-hotspot-zoom="0.9">90%</button>
          <button class="btn small" type="button" data-hotspot-zoom="0.8">80%</button>
          <button class="btn small" type="button" data-hotspot-zoom="0.7">70%</button>
        </div>
      </div>
      <div class="hotspot-editor-stage-wrap">
        <div
          id="hotspotEditorStage"
          class="hotspot-editor-stage"
          data-board-width="<%= layoutBoardWidth %>"
          data-board-height="<%= layoutBoardHeight %>"
          data-base-width="<%= layoutBoardWidth %>"
          data-base-height="<%= layoutBoardHeight %>"
          style="width:<%= layoutBoardWidth %>px;height:<%= layoutBoardHeight %>px;"
        >
          <% (backgrounds || []).forEach(function(bg) { %>
            <div
              class="venue-background-layer <%= bg.is_fixed ? 'is-fixed' : '' %>"
              data-bg-id="<%= bg.id %>"
              data-original-x="<%= bg.map_x %>"
              data-original-y="<%= bg.map_y %>"
              data-original-width="<%= bg.map_width %>"
              data-original-height="<%= bg.map_height %>"
              data-enabled="<%= bg.enabled ? 1 : 0 %>"
              data-has-image="<%= bg.image_path ? 1 : 0 %>"
              style="left:<%= bg.map_x %>px;top:<%= bg.map_y %>px;width:<%= bg.map_width %>px;height:<%= bg.map_height %>px;z-index:<%= 1 + (bg.sort_order || 1) %>;"
            >
              <div class="venue-background-image" style="<%= bg.image_path ? 'background-image:url(' + bg.image_path + ');' : '' %>"></div>
            </div>
          <% }) %>
          <svg id="hotspotEditorSvg" class="hotspot-editor-svg" viewBox="0 0 <%= layoutBoardWidth %> <%= layoutBoardHeight %>" preserveAspectRatio="none">
            <g id="hotspotExistingGroup"></g>
            <polygon id="hotspotDraftPolygon" class="hotspot-editor-polygon" points=""></polygon>
            <polyline id="hotspotDraftPolyline" class="hotspot-editor-polyline" points=""></polyline>
            <g id="hotspotDraftPoints"></g>
          </svg>
          <button id="hotspotDraftHint" class="venue-hotspot-hint hotspot-editor-hint" type="button" aria-label="箭头提示">
            <span class="venue-hotspot-hint-label" id="hotspotDraftHintLabel">模块</span>
          </button>
        </div>
      </div>
      <div class="hotspot-editor-footer">
        <div class="muted" id="hotspotEditorMeta">点击背景即可落点，至少 3 个点形成热区。</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn" type="button" onclick="closeHotspotEditor()">取消</button>
          <button class="btn primary" type="button" id="hotspotSaveBtn">保存热区</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 隐藏的编辑表单模板（每个场地一份） -->
<% venues.forEach(function(venue) { %>
  <template id="venueForm_<%= venue.id %>">
    <% const elementStageWidth = Math.max(120, Number(venue.map_width || venue.image_width || 280)); %>
    <% const elementStageHeight = Math.max(120, Number(venue.map_height || venue.image_height || 180)); %>
    <% const elementStageImage = venue.detail_image_path || venue.image_path || ''; %>
    <form method="post" action="/admin/venues/<%= venue.id %>/edit" enctype="multipart/form-data" class="form-grid compact-venue-form venue-hotspot-form" data-form-label="<%= venue.name %>" data-venue-id="<%= venue.id %>">
      <label><span>名称</span><input type="text" name="name" value="<%= venue.name %>" required /></label>
      <label><span>小班名额</span><input type="number" name="capSmall" value="<%= venue.cap_small %>" min="0" /></label>
      <label><span>中班名额</span><input type="number" name="capMiddle" value="<%= venue.cap_middle %>" min="0" /></label>
      <label><span>大班名额</span><input type="number" name="capLarge" value="<%= venue.cap_large %>" min="0" /></label>
      <label><span>排序</span><input type="number" name="sortOrder" value="<%= venue.sort_order %>" /></label>
      <label><span>更换背景图</span><input type="file" name="image" accept="image/*" /></label>
      <label><span>图片宽(px)</span><input type="number" name="imageWidth" value="<%= venue.image_width || 280 %>" /></label>
      <label><span>图片高(px)</span><input type="number" name="imageHeight" value="<%= venue.image_height || 180 %>" /></label>
      <input type="hidden" name="hotspotPoints" value="<%= toJson(venue.hotspot_points) %>" data-hotspot-points />
      <input type="hidden" name="hotspotHintX" value="<%= venue.hotspot_hint_x == null ? '' : venue.hotspot_hint_x %>" data-hotspot-hint-x />
      <input type="hidden" name="hotspotHintY" value="<%= venue.hotspot_hint_y == null ? '' : venue.hotspot_hint_y %>" data-hotspot-hint-y />
      <input type="hidden" name="hotspotHintLabel" value="<%= venue.hotspot_hint_label || venue.name %>" data-hotspot-hint-label />
      <input type="hidden" name="hotspotHintLabelSize" value="<%= venue.hotspot_hint_label_size || 14 %>" data-hotspot-hint-label-size />
      <input type="hidden" name="hotspotHintColor" value="<%= venue.hotspot_hint_color || '#2563eb' %>" data-hotspot-hint-color />
      <input type="hidden" name="hotspotHintSize" value="<%= venue.hotspot_hint_size || 28 %>" data-hotspot-hint-size />
      <input type="hidden" name="hotspotHintLength" value="<%= venue.hotspot_hint_length || 54 %>" data-hotspot-hint-length />
      <input type="hidden" name="hotspotHintBounceMs" value="<%= venue.hotspot_hint_bounce_ms || 1500 %>" data-hotspot-hint-bounce />
      <label><span>更新场景图</span><input type="file" name="detailImage" accept="image/*" /></label>
      <label><span>场景宽(px)</span><input type="number" name="detailViewWidth" value="<%= venue.detail_view_width || 960 %>" min="480" max="1600" /></label>
      <label><span>场景高(px)</span><input type="number" name="detailViewHeight" value="<%= venue.detail_view_height || 640 %>" min="320" max="1200" /></label>
      <div class="venue-hotspot-field" style="grid-column:1/-1;">
        <div class="venue-hotspot-field-head">
          <strong>背景热区</strong>
          <button class="btn small" type="button" onclick="openHotspotEditor(this)">在背景上绘制</button>
        </div>
        <div class="muted venue-hotspot-summary" data-hotspot-summary>
          <% if (venue.hotspot_points && venue.hotspot_points.length >= 3) { %>
            已绘制 <%= venue.hotspot_points.length %> 个顶点，提示按钮坐标：(<%= venue.hotspot_hint_x == null ? '-' : venue.hotspot_hint_x %>, <%= venue.hotspot_hint_y == null ? '-' : venue.hotspot_hint_y %>)
          <% } else { %>
            未绘制热区，将继续使用普通矩形布局。
          <% } %>
        </div>
        <div class="muted" style="margin-top:6px;font-size:12px;">箭头文字和样式请在“在背景上绘制”弹窗中统一调整。</div>
        <% if (venue.detail_image_path) { %>
          <div class="venue-hotspot-scene-preview">
            <img src="<%= venue.detail_image_path %>" alt="<%= venue.name %> 场景图" />
          </div>
        <% } %>
      </div>
      <label style="grid-column:1/-1;"><span>游戏材料</span><input type="text" name="equipment" value="<%= venue.equipment || '' %>" placeholder="如：攀爬架、平衡木、秋千" /></label>
      <div style="grid-column:1/-1;"><label><span>小班模块说明</span><textarea name="playDescSmall" rows="2"><%= venue.play_desc_small || '' %></textarea></label></div>
      <div style="grid-column:1/-1;">
        <label><span>小班玩法图片</span><input type="file" name="playImagesSmall" accept="image/*" multiple /></label>
        <% const pis = (function(){ try { return JSON.parse(venue.play_images_small || '[]'); } catch(e) { return []; } })(); %>
        <% if (pis.length) { %>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">
            <% pis.forEach(function(img) { %>
              <div style="position:relative;">
                <img src="<%= img %>" style="width:60px;height:60px;object-fit:cover;border-radius:6px;" />
                <label style="position:absolute;top:-4px;right:-4px;background:#ff3b30;color:#fff;border-radius:50%;width:16px;height:16px;display:flex;align-items:center;justify-content:center;font-size:10px;cursor:pointer;" title="删除"><input type="checkbox" name="removePlayImagesSmall" value="<%= img %>" style="display:none" />✕</label>
              </div>
            <% }) %>
          </div>
          <div class="muted" style="font-size:11px;margin-top:4px;">点 ✕ 标记删除，保存后生效</div>
        <% } %>
      </div>
      <div style="grid-column:1/-1;"><label><span>中大班模块说明</span><textarea name="playDescMl" rows="2"><%= venue.play_desc_ml || '' %></textarea></label></div>
      <div style="grid-column:1/-1;">
        <label><span>中大班玩法图片</span><input type="file" name="playImagesMl" accept="image/*" multiple /></label>
        <% const pim = (function(){ try { return JSON.parse(venue.play_images_ml || '[]'); } catch(e) { return []; } })(); %>
        <% if (pim.length) { %>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">
            <% pim.forEach(function(img) { %>
              <div style="position:relative;">
                <img src="<%= img %>" style="width:60px;height:60px;object-fit:cover;border-radius:6px;" />
                <label style="position:absolute;top:-4px;right:-4px;background:#ff3b30;color:#fff;border-radius:50%;width:16px;height:16px;display:flex;align-items:center;justify-content:center;font-size:10px;cursor:pointer;" title="删除"><input type="checkbox" name="removePlayImagesMl" value="<%= img %>" style="display:none" />✕</label>
              </div>
            <% }) %>
          </div>
          <div class="muted" style="font-size:11px;margin-top:4px;">点 ✕ 标记删除，保存后生效</div>
        <% } %>
      </div>
      <div class="venue-hotspot-field" style="grid-column:1/-1;">
        <div class="venue-hotspot-field-head">
          <strong>大循环运动指导</strong>
          <span class="muted">在前台“运动资源与指导”中作为独立入口展示。</span>
        </div>
      </div>
      <label><span>更新循环示意图</span><input type="file" name="loopGuideImage" accept="image/*" multiple /></label>
      <label><span>更新指导站位图</span><input type="file" name="loopGuideStationImage" accept="image/*" multiple /></label>
      <label><span>更新指导视频</span><input type="file" name="loopGuideVideo" accept="video/*" multiple /></label>
      <label><span>视频自动播放</span><select name="loopGuideVideoAutoplay"><option value="0" <%= !venue.loop_guide_video_autoplay ? 'selected' : '' %>>否</option><option value="1" <%= venue.loop_guide_video_autoplay ? 'selected' : '' %>>是</option></select></label>
      <% const venueLoopGuideImages = mediaList(venue.loop_guide_images, venue.loop_guide_image_path); %>
      <% const venueLoopGuideStationImages = mediaList(venue.loop_guide_station_images, venue.loop_guide_station_image_path); %>
      <% const venueLoopGuideVideos = mediaList(venue.loop_guide_videos, venue.loop_guide_video_path); %>
      <% if (venueLoopGuideImages.length) { %>
        <div class="venue-hotspot-scene-preview">
          <div class="muted" style="margin-bottom:8px;">当前循环示意图（可多选删除）</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <% venueLoopGuideImages.forEach(function(item) { %>
              <label style="display:flex;flex-direction:column;gap:8px;max-width:220px;">
                <img src="<%= item %>" alt="<%= venue.name %> 循环示意图" />
                <span class="muted" style="display:inline-flex;gap:6px;align-items:center;"><input type="checkbox" name="removeLoopGuideImages" value="<%= item %>" /> 删除这张</span>
              </label>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (venueLoopGuideStationImages.length) { %>
        <div class="venue-hotspot-scene-preview">
          <div class="muted" style="margin-bottom:8px;">当前指导站位图（可多选删除）</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <% venueLoopGuideStationImages.forEach(function(item) { %>
              <label style="display:flex;flex-direction:column;gap:8px;max-width:220px;">
                <img src="<%= item %>" alt="<%= venue.name %> 指导站位图" />
                <span class="muted" style="display:inline-flex;gap:6px;align-items:center;"><input type="checkbox" name="removeLoopGuideStationImages" value="<%= item %>" /> 删除这张</span>
              </label>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (venueLoopGuideVideos.length) { %>
        <div class="venue-hotspot-scene-preview">
          <div class="muted" style="margin-bottom:8px;">当前指导视频（可多选删除）</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <% venueLoopGuideVideos.forEach(function(item) { %>
              <label style="display:flex;flex-direction:column;gap:8px;max-width:260px;">
                <video src="<%= item %>" controls style="width:100%;border-radius:12px;background:#0f172a;"></video>
                <span class="muted" style="display:inline-flex;gap:6px;align-items:center;"><input type="checkbox" name="removeLoopGuideVideos" value="<%= item %>" /> 删除这段</span>
              </label>
            <% }) %>
          </div>
        </div>
      <% } %>
      <div style="grid-column:1/-1;"><label><span>小班大循环指导</span><textarea name="loopGuideDescSmall" rows="3"><%= venue.loop_guide_desc_small || '' %></textarea></label></div>
      <div style="grid-column:1/-1;"><label><span>中大班大循环指导</span><textarea name="loopGuideDescMl" rows="3"><%= venue.loop_guide_desc_ml || '' %></textarea></label></div>
      <div class="tool-row"><button class="btn primary" type="submit">保存</button></div>
    </form>

    <div style="border-top:1px solid var(--border);margin-top:16px;padding-top:16px;">
      <strong style="font-size:13px;">运动资源与指导</strong>
      <div class="muted" style="margin-top:6px;font-size:12px;">右侧导航中的“技能分级指导”内容在这里维护。小班前台显示基础级，若额外等级选择为基础级2也会显示；中大班会显示基础级、提升级、额外等级和幼小衔接指标。</div>

      <% if (venue.skillGuides && venue.skillGuides.length) { %>
        <% venue.skillGuides.forEach(function(guide) { %>
          <details style="margin-top:10px;background:var(--bg);border-radius:12px;padding:10px 14px;">
            <summary style="cursor:pointer;font-size:13px;font-weight:600;"><%= guide.title %> <span class="status-badge <%= guide.enabled ? 'ok' : 'off' %>" style="font-size:10px;"><%= guide.enabled ? '启用' : '停用' %></span></summary>
            <form method="post" action="/admin/venues/skill-guides/<%= guide.id %>/edit" enctype="multipart/form-data" class="form-grid compact-venue-form" style="margin-top:10px;">
              <label><span>技能分类名称</span><input type="text" name="title" value="<%= guide.title %>" required /></label>
              <label><span>排序</span><input type="number" name="sortOrder" value="<%= guide.sort_order || 1 %>" min="1" /></label>
              <label><span>状态</span><select name="enabled"><option value="1" <%= guide.enabled ? 'selected' : '' %>>启用</option><option value="0" <%= !guide.enabled ? 'selected' : '' %>>停用</option></select></label>
              <div class="venue-hotspot-field" style="grid-column:1/-1;"><div class="venue-hotspot-field-head"><strong>基础级</strong><span class="muted">小班只显示这一层。</span></div></div>
              <div style="grid-column:1/-1;"><label><span>基础级技能名称</span><textarea name="basicSkillNames" rows="2"><%= guide.basic_skill_names || '' %></textarea></label></div>
              <div style="grid-column:1/-1;"><label><span>基础级对应器械</span><textarea name="basicEquipment" rows="2"><%= guide.basic_equipment || '' %></textarea></label></div>
              <div style="grid-column:1/-1;"><label><span>基础级动作要领</span><textarea name="basicActionPoints" rows="4"><%= guide.basic_action_points || '' %></textarea></label></div>
              <div style="grid-column:1/-1;"><label><span>基础级安全指导要点</span><textarea name="basicSafetyPoints" rows="4"><%= guide.basic_safety_points || '' %></textarea></label></div>
              <label><span>基础级配图</span><input type="file" name="basicImage" accept="image/*" multiple /></label>
              <label><span>基础级视频</span><input type="file" name="basicVideo" accept="video/*" multiple /></label>
              <label><span>基础级视频自动播放</span><select name="basicVideoAutoplay"><option value="0" <%= !guide.basic_video_autoplay ? 'selected' : '' %>>否</option><option value="1" <%= guide.basic_video_autoplay ? 'selected' : '' %>>是</option></select></label>
              <% const guideBasicImages = mediaList(guide.basic_image_paths, guide.basic_image_path); %>
              <% const guideBasicVideos = mediaList(guide.basic_video_paths, guide.basic_video_path); %>
              <% if (guideBasicImages.length) { %>
                <div class="venue-hotspot-scene-preview">
                  <div class="muted" style="margin-bottom:8px;">当前基础级配图（可多选删除）</div>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <% guideBasicImages.forEach(function(item) { %>
                      <label style="display:flex;flex-direction:column;gap:8px;max-width:220px;">
                        <img src="<%= item %>" alt="<%= guide.title %> 基础级配图" />
                        <span class="muted" style="display:inline-flex;gap:6px;align-items:center;"><input type="checkbox" name="removeBasicImages" value="<%= item %>" /> 删除这张</span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              <% } %>
              <% if (guideBasicVideos.length) { %>
                <div class="venue-hotspot-scene-preview">
                  <div class="muted" style="margin-bottom:8px;">当前基础级视频（可多选删除）</div>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <% guideBasicVideos.forEach(function(item) { %>
                      <label style="display:flex;flex-direction:column;gap:8px;max-width:260px;">
                        <video src="<%= item %>" controls style="width:100%;border-radius:12px;background:#0f172a;"></video>
                        <span class="muted" style="display:inline-flex;gap:6px;align-items:center;"><input type="checkbox" name="removeBasicVideos" value="<%= item %>" /> 删除这段</span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              <% } %>

              <div class="venue-hotspot-field" style="grid-column:1/-1;"><div class="venue-hotspot-field-head"><strong>提升级</strong><span class="muted">仅中大班前台展示。</span></div></div>
              <div style="grid-column:1/-1;"><label><span>提升级技能名称</span><textarea name="advancedSkillNames" rows="2"><%= guide.advanced_skill_names || '' %></textarea></label></div>
              <div style="grid-column:1/-1;"><label><span>提升级对应器械</span><textarea name="advancedEquipment" rows="2"><%= guide.advanced_equipment || '' %></textarea></label></div>
              <div style="grid-column:1/-1;"><label><span>提升级动作要领</span><textarea name="advancedActionPoints" rows="4"><%= guide.advanced_action_points || '' %></textarea></label></div>
              <div style="grid-column:1/-1;"><label><span>提升级安全指导要点</span><textarea name="advancedSafetyPoints" rows="4"><%= guide.advanced_safety_points || '' %></textarea></label></div>
