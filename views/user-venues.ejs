                  <article class="venue-resource-panel" data-resource-panel="<%= target %>" hidden>
                    <div class="venue-resource-panel-head">
                      <div>
                        <div class="venue-resource-panel-label">技能分级指导</div>
                        <h4><%= guide.title %></h4>
