<%- include('partials/header') %>

<%
  const formatAttentionPeriod = function(startDate, endDate) {
    const start = startDate ? new Date(startDate).toISOString().slice(0, 10) : '即日起';
    const end = endDate ? new Date(endDate).toISOString().slice(0, 10) : '长期';
    return start + ' ~ ' + end;
  };
  const parseAttentionTags = function(value) {
    return String(value || '').split(',').map(function(item) { return item.trim(); }).filter(Boolean);
  };
  const attentionVestKey = function(item) {
    if (!item) return 'yellow';
    if (item.attention_vest_type === 'red') return 'red';
    if (item.attention_vest_type === 'green') return 'green';
    return 'yellow';
  };
  const attentionVestLabel = function(item) {
    const vest = attentionVestKey(item);
    return vest === 'red' ? '红马甲' : (vest === 'green' ? '绿马甲' : '黄马甲');
  };
  const attentionVestClass = function(item) {
    return 'attention-vest-' + attentionVestKey(item);
  };
  const attentionVenueLabel = function(item) {
    if (!item) return '';
    if (item.venueSummary) {
      return item.venueSummary;
    }
    if (Number(item.sort_order || 0) > 0 && item.venue_name) {
      return '模块' + item.sort_order + ' · ' + item.venue_name;
    }
    if (Number(item.sort_order || 0) > 0) {
      return '模块' + item.sort_order;
    }
    return item.venue_name || '';
  };
  const pageConfig = {
    round: activeRound ? {
      status: activeRound.status,
      openTime: activeRound.open_time_text,
      closeTime: activeRound.close_time_text || null
    } : null,
    serverNow: now
  };
  const hasConfirmedBooking = Object.keys(bookingMap || {}).length > 0;
  const bookedVenueSummary = bookedVenueLabel || '';
  const attentionGroupLabel = myGrade === 'small' ? '小班' : '中大班';
  const attentionReminderRows = Array.isArray(attentionReminderChildren) && attentionReminderChildren.length ? attentionReminderChildren : attentionChildren;
  const venueSceneImage = function(venue) {
    return venue.detail_image_path || venue.image_path || '';
  };
  const venueSceneDesc = function(venue) {
    return myGrade === 'small'
      ? (venue.play_desc_small || '暂无小班玩法说明')
      : (venue.play_desc_ml || '暂无中大班玩法说明');
  };
  const venueHotspotPoints = function(venue) {
    return Array.isArray(venue.hotspot_points) ? venue.hotspot_points : [];
  };
  const venueHotspotString = function(venue) {
    return venueHotspotPoints(venue).map(function(point) { return point.x + ',' + point.y; }).join(' ');
  };
  const venueHotspotHintStyle = function(venue) {
    return [
      'left:' + venue.hotspot_hint_x + 'px',
      'top:' + venue.hotspot_hint_y + 'px',
      '--hint-color:' + (venue.hotspot_hint_color || '#2563eb'),
      '--hint-label-size:' + (venue.hotspot_hint_label_size || 14) + 'px',
      '--hint-size:' + (venue.hotspot_hint_size || 28) + 'px',
      '--hint-length:' + (venue.hotspot_hint_length || 54) + 'px',
      '--hint-bounce-ms:' + (venue.hotspot_hint_bounce_ms || 1500) + 'ms'
    ].join(';');
  };
  const venueSceneBaseWidth = function(venue) {
    return Math.max(Number(venue.detail_view_width || venue.image_width || venue.map_width || 1), 1);
  };
  const venueSceneBaseHeight = function(venue) {
    return Math.max(Number(venue.detail_view_height || venue.image_height || venue.map_height || 1), 1);
  };
  const venueLoopGuideDesc = function(venue) {
    return myGrade === 'small'
      ? (venue.loop_guide_desc_small || '暂无小班大循环运动指导')
      : (venue.loop_guide_desc_ml || '暂无中大班大循环运动指导');
  };
  const mediaList = function(values, fallbackValues) {
    const output = [];
    const pushValue = function(value) {
      if (typeof value !== 'string') return;
      const trimmed = value.trim();
      if (trimmed) output.push(trimmed);
    };
    if (Array.isArray(values)) {
      values.forEach(pushValue);
    } else if (typeof values === 'string' && values.trim()) {
      try {
        const parsed = JSON.parse(values);
        if (Array.isArray(parsed)) parsed.forEach(pushValue);
        else pushValue(values);
      } catch (error) {
        pushValue(values);
      }
    }
    (Array.isArray(fallbackValues) ? fallbackValues : [fallbackValues]).forEach(pushValue);
    return Array.from(new Set(output));
  };
  const skillGuideExtraLevelType = function(guide) {
    if (!guide) return '';
    if (guide.extra_level_type === 'basic') return 'basic';
    if (guide.extra_level_type === 'advanced') return 'advanced';
    return '';
  };
  const skillGuideExtraLevelLabel = function(guide) {
    return skillGuideExtraLevelType(guide) === 'basic' ? '基础级2' : '提升级2';
  };
  const skillGuideHasExtraLevel = function(guide) {
    return !!(
      skillGuideExtraLevelType(guide) &&
      (
        guide.extra_skill_names ||
        guide.extra_equipment ||
        guide.extra_action_points ||
        guide.extra_safety_points ||
        mediaList(guide.extra_image_paths, guide.extra_image_path).length ||
        mediaList(guide.extra_video_paths, guide.extra_video_path).length
      )
    );
  };
  const venueHasLoopGuide = function(venue) {
    return !!(
      mediaList(venue.loop_guide_images, venue.loop_guide_image_path).length ||
      mediaList(venue.loop_guide_station_images, venue.loop_guide_station_image_path).length ||
      mediaList(venue.loop_guide_videos, venue.loop_guide_video_path).length ||
      venue.loop_guide_desc_small ||
      venue.loop_guide_desc_ml
    );
  };
  const venueResourceDefaultTarget = function(venue) {
    if (venue.skillGuides && venue.skillGuides.length) {
      return 'guide-' + venue.skillGuides[0].id;
    }
    return venueHasLoopGuide(venue) ? 'loop' : '';
  };
  const venueHasResourceGuides = function(venue) {
    return !!((venue.skillGuides && venue.skillGuides.length) || venueHasLoopGuide(venue));
  };
  const venueElementPercentStyle = function(venue, element) {
    const baseWidth = venueSceneBaseWidth(venue);
    const baseHeight = venueSceneBaseHeight(venue);
    const left = Math.max(0, Number(element.pos_x || 0)) / baseWidth * 100;
    const top = Math.max(0, Number(element.pos_y || 0)) / baseHeight * 100;
    const width = Math.max(24, Number(element.box_width || 44)) / baseWidth * 100;
    const height = Math.max(24, Number(element.box_height || 44)) / baseHeight * 100;
    return [
      'left:' + left.toFixed(4) + '%',
      'top:' + top.toFixed(4) + '%',
      'width:' + width.toFixed(4) + '%',
      'height:' + height.toFixed(4) + '%'
    ].join(';');
  };
%>

<section class="dashboard-head card">
  <div>
    <div class="eyebrow">场地预约</div>
    <h1>户外活动场地预约</h1>
    <p>
      您是 <strong><%= myGradeLabel || '-' %></strong> 教师。
      <% if (myGrade === 'small') { %>
        当前页面展示小班可见名额和小班玩法。
      <% } else if (myGrade) { %>
        当前页面展示中大班共享占用情况，同时按您本年级的真实可约名额控制预约。
      <% } else { %>
        当前账号尚未绑定班级。
      <% } %>
    </p>
  </div>
  <a class="btn" href="/user">返回工作台</a>
</section>

<% if (message) { %>
  <div class="alert success"><%= message %></div>
<% } %>

<% if (!classId) { %>
  <div class="card"><div class="empty-state">您的账号未绑定班级，请联系管理员。</div></div>
<% } else if (!activeRound) { %>
  <div class="card"><div class="empty-state">暂无预约活动，请等待管理员发布。</div></div>
<% } else { %>

  <% if (attentionReminderRows && attentionReminderRows.length) { %>
    <section class="card venue-attention-card">
      <div class="section-head">
        <div>
          <div class="eyebrow">重点关注提醒</div>
          <h3>当前已预约场地内您可见年级的重点关注幼儿（<%= attentionGroupLabel %>）</h3>
        </div>
        <span class="status-badge warn"><%= attentionChildren.length %> 名需关注</span>
      </div>
      <div class="child-mobile-list">
        <% attentionReminderRows.forEach(function(child) { const attentionTags = parseAttentionTags(child.attention_tags); const attentionVenue = attentionVenueLabel(child); const vestType = attentionVestKey(child); %>
          <div class="child-item attention-reminder-card <%= attentionVestClass(child) %>">
            <div class="child-item-head attention-reminder-head">
              <div class="attention-reminder-main">
                <strong><%= child.name %></strong>
                <div class="muted attention-reminder-subtitle"><%= child.class_name %> · <%= gradeLabel(child.grade_level) %><%= child.gender ? ' · ' + child.gender : '' %></div>
              </div>
              <div class="attention-reminder-badges">
                <span class="vest-badge <%= vestType %>"><%= attentionVestLabel(child) %></span>
                <span class="status-badge warn">需关注</span>
              </div>
            </div>
            <div class="attention-reminder-meta">
              <% if (attentionVenue) { %>
                <span class="attention-reminder-meta-chip">所在模块：<%= attentionVenue %></span>
              <% } %>
              <span class="attention-reminder-meta-chip">有效期：<%= formatAttentionPeriod(child.attention_start_date, child.attention_end_date) %></span>
            </div>
            <div class="attention-reminder-detail"><strong>原因：</strong><%= child.attention_reason || '已被标记为重点关注，请活动时重点照看。' %></div>
            <% if (attentionTags.length) { %>
              <div class="attention-reminder-tag-row">
                <span class="attention-reminder-label">标签</span>
                <div class="tag-list compact-tag-list">
                  <% attentionTags.forEach(function(tag) { %><span class="tag-pill"><%= tag %></span><% }) %>
                </div>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (false) { %>
    <section id="venueAttentionManage" class="card venue-attention-manage-card">
      <div class="section-head">
        <div>
          <div class="eyebrow">二次晨检</div>
          <h3>本班重点关注维护</h3>
          <div class="muted">
            仅允许维护
            <strong><%= assignedClass && assignedClass.name ? assignedClass.name : '当前班级' %></strong>
            的幼儿。保存后会同步出现在预约成功场地的重点关注提醒里。
          </div>
        </div>
        <span class="status-badge <%= ownActiveAttentionChildren.length ? 'warn' : 'ok' %>">
          <%= ownActiveAttentionChildren.length ? (ownActiveAttentionChildren.length + ' 名需关注') : '当前无重点关注' %>
        </span>
      </div>

      <div class="venue-attention-manage-grid">
        <form method="post" action="/user/venues/attention/save" class="venue-attention-form" id="userVenueAttentionForm">
          <label>
            <span>选择幼儿</span>
            <select name="childId" id="userVenueAttentionChild" required>
              <option value="">请选择本班幼儿</option>
              <% ownClassChildrenSafe.forEach(function(child) {
                const childStart = child.attention_start_date ? new Date(child.attention_start_date).toISOString().slice(0, 10) : '';
                const childEnd = child.attention_end_date ? new Date(child.attention_end_date).toISOString().slice(0, 10) : '';
                const childTagsText = parseAttentionTags(child.attention_tags).join(',');
              %>
                <option
                  value="<%= child.id %>"
                  data-attention-reason="<%= child.attention_reason || '' %>"
                  data-attention-start="<%= childStart %>"
                  data-attention-end="<%= childEnd %>"
                  data-attention-tags="<%= childTagsText %>"
                  data-attention-active="<%= Number(child.needs_attention || 0) ? '1' : '0' %>"
                >
                  <%= child.name %><%= child.gender ? ' · ' + child.gender : '' %>
                </option>
              <% }) %>
            </select>
          </label>

          <label>
            <span>关注原因</span>
            <input type="text" name="attentionReason" id="userVenueAttentionReason" placeholder="例如：咳嗽，减少跑跳" />
          </label>

          <div class="venue-attention-form-row">
            <label>
              <span>开始日期</span>
              <input type="date" name="attentionStartDate" id="userVenueAttentionStart" value="<%= todayText || '' %>" />
            </label>
            <label>
              <span>结束日期</span>
              <input type="date" name="attentionEndDate" id="userVenueAttentionEnd" />
            </label>
          </div>

          <label>
            <span>关注标签</span>
            <input type="text" name="attentionTagsExtra" id="userVenueAttentionTags" placeholder="例如：咳嗽,恢复期,扭伤，多项用逗号分隔" />
          </label>

          <div class="venue-attention-form-actions">
            <button class="btn primary" type="submit">保存重点关注</button>
            <span class="muted">已设置过的幼儿再次保存会直接覆盖原内容。</span>
          </div>
        </form>

        <div class="venue-attention-current">
          <div class="venue-attention-current-head">
            <strong>当前本班已关注</strong>
            <span class="muted"><%= ownActiveAttentionChildren.length %> 名</span>
          </div>
          <% if (ownActiveAttentionChildren.length) { %>
            <div class="venue-attention-current-list">
              <% ownActiveAttentionChildren.forEach(function(child) { %>
                <div class="venue-attention-current-item">
                  <div class="venue-attention-current-meta">
                    <div>
                      <strong><%= child.name %></strong>
                      <div class="muted"><%= formatAttentionPeriod(child.attention_start_date, child.attention_end_date) %></div>
                    </div>
                    <form method="post" action="/user/venues/attention/clear" class="inline-form">
                      <input type="hidden" name="childId" value="<%= child.id %>" />
                      <button class="btn small" type="submit">取消关注</button>
                    </form>
                  </div>
                  <div class="venue-scene-text"><%= child.attention_reason || '已标记为重点关注，请活动前再次确认。' %></div>
                  <% const ownTags = parseAttentionTags(child.attention_tags); %>
                  <% if (ownTags.length) { %>
                    <div class="tag-list compact-tag-list">
                      <% ownTags.forEach(function(tag) { %><span class="tag-pill"><%= tag %></span><% }) %>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="venue-resource-empty venue-attention-current-empty">当前本班还没有设置重点关注幼儿。</div>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>

  <section class="card venue-round-card">
    <div class="section-head">
      <div>
        <div class="eyebrow">预约轮次</div>
        <h3>活动日期：<%= activeRound.round_date_text || new Date(activeRound.round_date).toISOString().slice(0, 10) %></h3>
        <div class="muted">
          开放时间：<strong><%= activeRound.open_time_text ? activeRound.open_time_text.replace(/-/g, '/') : '-' %></strong>
          <% if (activeRound.close_time_text) { %>
            · 截止：<%= activeRound.close_time_text.replace(/-/g, '/') %>
          <% } %>
        </div>
      </div>
      <% if (hasConfirmedBooking && bookedVenueSummary) { %>
        <div class="venue-countdown-box">
          <div class="venue-countdown-label">预约状态</div>
          <div class="venue-countdown-timer">您已成功预约 <%= bookedVenueSummary %></div>
        </div>
      <% } else { %>
        <div class="venue-countdown-box">
          <div id="countdownLabel" class="venue-countdown-label"></div>
          <div id="countdownTimer" class="venue-countdown-timer"></div>
        </div>
      <% } %>
    </div>
  </section>

  <% if (venueRecommendationEnabled && Array.isArray(venueRecommendations) && venueRecommendations.length) { %>
    <section class="card venue-recommend-card">
      <div class="section-head">
        <div>
          <div class="eyebrow">智能推荐</div>
          <h3>推荐优先选择的区域</h3>
          <div class="muted">结合本班体测短板、当前容量和上一次区域选择，自动给出最优与次优模块。</div>
        </div>
        <span class="status-badge info">已开启</span>
      </div>
      <div class="venue-recommend-list">
        <% venueRecommendations.forEach(function(item) { %>
          <article class="venue-recommend-item <%= item.rank === '最优选择' ? 'is-best' : '' %>">
            <div class="venue-recommend-head">
              <span class="venue-recommend-rank"><%= item.rank %></span>
              <strong><%= item.label || item.venueName %></strong>
            </div>
            <ul class="venue-recommend-reasons">
              <% (item.reasons || []).forEach(function(reason) { %>
                <li><%= reason %></li>
              <% }) %>
            </ul>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="card venue-map-shell">
    <div class="section-head">
      <div>
        <div class="eyebrow">场地地图</div>
        <h3>超大地图居中显示，支持切换成文字列表</h3>
        <div class="muted">桌面端默认地图模式，手机端默认文字模式。点击切换按钮可在两种 UI 间来回切换。</div>
      </div>
      <div class="venue-view-toolbar">
        <span id="viewModeBadge" class="status-badge">当前：地图模式</span>
        <button id="viewToggleBtn" class="btn small" type="button">切换UI显示</button>
      </div>
    </div>

    <div id="venueMapView" class="venue-view-panel">
      <div id="venueMapStage" class="venue-map-stage">
        <div id="venueMapStageInner" class="venue-map-stage-inner">
          <div
            id="venueMapBoard"
            class="venue-map-board"
            data-board-width="<%= layoutBoardWidth %>"
            data-board-height="<%= layoutBoardHeight %>"
            style="width:<%= layoutBoardWidth %>px;height:<%= layoutBoardHeight %>px;"
          >
            <% (backgrounds || []).forEach(function(bg) { %>
              <div
                class="venue-background-layer <%= bg.is_fixed ? 'is-fixed' : '' %>"
                style="left:<%= bg.map_x %>px;top:<%= bg.map_y %>px;width:<%= bg.map_width %>px;height:<%= bg.map_height %>px;z-index:<%= 1 + (bg.sort_order || 1) %>;"
              >
                <div
                  class="venue-background-image"
                  style="<%= bg.image_path ? 'background-image:url(' + bg.image_path + '?v=' + cssVersion + ');' : '' %>"
                ></div>
              </div>
            <% }) %>
            <% const hotspotVenues = venues.filter(function(v) { return venueHotspotPoints(v).length >= 3; }); %>
            <% if (hotspotVenues.length) { %>
              <div class="venue-map-hotspot-layer">
                <svg class="venue-hotspot-svg" viewBox="0 0 <%= layoutBoardWidth %> <%= layoutBoardHeight %>" preserveAspectRatio="none">
                  <% hotspotVenues.forEach(function(v) { %>
                    <polygon
                      class="venue-hotspot-shape js-open-venue-scene <%= bookingMap[v.id] ? 'is-mine' : '' %> <%= v._full && !bookingMap[v.id] ? 'is-pool-full' : '' %>"
                      data-venue-id="<%= v.id %>"
                      points="<%= venueHotspotString(v) %>"
                    ></polygon>
                  <% }) %>
                </svg>
                <% hotspotVenues.forEach(function(v) { %>
                  <button
                    type="button"
                    class="venue-hotspot-hint js-open-venue-scene <%= bookingMap[v.id] ? 'is-mine' : '' %> <%= v._full && !bookingMap[v.id] ? 'is-pool-full' : '' %>"
                    data-venue-id="<%= v.id %>"
                    title="<%= v.hotspot_hint_label || v.name %>"
                    aria-label="查看 <%= v.name %> 场地详情"
                    style="<%= venueHotspotHintStyle(v) %>;"
                  >
                    <span class="venue-hotspot-hint-label"><%= v.hotspot_hint_label || v.name %></span>
                  </button>
                <% }) %>
              </div>
            <% } %>
            <% venues.forEach(function(v) { %>
              <% if (venueHotspotPoints(v).length >= 3) { return; } %>
              <article
                class="venue-zone <%= bookingMap[v.id] ? 'is-mine' : '' %> <%= v._full && !bookingMap[v.id] ? 'is-pool-full' : '' %>"
                style="left:<%= v.map_x %>px;top:<%= v.map_y %>px;width:<%= v.map_width %>px;height:<%= v.map_height %>px;"
              >
                <button
                  type="button"
                  class="venue-zone-hit js-open-venue-scene"
                  aria-label="查看 <%= v.name %> 场地详情"
                  data-venue-id="<%= v.id %>"
                ></button>
                <div
                  class="venue-zone-bg"
                  style="<%= v.image_path ? 'background-image:url(' + v.image_path + '?v=' + cssVersion + ');' : '' %>"
                ></div>

                <div class="venue-zone-overlay"></div>

                <div class="venue-zone-head">
                  <div>
                    <h4><%= v.name %></h4>
                    <div class="venue-zone-meta">
                      <% if (myGrade === 'small') { %>
                        小班已约 <strong><%= v._bookedSmall %>/<%= v.cap_small %></strong>
                      <% } else { %>
                        中大班占用 <strong><%= v._booked %>/<%= v._visibleCapacity %></strong>
                        <span class="muted">中 <%= v._bookedMiddle %>/<%= v.cap_middle %> · 大 <%= v._bookedLarge %>/<%= v.cap_large %></span>
                      <% } %>
                    </div>
                  </div>
                  <div class="venue-zone-badge"><%= v._booked %>/<%= v._visibleCapacity %></div>
                </div>

                <div class="venue-zone-foot">
                  <div class="venue-class-list">
                    <% if (v._visibleBookings.length) { %>
                      <% v._visibleBookings.forEach(function(item) { %>
                        <span class="venue-class-chip <%= Number(item.class_id) === Number(classId) ? 'is-self' : '' %>"><%= item.class_name %></span>
                      <% }) %>
                    <% } else { %>
                      <span class="venue-class-empty">当前可见范围内还没有班级预约</span>
                    <% } %>
                  </div>

                  <div class="venue-zone-actions">
                    <div class="venue-availability">
                      您所在<%= myGradeLabel %>可约：<strong><%= v._myPoolBooked %>/<%= v._myPoolCapacity %></strong>
                    </div>

                    <% if (bookingMap[v.id]) { %>
                      <form method="post" action="/user/venues/cancel" class="inline-form">
                        <input type="hidden" name="bookingId" value="<%= bookingMap[v.id].id %>" />
                        <button class="btn small" type="submit">取消预约</button>
                      </form>
                    <% } else if (hasConfirmedBooking) { %>
                      <button class="btn small" type="button" disabled>本轮已预约其他场地</button>
                    <% } else if (v._full) { %>
                      <button class="btn small" type="button" disabled>本年级名额已满</button>
                    <% } else { %>
                      <form method="post" action="/user/venues/book" class="inline-form">
                        <input type="hidden" name="venueId" value="<%= v.id %>" />
                        <input type="hidden" name="roundId" value="<%= activeRound.id %>" />
                        <button class="btn small primary book-btn" type="submit" disabled>预约</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="muted venue-map-caption">地图模式用于查看整体布局，点击模块区域可进入对应的运动资源与指导。</div>
    </div>

    <div id="venueTextView" class="venue-view-panel" hidden>
      <div class="venue-text-list">
        <% venues.forEach(function(v) { %>
          <article class="venue-text-card">
            <div class="venue-text-head">
              <div>
                <h4><%= v.name %></h4>
                <div class="muted">
                  <% if (myGrade === 'small') { %>
                    小班已约 <strong><%= v._bookedSmall %>/<%= v.cap_small %></strong>
                  <% } else { %>
                    中大班占用 <strong><%= v._booked %>/<%= v._visibleCapacity %></strong>
                    · 中 <%= v._bookedMiddle %>/<%= v.cap_middle %> · 大 <%= v._bookedLarge %>/<%= v.cap_large %>
                  <% } %>
                </div>
              </div>
              <div class="venue-zone-badge"><%= v._booked %>/<%= v._visibleCapacity %></div>
            </div>

            <div class="venue-text-body">
              <div class="venue-text-row">
                <strong>当前可见班级</strong>
                <div class="venue-class-list">
                  <% if (v._visibleBookings.length) { %>
                    <% v._visibleBookings.forEach(function(item) { %>
                      <span class="venue-class-chip <%= Number(item.class_id) === Number(classId) ? 'is-self' : '' %>"><%= item.class_name %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="venue-class-empty">还没有班级预约</span>
                  <% } %>
                </div>
              </div>

              <div class="venue-text-row">
                <strong>运动资源与指导</strong>
                <div class="venue-class-list">
                  <span class="venue-class-empty">点击“查看场地”后，可在右侧切换技能分级指导和大循环运动指导。</span>
                </div>
              </div>

              <div class="venue-text-actions">
                <button
                  type="button"
                  class="btn small js-open-venue-scene"
                  data-venue-id="<%= v.id %>"
                >查看场地</button>

                <% if (bookingMap[v.id]) { %>
                  <form method="post" action="/user/venues/cancel" class="inline-form">
                    <input type="hidden" name="bookingId" value="<%= bookingMap[v.id].id %>" />
                    <button class="btn small" type="submit">取消预约</button>
                  </form>
                <% } else if (hasConfirmedBooking) { %>
                  <button class="btn small" type="button" disabled>本轮已预约其他场地</button>
                <% } else if (v._full) { %>
                  <button class="btn small" type="button" disabled>本年级名额已满</button>
                <% } else { %>
                  <form method="post" action="/user/venues/book" class="inline-form">
                    <input type="hidden" name="venueId" value="<%= v.id %>" />
                    <input type="hidden" name="roundId" value="<%= activeRound.id %>" />
                    <button class="btn small primary book-btn" type="submit" disabled>预约</button>
                  </form>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<div id="venueSceneModal" class="modal-overlay venue-scene-overlay" style="display:none;">
  <div class="modal-box venue-scene-modal">
    <div class="modal-header">
      <div>
        <h3 id="venueSceneTitle">场地详情</h3>
      </div>
      <button id="venueSceneClose" class="modal-close" type="button">&times;</button>
    </div>
    <div id="venueSceneContent" class="modal-body venue-scene-content"></div>
  </div>
</div>

<div id="venueSceneImageModal" class="modal-overlay venue-scene-image-overlay" style="display:none;">
