    </div>
  </div>
</div>

<% venues.forEach(function(v) { const sceneImage = venueSceneImage(v); const sceneDesc = venueSceneDesc(v); const loopGuideDesc = venueLoopGuideDesc(v); const defaultResourceTarget = venueResourceDefaultTarget(v); const hasResourceGuides = venueHasResourceGuides(v); const sceneAttentionChildren = (sceneAttentionRows || []).filter(function(child) { return Number(child.venue_id) === Number(v.id); }); const yellowAttentionChildren = sceneAttentionChildren.filter(function(child) { return attentionVestKey(child) === 'yellow'; }); const greenAttentionChildren = sceneAttentionChildren.filter(function(child) { return attentionVestKey(child) === 'green'; }); const redAttentionChildren = sceneAttentionChildren.filter(function(child) { return attentionVestKey(child) === 'red'; }); const defaultAttentionVest = redAttentionChildren.length ? 'red' : (yellowAttentionChildren.length ? 'yellow' : (greenAttentionChildren.length ? 'green' : 'yellow')); %>
  <template id="venueSceneTemplate_<%= v.id %>" data-title="<%= v.name %>">
