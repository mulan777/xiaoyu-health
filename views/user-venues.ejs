                      <% } %>
                      <% if (false && (guide.basic_image_path || guide.basic_video_path)) { %>
                        <div class="venue-resource-media-grid">
                          <% if (guide.basic_image_path) { %>
                            <figure class="venue-resource-figure">
                              <img src="<%= guide.basic_image_path %>?v=<%= cssVersion %>" alt="<%= guide.title %> 基础级配图" />
                              <figcaption>基础级配图</figcaption>
                            </figure>
                          <% } %>
                          <% if (guide.basic_video_path) { %>
                            <div class="venue-resource-video">
                              <video src="<%= guide.basic_video_path %>?v=<%= cssVersion %>" controls playsinline <%= guide.basic_video_autoplay ? 'autoplay muted' : '' %>></video>
                              <span class="muted"><%= guide.basic_video_autoplay ? '基础级视频已设置自动播放（静音）' : '基础级视频手动播放' %></span>
                            </div>
                          <% } %>
                        </div>
                      <% } %>
                    </div>

                    <% if (myGrade !== 'small' && hasAdvanced) { %>
                      <div class="venue-resource-level-panel" data-resource-level-panel="advanced" hidden>
                        <div class="venue-resource-content-grid">
                          <section class="venue-resource-card">
                            <strong>技能名称</strong>
                            <div class="venue-scene-text"><%= guide.advanced_skill_names || '暂无提升级技能名称' %></div>
                          </section>
                          <section class="venue-resource-card">
                            <strong>对应器械</strong>
