                        <section class="venue-resource-card">
                          <strong>安全指导要点</strong>
                          <div class="venue-scene-text"><%= guide.basic_safety_points || '暂无基础级安全指导要点' %></div>
                        </section>
                      </div>
                      <% const basicImages = mediaList(guide.basic_image_paths, guide.basic_image_path); %>
                      <% const basicVideos = mediaList(guide.basic_video_paths, guide.basic_video_path); %>
                      <% if (basicImages.length || basicVideos.length) { %>
                        <div class="venue-resource-media-grid">
                          <% basicImages.forEach(function(item, index) { %>
                            <figure class="venue-resource-figure">
                              <img src="<%= item %>?v=<%= cssVersion %>" alt="<%= guide.title %> 基础级配图 <%= index + 1 %>" />
                              <figcaption>基础级配图 <%= index + 1 %></figcaption>
