                      <% } %>
                      <% if (myGrade !== 'small' && hasBridge) { %>
                        <button type="button" class="venue-resource-level-btn js-resource-level" data-resource-level="bridge">幼小衔接指标</button>
                      <% } %>
                    </div>

                    <div class="venue-resource-level-panel is-active" data-resource-level-panel="basic">
                      <div class="venue-resource-content-grid">
                        <section class="venue-resource-card">
