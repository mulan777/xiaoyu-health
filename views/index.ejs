<%- include('partials/header') %>

<section class="minimal-home">
  <div class="minimal-home-copy">
    <div class="minimal-kicker"><%= settings.subtitle || '教研管理平台' %></div>
    <h1><%= settings.heroTitle || settings.siteName %></h1>
    <div class="minimal-actions">
      <a class="apple-btn apple-btn-primary" href="/login">进入平台</a>
      <a class="apple-btn apple-btn-secondary" href="/login">查看趋势</a>
    </div>
  </div>

  <div class="minimal-chart-card" aria-label="生长与体测趋势预览">
    <div class="minimal-chart-head">
      <span>Growth / Fitness</span>
      <strong>趋势看板</strong>
    </div>
    <svg viewBox="0 0 720 360" role="img" aria-label="趋势示意图">
      <defs>
        <linearGradient id="minimalBlue" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#60a5fa" stop-opacity=".20"/><stop offset="1" stop-color="#60a5fa" stop-opacity="0"/></linearGradient>
        <linearGradient id="minimalCyan" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#22d3ee" stop-opacity=".14"/><stop offset="1" stop-color="#22d3ee" stop-opacity="0"/></linearGradient>
      </defs>
      <g class="minimal-grid">
        <line x1="54" y1="64" x2="666" y2="64"/><line x1="54" y1="126" x2="666" y2="126"/><line x1="54" y1="188" x2="666" y2="188"/><line x1="54" y1="250" x2="666" y2="250"/><line x1="54" y1="312" x2="666" y2="312"/>
      </g>
      <path d="M54 270 C128 232 170 238 234 198 C304 154 354 174 420 126 C498 70 560 100 666 58 L666 312 L54 312 Z" fill="url(#minimalBlue)"/>
      <path d="M54 286 C132 256 178 260 246 224 C318 186 372 208 444 164 C510 122 576 136 666 104 L666 312 L54 312 Z" fill="url(#minimalCyan)"/>
      <path class="minimal-line line-main" d="M54 270 C128 232 170 238 234 198 C304 154 354 174 420 126 C498 70 560 100 666 58"/>
      <path class="minimal-line line-second" d="M54 286 C132 256 178 260 246 224 C318 186 372 208 444 164 C510 122 576 136 666 104"/>
      <path class="minimal-line line-third" d="M54 238 C126 220 184 230 254 178 C326 126 390 150 456 116 C524 84 588 92 666 76"/>
      <g class="minimal-dots"><circle cx="234" cy="198" r="6"/><circle cx="420" cy="126" r="6"/><circle cx="666" cy="58" r="6"/></g>
    </svg>
    <div class="minimal-legend"><span><i class="a"></i>综合</span><span><i class="b"></i>生长</span><span><i class="c"></i>对比</span></div>
  </div>
</section>

<%- include('partials/footer') %>
