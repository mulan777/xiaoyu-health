<%- include('partials/header') %>

<% const ft = content.features || []; %>
<% const ql = content.quickLinks || []; %>

<section class="apple-hero data-hero">
  <div class="data-hero-grid">
    <div class="data-hero-copy">
      <div class="apple-eyebrow"><%= settings.subtitle || '教研管理平台' %></div>
      <h1 class="apple-hero-title"><%= settings.heroTitle || settings.siteName %></h1>
      <p class="apple-hero-desc"><%= settings.heroDesc || '把幼儿体测、生长趋势、班级对比和场地预约放进一个清晰的数据工作台。' %></p>
      <div class="apple-hero-actions data-hero-actions">
        <a class="apple-btn apple-btn-primary" href="/login">进入数据工作台</a>
        <a class="apple-btn apple-btn-secondary" href="#fitness-preview">查看趋势能力</a>
      </div>
    </div>
    <div class="hero-chart-card" aria-label="平台趋势能力预览">
      <div class="hero-chart-topline">
        <div><span class="apple-section-kicker">Growth Trend</span><h2>生长与体测趋势</h2></div>
        <span class="hero-live-pill">实时分析</span>
      </div>
      <svg class="hero-trend-svg" viewBox="0 0 640 330" role="img" aria-label="身高、体重、综合体测趋势示意图">
        <defs>
          <linearGradient id="heroAreaBlue" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#0071e3" stop-opacity=".26" /><stop offset="1" stop-color="#0071e3" stop-opacity="0" /></linearGradient>
          <linearGradient id="heroAreaOrange" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#ff9f0a" stop-opacity=".22" /><stop offset="1" stop-color="#ff9f0a" stop-opacity="0" /></linearGradient>
        </defs>
        <g class="hero-grid-lines"><line x1="52" y1="58" x2="590" y2="58" /><line x1="52" y1="116" x2="590" y2="116" /><line x1="52" y1="174" x2="590" y2="174" /><line x1="52" y1="232" x2="590" y2="232" /><line x1="52" y1="290" x2="590" y2="290" /></g>
        <path d="M52 250 C118 214 144 218 198 190 C260 158 294 178 350 142 C422 96 472 126 590 72 L590 290 L52 290 Z" fill="url(#heroAreaBlue)" />
        <path d="M52 258 C122 238 158 242 216 212 C276 182 322 206 382 166 C442 128 500 146 590 112 L590 290 L52 290 Z" fill="url(#heroAreaOrange)" />
        <path class="hero-line-blue" d="M52 250 C118 214 144 218 198 190 C260 158 294 178 350 142 C422 96 472 126 590 72" />
        <path class="hero-line-orange" d="M52 258 C122 238 158 242 216 212 C276 182 322 206 382 166 C442 128 500 146 590 112" />
        <path class="hero-line-pink" d="M52 226 C128 202 172 226 232 178 C300 124 354 162 410 134 C470 102 526 110 590 88" />
        <g class="hero-chart-dots"><circle cx="198" cy="190" r="6" /><circle cx="350" cy="142" r="6" /><circle cx="590" cy="72" r="6" /></g>
        <g class="hero-axis-labels"><text x="52" y="315">3月</text><text x="198" y="315">4月</text><text x="350" y="315">5月</text><text x="590" y="315" text-anchor="end">6月</text></g>
      </svg>
      <div class="hero-chart-legend"><span><i style="background:#0071e3"></i>综合得分</span><span><i style="background:#ff9f0a"></i>生长趋势</span><span><i style="background:#ec4899"></i>BMI 变化</span></div>
    </div>
  </div>
</section>

<section class="apple-stats card data-stat-strip">
  <div class="apple-stat-item"><div class="apple-stat-value">8</div><div class="apple-stat-label">体测评分维度</div></div>
  <div class="apple-stat-item"><div class="apple-stat-value">趋势</div><div class="apple-stat-label">生长 / 体测双曲线</div></div>
  <div class="apple-stat-item"><div class="apple-stat-value">对比</div><div class="apple-stat-label">个人 / 班级 / 年级</div></div>
  <div class="apple-stat-item"><div class="apple-stat-value">AI</div><div class="apple-stat-label">智能体质分析报告</div></div>
</section>

<section class="apple-section" id="fitness-preview">
  <div class="apple-section-head">
    <div class="apple-section-kicker">Visual Analytics</div>
    <h2>首页先看趋势，再进入管理。</h2>
    <p>把教师端已经更新的生长趋势、体测趋势和幼儿纵向对比能力，前置成可感知的数据入口。</p>
  </div>
  <div class="home-visual-grid">
    <article class="home-visual-card home-visual-card-large">
      <div class="home-visual-head"><span>全园体测趋势</span><strong>项目均分对比</strong></div>
      <div class="mini-bars" aria-hidden="true"><i style="--h:62%;--c:#ef4444"></i><i style="--h:78%;--c:#f97316"></i><i style="--h:54%;--c:#eab308"></i><i style="--h:84%;--c:#22c55e"></i><i style="--h:69%;--c:#06b6d4"></i><i style="--h:76%;--c:#8b5cf6"></i></div>
      <p>握力、跳远、体前屈、双脚跳、障碍跑、平衡木等项目按批次自动生成趋势。</p>
    </article>
    <article class="home-visual-card">
      <div class="home-visual-head"><span>幼儿纵向对比</span><strong>个人轨迹</strong></div>
      <div class="mini-sparkline"><svg viewBox="0 0 260 96"><path d="M8 72 C42 58 58 68 86 42 S142 44 170 28 S220 38 252 18"/></svg></div>
      <p>点击幼儿姓名即可查看身高、体重、BMI 与体测得分变化。</p>
    </article>
    <article class="home-visual-card">
      <div class="home-visual-head"><span>管理端同步</span><strong>全局视角</strong></div>
      <div class="mini-rings"><span style="--p:78%">78</span><span style="--p:64%">64</span><span style="--p:86%">86</span></div>
      <p>Admin 支持全园、年级、班级、个人多维筛选与导出。</p>
    </article>
  </div>
</section>

<% if (ft.length) { %>
<section class="apple-section">
  <div class="apple-section-head"><div class="apple-section-kicker">核心能力</div><h2>专注体适能教研场景</h2></div>
  <div class="apple-feature-grid"><% ft.forEach(function(item) { %><article class="apple-feature-card"><h3><%= item.title %></h3><p><%= item.desc %></p></article><% }) %></div>
</section>
<% } %>

<section class="apple-split-grid">
  <div class="apple-panel card"><div class="apple-section-kicker">教师端</div><h3>移动优先，随时录入</h3><p><%= settings.mobileHint || '教师端已适配手机 H5，可通过微信直接访问，随时录入体测数据和管理场地预约。' %></p></div>
  <div class="apple-panel card"><div class="apple-section-kicker">管理端</div><h3>统一维护，清晰可控</h3><p><%= settings.adminNotice || '管理员可在后台统一管理用户权限、班级设置、幼儿档案、体测数据和场地配置。' %></p></div>
</section>

<%- include('partials/footer') %>
