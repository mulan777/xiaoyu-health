<%- include('partials/header') %>

<section class="premium-home">
  <div class="premium-hero">
    <div class="premium-kicker"><%= settings.subtitle || '幼儿园体适能教研平台' %></div>
    <h1><%= settings.heroTitle || settings.siteName %></h1>
    <p>体测、生长、预约与 AI 分析，一站式完成。</p>
    <div class="premium-actions">
      <a class="premium-btn primary" href="/login">进入平台</a>
      <a class="premium-btn ghost" href="#capabilities">查看能力</a>
    </div>
    <div class="premium-mini-pills" aria-label="平台功能入口">
      <a href="/login">体测</a>
      <a href="/login">成长</a>
      <a href="/login">预约</a>
      <a href="/login">AI</a>
    </div>
  </div>

  <div class="premium-visual" aria-label="平台能力视觉预览">
    <div class="premium-orb orb-a"></div>
    <div class="premium-orb orb-b"></div>
    <div class="premium-orb orb-c"></div>
    <div class="premium-glass-panel">
      <div class="premium-panel-top">
        <span>Health Intelligence</span>
        <i></i>
      </div>
      <svg viewBox="0 0 760 360" role="img" aria-label="平台趋势视觉">
        <defs>
          <linearGradient id="premiumBlue" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#60a5fa"/><stop offset="1" stop-color="#22d3ee"/></linearGradient>
          <linearGradient id="premiumPurple" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#a78bfa"/><stop offset="1" stop-color="#60a5fa"/></linearGradient>
          <filter id="softGlow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <g opacity=".34" stroke="#94a3b8" stroke-width="1">
          <line x1="64" y1="72" x2="700" y2="72"/><line x1="64" y1="144" x2="700" y2="144"/><line x1="64" y1="216" x2="700" y2="216"/><line x1="64" y1="288" x2="700" y2="288"/>
        </g>
        <path d="M66 276 C142 224 190 244 258 194 C334 138 392 160 466 108 C548 50 612 80 700 44" fill="none" stroke="url(#premiumBlue)" stroke-width="8" stroke-linecap="round" filter="url(#softGlow)"/>
        <path d="M66 292 C150 260 202 258 274 226 C348 192 414 210 492 162 C572 112 632 126 700 92" fill="none" stroke="url(#premiumPurple)" stroke-width="6" stroke-linecap="round" stroke-dasharray="14 14" opacity=".9"/>
        <g fill="#fff" stroke="#3b82f6" stroke-width="5">
          <circle cx="258" cy="194" r="8"/><circle cx="466" cy="108" r="8"/><circle cx="700" cy="44" r="8"/>
        </g>
      </svg>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
