<%- include('partials/header') %>

<section class="minimal-home">
  <div class="minimal-home-copy">
    <div class="minimal-kicker"><%= settings.subtitle || '教研管理平台' %></div>
    <h1><%= settings.heroTitle || settings.siteName %></h1>
    <div class="minimal-actions">
      <a class="apple-btn apple-btn-primary" href="/login">进入平台</a>
      <a class="apple-btn apple-btn-secondary" href="/login">查看趋势</a>
    </div>
  </div>

  <div class="minimal-chart-card" aria-label="生长与体测趋势预览">
    <div class="minimal-chart-head">
      <span>Growth / Fitness</span>
      <strong>趋势看板</strong>
    </div>
    <svg viewBox="0 0 720 360" role="img" aria-label="趋势示意图">
      <defs>
        <linearGradient id="minimalBlue" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#60a5fa" stop-opacity=".20"/><stop offset="1" stop-color="#60a5fa" stop-opacity="0"/></linearGradient>
        <linearGradient id="minimalCyan" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#22d3ee" stop-opacity=".14"/><stop offset="1" stop-color="#22d3ee" stop-opacity="0"/></linearGradient>
      </defs>
      <g class="minimal-grid">
        <line x1="54" y1="64" x2="666" y2="64"/><line x1="54" y1="126" x2="666" y2="126"/><line x1="54" y1="188" x2="666" y2="188"/><line x1="54" y1="250" x2="666" y2="250"/><line x1="54" y1="312" x2="666" y2="312"/>
      </g>
      <path d="M54 270 C128 232 170 238 234 198 C304 154 354 174 420 126 C498 70 560 100 666 58 L666 312 L54 312 Z" fill="url(#minimalBlue)"/>
      <path d="M54 286 C132 256 178 260 246 224 C318 186 372 208 444 164 C510 122 576 136 666 104 L666 312 L54 312 Z" fill="url(#minimalCyan)"/>
      <path d="M54 270 C128 232 170 238 234 198 C304 154 354 174 420 126 C498 70 560 100 666 58" fill="none" stroke="#3b82f6" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M54 286 C132 256 178 260 246 224 C318 186 372 208 444 164 C510 122 576 136 666 104" fill="none" stroke="#06b6d4" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M54 238 C126 220 184 230 254 178 C326 126 390 150 456 116 C524 84 588 92 666 76" fill="none" stroke="#8b5cf6" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="10 10"/>
      <g class="minimal-dots"><circle cx="234" cy="198" r="6" fill="#3b82f6" stroke="#fff" stroke-width="4"/><circle cx="420" cy="126" r="6" fill="#3b82f6" stroke="#fff" stroke-width="4"/><circle cx="666" cy="58" r="6" fill="#3b82f6" stroke="#fff" stroke-width="4"/></g>
    </svg>
    <div class="minimal-legend integrated-legend">
      <span><i class="a"></i><strong>综合</strong><em>总分趋势</em></span>
      <span><i class="b"></i><strong>生长</strong><em>身高 / 体重 / BMI</em></span>
      <span><i class="c"></i><strong>对比</strong><em>个人 / 班级</em></span>
    </div>
  </div>
</section>

<section class="home-capability-strip" aria-label="平台核心能力">
  <a href="/login"><strong>体测数据</strong><span>录入、导入、评分、导出</span></a>
  <a href="/login"><strong>成长档案</strong><span>幼儿资料与重点关注</span></a>
  <a href="/login"><strong>场地预约</strong><span>班级预约与开放时间</span></a>
  <a href="/login"><strong>AI 报告</strong><span>智能体质分析建议</span></a>
</section>

<%- include('partials/footer') %>
