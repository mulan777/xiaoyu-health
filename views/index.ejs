<%- include('partials/header') %>

<section class="lux-home">
  <div class="lux-home-copy">
    <div class="lux-kicker"><%= settings.subtitle || '幼儿园体适能教研平台' %></div>
    <h1><%= settings.heroTitle || settings.siteName %></h1>
    <p><%= settings.heroDesc || '体测、生长、预约与 AI 分析，一站式完成。' %></p>

    <div class="lux-actions">
      <a class="lux-btn primary" href="/login">进入平台</a>
    </div>

    <div class="lux-tags">
      <span>体测管理</span>
      <span>成长档案</span>
      <span>预约排班</span>
      <span>AI 分析</span>
    </div>

    <div class="lux-stats-row" aria-label="平台核心指标">
      <div>
        <strong>3+1</strong>
        <span>教师、园所、家长协同</span>
      </div>
      <div>
        <strong>实时</strong>
        <span>体测与成长数据同步</span>
      </div>
      <div>
        <strong>AI</strong>
        <span>自动生成分析与建议</span>
      </div>
    </div>
  </div>

  <div class="lux-home-visual">
    <div class="lux-blob blob-a"></div>
    <div class="lux-blob blob-b"></div>
    <div class="lux-blob blob-c"></div>
    <div class="lux-hero-card">
      <div class="lux-card-top">
        <span>Health Intelligence</span>
        <em>Live</em>
      </div>
      <div class="lux-dashboard-grid">
        <article>
          <strong>93%</strong>
          <span>出勤覆盖</span>
        </article>
        <article>
          <strong>128</strong>
          <span>今日体测任务</span>
        </article>
        <article>
          <strong>AI</strong>
          <span>趋势洞察</span>
        </article>
      </div>
      <svg viewBox="0 0 760 360" role="img" aria-label="平台趋势视觉">
        <defs>
          <linearGradient id="luxBlue" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#2563eb" />
            <stop offset="1" stop-color="#06b6d4" />
          </linearGradient>
          <linearGradient id="luxWarm" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#fb7185" />
            <stop offset="1" stop-color="#f59e0b" />
          </linearGradient>
          <filter id="luxGlow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="6" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <g opacity=".22" stroke="#94a3b8" stroke-width="1">
          <line x1="60" y1="64" x2="704" y2="64" />
          <line x1="60" y1="128" x2="704" y2="128" />
          <line x1="60" y1="192" x2="704" y2="192" />
          <line x1="60" y1="256" x2="704" y2="256" />
        </g>
        <path d="M64 272 C132 232 186 238 250 188 C320 134 386 160 456 114 C540 58 616 74 702 42" fill="none" stroke="url(#luxBlue)" stroke-width="9" stroke-linecap="round" filter="url(#luxGlow)" />
        <path d="M64 292 C144 256 200 258 274 226 C346 196 414 214 494 166 C570 120 628 126 702 96" fill="none" stroke="url(#luxWarm)" stroke-width="6" stroke-linecap="round" stroke-dasharray="12 12" opacity=".95" />
        <g fill="#fff" stroke="#2563eb" stroke-width="5">
          <circle cx="250" cy="188" r="8" />
          <circle cx="456" cy="114" r="8" />
          <circle cx="702" cy="42" r="8" />
        </g>
      </svg>
      <div class="lux-inline-notes">
        <span>体测</span>
        <span>成长曲线</span>
        <span>AI 报告</span>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
