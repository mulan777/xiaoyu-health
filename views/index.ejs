        </div>
      </div>

      <!-- 医疗级心率脉冲波形窗口：极慢流动，宁静舒展 -->
      <div class="board-ecg-window">
        <div class="ecg-window-title">
          <span>实时心率图谱 (Real-time ECG Stream)</span>
          <span class="ecg-filter">滤波降噪 · 100Hz</span>
        </div>
        <div class="ecg-svg-container" style="height:85px;">
          <canvas id="luxEcgCanvas" width="520" height="85" style="width:100%;height:100%;display:block;"></canvas>
        </div>
      </div>

      <!-- 底部状态指示 -->
      <div class="board-footer-roster">
        <div class="roster-tag is-active">
          <span class="dot-green"></span>
          <span>全园体征连续监护中</span>
        </div>
        <div class="roster-tag">
          <span class="dot-blue"></span>
          <span>异常体征 0 项告警</span>
        </div>
        <div class="roster-tag">
          <span class="dot-blue"></span>
          <span>数据已实时归档</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 极慢、极稳、极平缓的流动波形脚本 -->
<script>
(function() {
  var canvas = document.getElementById('luxEcgCanvas');
  if (canvas) {
    var ctx = canvas.getContext('2d');
    var w = canvas.width;
    var h = canvas.height;
    var step = 0;

    function getWaveY(x) {
      var phase = (x % 140);
      var mid = h * 0.58;
      if (phase >= 30 && phase < 45) {
        return mid - Math.sin((phase - 30) / 15 * Math.PI) * 6; // P波
      } else if (phase >= 55 && phase < 58) {
        return mid + 5; // Q
      } else if (phase >= 58 && phase < 66) {
        return mid - 30; // R尖峰
      } else if (phase >= 66 && phase < 72) {
        return mid + 14; // S
      } else if (phase >= 85 && phase < 110) {
        return mid - Math.sin((phase - 85) / 25 * Math.PI) * 9; // T波
      }
      return mid + (Math.sin(x * 0.12) * 1.2);
    }

    function render() {
      ctx.clearRect(0, 0, w, h);

      // 背景微网格
      ctx.strokeStyle = 'rgba(51, 65, 85, 0.35)';
      ctx.lineWidth = 0.8;
      ctx.setLineDash([2, 3]);
      for (var y = 20; y < h; y += 22) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }
      for (var x = 30; x < w; x += 65) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
      }
      ctx.setLineDash([]);

      // 渐变主线
      var grad = ctx.createLinearGradient(0, 0, w, 0);
      grad.addColorStop(0, '#0284c7');
      grad.addColorStop(0.4, '#3b82f6');
      grad.addColorStop(0.75, '#10b981');
      grad.addColorStop(1, '#38bdf8');

      ctx.beginPath();
      ctx.strokeStyle = grad;
      ctx.lineWidth = 2.2;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      for (var i = 0; i < w; i++) {
        var yVal = getWaveY(i + step);
        if (i === 0) ctx.moveTo(i, yVal);
        else ctx.lineTo(i, yVal);
      }
      ctx.stroke();

      // 尾端呼吸流式亮点
      var lastY = getWaveY(w - 1 + step);
      ctx.beginPath();
      ctx.arc(w - 4, lastY, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#38bdf8';
      ctx.shadowColor = '#38bdf8';
      ctx.shadowBlur = 8;
      ctx.fill();
      ctx.shadowBlur = 0;

      // 步进放慢到 0.45（原来是 1.8，慢了整整 4 倍，平缓优雅像真实医用监护仪）
      step += 0.45;
      requestAnimationFrame(render);
    }
    requestAnimationFrame(render);
  }

  // 心率自然呼吸跳变（每 4.5 秒微动一下）
  var hrEl = document.getElementById('board-hr-val');
  if (hrEl) {
    setInterval(function() {
      var d = Math.random() > 0.5 ? 1 : -1;
      var current = 88 + (Math.random() > 0.6 ? d : 0);
      hrEl.innerText = current;
    }, 4500);
  }
})();
</script>

