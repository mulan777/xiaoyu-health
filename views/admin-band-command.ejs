<%- include('partials/header', { pageClass: 'admin-page' }) %>
<style>
  .bc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px; margin-top: 16px; }
  .bc-card { background: #fff; border: 1px solid #eef0f6; border-radius: 16px; padding: 18px; }
  .bc-card h3 { font-size: 14.5px; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
  .bc-card h3 .bar { width: 4px; height: 16px; border-radius: 2px; background: linear-gradient(180deg, #6366f1, #4f46e5); display: inline-block; flex: none; }
  .bc-form { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
  .bc-form .fld { flex: 1; min-width: 130px; }
  .bc-form .fld label { font-size: 12px; color: #64748b; display: block; margin-bottom: 6px; font-weight: 600; }
  .bc-form .fld input, .bc-form .fld select, .bc-select {
    width: 100%; border: 1.5px solid #e2e8f0; border-radius: 11px; padding: 10px 12px; font-size: 16px;
    outline: none; background: #fff; min-height: 44px;
  }
  .bc-form .fld input:focus, .bc-form .fld select:focus, .bc-select:focus { border-color: #818cf8; box-shadow: 0 0 0 3px rgba(99,102,241,.13); }
  .bc-form .hint { font-size: 12.5px; color: #7c8ba1; margin-top: 5px; line-height: 1.55; }
  .bc-btn {
    background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; border: none;
    border-radius: 11px; padding: 11px 20px; font-size: 14px; font-weight: 700; cursor: pointer;
    box-shadow: 0 6px 16px -6px rgba(79,70,229,.55); min-height: 44px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .bc-btn:hover { transform: translateY(-1px); }
  .bc-btn:active { transform: scale(.97); }
  .bc-btn.secondary { background: #fff; color: #475569; border: 1.5px solid #e2e8f0; box-shadow: none; font-weight: 600; }
  .bc-toggle { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: #334155; font-weight: 600; }
  .bc-toggle input { width: 18px; height: 18px; accent-color: #4f46e5; }

  /* —— 下发记录：桌面表格 / 手机卡片 —— */
  .bc-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 12px; }
  .bc-table th { text-align: left; color: #64748b; font-weight: 600; font-size: 12px; padding: 8px 10px; border-bottom: 1px solid #eef0f6; white-space: nowrap; }
  .bc-table td { padding: 9px 10px; border-bottom: 1px solid #f6f7fb; color: #334155; }
  .bc-table tr:last-child td { border-bottom: none; }
  .bc-cards { display: none; }
  .bc-cmd-item { border: 1px solid #eef2f7; border-radius: 13px; padding: 0; margin-top: 8px; background: #fbfcfe; overflow: hidden; }
  .bc-cmd-item summary { list-style: none; display: flex; align-items: center; gap: 8px; padding: 11px 13px; cursor: pointer; min-height: 44px; }
  .bc-cmd-item summary::-webkit-details-marker { display: none; }
  .bc-cmd-item summary::after { content: '›'; margin-left: auto; color: #94a3b8; font-size: 16px; transform: rotate(90deg); transition: transform .15s ease; flex: none; }
  .bc-cmd-item[open] summary::after { transform: rotate(-90deg); }
  .bc-cmd-item .child { font-size: 14px; font-weight: 700; color: #1e293b; flex: none; }
  .bc-cmd-item .sum-desc { font-size: 12.5px; color: #64748b; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bc-cmd-item .detail { padding: 2px 13px 11px; border-top: 1px dashed #eef2f7; }
  .bc-cmd-item .meta { font-size: 12px; color: #64748b; margin-top: 8px; line-height: 1.55; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .bc-cmd-item .err { font-size: 12px; color: #dc2626; margin-top: 6px; }
  .bc-cmd-item .mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11.5px; color: #94a3b8; margin-top: 6px; }
  .bc-tag { display: inline-block; padding: 2.5px 10px; border-radius: 99px; font-size: 11.5px; font-weight: 700; white-space: nowrap; }
  .bc-tag.acked { background: #ecfdf5; color: #059669; }
  .bc-tag.sent { background: #eef2ff; color: #4f46e5; }
  .bc-tag.pending { background: #f1f5f9; color: #64748b; }
  .bc-tag.failed, .bc-tag.no_response { background: #fef2f2; color: #dc2626; }
  .bc-tag.manual { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
  .bc-tag.threshold { background: #fff7ed; color: #d97706; }
  .bc-mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11.5px; color: #64748b; }
  .bc-empty { text-align: center; padding: 28px 10px; color: #94a3b8; font-size: 13px; }
  .bc-filter { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0 2px; }
  .bc-pager { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 14px; }
  .bc-pginfo { font-size: 13px; color: #64748b; font-weight: 700; }
  .bc-pill { border: 1.5px solid #e2e8f0; background: #fff; color: #64748b; border-radius: 99px; padding: 6px 16px; font-size: 12.5px; font-weight: 700; cursor: pointer; min-height: 34px; }
  .bc-pill.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
  .bc-toast { position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%); background: rgba(15,23,42,.92); color: #fff; padding: 10px 22px; border-radius: 99px; font-size: 13.5px; display: none; z-index: 50; max-width: 86vw; }
  .bc-toast.err { background: rgba(185,28,28,.94); }

  /* —— 移动端适配 —— */
  @media (max-width: 720px) {
    .bc-grid { grid-template-columns: 1fr; gap: 12px; margin-top: 12px; }
    .admin-container { padding-bottom: 96px !important; }
    .bc-cmd-item .meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .bc-cmd-item { padding: 10px 12px; }
    .bc-cmd-item + .bc-cmd-item { margin-top: 8px; }
    .bc-card { padding: 15px 14px; border-radius: 14px; }
    /* 表单：单列大触控目标 */
    .bc-form { gap: 10px; }
    .bc-form .fld { min-width: 100%; flex: 1 1 100%; }
    /* 手动下发的操作按钮并排占满 */
    .bc-actions { display: flex; gap: 10px; }
    .bc-actions .bc-btn { flex: 1; padding: 11px 8px; white-space: nowrap; }
    /* 记录：表格隐藏，换卡片流 */
    .bc-table { display: none; }
    .bc-cards { display: block; }
  }
  @media (min-width: 721px) {
    .bc-actions { display: flex; gap: 10px; align-items: flex-end; }
  }
</style>

<section class="admin-hero card shell-hero band-hero admin-hero-compact">
  <div>
    <div class="eyebrow">数据管理</div>
    <h1>手环下发管理</h1>
    <p>YT9 手环下行控制：找手环震动、心率检测频次、心率超标自动震动。下发记录全程留痕。</p>
    <div class="hero-date"><%= nowIso %> · 记录与在线手环每 10 秒自动刷新</div>
  </div>
  <div class="admin-hero-actions">
    <div class="status-chip" id="bcOnline">— 只手环在线</div>
    <button class="btn primary" onclick="location.reload()">刷新</button>
  </div>
</section>

<div class="bc-grid">
  <div class="bc-card">
    <h3><span class="bar"></span>全局设置</h3>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div class="bc-form">
        <div class="fld">
          <label>默认震动时长（秒）</label>
          <input type="number" inputmode="numeric" id="vibrateSeconds" min="1" max="60" value="<%= settings.vibrate_seconds %>">
          <div class="hint">1–60 秒，保存后用于手动下发和心率阈值触发</div>
        </div>
        <div class="fld">
          <label>心率检测频次</label>
          <select id="hrInterval">
            <option value="1" <%= settings.hr_interval == 1 ? 'selected' : '' %>>15 分钟一次</option>
            <option value="2" <%= settings.hr_interval == 2 ? 'selected' : '' %>>30 分钟一次</option>
            <option value="3" <%= settings.hr_interval == 3 ? 'selected' : '' %>>60 分钟一次</option>
          </select>
          <div class="hint">手环固件仅支持 15/30/60 分钟档</div>
        </div>
      </div>
      <div class="bc-form">
        <div class="fld">
          <label>心率阈值</label>
          <input type="number" inputmode="numeric" id="hrThreshold" min="80" max="220" value="<%= settings.hr_threshold %>">
          <div class="hint">实时心率 ≥ 此值自动下发震动</div>
        </div>
        <div class="fld">
          <label>阈值震动冷却（秒）</label>
          <input type="number" inputmode="numeric" id="hrCooldown" min="30" max="3600" value="<%= settings.hr_cooldown_seconds %>">
          <div class="hint">同一手环两次自动震动的最短间隔</div>
        </div>
      </div>
      <div style="display: flex; gap: 14px; align-items: center; margin-top: 2px; flex-wrap: wrap;">
        <label class="bc-toggle"><input type="checkbox" id="hrWatch" <%= settings.hr_watch_enabled ? 'checked' : '' %>> 启用心率阈值监听</label>
        <button class="bc-btn" onclick="saveSettings()">保存设置</button>
      </div>
    </div>
  </div>

  <div class="bc-card">
    <h3><span class="bar"></span>手动下发</h3>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div class="fld">
        <label style="font-size: 12px; color: #64748b; display: block; margin-bottom: 6px; font-weight: 600;">选择手环</label>
        <select id="targetBand" class="bc-select"></select>
        <div class="hint" id="bandStat">加载中…</div>
      </div>
      <div class="fld">
        <label style="font-size: 12px; color: #64748b; display: block; margin-bottom: 6px; font-weight: 600;">本次震动时长（秒）</label>
        <input type="number" inputmode="numeric" id="manualSeconds" min="1" max="60" placeholder="默认 = 设置值">
        <div class="hint">填 1–60 秒的整数；留空使用默认时长。此处只影响本次下发。</div>
      </div>
      <div class="bc-actions">
        <button class="bc-btn" id="sendVibrateButton" onclick="sendVibrate()">📳 立即震动</button>
        <button class="bc-btn secondary" onclick="pushHrInterval()">下发心率频次</button>
      </div>
      <div class="hint">「下发心率频次」会把上方选择的频次写入所选孩子的手环（近 2 分钟在线的手环才会列出）</div>
      <div class="hint">手表声音：当前 YT9 协议未提供发声指令，需要厂家确认手表硬件和固件支持。</div>
    </div>
  </div>
</div>

<div class="bc-card" style="margin-top: 16px;" id="teacherLinkPanel">
  <h3><span class="bar"></span>教师手环联动 <span id="teacherBandCount" style="font-size:12px;color:#64748b"></span></h3>
  <p class="hint">已绑定幼儿的手环收到手动或心率阈值震动指令后，通知同班已启用的教师手环；发送班级、孩子姓名及原因，并按下方设置的教师时长震动。教师手环离线或忙碌时最多等待 3 分钟，超时记录为未送达。</p>
  <p class="hint">屏幕文字是否正常显示需真机确认。下方测试只向该教师手环发送“教师联动测试”和所设时长的震动。</p>
  <div class="bc-form" style="margin:12px 0;align-items:flex-end">
    <div class="fld"><label for="teacherVibrateSeconds">教师震动时长（秒）</label><input type="number" inputmode="numeric" id="teacherVibrateSeconds" min="1" max="60" value="15"><div class="hint">1–60 秒，用于教师联动和测试。</div></div>
    <button class="bc-btn" id="saveTeacherDuration">保存教师时长</button>
  </div>
  <div id="teacherBands" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px">正在读取教师手环…</div>
  <details style="margin-top:14px"><summary>最近联动记录</summary><div id="teacherNotifications" style="font-size:12px;margin-top:10px"></div></details>
</div>

<div class="bc-card" style="margin-top: 16px;">
  <h3>
    <span class="bar"></span>
    下发记录 <span style="font-size: 12px; color: #94a3b8; font-weight: 500;" id="cmdCount"></span>
  </h3>
  <div class="bc-filter" id="bcFilter">
    <button class="bc-pill active" data-f="all">全部</button>
    <button class="bc-pill" data-f="acked">已确认</button>
    <button class="bc-pill" data-f="sent">已发送</button>
    <button class="bc-pill" data-f="failed">失败</button>
  </div>
  <table class="bc-table">
    <thead><tr><th>时间</th><th>孩子 / 手环</th><th>命令</th><th>触发</th><th>状态</th></tr></thead>
    <tbody id="cmdBody"></tbody>
  </table>
  <div class="bc-cards" id="cmdCards"></div>
  <div class="bc-empty" id="cmdEmpty" style="display: none;">暂无下发记录</div>
  <div class="bc-pager" id="cmdPager" style="display: none;">
    <button class="bc-pill" id="pgPrev" onclick="pageTurn(-1)">‹ 上一页</button>
    <span class="bc-pginfo" id="pgInfo">1 / 1</span>
    <button class="bc-pill" id="pgNext" onclick="pageTurn(1)">下一页 ›</button>
  </div>
</div>

<div class="bc-toast" id="bcToast"></div>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var API = (window.__bandApiBase || '/admin/bands/command') + '/api';
  var PAGE_SIZE = 10;
  var curFilter = 'all';
  var curPage = 1, totalPages = 1;

  function toast(msg, ok) {
    var t = $('bcToast');
    t.textContent = msg;
    t.className = 'bc-toast' + (ok === false ? ' err' : '');
    t.style.display = 'block';
    clearTimeout(t._h);
    t._h = setTimeout(function () { t.style.display = 'none'; }, 2800);
  }
  function fmtTime(s) { return s ? String(s).replace('T', ' ').slice(0, 16) : '-'; }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function statusTag(s) {
    var m = { acked: '已确认', sent: '已发送', pending: '待发送', failed: '失败', no_response: '无回执' };
    return '<span class="bc-tag ' + esc(s) + '">' + (m[s] || esc(s)) + '</span>';
  }
  function srcTag(s) {
    var m = { manual: '手动', threshold: '阈值触发', teacher_link: '同班教师联动', teacher_test: '教师测试' };
    return '<span class="bc-tag ' + esc(s) + '">' + (m[s] || esc(s)) + '</span>';
  }

  var teacherTests = new Set();
  function loadTeacherBands() {
    fetch(API + '/teacher-bands').then(function(r) { if (!r.ok) throw new Error('读取失败'); return r.json(); }).then(function(r) {
      $('teacherBandCount').textContent = '已配置 ' + r.bands.length + ' 只';
      if (document.activeElement !== $('teacherVibrateSeconds') && r.bands.length) $('teacherVibrateSeconds').value = r.bands[0].vibrate_seconds || 15;
      $('teacherBands').innerHTML = r.bands.map(function(t) {
        return '<div style="border:1px solid #e2e8f0;border-radius:12px;padding:12px;min-width:0"><b>' + esc(t.class_name) + ' · ' + esc(t.label) + '</b><div class="bc-mono" style="margin:6px 0">' + esc(t.band_mac.match(/.{2}/g).join(':').toUpperCase()) + '</div><div style="margin-bottom:8px">' + (t.online ? (t.busy ? '在线 · 正在下发' : '在线') : '离线') + (t.enabled ? ' · 联动已启用' : ' · 联动已停用') + '</div><button class="bc-btn secondary" data-test-teacher="' + esc(t.band_mac) + '" ' + (!t.online || t.busy || !t.enabled || teacherTests.has(t.band_mac) ? 'disabled' : '') + '>测试文字＋震动（' + esc(t.vibrate_seconds || 15) + '秒）</button></div>';
      }).join('') || '暂无教师手环';
      var states = {queued:'等待送达',sending:'正在发送',sent:'震动已下发',failed:'发送失败',expired:'超时未送达'};
      $('teacherNotifications').innerHTML = r.notifications.map(function(n) {
        return '<div style="padding:8px 0;border-bottom:1px solid #e2e8f0">' + esc(fmtTime(n.created_at)) + ' · ' + esc(n.class_name) + ' · ' + esc(n.child_name) + ' → ' + esc(n.teacher_mac) + '<br>' + esc(states[n.status] || n.status) + (n.message_acked ? ' · 文字指令已确认' : '') + (n.error_msg ? ' · ' + esc(n.error_msg) : '') + '</div>';
      }).join('') || '暂无联动记录';
    }).catch(function() { $('teacherBands').textContent = '读取失败，请刷新重试'; });
  }
  $('saveTeacherDuration').addEventListener('click', function() {
    var seconds = Number($('teacherVibrateSeconds').value), button = this;
    if (!Number.isInteger(seconds) || seconds < 1 || seconds > 60) return toast('教师震动时长请填写 1–60 秒的整数',false);
    if (button.disabled) return;
    button.disabled = true;
    fetch(API + '/teacher-bands/duration',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({seconds:seconds})})
      .then(function(r) {return r.json();}).then(function(r) {
        toast(r.ok ? '教师震动时长已设为 ' + r.seconds + ' 秒' : '保存失败：' + (r.error || ''),r.ok);
        if (r.ok) loadTeacherBands();
      }).catch(function() {toast('保存失败：网络异常',false);}).finally(function() {button.disabled=false;});
  });
  $('teacherBands').addEventListener('click', function(e) {
    var button = e.target.closest('[data-test-teacher]');
    if (!button || button.disabled) return;
    var mac = button.dataset.testTeacher;
    if (teacherTests.has(mac)) return;
    teacherTests.add(mac); button.disabled = true;
    toast('正在向该教师手环发送测试…');
    fetch(API + '/teacher-bands/test', {method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({band_mac:mac})})
      .then(function(r) {return r.json();}).then(function(r) {
        toast(r.ok ? (r.messageAcked ? '测试已下发，文字指令已确认，请核对手环屏幕' : '震动已下发，文字未确认，请核对手环屏幕') : '测试失败：' + (r.error || ''),r.ok);
        loadCommands();
      }).catch(function() {toast('测试失败：网络异常',false);})
      .finally(function() {teacherTests.delete(mac); loadTeacherBands();});
  });

  function loadHealth() {
    fetch(API + '/health').then(function (r) { return r.json(); }).then(function (r) {
      if (!r.ok) return;
      $('bcOnline').textContent = r.gwKnown + ' 只手环在线';
    }).catch(function () {});
  }

  function loadSettings() {
    fetch(API + '/settings').then(function (r) { return r.json(); }).then(function (s) {
      $('vibrateSeconds').value = s.vibrate_seconds;
      $('manualSeconds').placeholder = '留空使用默认 ' + s.vibrate_seconds + ' 秒';
      $('hrInterval').value = s.hr_interval;
      $('hrThreshold').value = s.hr_threshold;
      $('hrCooldown').value = s.hr_cooldown_seconds;
      $('hrWatch').checked = !!s.hr_watch_enabled;
    }).catch(function () { toast('加载设置失败', false); });
  }

  window.saveSettings = function () {
    var seconds = Number($('vibrateSeconds').value);
    if (!Number.isInteger(seconds) || seconds < 1 || seconds > 60) return toast('震动时长请填写 1–60 秒的整数', false);
    var body = {
      vibrate_seconds: +$('vibrateSeconds').value,
      hr_interval: +$('hrInterval').value,
      hr_threshold: +$('hrThreshold').value,
      hr_cooldown_seconds: +$('hrCooldown').value,
      hr_watch_enabled: $('hrWatch').checked
    };
    fetch(API + '/settings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json(); })
      .then(function (r) { if (r.ok) { toast('设置已保存'); loadSettings(); } else toast('保存失败：' + (r.error || ''), false); })
      .catch(function () { toast('保存失败：网络异常', false); });
  };

  function loadBands() {
    fetch(API + '/bands').then(function (r) { return r.json(); }).then(function (r) {
      var sel = $('targetBand'), cur = sel.value;
      if (!r.bands || !r.bands.length) {
        sel.innerHTML = '<option value="">（暂无在线手环）</option>';
        $('bandStat').textContent = '网关扫描中，稍候自动刷新';
        return;
      }
      sel.innerHTML = r.bands.map(function (c) {
        var label = c.child_name
          ? c.child_name + (c.class_name ? ' · ' + c.class_name : '')
          : '未绑定 ' + String(c.band_mac).slice(-4);
        return '<option value="' + esc(c.band_mac) + '">' + esc(label) + ' · 心率' + (c.heart_rate ?? '-') + ' · 电量' + (c.battery ?? '-') + '%</option>';
      }).join('');
      if (cur) sel.value = cur;
      $('bandStat').textContent = r.bands.length + ' 块手环在线（近 2 分钟有数据）';
    }).catch(function () {});
  }

  window.sendVibrate = function () {
    var mac = $('targetBand').value;
    if (!mac) return toast('暂无在线手环', false);
    var body = { band_mac: mac };
    if ($('manualSeconds').value) body.seconds = +$('manualSeconds').value;
    if (body.seconds !== undefined && (!Number.isInteger(body.seconds) || body.seconds < 1 || body.seconds > 60)) return toast('本次震动时长请填写 1–60 秒的整数', false);
    var button = $('sendVibrateButton');
    if (button.disabled) return;
    button.disabled = true;
    toast('下发中…');
    fetch(API + '/vibrate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json(); })
      .then(function (r) {
        r.ok ? toast(r.detail || '已下发') : toast('失败：' + (r.error || ''), false);
        loadCommands();
      })
      .catch(function () { toast('下发失败：网络异常', false); })
      .finally(function () { button.disabled = false; });
  };

  window.pushHrInterval = function () {
    var mac = $('targetBand').value;
    if (!mac) return toast('暂无在线手环', false);
    toast('下发中…');
    fetch(API + '/heart-rate/interval', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ band_mac: mac, code: +$('hrInterval').value }) })
      .then(function (r) { return r.json(); })
      .then(function (r) {
        r.ok ? toast(r.acked ? '手环已确认频次设置' : '指令已写入，等待手环回执') : toast('失败：' + (r.error || ''), false);
        loadCommands();
      })
      .catch(function () { toast('下发失败：网络异常', false); });
  };

  function renderRows(rows) {
    var isMobileCard = window.matchMedia('(max-width: 720px)').matches;
    $('cmdBody').innerHTML = rows.map(function (c) {
      var child = c.child_name ? '<b>' + esc(c.child_name) + '</b>' : '<span style="color:#94a3b8">未绑定</span>';
      return '<tr>' +
        '<td style="color:#94a3b8; font-size:12px; white-space:nowrap">' + fmtTime(c.created_at) + '</td>' +
        '<td>' + child + '<div class="bc-mono">' + esc(c.band_mac) + '</div></td>' +
        '<td>' + esc(c.cmd_desc || c.cmd_type) + '</td>' +
        '<td>' + srcTag(c.trigger_source) + '</td>' +
        '<td>' + statusTag(c.status) + (c.error_msg ? '<div style="font-size:11.5px;color:#94a3b8">' + esc(c.error_msg) + '</div>' : '') + '</td>' +
      '</tr>';
    }).join('');
    $('cmdCards').innerHTML = rows.map(function (c) {
      var child = c.child_name ? esc(c.child_name) : '<span style="color:#94a3b8">未绑定</span>';
      return '<details class="bc-cmd-item">' +
        '<summary>' +
          '<span class="child">' + child + '</span>' +
          '<span class="sum-desc">' + esc(c.cmd_desc || c.cmd_type) + '</span>' +
          statusTag(c.status) +
        '</summary>' +
        '<div class="detail">' +
          '<div class="meta"><span>' + fmtTime(c.created_at) + '</span>' + srcTag(c.trigger_source) + '</div>' +
          (c.error_msg ? '<div class="err">' + esc(c.error_msg) + '</div>' : '') +
          '<div class="mono">' + esc(c.band_mac) + (c.ack_raw ? ' · 回执 ' + esc(c.ack_raw) : '') + '</div>' +
        '</div>' +
      '</details>';
    }).join('');
  }

  function loadCommands() {
    var qs = '?page=' + curPage + '&limit=' + PAGE_SIZE;
    if (curFilter !== 'all') qs += '&status=' + curFilter;
    fetch(API + '/commands' + qs).then(function (r) { return r.json(); }).then(function (r) {
      var rows = r.commands || [];
      totalPages = Math.max(1, Math.ceil((r.total || 0) / PAGE_SIZE));
      $('cmdCount').textContent = '共 ' + (r.total || 0) + ' 条';
      $('cmdEmpty').style.display = rows.length ? 'none' : 'block';
      $('cmdPager').style.display = (r.total || 0) > PAGE_SIZE ? 'flex' : 'none';
      $('pgInfo').textContent = curPage + ' / ' + totalPages;
      $('pgPrev').disabled = curPage <= 1;
      $('pgNext').disabled = curPage >= totalPages;
      renderRows(rows);
    }).catch(function (e) { console.error('loadCommands', e); });
  }

  window.pageTurn = function (d) {
    var next = curPage + d;
    if (next < 1 || next > totalPages) return;
    curPage = next;
    loadCommands();
  };

  document.getElementById('bcFilter').addEventListener('click', function (e) {
    var b = e.target.closest('.bc-pill');
    if (!b) return;
    curFilter = b.dataset.f;
    this.querySelectorAll('.bc-pill').forEach(function (x) { x.classList.toggle('active', x === b); });
    curPage = 1;
    loadCommands();
  });

  loadHealth(); loadSettings(); loadBands(); loadCommands(); loadTeacherBands();
  setInterval(loadTeacherBands, 10000);
  setInterval(loadBands, 10000);
  setInterval(loadCommands, 10000);
  setInterval(loadHealth, 30000);
})();
</script>

