    <!-- 底部状态通栏 -->
    <footer class="screen-footer">
      <div class="footer-left">
        <span class="footer-item">最后同步：<b id="footUpdated">--</b></span>
        <span class="footer-item">全园幼儿：<b id="footChildren">-</b></span>
        <span class="footer-item">体测记录：<b id="footFitness">-</b></span>
        <span class="footer-item">手环累计：<b id="footBands">-</b></span>
