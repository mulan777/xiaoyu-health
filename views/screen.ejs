<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>小鱼健康 · 智能健康监测大屏</title>
  <style>
    :root {
      /* 典雅明亮高级科技风配色 */
      --bg-base: #f8fafc;
      --panel-bg: #ffffff;
      --panel-border: #e2e8f0;
      
      --primary: #4f46e5;
      --primary-light: #6366f1;
      --accent-cyan: #0284c7;
      --accent-emerald: #059669;
      --accent-rose: #e11d48;
      --accent-amber: #d97706;
      --accent-purple: #7c3aed;

      --text-main: #0f172a;
      --text-sub: #475569;
      --text-muted: #94a3b8;
      
      --shadow-sm: 0 2px 4px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.02);
      --shadow-md: 0 10px 25px -3px rgba(15, 23, 42, 0.07), 0 4px 10px -2px rgba(15, 23, 42, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.85);
      --shadow-glow: 0 12px 30px -4px rgba(79, 70, 229, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.9);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background-color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", "Microsoft YaHei", Roboto, sans-serif;
      color: var(--text-main);
      user-select: none;
    }

    /* 柔和科技微光背景 */
    body::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(1200px 600px at 50% -10%, rgba(99, 102, 241, 0.10) 0%, transparent 60%),
        radial-gradient(800px 400px at 10% 40%, rgba(14, 165, 233, 0.06) 0%, transparent 50%),
        radial-gradient(800px 400px at 90% 40%, rgba(168, 85, 247, 0.06) 0%, transparent 50%),
        linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
      z-index: -2;
    }
    
    body::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(15, 23, 42, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15, 23, 42, 0.025) 1px, transparent 1px);
      background-size: 30px 30px;
      z-index: -1;
      pointer-events: none;
    }

    .screen-root {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      padding: 12px 18px 8px;
    }

    /* ============ 顶部 Header ============ */
    .screen-header {
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      margin-bottom: 10px;
      padding: 0 16px;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 12px;
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow-md);
      flex: 0 0 60px;
    }
    
    .screen-header::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 10%;
      right: 10%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #38bdf8, #818cf8, transparent);
      opacity: 0.8;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-logo-img {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      object-fit: cover;
      box-shadow: 0 3px 10px rgba(79, 70, 229, 0.2);
      border: 1px solid rgba(226, 232, 240, 0.8);
      background: #fff;
    }
    .brand-meta h1 {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: #0f172a;
      line-height: 1.2;
    }
    .brand-meta .sub-title {
      font-size: 11px;
      color: #6366f1;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    /* 范围切换胶囊 */
    .scope-bar {
      display: flex;
      align-items: center;
      gap: 5px;
      background: #f1f5f9;
      padding: 3px 5px;
      border-radius: 999px;
      border: 1px solid #e2e8f0;
    }
    .scope-chip {
      padding: 4px 13px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-sub);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .scope-chip:hover {
      color: #0f172a;
      background: rgba(255, 255, 255, 0.6);
    }
    .scope-chip.active {
      background: linear-gradient(135deg, #4f46e5, #0ea5e9);
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(79, 70, 229, 0.3);
    }

    /* 顶栏右侧状态与时钟 */
    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .live-indicator {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      color: #059669;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.25);
      padding: 3px 9px;
      border-radius: 999px;
    }
    .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #059669;
      box-shadow: 0 0 5px rgba(5, 150, 105, 0.6);
      animation: liveBlink 1.8s infinite;
    }
    @keyframes liveBlink {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }
    .clock-display {
      text-align: right;
    }
    .clock-display .time {
      font-size: 24px;
      font-weight: 800;
      color: #0f172a;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.5px;
      line-height: 1;
    }
    .clock-display .date {
      font-size: 10.5px;
      color: var(--text-sub);
      margin-top: 2px;
      font-weight: 500;
    }

    /* ============ 主网格主体 ============ */
    .screen-grid {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-columns: 315px 1fr 325px;
      gap: 12px;
    }

    .tech-panel {
      background: linear-gradient(175deg, #ffffff 0%, #fcfdfe 70%, #f8fafc 100%);
      border: 1px solid rgba(226, 232, 240, 0.85);
      border-radius: 14px;
      box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.06), 0 4px 12px -2px rgba(15, 23, 42, 0.03), inset 0 1px 0 0 rgba(255, 255, 255, 0.95), inset 0 -1px 2px rgba(226, 232, 240, 0.4);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    }
    .tech-panel:hover {
      box-shadow: 0 14px 36px -4px rgba(15, 23, 42, 0.09), 0 6px 16px -2px rgba(15, 23, 42, 0.04), inset 0 1px 0 0 #ffffff;
      transform: translateY(-1px);
    }

    .panel-header {
      height: 36px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #f1f5f9;
      background: linear-gradient(90deg, rgba(248, 250, 252, 0.8), transparent);
      flex: 0 0 36px;
    }
    .panel-title {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
      font-weight: 700;
      color: #1e293b;
      letter-spacing: 0.2px;
    }
    .panel-title-bar {
      width: 3.5px;
      height: 12px;
      border-radius: 2px;
      background: linear-gradient(180deg, #4f46e5, #0ea5e9);
      box-shadow: 0 1px 4px rgba(79, 70, 229, 0.25);
    }
    .panel-tag {
      font-size: 11px;
      color: var(--text-sub);
    }
    .panel-tag b {
      color: #4f46e5;
      font-weight: 600;
    }

    .panel-body {
      flex: 1;
      min-height: 0;
      position: relative;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
    }

    .chart-container {
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .col-stack {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 0;
    }

    /* ============ 中间核心：5 个体征卡片（含异常告警卡） ============ */
    .center-top-metrics {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      margin-bottom: 8px;
      flex: 0 0 auto;
    }
    
    .metric-card {
      background: linear-gradient(160deg, #ffffff 0%, #f8fafc 100%);
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 12px;
      padding: 9px 12px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.95), inset 0 0 0 1px rgba(255, 255, 255, 0.5);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .metric-card:hover {
      box-shadow: 0 8px 20px -2px rgba(79, 70, 229, 0.12), inset 0 1px 0 rgba(255, 255, 255, 1);
      transform: translateY(-2px);
      border-color: rgba(99, 102, 241, 0.3);
    }

    .metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }
    .metric-card.hr::before { background: linear-gradient(90deg, #e11d48, #fb7185); }
    .metric-card.sp::before { background: linear-gradient(90deg, #0284c7, #38bdf8); }
    .metric-card.tp::before { background: linear-gradient(90deg, #d97706, #fbbf24); }
    .metric-card.bp::before { background: linear-gradient(90deg, #7c3aed, #a855f7); }
    .metric-card.alert::before { background: linear-gradient(90deg, #dc2626, #f87171); }

    .m-label-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-sub);
    }
    .m-label-row .icon {
      font-size: 12px;
    }
    .m-value-row {
      margin: 2px 0 1px;
      display: flex;
      align-items: baseline;
      gap: 3px;
    }
    .m-value-row .number {
      font-size: 23px;
      font-weight: 800;
      color: #0f172a;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    .metric-card.hr .number { color: #e11d48; }
    .metric-card.sp .number { color: #0284c7; }
    .metric-card.tp .number { color: #d97706; }
    .metric-card.bp .number { color: #7c3aed; font-size: 19px; }
    .metric-card.alert .number { color: #dc2626; }

    .m-value-row .unit {
      font-size: 10.5px;
      color: var(--text-muted);
      font-weight: 600;
    }
    .m-status-row {
      font-size: 10px;
      color: var(--text-muted);
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* 设备药丸条 */
    .band-pills-row {
      display: flex;
      gap: 6px;
      align-items: center;
      margin-bottom: 6px;
      flex-wrap: wrap;
      flex: 0 0 auto;
    }
    .mini-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2.5px 8px;
      border-radius: 6px;
      font-size: 10.5px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      color: var(--text-sub);
      font-weight: 500;
    }
    .mini-pill b {
      color: #0f172a;
      font-size: 11.5px;
      font-weight: 700;
    }
    .mini-pill .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }
    .mini-pill.green .dot { background: #10b981; box-shadow: 0 0 4px rgba(16, 185, 129, 0.5); }
    .mini-pill.cyan .dot { background: #0284c7; box-shadow: 0 0 4px rgba(2, 132, 199, 0.5); }
    .mini-pill.red {
      background: #fff1f2;
      border-color: #fecdd3;
      color: #e11d48;
    }
    .mini-pill.red .dot { background: #e11d48; box-shadow: 0 0 5px rgba(225, 29, 72, 0.5); animation: liveBlink 1.2s infinite; }

    /* 折线趋势大模块 */
    .trend-block {
      flex: 1;
      min-height: 0;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 6px 10px 4px;
      margin-bottom: 8px;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: var(--shadow-sm);
    }
    .trend-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-sub);
      margin-bottom: 2px;
      flex: 0 0 auto;
    }

    /* 异常报警与最近上报 */
    .center-bottom-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      height: 108px;
      flex: 0 0 108px;
    }
    
    .feed-box {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 6px 8px;
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .feed-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-sub);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex: 0 0 auto;
    }
    .feed-list {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .feed-list::-webkit-scrollbar { width: 3px; }
    .feed-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }

    .feed-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 10.5px;
      padding: 2.5px 6px;
      border-radius: 4px;
      background: #f8fafc;
      border: 1px solid #f1f5f9;
    }
    .feed-time { color: var(--text-muted); font-size: 9.5px; }
    .feed-name { color: #334155; font-weight: 600; font-family: ui-monospace, Menlo, monospace; font-size: 10px; }
    .feed-val { font-variant-numeric: tabular-nums; font-weight: 600; }
    .feed-val.hr { color: #e11d48; }
    .feed-val.tp { color: #d97706; }
    .feed-val.sp { color: #0284c7; }

    /* 重点关注右侧列表（完全显示不溢出，带独立滚动条） */
    .attn-container {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-right: 2px;
    }
    .attn-container::-webkit-scrollbar { width: 4px; }
    .attn-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

    .attention-card {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 9px;
      border-radius: 8px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      box-shadow: var(--shadow-sm);
      flex: 0 0 auto;
    }
    .vest-bar {
      width: 4px;
      height: 26px;
      border-radius: 2px;
      flex: 0 0 4px;
    }
    .att-info {
      flex: 1;
      min-width: 0;
    }
    .att-row-1 {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .att-name {
      font-size: 12px;
      font-weight: 700;
      color: #0f172a;
    }
    .att-class {
      font-size: 10.5px;
      color: var(--text-muted);
      font-weight: 500;
    }
    .att-reason {
      font-size: 10px;
      color: var(--text-sub);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: 1px;
    }

    /* ============ 底部状态条 Footer ============ */
    .screen-footer {
      height: 24px;
      margin-top: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: var(--text-sub);
      padding: 0 4px;
      flex: 0 0 24px;
    }
    .footer-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .footer-item b {
      color: #4f46e5;
      font-weight: 700;
      margin-left: 2px;
    }
    .back-btn {
      color: var(--text-sub);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }
    .back-btn:hover {
      color: #4f46e5;
    }
  
    
    
    /* ========== 深色未来科技大屏微光主题 (Cyber Dark Theme) ========== */
    body.theme-dark {
      background-color: #030712 !important;
      color: #f1f5f9 !important;
    }
    body.theme-dark::before {
      background:
        radial-gradient(1000px 500px at 50% -5%, rgba(14, 165, 233, 0.22) 0%, transparent 65%),
        radial-gradient(800px 400px at 15% 35%, rgba(99, 102, 241, 0.18) 0%, transparent 55%),
        radial-gradient(800px 400px at 85% 45%, rgba(16, 185, 129, 0.15) 0%, transparent 55%),
        linear-gradient(180deg, #040918 0%, #020617 100%) !important;
    }
    body.theme-dark::after {
      background-image: 
        linear-gradient(rgba(56, 189, 248, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(56, 189, 248, 0.05) 1px, transparent 1px) !important;
      background-size: 24px 24px !important;
    }
    
    body.theme-dark .screen-header {
      background: rgba(10, 22, 40, 0.85) !important;
      border: 1px solid rgba(56, 189, 248, 0.35) !important;
      box-shadow: 0 0 25px rgba(14, 165, 233, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
    }
    body.theme-dark .brand-meta h1 {
      color: #ffffff !important;
      text-shadow: 0 0 12px rgba(56, 189, 248, 0.6) !important;
    }
    body.theme-dark .brand-meta .sub-title {
      color: #38bdf8 !important;
    }
    body.theme-dark .scope-chip {
      background: rgba(15, 23, 42, 0.8) !important;
      border-color: rgba(56, 189, 248, 0.25) !important;
      color: #94a3b8 !important;
    }
    body.theme-dark .scope-chip.active {
      background: linear-gradient(135deg, #0ea5e9, #6366f1) !important;
      color: #ffffff !important;
      border-color: #38bdf8 !important;
      box-shadow: 0 0 14px rgba(14, 165, 233, 0.5) !important;
    }
    body.theme-dark .clock-display .time {
      color: #38bdf8 !important;
      text-shadow: 0 0 10px rgba(56, 189, 248, 0.7) !important;
    }
    body.theme-dark .clock-display .date {
      color: #64748b !important;
    }

    /* 科技面板强化 */
    body.theme-dark .tech-panel {
      background: rgba(10, 20, 36, 0.82) !important;
      border: 1px solid rgba(56, 189, 248, 0.22) !important;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(14, 165, 233, 0.05) !important;
      backdrop-filter: blur(20px) !important;
    }
    body.theme-dark .panel-header {
      background: linear-gradient(90deg, rgba(14, 165, 233, 0.12), transparent) !important;
      border-bottom: 1px solid rgba(56, 189, 248, 0.2) !important;
    }
    body.theme-dark .panel-title {
      color: #f8fafc !important;
      text-shadow: 0 0 8px rgba(56, 189, 248, 0.4) !important;
    }
    body.theme-dark .panel-title-bar {
      box-shadow: 0 0 10px #38bdf8 !important;
    }
    body.theme-dark .panel-tag {
      background: rgba(15, 23, 42, 0.85) !important;
      border-color: rgba(56, 189, 248, 0.3) !important;
      color: #7dd3fc !important;
    }

    /* 中间 5 大卡片 */
    body.theme-dark .metric-card {
      background: rgba(15, 28, 48, 0.85) !important;
      border: 1px solid rgba(56, 189, 248, 0.22) !important;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4) !important;
    }
    body.theme-dark .metric-card .number {
      color: #ffffff !important;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.3) !important;
    }
    body.theme-dark .metric-card.hr { border-top: 2px solid #f43f5e !important; }
    body.theme-dark .metric-card.sp { border-top: 2px solid #0ea5e9 !important; }
    body.theme-dark .metric-card.tp { border-top: 2px solid #10b981 !important; }
    body.theme-dark .metric-card.bp { border-top: 2px solid #a855f7 !important; }
    body.theme-dark .metric-card.alert-card { border-top: 2px solid #eab308 !important; }

    /* 关键：修复之前 trend-block 为纯白色大坑！彻底深色科技化 */
    body.theme-dark .trend-block {
      background: rgba(8, 16, 30, 0.85) !important;
      border: 1px solid rgba(56, 189, 248, 0.25) !important;
      box-shadow: inset 0 0 24px rgba(14, 165, 233, 0.06) !important;
    }
    body.theme-dark .trend-header {
      border-bottom: 1px solid rgba(56, 189, 248, 0.15) !important;
      color: #94a3b8 !important;
    }

    /* 底部预警与实时流 */
    body.theme-dark .feed-box {
      background: rgba(8, 16, 30, 0.85) !important;
      border: 1px solid rgba(56, 189, 248, 0.2) !important;
    }
    body.theme-dark .feed-title {
