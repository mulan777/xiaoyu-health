    <label><span>走平衡木(秒)</span><input type="number" name="balanceBeamSec" step="0.01" placeholder="如 15" /></label>
    <div style="grid-column: 1 / -1;">
      <button class="btn primary" type="submit" id="fitnessEntrySubmitButton">提交并自动计算得分</button>
      <div class="muted" style="margin-top:8px;">如果同一幼儿在同一天已经录过，本次提交会自动覆盖原记录。</div>
    </div>
  </form>
</section>



<!-- 批量导入/导出 -->
<section class="card">
  <h2>体测数据导入 / 导出</h2>
  <div class="toolbar-links" style="margin-bottom:12px;">
    <a class="btn small" href="/user/fitness/template">下载体测导入模板</a>
    <a class="btn small" href="/user/fitness/export">导出本班体测数据</a>
  </div>
  <form method="post" action="/user/fitness/import" enctype="multipart/form-data" class="form-grid" style="max-width:400px;">
    <input type="file" name="file" accept=".xlsx,.xls,.csv" required />
    <button class="btn primary full" type="submit">上传并导入</button>
  </form>
  <div class="muted" style="margin-top:8px;">模板字段：幼儿姓名、测试日期、身高(CM)、体重(KG)、握力(KG)、立定跳远(CM)、坐位体前屈(CM)、双脚连续跳(秒)、15米绕障碍跑(秒)、走平衡木(秒)</div>
</section>
    <% } %>

</section>
  </div>
</section>

<script>
(function () {
  const SCROLL_KEY = 'kgp-user-scroll-target';
  function bindRadarToggles(root) {
    (root || document).querySelectorAll('[data-radar-root]').forEach(function (card) {
      card.querySelectorAll('[data-radar-toggle]').forEach(function (button) {
        if (button.dataset.radarBound === '1') return;
        button.dataset.radarBound = '1';
        button.addEventListener('click', function () {
          var key = button.getAttribute('data-radar-toggle');
          if (!key) return;
          var isActive = button.classList.toggle('is-active');
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          card.querySelectorAll('[data-radar-series="' + key + '"]').forEach(function (seriesNode) {
            seriesNode.classList.toggle('is-hidden', !isActive);
          });
        });
      });
    });
  }
  function replaceRecordsFromHtml(html) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const incoming = doc.querySelector('[data-ajax-panel="user-records"]');
    const current = document.querySelector('[data-ajax-panel="user-records"]');
    if (incoming && current) current.outerHTML = incoming.outerHTML;
  }
  function scrollToUserRecords(behavior) {
    const target = document.getElementById('user-record-filter-anchor')
      || document.querySelector('#fitness-records .toolbar')
      || document.querySelector('[data-ajax-panel="user-records"] .table-wrap')
      || document.getElementById('fitness-records')
      || document.querySelector('[data-ajax-panel="user-records"]');
    if (!target) return;
    target.scrollIntoView({ behavior: behavior || 'auto', block: 'start' });
  }
  function restoreUserRecordScroll() {
    const params = new URLSearchParams(window.location.search);
    const hasFilterParams = ['keyword', 'rating', 'dateFrom', 'dateTo', 'sortField', 'sortOrder', 'recordPage'].some(function (key) {
      return params.has(key) && String(params.get(key) || '') !== '';
    });
    const shouldScroll = window.location.hash === '#fitness-records'
      || sessionStorage.getItem(SCROLL_KEY) === 'fitness-records'
      || (params.get('view') === 'records' && hasFilterParams);
    if (!shouldScroll) return;
    sessionStorage.removeItem(SCROLL_KEY);
    [0, 120, 320, 700].forEach(function (delay) {
      setTimeout(function () { scrollToUserRecords('auto'); }, delay);
    });
  }
  async function loadUserRecords(url, push, scroll) {
    const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' }, credentials: 'same-origin' });
    if (!res.ok) { if (scroll !== false) sessionStorage.setItem(SCROLL_KEY, 'fitness-records'); window.location.href = url; return; }
    const html = await res.text();
    replaceRecordsFromHtml(html);
    if (push) window.history.pushState({ kind: 'user-records', url: url }, '', url);
    bindUserPagination();
    if (scroll !== false) scrollToUserRecords('smooth');
  }
  function bindUserPagination() {
    document.querySelectorAll('[data-ajax-panel="user-records"] .pagination-link').forEach(function (link) {
      if (link.dataset.ajaxBound === '1') return;
      link.dataset.ajaxBound = '1';
      link.addEventListener('click', function (event) {
        event.preventDefault();
        sessionStorage.setItem(SCROLL_KEY, 'fitness-records');
        loadUserRecords(event.currentTarget.href, true).catch(function () { window.location.href = event.currentTarget.href; });
      });
    });
    document.querySelectorAll('[data-ajax-panel="user-records"] form.user-analysis-batch-form').forEach(function (form) {
      if (form.dataset.ajaxBound === '1') return;
      form.dataset.ajaxBound = '1';
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        const action = form.getAttribute('action') || window.location.pathname;
        const url = new URL(action, window.location.origin);
        const formData = new FormData(form);
        formData.forEach(function (value, key) {
          if (value !== null && String(value) !== '') url.searchParams.set(key, String(value));
        });
        loadUserRecords(url.toString(), true, false).catch(function () { window.location.href = url.toString(); });
      });
    });
    document.querySelectorAll('[data-ajax-panel="user-records"] form.user-record-filter-form').forEach(function (form) {
      if (form.dataset.ajaxBound === '1') return;
      form.dataset.ajaxBound = '1';
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        const action = form.getAttribute('action') || window.location.pathname;
        const url = new URL(action, window.location.origin);
        url.hash = 'fitness-records';
        const formData = new FormData(form);
        formData.forEach(function (value, key) {
          if (value !== null && String(value) !== '') url.searchParams.set(key, String(value));
        });
        sessionStorage.setItem(SCROLL_KEY, 'fitness-records');
        loadUserRecords(url.toString(), true).catch(function () { window.location.href = url.toString(); });
      });
    });
    bindRadarToggles(document.querySelector('[data-ajax-panel="user-records"]'));
  }
  window.addEventListener('popstate', function () {
    if (window.location.search.indexOf('view=records') === -1) return;
    if (!document.querySelector('[data-ajax-panel="user-records"]')) return;
    sessionStorage.setItem(SCROLL_KEY, 'fitness-records');
    loadUserRecords(window.location.href, false).catch(function () { window.location.reload(); });
  });
  window.addEventListener('pageshow', restoreUserRecordScroll);
  window.addEventListener('load', restoreUserRecordScroll);
  restoreUserRecordScroll();
  bindRadarToggles(document);
  bindUserPagination();
})();

(function () {
  var attentionNavLink = document.querySelector('.user-fitness-nav-link[href="/user?view=attention"]');
  if (attentionNavLink) {
    var titleNode = attentionNavLink.querySelector('.user-fitness-nav-title');
    var descNode = attentionNavLink.querySelector('.user-fitness-nav-desc');
    if (titleNode) titleNode.textContent = '本班重点关注';
    if (descNode) descNode.textContent = '维护本班重点关注幼儿，供二次晨检和活动前快速复核';
  }

  var attentionChildSelect = document.getElementById('userAttentionChild');
  var attentionReasonInput = document.getElementById('userAttentionReason');
  var attentionVestInput = document.getElementById('userAttentionVestType');
  var attentionStartInput = document.getElementById('userAttentionStart');
  var attentionEndInput = document.getElementById('userAttentionEnd');
  var attentionTagsInput = document.getElementById('userAttentionTags');
  var attentionDefaultStart = attentionStartInput ? (attentionStartInput.defaultValue || attentionStartInput.value || '') : '';
  var fitnessBatchSelect = document.getElementById('fitnessEntryBatchDate');
  var fitnessBatchForm = document.getElementById('fitnessEntryBatchForm');
  var fitnessEntryForm = document.getElementById('fitnessEntryForm');
  var fitnessEntryDateInput = document.getElementById('fitnessEntryTestDate');
  var fitnessEntryChildSelect = document.getElementById('fitnessEntryChild');
  var fitnessEntryManualChildWrap = document.getElementById('fitnessEntryManualChildWrap');
  var fitnessEntryManualChildInput = document.getElementById('fitnessEntryManualChildName');
  var fitnessEntryManualGenderWrap = document.getElementById('fitnessEntryManualGenderWrap');
  var fitnessEntryManualGenderInput = document.getElementById('fitnessEntryManualChildGender');
  var fitnessEntryManualBirthDateWrap = document.getElementById('fitnessEntryManualBirthDateWrap');
  var fitnessEntryManualBirthDateInput = document.getElementById('fitnessEntryManualChildBirthDate');
  var fitnessEntrySelectionHint = document.getElementById('fitnessEntrySelectionHint');
  var fitnessEntryLiveMessage = document.getElementById('fitnessEntryLiveMessage');
  var fitnessEntrySubmitButton = document.getElementById('fitnessEntrySubmitButton') || (fitnessEntryForm ? fitnessEntryForm.querySelector('button[type="submit"]') : null);
  var fitnessEntryMetricFields = [
    { name: 'heightCm', label: '\u8eab\u9ad8(CM)' },
    { name: 'weightKg', label: '\u4f53\u91cd(KG)' },
    { name: 'gripKg', label: '\u63e1\u529b(KG)' },
    { name: 'longJumpCm', label: '\u7acb\u5b9a\u8df3\u8fdc(CM)' },
    { name: 'sitReachCm', label: '\u5750\u4f4d\u4f53\u524d\u5c48(CM)' },
    { name: 'doubleJumpSec', label: '\u53cc\u811a\u8fde\u7eed\u8df3(\u79d2)' },
    { name: 'obstacleRunSec', label: '15\u7c73\u7ed5\u969c\u788d\u8dd1(\u79d2)' },
    { name: 'balanceBeamSec', label: '\u8d70\u5e73\u8861\u6728(\u79d2)' }
  ];
  var defaultFitnessEntrySubmitText = fitnessEntrySubmitButton ? fitnessEntrySubmitButton.textContent : '提交并自动计算得分';

  function isManualEntryMode() {
    return !!(fitnessEntryChildSelect && fitnessEntryChildSelect.value === '__manual__');
  }

  function toggleManualChildField() {
    var shouldShow = isManualEntryMode();
    if (fitnessEntryManualChildWrap) {
      fitnessEntryManualChildWrap.style.display = shouldShow ? 'block' : 'none';
    }
    if (fitnessEntryManualGenderWrap) {
      fitnessEntryManualGenderWrap.style.display = shouldShow ? 'block' : 'none';
    }
    if (fitnessEntryManualBirthDateWrap) {
      fitnessEntryManualBirthDateWrap.style.display = shouldShow ? 'block' : 'none';
    }
    if (fitnessEntryManualChildInput) {
      fitnessEntryManualChildInput.required = shouldShow;
      if (!shouldShow) fitnessEntryManualChildInput.value = '';
    }
    if (fitnessEntryManualGenderInput) {
      fitnessEntryManualGenderInput.required = shouldShow;
      if (!shouldShow) fitnessEntryManualGenderInput.value = '';
    }
    if (fitnessEntryManualBirthDateInput) {
      fitnessEntryManualBirthDateInput.required = shouldShow;
      if (!shouldShow) fitnessEntryManualBirthDateInput.value = '';
    }
    fitnessEntryMetricFields.forEach(function (field) {
      if (!fitnessEntryForm || !fitnessEntryForm.elements[field.name]) return;
      fitnessEntryForm.elements[field.name].required = true;
    });
  }

  function renderFitnessEntryFeedback(message, type) {
    if (!fitnessEntryLiveMessage) return;
    if (!message) {
      fitnessEntryLiveMessage.style.display = 'none';
      fitnessEntryLiveMessage.textContent = '';
      fitnessEntryLiveMessage.className = 'alert';
      return;
    }
    fitnessEntryLiveMessage.textContent = message;
    fitnessEntryLiveMessage.className = type === 'error' ? 'alert error' : 'alert success';
    fitnessEntryLiveMessage.style.display = 'block';
  }

  function renderFitnessEntrySelectionHint(message) {
    if (!fitnessEntrySelectionHint) return;
    fitnessEntrySelectionHint.textContent = message || '选择已录入幼儿时，会自动回填该批次的体测数值。';
  }

  function setFitnessMetricFieldValue(name, value) {
    if (!fitnessEntryForm || !fitnessEntryForm.elements || !fitnessEntryForm.elements[name]) return;
    fitnessEntryForm.elements[name].value = value == null ? '' : String(value);
  }

  function clearFitnessMetricFields() {
    fitnessEntryMetricFields.forEach(function (field) {
      setFitnessMetricFieldValue(field.name, '');
    });
  }

  function syncFitnessEntrySelection() {
    var selectedOption = fitnessEntryChildSelect && fitnessEntryChildSelect.options
      ? fitnessEntryChildSelect.options[fitnessEntryChildSelect.selectedIndex]
      : null;
    var hasBatch = !!(fitnessBatchSelect && fitnessBatchSelect.value);
    var defaultHint = hasBatch
      ? '当前批次下，选择已录入幼儿会自动回填数值；选择未录入幼儿则直接填写本次数据。'
      : '不使用批次时可直接录入，也可以选择“其他（手填新增）”补录新幼儿。';

    if (!selectedOption || !selectedOption.value) {
      if (fitnessEntrySubmitButton) fitnessEntrySubmitButton.textContent = defaultFitnessEntrySubmitText;
      renderFitnessEntrySelectionHint(defaultHint);
      return;
    }

    if (selectedOption.value === '__manual__') {
      clearFitnessMetricFields();
      if (fitnessEntrySubmitButton) fitnessEntrySubmitButton.textContent = defaultFitnessEntrySubmitText;
      renderFitnessEntrySelectionHint('手填新增幼儿时，请补齐姓名、性别、出生日期和体测数值后再提交。');
      return;
    }

    if (hasBatch && fitnessEntryDateInput) {
      fitnessEntryDateInput.value = selectedOption.dataset.testDate || fitnessBatchSelect.value;
    }

    if (selectedOption.dataset.prefillReady === '1') {
      setFitnessMetricFieldValue('heightCm', selectedOption.dataset.heightCm);
      setFitnessMetricFieldValue('weightKg', selectedOption.dataset.weightKg);
      setFitnessMetricFieldValue('gripKg', selectedOption.dataset.gripKg);
      setFitnessMetricFieldValue('longJumpCm', selectedOption.dataset.longJumpCm);
      setFitnessMetricFieldValue('sitReachCm', selectedOption.dataset.sitReachCm);
      setFitnessMetricFieldValue('doubleJumpSec', selectedOption.dataset.doubleJumpSec);
      setFitnessMetricFieldValue('obstacleRunSec', selectedOption.dataset.obstacleRunSec);
      setFitnessMetricFieldValue('balanceBeamSec', selectedOption.dataset.balanceBeamSec);
      if (fitnessEntrySubmitButton) fitnessEntrySubmitButton.textContent = '提交并覆盖原记录';
      renderFitnessEntrySelectionHint('已自动回填该幼儿在当前批次的历史数值，直接修改后提交即可覆盖原记录。');
      return;
    }

    clearFitnessMetricFields();
    if (fitnessEntrySubmitButton) fitnessEntrySubmitButton.textContent = defaultFitnessEntrySubmitText;
    renderFitnessEntrySelectionHint(hasBatch
      ? '该幼儿在当前批次还未录入，请填写本次体测数据后提交。'
      : defaultHint);
  }

  function clearFitnessEntryValidity() {
    if (fitnessEntryManualChildInput) {
      fitnessEntryManualChildInput.setCustomValidity('');
    }
    if (fitnessEntryManualGenderInput) {
      fitnessEntryManualGenderInput.setCustomValidity('');
    }
    if (fitnessEntryManualBirthDateInput) {
      fitnessEntryManualBirthDateInput.setCustomValidity('');
    }
    fitnessEntryMetricFields.forEach(function (field) {
      if (!fitnessEntryForm || !fitnessEntryForm.elements[field.name]) return;
      fitnessEntryForm.elements[field.name].setCustomValidity('');
    });
  }

  function getManualMissingFitnessLabels() {
    if (!fitnessEntryForm) return [];
    return fitnessEntryMetricFields.filter(function (field) {
      var input = fitnessEntryForm.elements[field.name];
      return !input || String(input.value || '').trim() === '';
    }).map(function (field) {
      return field.label;
    });
  }

  function reportFitnessEntryMissing(message, input) {
    renderFitnessEntryFeedback(message, 'error');
    if (input && typeof input.setCustomValidity === 'function') {
      input.setCustomValidity(message);
      if (typeof input.reportValidity === 'function') {
        input.reportValidity();
      }
      if (typeof input.focus === 'function') {
        input.focus();
      }
      return;
    }
    if (typeof window.alert === 'function') {
      window.alert(message);
    }
  }

  function validateFitnessEntryBeforeSubmit() {
    clearFitnessEntryValidity();
    if (isManualEntryMode()) {
      var manualName = fitnessEntryManualChildInput ? String(fitnessEntryManualChildInput.value || '').trim() : '';
      if (!manualName) {
        reportFitnessEntryMissing('\u8bf7\u5148\u586b\u5199\u201c\u5176\u4ed6\u5e7c\u513f\u201d\u7684\u59d3\u540d', fitnessEntryManualChildInput);
        return false;
      }
      var manualGender = fitnessEntryManualGenderInput ? String(fitnessEntryManualGenderInput.value || '').trim() : '';
      if (!manualGender) {
        reportFitnessEntryMissing('请选择手填新增幼儿的性别', fitnessEntryManualGenderInput);
        return false;
      }
      var manualBirthDate = fitnessEntryManualBirthDateInput ? String(fitnessEntryManualBirthDateInput.value || '').trim() : '';
      if (!manualBirthDate) {
        reportFitnessEntryMissing('请填写手填新增幼儿的出生日期', fitnessEntryManualBirthDateInput);
        return false;
      }
    }

    var missingFields = fitnessEntryMetricFields.filter(function (field) {
      var input = fitnessEntryForm && fitnessEntryForm.elements ? fitnessEntryForm.elements[field.name] : null;
      return !input || String(input.value || '').trim() === '';
    });
    if (!missingFields.length) return true;

    var firstMissing = missingFields[0];
    var firstInput = fitnessEntryForm && fitnessEntryForm.elements ? fitnessEntryForm.elements[firstMissing.name] : null;
    reportFitnessEntryMissing('\u7f3a\u5c11\u586b\u5199' + firstMissing.label, firstInput);
    return false;
  }

  function syncAttentionForm() {
    if (!attentionChildSelect) return;
    var selectedOption = attentionChildSelect.options[attentionChildSelect.selectedIndex];
    if (!selectedOption || !selectedOption.value) {
      if (attentionReasonInput) attentionReasonInput.value = '';
      if (attentionVestInput) attentionVestInput.value = 'yellow';
      if (attentionStartInput) attentionStartInput.value = attentionDefaultStart;
      if (attentionEndInput) attentionEndInput.value = '';
      if (attentionTagsInput) attentionTagsInput.value = '';
      return;
    }
    if (attentionReasonInput) attentionReasonInput.value = selectedOption.dataset.attentionReason || '';
    if (attentionVestInput) {
      attentionVestInput.value = selectedOption.dataset.attentionVestType === 'red'
        ? 'red'
        : (selectedOption.dataset.attentionVestType === 'green' ? 'green' : 'yellow');
    }
    if (attentionStartInput) attentionStartInput.value = selectedOption.dataset.attentionStart || attentionDefaultStart;
    if (attentionEndInput) attentionEndInput.value = selectedOption.dataset.attentionEnd || '';
    if (attentionTagsInput) attentionTagsInput.value = selectedOption.dataset.attentionTags || '';
  }

  if (attentionChildSelect) {
    attentionChildSelect.addEventListener('change', syncAttentionForm);
    syncAttentionForm();
  }

  if (fitnessBatchSelect && fitnessBatchForm) {
    fitnessBatchSelect.addEventListener('change', function () {
      fitnessBatchForm.submit();
    });
  }
  if (fitnessBatchSelect && fitnessEntryDateInput && fitnessBatchSelect.value) {
    fitnessEntryDateInput.value = fitnessBatchSelect.value;
  }
  if (fitnessEntryChildSelect && fitnessBatchSelect && fitnessBatchSelect.value && !fitnessEntryChildSelect.value) {
    var firstMissingOption = fitnessEntryChildSelect.querySelector('option[data-entry-status="missing"]');
    var firstRecordedOption = fitnessEntryChildSelect.querySelector('option[data-entry-status="recorded"]');
    if (firstMissingOption) fitnessEntryChildSelect.value = firstMissingOption.value;
    else if (firstRecordedOption) fitnessEntryChildSelect.value = firstRecordedOption.value;
  }
  if (fitnessEntryChildSelect) {
    fitnessEntryChildSelect.addEventListener('change', function () {
      toggleManualChildField();
      syncFitnessEntrySelection();
      clearFitnessEntryValidity();
    });
  }
  toggleManualChildField();
  syncFitnessEntrySelection();
  clearFitnessEntryValidity();

  if (fitnessEntryManualChildInput) {
    fitnessEntryManualChildInput.addEventListener('input', clearFitnessEntryValidity);
  }
  if (fitnessEntryManualGenderInput) {
    fitnessEntryManualGenderInput.addEventListener('change', clearFitnessEntryValidity);
  }
  if (fitnessEntryManualBirthDateInput) {
    fitnessEntryManualBirthDateInput.addEventListener('input', clearFitnessEntryValidity);
  }
  fitnessEntryMetricFields.forEach(function (field) {
    if (!fitnessEntryForm || !fitnessEntryForm.elements[field.name]) return;
    fitnessEntryForm.elements[field.name].addEventListener('input', clearFitnessEntryValidity);
  });

  if (fitnessEntryForm) {
    fitnessEntryForm.addEventListener('submit', function (event) {
      event.preventDefault();
      renderFitnessEntryFeedback('', 'success');

      if (!validateFitnessEntryBeforeSubmit()) {
        var missingLabels = getManualMissingFitnessLabels();
        if (missingLabels.length) {
          renderFitnessEntryFeedback('\u7f3a\u5c11\u586b\u5199' + missingLabels.join('\u3001'), 'error');
        }
        return;
      }

      if (!fitnessEntryForm.reportValidity()) {
        return;
      }

      var formData = new FormData(fitnessEntryForm);
      var body = new URLSearchParams();
      formData.forEach(function (value, key) {
        body.append(key, value == null ? '' : String(value));
      });

      if (fitnessEntrySubmitButton) {
        fitnessEntrySubmitButton.disabled = true;
      }

      fetch(fitnessEntryForm.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          'Accept': 'application/json',
          'X-Requested-With': 'fetch'
        },
        body: body.toString(),
        credentials: 'same-origin'
      }).then(function (response) {
        var contentType = String(response.headers.get('content-type') || '').toLowerCase();
        if (!contentType.includes('application/json')) {
          window.location.href = response.url || fitnessEntryForm.action;
          return null;
        }
        return response.json().then(function (payload) {
          if (!response.ok || !payload || payload.ok === false) {
            renderFitnessEntryFeedback((payload && payload.message) || '\u63d0\u4ea4\u5931\u8d25\uff0c\u8bf7\u7a0d\u540e\u518d\u8bd5', 'error');
            return null;
          }
          if (payload.changed) {
            window.location.href = payload.redirectUrl || window.location.href;
            return null;
          }
          renderFitnessEntryFeedback(payload.message || '\u6570\u636e\u5df2\u4fdd\u5b58', 'success');
          return null;
        });
      }).catch(function () {
        renderFitnessEntryFeedback('\u7f51\u7edc\u5f02\u5e38\uff0c\u8bf7\u7a0d\u540e\u518d\u8bd5', 'error');
      }).finally(function () {
        if (fitnessEntrySubmitButton) {
          fitnessEntrySubmitButton.disabled = false;
        }
      });
    });
  }
})();

function openUserChildFitnessModal(data) {
  var overlay = document.getElementById('userChildFitnessOverlay');
  var title = document.getElementById('userChildFitnessTitle');
  var meta = document.getElementById('userChildFitnessMeta');
  var scores = document.getElementById('userChildFitnessScores');
  var train = document.getElementById('userChildFitnessTraining');
  var viewBtn = document.getElementById('userChildFitnessViewBtn');
  if (!overlay) return;
  var birthText = data && data.birthDate ? String(data.birthDate).slice(0, 10) : '-';
  title.textContent = (data && data.childName) || '幼儿体测详情';
  meta.innerHTML = '班级：' + ((data && data.className) || '-')
    + '　|　性别：' + ((data && data.gender) || '-')
    + '　|　出生日期：' + birthText
    + '<br>最近体测：' + ((data && data.testDate) || '-')
    + '　|　综合得分：' + ((data && data.totalScore) || '-')
    + '　|　评级：' + ((data && data.rating) || '-');
  scores.innerHTML = [
    '身高：' + ((data && data.heightCm) || '-') + ' cm',
    '体重：' + ((data && data.weightKg) || '-') + ' kg',
    'BMI：' + ((data && data.bmi) || '-'),
    '握力：' + ((data && data.gripKg) || '-') + ' kg（' + ((data && data.gripScore) || '-') + '分）',
    '立定跳远：' + ((data && data.longJumpCm) || '-') + ' cm（' + ((data && data.jumpScore) || '-') + '分）',
    '坐位体前屈：' + ((data && data.sitReachCm) || '-') + ' cm（' + ((data && data.sitScore) || '-') + '分）',
    '双脚连续跳：' + ((data && data.doubleJumpSec) || '-') + ' 秒（' + ((data && data.djumpScore) || '-') + '分）',
    '15米绕障碍跑：' + ((data && data.obstacleRunSec) || '-') + ' 秒（' + ((data && data.obstacleScore) || '-') + '分）',
    '走平衡木：' + ((data && data.balanceBeamSec) || '-') + ' 秒（' + ((data && data.balanceScore) || '-') + '分）'
  ].map(function (line) { return '<div style="margin:6px 0;">' + line + '</div>'; }).join('');
  train.textContent = data && data.needTraining && data.needTraining.length ? '建议重点加强：' + data.needTraining.join('、') : '当前暂无明显薄弱项';
  if (viewBtn) viewBtn.href = '/user?view=records&keyword=' + encodeURIComponent((data && data.childName) || '') + '#fitness-records';
  overlay.style.display = 'flex';
}
function closeUserChildFitnessModal() {
  var overlay = document.getElementById('userChildFitnessOverlay');
  if (overlay) overlay.style.display = 'none';
}
</script>

<div id="userChildFitnessOverlay" class="modal-overlay" style="display:none;" onclick="if(event.target===this) closeUserChildFitnessModal()">
  <div class="modal-box" style="width:min(92vw,680px);max-height:86vh;overflow:auto;">
    <div class="modal-header" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
      <div>
        <h3 id="userChildFitnessTitle" style="margin:0;">幼儿体测详情</h3>
        <div id="userChildFitnessMeta" class="muted" style="margin-top:8px;"></div>
      </div>
      <button class="modal-close" type="button" onclick="closeUserChildFitnessModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="card" style="margin-bottom:12px;">
        <div class="section-head"><h3>最近一次体测</h3></div>
        <div id="userChildFitnessScores"></div>
      </div>
      <div class="card">
        <div class="section-head"><h3>训练建议</h3></div>
        <div id="userChildFitnessTraining" class="muted"></div>
      </div>
      <div class="toolbar-links" style="margin-top:16px;">
        <a id="userChildFitnessViewBtn" class="btn primary" href="/user?view=records#fitness-records">查看记录列表</a>
        <button class="btn" type="button" onclick="closeUserChildFitnessModal()">关闭</button>
      </div>
    </div>
  </div>
</div>



<!-- 幼儿纵向对比面板 -->
<div id="childCompareOverlay" class="compare-panel-overlay" onclick="if(event.target===this) closeChildComparePanel()">
  <div class="compare-panel">
    <div class="compare-panel-header">
      <div>
        <h3 id="compareChildTitle">幼儿纵向对比</h3>
        <div class="meta" id="compareChildMeta"></div>
      </div>
      <button class="compare-panel-close" onclick="closeChildComparePanel()">&times;</button>
    </div>
    <div class="compare-panel-body" id="comparePanelBody">
      <div class="compare-panel-loading" id="compareLoading">加载中...</div>
    </div>
  </div>
</div>



<script>
(function() {
  function svgLine(points, color, width, dash) {
    var d = points.map(function(p, i) { return (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ' ' + p.y.toFixed(1); }).join('');
    return '<polyline points="' + points.map(function(p) { return p.x.toFixed(1) + ',' + p.y.toFixed(1); }).join(' ') + '" fill="none" stroke="' + color + '" stroke-width="' + (width || 2) + '" stroke-linejoin="round"' + (dash ? ' stroke-dasharray="' + dash + '"' : '') + '/>';
  }

  function svgDot(cx, cy, r, color) {
    return '<circle cx="' + cx.toFixed(1) + '" cy="' + cy.toFixed(1) + '" r="' + (r || 3.5) + '" fill="' + color + '"/>';
  }

  function renderGrowthChart(records) {
    var W = 500, H = 280, padL = 50, padR = 30, padT = 20, padB = 35;
    var iW = W - padL - padR, iH = H - padT - padB;

    var heightVals = records.map(function(r) { return r.heightCm; }).filter(function(v) { return v != null; });
    var weightVals = records.map(function(r) { return r.weightKg; }).filter(function(v) { return v != null; });
    var bmiVals = records.map(function(r) { return r.bmi; }).filter(function(v) { return v != null; });

    var hMin = Math.min.apply(null, heightVals.length ? heightVals : [0]) || 0;
    var hMax = Math.max.apply(null, heightVals.length ? heightVals : [0]) || 100;
    var hRange = hMax - hMin || 20;
    hMin -= hRange * 0.15; hMax += hRange * 0.15; hRange = hMax - hMin;

    var allW = weightVals.concat(bmiVals);
    var wMin = Math.min.apply(null, allW.length ? allW : [0]) || 0;
    var wMax = Math.max.apply(null, allW.length ? allW : [0]) || 30;
    var wRange = wMax - wMin || 10;
    wMin -= wRange * 0.15; wMax += wRange * 0.15; wRange = wMax - wMin;

    var parts = [];
    parts.push('<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="生长曲线">');

    for (var i = 0; i <= 4; i++) {
      var gy = padT + iH * i / 4;
      parts.push('<line x1="' + padL + '" y1="' + gy.toFixed(1) + '" x2="' + (padL + iW) + '" y2="' + gy.toFixed(1) + '" stroke="#e2e8f0" stroke-width="1"/>');
    }

    for (var i = 0; i <= 4; i++) {
      var valH = hMax - (hMax - hMin) * i / 4;
      var ly = padT + iH * i / 4;
      parts.push('<text x="' + (padL - 6) + '" y="' + (ly + 4).toFixed(1) + '" fill="#f97316" font-size="10" text-anchor="end">' + valH.toFixed(0) + '</text>');
    }
    for (var i = 0; i <= 4; i++) {
      var valW = wMax - (wMax - wMin) * i / 4;
      var ry = padT + iH * i / 4;
      parts.push('<text x="' + (padL + iW + 6) + '" y="' + (ry + 4).toFixed(1) + '" fill="#8b5cf6" font-size="10" text-anchor="start">' + valW.toFixed(1) + '</text>');
    }

    records.forEach(function(r, idx) {
      var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
      var label = r.testDate ? r.testDate.slice(5) : '';
      parts.push('<text x="' + x + '" y="' + (H - 6) + '" fill="#94a3b8" font-size="10" text-anchor="middle">' + label + '</text>');
    });

    var makeLine = function(records, valueKey, color, width, dash, useWMin) {
      var points = [];
      var rng = useWMin ? wRange : hRange;
      var vmin = useWMin ? wMin : hMin;
      records.forEach(function(r, idx) {
        var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
        var val = r[valueKey];
        if (val != null) points.push({ x: x, y: padT + iH - (val - vmin) / rng * iH });
      });
      if (!points.length) return;
      parts.push(svgLine(points, color, width, dash));
      points.forEach(function(p) { parts.push(svgDot(p.x, p.y, width > 2 ? 4 : 3, color)); });
    };

    makeLine(records, 'heightCm', '#f97316', 2.5, null, false);
    makeLine(records, 'weightKg', '#8b5cf6', 2.5, null, true);
    makeLine(records, 'bmi', '#ec4899', 2, '5,3', true);

    parts.push('</svg>');

    var legend = '<div class="compare-growth-legend">'
      + '<span class="compare-legend-item"><span class="compare-legend-dot" style="background:#f97316;"></span>身高(cm)</span>'
      + '<span class="compare-legend-item"><span class="compare-legend-dot" style="background:#8b5cf6;"></span>体重(kg)</span>'
      + '<span class="compare-legend-item"><span class="compare-legend-dot" style="background:#ec4899;"></span>BMI</span>'
      + '</div>';

    return legend + parts.join('\n');
  }

  function renderFitnessChart(records) {
    var W = 500, H = 280, padL = 45, padR = 20, padT = 20, padB = 35;
    var iW = W - padL - padR, iH = H - padT - padB;

    var metrics = [
      { key: 'gripScore', label: '握力', color: '#ef4444' },
      { key: 'jumpScore', label: '跳远', color: '#f97316' },
      { key: 'sitScore', label: '体前屈', color: '#eab308' },
      { key: 'djumpScore', label: '双脚跳', color: '#22c55e' },
      { key: 'obstacleScore', label: '障碍跑', color: '#06b6d4' },
      { key: 'balanceScore', label: '平衡木', color: '#8b5cf6' }
    ];

    var allVals = [];
    metrics.forEach(function(m) {
      records.forEach(function(r) { if (r[m.key] != null) allVals.push(r[m.key]); });
    });
    var yMin = allVals.length ? Math.min(0, Math.min.apply(null, allVals)) : 0;
    var yMax = allVals.length ? Math.max(100, Math.max.apply(null, allVals)) : 100;
    var yRange = yMax - yMin || 100;

    var parts = [];
    parts.push('<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="体测得分趋势">');

    for (var i = 0; i <= 4; i++) {
      var gy = padT + iH * i / 4;
      parts.push('<line x1="' + padL + '" y1="' + gy.toFixed(1) + '" x2="' + (padL + iW) + '" y2="' + gy.toFixed(1) + '" stroke="#e2e8f0" stroke-width="1"/>');
      var val = yMax - (yMax - yMin) * i / 4;
      parts.push('<text x="' + (padL - 6) + '" y="' + (gy + 4).toFixed(1) + '" fill="#94a3b8" font-size="10" text-anchor="end">' + val.toFixed(0) + '</text>');
    }

    if (yMin <= 60 && yMax >= 60) {
      var ref60y = padT + iH - (60 - yMin) / yRange * iH;
      parts.push('<line x1="' + padL + '" y1="' + ref60y.toFixed(1) + '" x2="' + (padL + iW) + '" y2="' + ref60y.toFixed(1) + '" stroke="#fca5a5" stroke-width="1" stroke-dasharray="4,4"/>');
    }

    records.forEach(function(r, idx) {
      var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
      var label = r.testDate ? r.testDate.slice(5) : '';
      parts.push('<text x="' + x + '" y="' + (H - 6) + '" fill="#94a3b8" font-size="10" text-anchor="middle">' + label + '</text>');
    });

    metrics.forEach(function(m) {
      var points = [];
      records.forEach(function(r, idx) {
        var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
        if (r[m.key] != null) points.push({ x: x, y: padT + iH - (r[m.key] - yMin) / yRange * iH });
      });
      if (points.length >= 1) {
        parts.push(svgLine(points, m.color, 2));
        points.forEach(function(p) { parts.push(svgDot(p.x, p.y, 3, m.color)); });
      }
    });

    parts.push('</svg>');

    var legend = '<div class="compare-fitness-legend">';
    metrics.forEach(function(m) {
      legend += '<span class="compare-legend-item"><span class="compare-legend-dot" style="background:' + m.color + ';"></span>' + m.label + '</span>';
    });
    legend += '</div>';

    return legend + parts.join('\n');
  }

  function renderRatingTimeline(records) {
    var classMap = { '优秀': 'rating-excellent', '良好': 'rating-good', '合格': 'rating-pass', '不合格': 'rating-fail' };
    var parts = ['<span class="timeline-label">历史评级：</span>'];
    records.forEach(function(r, idx) {
      if (idx > 0) parts.push('<span class="compare-rating-arrow">&rarr;</span>');
      var label = (r.testDate || '').slice(0, 10) + ' ' + (r.rating || '-');
      var cls = classMap[r.rating] || '';
      parts.push('<span class="compare-rating-pill ' + cls + '">' + label + '</span>');
    });
    if (records.length === 0) parts.push('<span class="muted">暂无数据</span>');
    return '<div class="compare-rating-timeline">' + parts.join('') + '</div>';
  }

  function renderDataTable(records) {
    var cols = [
      { key: 'testDate', label: '测试日期', fmt: function(v) { return v ? v.slice(0,10) : '-'; } },
      { key: 'heightCm', label: '身高' },
      { key: 'weightKg', label: '体重' },
      { key: 'bmi', label: 'BMI' },
      { key: 'gripScore', label: '握力分' },
      { key: 'jumpScore', label: '跳远分' },
      { key: 'sitScore', label: '体前屈分' },
      { key: 'djumpScore', label: '双脚跳分' },
      { key: 'obstacleScore', label: '障碍跑分' },
      { key: 'balanceScore', label: '平衡木分' },
      { key: 'totalScore', label: '综合得分' },
      { key: 'rating', label: '评级' }
    ];

    var th = cols.map(function(c) { return '<th>' + c.label + '</th>'; }).join('');
    var rows = records.map(function(r) {
      var tds = cols.map(function(c) {
        var val = r[c.key];
        if (c.fmt) val = c.fmt(val);
        return '<td>' + (val != null ? val : '-') + '</td>';
      }).join('');
      return '<tr>' + tds + '</tr>';
    }).join('');

    return '<div class="compare-data-table-wrap"><table class="compare-data-table"><thead><tr>' + th + '</tr></thead><tbody>' + rows + '</tbody></table></div>';
  }

  window.openChildComparePanel = function(el, childId, childName) {
    var overlay = document.getElementById('childCompareOverlay');
    var titleEl = document.getElementById('compareChildTitle');
    var metaEl = document.getElementById('compareChildMeta');
    var body = document.getElementById('comparePanelBody');

    titleEl.textContent = childName + ' · 纵向对比';
    metaEl.textContent = '加载中...';
    body.innerHTML = '<div class="compare-panel-loading">加载中...</div>';
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';

    fetch('/user/fitness/compare/' + childId)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (!data.ok) {
          body.innerHTML = '<div class="compare-panel-loading" style="color:#ef4444;">' + (data.message || '获取数据失败') + '</div>';
          return;
        }
        var child = data.child || {};
        var records = data.records || [];
        metaEl.textContent = (child.gender || '?') + ' · ' + (child.birthDate || '?') + ' 出生 · 共 ' + records.length + ' 次体测';

        if (records.length === 0) {
          body.innerHTML = '<div class="compare-panel-loading">该幼儿暂无体测记录</div>';
          return;
        }

        var growthSection = '<div class="compare-chart-card"><h4>身高 / 体重 / BMI 趋势</h4>' + renderGrowthChart(records) + '</div>';
        var fitnessSection = '<div class="compare-chart-card"><h4>体测得分趋势</h4>' + renderFitnessChart(records) + '</div>';
        var chartsRow = '<div class="compare-charts-row">' + growthSection + fitnessSection + '</div>';
        var ratingSection = renderRatingTimeline(records);
        var tableSection = renderDataTable(records);

        body.innerHTML = chartsRow + ratingSection + '<h4 style="margin:0 0 10px;color:#334155;">历史记录明细</h4>' + tableSection;
      })
      .catch(function(err) {
        body.innerHTML = '<div class="compare-panel-loading" style="color:#ef4444;">加载异常：' + err.message + '</div>';
      });
  };

  window.closeChildComparePanel = function() {
    var overlay = document.getElementById('childCompareOverlay');
    if (overlay) overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  };
})();
</script>

