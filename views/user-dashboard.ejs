<%- include('partials/header') %>


<% const safeAllChildren = typeof allChildren !== 'undefined' ? allChildren : []; %>
<% const safeChildren = typeof children !== 'undefined' ? children : []; %>
<% const childCollection = Array.isArray(safeAllChildren) && safeAllChildren.length ? safeAllChildren : safeChildren; %>
<% const activeAttentionChildren = Array.isArray(childCollection) ? childCollection.filter(function(item) { return item.needs_attention; }) : []; %>
<% const birthdayChildren = typeof todayBirthdayChildren !== 'undefined' && Array.isArray(todayBirthdayChildren) ? todayBirthdayChildren : []; %>
<% const showBirthdayModal = (typeof teacherBirthday !== 'undefined' ? !!teacherBirthday : false) || birthdayChildren.length > 0; %>
<% const teacherDisplayName = currentUser && currentUser.name ? currentUser.name : '老师'; %>
<% const birthdayChildNames = birthdayChildren.map(function(item) { return item.name; }); %>
<% const formatAttentionPeriod = function(startDate, endDate) {
     const start = startDate ? new Date(startDate).toISOString().slice(0,10) : '即日起';
     const end = endDate ? new Date(endDate).toISOString().slice(0,10) : '长期';
     return start + ' ~ ' + end;
   }; %>
<% const parseAttentionTags = function(value) {
     return String(value || '').split(',').map(function(item) { return item.trim(); }).filter(Boolean);
   }; %>
<% const attentionVestKey = function(item) {
     if (!item) return 'yellow';
     if (item.attention_vest_type === 'red') return 'red';
     if (item.attention_vest_type === 'green') return 'green';
     return 'yellow';
   }; %>
<% const attentionVestLabel = function(item) {
     const vest = attentionVestKey(item);
     return vest === 'red' ? '红马甲' : (vest === 'green' ? '绿马甲' : '黄马甲');
   }; %>

<% if (showBirthdayModal) { %>
  <style>
    .birthday-letter-overlay {
      background:
        radial-gradient(circle at top, rgba(238, 210, 175, 0.26), transparent 22%),
        rgba(18, 12, 8, 0.76);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .birthday-letter-modal {
      position: relative;
      width: min(92vw, 860px);
      max-width: 860px;
      border-radius: 34px;
      overflow: hidden;
      border: 1px solid rgba(207, 173, 133, 0.32);
      background: linear-gradient(145deg, #fffaf4 0%, #fffdfa 55%, #fff8f2 100%);
      box-shadow: 0 40px 120px rgba(44, 27, 16, 0.34);
    }
    .birthday-letter-modal::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(135deg, rgba(255,255,255,0.48), transparent 24%),
        linear-gradient(315deg, rgba(216, 177, 133, 0.12), transparent 18%);
    }
    .birthday-letter-close {
      position: absolute;
      top: 18px;
      right: 20px;
      z-index: 5;
      width: 42px;
      height: 42px;
      border-radius: 999px;
      border: 1px solid rgba(214, 182, 147, 0.34);
      background: rgba(255,255,255,0.72);
      color: #9b6a3a;
      box-shadow: 0 10px 26px rgba(73, 44, 24, 0.10);
    }
    .birthday-letter-body {
      position: relative;
      padding: 38px;
      background:
        radial-gradient(circle at 16% 18%, rgba(255, 233, 205, 0.58), transparent 20%),
        radial-gradient(circle at 84% 82%, rgba(255, 241, 222, 0.48), transparent 22%),
        linear-gradient(180deg, #fff8ef 0%, #fffdfa 100%);
    }
    .birthday-letter-topline,
    .birthday-letter-bottomline {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      color: #c58b46;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      font-size: 12px;
    }
    .birthday-letter-topline { margin-bottom: 16px; }
    .birthday-letter-bottomline { margin-top: 18px; }
    .birthday-letter-topline::before,
    .birthday-letter-topline::after,
    .birthday-letter-bottomline::before,
    .birthday-letter-bottomline::after {
      content: '';
      width: 88px;
      height: 1px;
      background: linear-gradient(90deg, transparent, #d4a168, transparent);
    }
    .birthday-letter-seal {
      width: 88px;
      height: 88px;
      margin: 0 auto 18px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 30%, #f7d9ab, #cc8d54 62%, #a96136 100%);
      box-shadow: inset 0 2px 8px rgba(255,255,255,0.42), 0 16px 30px rgba(129, 74, 35, 0.24);
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.94);
      font-size: 26px;
      position: relative;
      z-index: 2;
    }
    .birthday-letter-paper {
      position: relative;
      overflow: hidden;
      border-radius: 30px;
      border: 1px solid rgba(210, 174, 133, 0.28);
      background:
        linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,252,248,0.97)),
        repeating-linear-gradient(180deg, transparent 0 38px, rgba(208, 171, 131, 0.045) 38px 39px);
      padding: 56px 54px 46px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.96), 0 18px 50px rgba(145, 97, 58, 0.12);
    }
    .birthday-letter-paper::before {
      content: '';
      position: absolute;
      inset: 14px;
      border: 1px solid rgba(214, 178, 136, 0.24);
      border-radius: 22px;
      pointer-events: none;
    }
    .birthday-letter-paper::after {
      content: '';
      position: absolute;
      top: 24px;
      left: 50%;
      transform: translateX(-50%);
      width: 220px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(206, 160, 109, 0.95), transparent);
      pointer-events: none;
    }
    .birthday-letter-corner {
      position: absolute;
      width: 72px;
      height: 72px;
      border-color: rgba(211, 172, 128, 0.52);
      z-index: 1;
      pointer-events: none;
    }
    .birthday-letter-corner.lt { top: 18px; left: 18px; border-top: 2px solid; border-left: 2px solid; border-top-left-radius: 20px; }
    .birthday-letter-corner.rt { top: 18px; right: 18px; border-top: 2px solid; border-right: 2px solid; border-top-right-radius: 20px; }
    .birthday-letter-corner.lb { bottom: 18px; left: 18px; border-bottom: 2px solid; border-left: 2px solid; border-bottom-left-radius: 20px; }
    .birthday-letter-corner.rb { bottom: 18px; right: 18px; border-bottom: 2px solid; border-right: 2px solid; border-bottom-right-radius: 20px; }
    .birthday-letter-head {
      text-align: center;
      margin-bottom: 20px;
      font-size: 12px;
      color: #ca8a44;
      letter-spacing: 0.42em;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
    }
    .birthday-letter-paper h2 {
      position: relative;
      z-index: 1;
      margin: 0 0 26px;
      text-align: center;
      color: #7a3b17;
      font-size: 38px;
      line-height: 1.42;
      font-weight: 700;
    }
    .birthday-letter-paper p {
      position: relative;
      z-index: 1;
      margin: 0 0 18px;
      color: #5c3822;
      font-size: 19px;
      line-height: 2.08;
      text-indent: 2em;
    }
    .birthday-letter-main {
      color: #6c2f10;
      font-size: 21px;
    }
    .birthday-letter-paper strong {
      color: #9c3412;
      font-weight: 700;
    }
    .birthday-letter-actions {
      display: flex;
      justify-content: center;
      margin-top: 26px;
    }
    .birthday-letter-actions .btn {
      min-width: 220px;
      height: 48px;
      border-radius: 999px;
      border: 1px solid rgba(184, 119, 74, 0.20);
      background: linear-gradient(135deg, #d7a062 0%, #bb7047 100%);
      color: #fff;
      font-weight: 700;
      box-shadow: 0 16px 34px rgba(130, 72, 35, 0.18);
    }
    @media (max-width: 640px) {
      .birthday-letter-body { padding: 18px; }
      .birthday-letter-paper { padding: 46px 24px 34px; border-radius: 22px; }
      .birthday-letter-paper h2 { font-size: 28px; }
      .birthday-letter-paper p { font-size: 16px; line-height: 1.95; }
      .birthday-letter-topline::before,
      .birthday-letter-topline::after,
      .birthday-letter-bottomline::before,
      .birthday-letter-bottomline::after { width: 44px; }
      .birthday-letter-seal { width: 72px; height: 72px; font-size: 22px; }
      .birthday-letter-actions .btn { min-width: 180px; }
    }
  </style>
  <div class="modal-overlay birthday-letter-overlay" id="birthdayLetterOverlay">
    <div class="modal-box birthday-letter-modal" role="dialog" aria-modal="true" aria-labelledby="birthdayLetterTitle">
      <button class="modal-close birthday-letter-close" type="button" aria-label="关闭" data-birthday-close>×</button>
      <div class="modal-body birthday-letter-body">
        <div class="birthday-letter-seal">✦</div>
        <div class="birthday-letter-paper">
          <span class="birthday-letter-corner lt"></span>
          <span class="birthday-letter-corner rt"></span>
          <span class="birthday-letter-corner lb"></span>
          <span class="birthday-letter-corner rb"></span>

          <% if (teacherBirthday) { %>
            <p class="birthday-letter-main">生日快乐！愿你眉目舒展，心有欢喜，所行皆坦途，所念皆如愿；愿往后的每一天，都被温柔与美好轻轻环绕。</p>
          <% } %>

          <% if (birthdayChildNames.length) { %>
            <p>今天，本班的小寿星是：<strong><%= birthdayChildNames.join('、') %></strong>。</p>
            <p>愿这一份甜甜的生日喜悦，在教室里慢慢铺开，化作孩子们眼中的光亮与笑容，也化作属于今天的温柔仪式感。</p>
          <% } %>

          <% if (!teacherBirthday && birthdayChildNames.length) { %>
            <p class="birthday-letter-main">愿你带着这份温柔的祝福，陪孩子们度过一个闪闪发光的生日时刻。</p>
          <% } %>
        </div>
        <div class="birthday-letter-bottomline">愿美好如约而至</div>
        <div class="birthday-letter-actions">
          <button class="btn primary" type="button" data-birthday-close>收下这份祝福</button>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var overlay = document.getElementById('birthdayLetterOverlay');
      if (!overlay) return;
      function closeModal() {
        overlay.style.display = 'none';
      }
      overlay.querySelectorAll('[data-birthday-close]').forEach(function (btn) {
        btn.addEventListener('click', closeModal);
      });
      overlay.addEventListener('click', function (event) {
        if (event.target === overlay) closeModal();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeModal();
      });
    })();
  </script>
<% } %>

<section class="user-fitness-layout">
  <aside class="card user-fitness-sidebar">
    <div class="sidebar-brand"><div class="sidebar-title">教师体测导航</div></div>
    <nav class="user-fitness-nav">
      <a class="user-fitness-nav-link <%= userView === 'records' ? 'active' : '' %>" href="/user?view=records">
        <span class="user-fitness-nav-title">本班体测记录</span>
        <span class="user-fitness-nav-desc">查看分页后的体测结果与分析</span>
      </a>
      <a class="user-fitness-nav-link <%= userView === 'entry' ? 'active' : '' %>" href="/user?view=entry">
        <span class="user-fitness-nav-title">体测数据录入</span>
        <span class="user-fitness-nav-desc">仅用于新增、导入、导出体测数据</span>
      </a>
      <a class="user-fitness-nav-link <%= userView === 'attention' ? 'active' : '' %>" href="/user?view=attention">
        <span class="user-fitness-nav-title">二次晨检维护</span>
        <span class="user-fitness-nav-desc">维护本班重点关注幼儿，活动前快速复核</span>
      </a>
      <a class="user-fitness-nav-link" href="/user/venues">
        <span class="user-fitness-nav-title">场地预约</span>
        <span class="user-fitness-nav-desc">进入场地预约与使用管理</span>
      </a>
    </nav>
  </aside>
  <div class="user-fitness-main">
    <section class="dashboard-head card">
      <div>
        <div class="eyebrow">教师工作台</div>
        <h1>你好，<%= currentUser.name %></h1>
        <p>教师端工作台，支持查看本班体测记录、录入体测数据与场地预约。</p>
      </div>
      <div style="display:flex;gap:8px;">
        <a class="btn primary" href="/user/venues">场地预约 →</a>
        <a class="btn secondary" href="/logout">退出登录</a>
      </div>
