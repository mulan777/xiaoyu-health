    <% if (message) { %>
      <div class="alert success"><%= message %></div>
    <% } %>
    <% if (editError) { %>
      <div class="alert error"><%= editError %></div>
    <% } %>
    <% if (userView === 'attention') { %>

<section class="card venue-attention-manage-card" id="attention-manage">
  <div class="section-head">
    <div>
      <div class="eyebrow">本班重点关注</div>
      <h2>本班重点关注</h2>
      <div class="muted">
        仅可维护
        <strong><%= assignedClass && assignedClass.name ? assignedClass.name : '当前班级' %></strong>
        的幼儿。保存后会同步用于二次晨检和活动前复核。
      </div>
    </div>
    <span class="status-badge <%= activeAttentionChildren.length ? 'warn' : 'ok' %>">
      <%= activeAttentionChildren.length ? (activeAttentionChildren.length + ' 名需关注') : '当前无重点关注' %>
    </span>
  </div>

  <% if (childCollection.length) { %>
    <div class="venue-attention-manage-grid">
      <form method="post" action="/user/attention/save" class="venue-attention-form" id="userAttentionForm">
        <label>
          <span>选择幼儿</span>
          <select name="childId" id="userAttentionChild" required>
            <option value="">请选择本班幼儿</option>
            <% childCollection.forEach(function(child) {
              const childStart = child.attention_start_date ? new Date(child.attention_start_date).toISOString().slice(0, 10) : '';
              const childEnd = child.attention_end_date ? new Date(child.attention_end_date).toISOString().slice(0, 10) : '';
              const childTagsText = parseAttentionTags(child.attention_tags).join(',');
            %>
              <option
                value="<%= child.id %>"
                data-attention-reason="<%= child.attention_reason || '' %>"
                data-attention-start="<%= childStart %>"
                data-attention-end="<%= childEnd %>"
                data-attention-tags="<%= childTagsText %>"
                data-attention-vest-type="<%= attentionVestKey(child) %>"
              >
                <%= child.name %><%= child.gender ? ' / ' + child.gender : '' %>
              </option>
            <% }) %>
          </select>
        </label>

        <label>
          <span>关注原因</span>
          <input type="text" name="attentionReason" id="userAttentionReason" placeholder="例如：咳嗽，减少跑跳" />
        </label>

        <div class="venue-attention-form-row">
          <label>
            <span>马甲类型</span>
            <select name="attentionVestType" id="userAttentionVestType">
              <option value="yellow">黄马甲</option>
              <option value="green">绿马甲</option>
              <option value="red">红马甲</option>
            </select>
          </label>
          <label>
            <span>开始日期</span>
            <input type="date" name="attentionStartDate" id="userAttentionStart" value="<%= todayText || '' %>" />
          </label>
          <label>
            <span>结束日期</span>
            <input type="date" name="attentionEndDate" id="userAttentionEnd" />
          </label>
        </div>

        <label>
          <span>关注标签</span>
          <input type="text" name="attentionTagsExtra" id="userAttentionTags" placeholder="例如：咳嗽,恢复期,扭伤，多项用逗号分隔" />
        </label>

        <div class="venue-attention-form-actions">
          <button class="btn primary" type="submit">保存重点关注</button>
          <span class="muted">再次保存会直接覆盖该幼儿当前的重点关注信息。</span>
        </div>
      </form>

      <div class="venue-attention-current">
        <div class="venue-attention-current-head">
          <strong>当前本班已关注</strong>
          <span class="muted"><%= activeAttentionChildren.length %> 名</span>
        </div>
        <% if (activeAttentionChildren.length) { %>
          <div class="venue-attention-current-list">
            <% activeAttentionChildren.forEach(function(child) { %>
              <div class="venue-attention-current-item">
                <div class="venue-attention-current-meta">
                  <div>
                    <strong><%= child.name %></strong>
                    <div class="muted"><%= formatAttentionPeriod(child.attention_start_date, child.attention_end_date) %></div>
                  </div>
                  <span class="vest-badge <%= attentionVestKey(child) %>"><%= attentionVestLabel(child) %></span>
                  <form method="post" action="/user/attention/clear" class="inline-form">
                    <input type="hidden" name="childId" value="<%= child.id %>" />
                    <button class="btn small" type="submit">取消关注</button>
                  </form>
                </div>
                <div class="venue-scene-text"><%= child.attention_reason || '已标记为重点关注，请在活动前再次确认。' %></div>
                <% const attentionTags = parseAttentionTags(child.attention_tags); %>
                <% if (attentionTags.length) { %>
                  <div class="tag-list compact-tag-list">
                    <% attentionTags.forEach(function(tag) { %><span class="tag-pill"><%= tag %></span><% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="venue-resource-empty venue-attention-current-empty">当前本班还没有设置重点关注幼儿。</div>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state">当前账号还没有绑定幼儿数据，暂时无法维护本班重点关注。</div>
  <% } %>
</section>

    <% } else if (userView === 'records') { %>
<!-- 本班体测数据 -->
<section class="card" id="fitness-records" data-ajax-panel="user-records">
  <h2>本班体测记录</h2>
  <% const uf = userFitnessFilters || {}; %>
  <% const dateOptions = Array.isArray(fitnessRecordDates) ? fitnessRecordDates : []; %>
  <% const selectedAnalysisBatchDate = uf.batchDate || ((dateOptions[1] && dateOptions[1].testDate) || ''); %>
  <% const selectedDetailBatchDate = uf.detailBatchDate || ((dateOptions[0] && dateOptions[0].testDate) || ''); %>
  <% const userSortOptions = [
    ['test_date', '测试日期'],
    ['child_name', '幼儿姓名'],
    ['height_score', '身高分'],
    ['bmi_score', 'BMI分'],
    ['grip_score', '握力分'],
    ['jump_score', '跳远分'],
    ['sit_score', '体前屈分'],
    ['djump_score', '双脚跳分'],
    ['obstacle_score', '障碍跑分'],
    ['balance_score', '平衡木分'],
    ['total_score', '综合得分']
  ]; %>
  <% if (!fitnessRecords || !fitnessRecords.length) { %>
    <div class="empty-state">暂无体测记录。请通过上方表单录入或下载模板后批量导入。</div>
  <% } else { %>
    <% if (avgScore) { %>
      <div class="toolbar" style="margin-bottom:12px;align-items:center;gap:10px;">
        <div><strong>本班最新体测分析平均综合得分：<%= avgScore %></strong></div>
        <form method="get" action="/user" class="toolbar-links user-analysis-batch-form" style="margin:0;display:flex;gap:8px;align-items:center;">
          <input type="hidden" name="view" value="records" />
          <input type="hidden" name="detailBatchDate" value="<%= selectedDetailBatchDate || '' %>" />
          <select name="batchDate" style="max-width:180px;">
            <option value="">对比批次</option>
            <% dateOptions.forEach(function(item) { %>
              <option value="<%= item.testDate %>" <%= selectedAnalysisBatchDate === item.testDate ? 'selected' : '' %>><%= item.testDate %></option>
            <% }) %>
          </select>
          <button class="btn small" type="submit">筛选批次</button>
        </form>
      </div>
    <% } %>

    <div class="stats-grid overview-stats" style="margin-bottom:16px;">
      <% (ratingSummary || []).forEach(function(item) { %>
        <div class="card stat-card">
          <div class="stat-label"><%= item.label %></div>
          <div class="stat-number" style="color:<%= item.label === '优秀' ? '#34c759' : item.label === '良好' ? '#0071e3' : item.label === '合格' ? '#ff9f0a' : '#ff3b30' %>;"><%= item.count %></div>
          <div class="muted">占比 <%= item.percent %>%</div>
        </div>
      <% }) %>
    </div>

    <div class="card chart-card" style="margin-bottom:16px;">
      <h3 style="margin-top:0;">班级体能结构雷达图</h3>
      <div class="visual-grid">
        <div class="radar-card" data-radar-root>
          <%
            const radarData = radarChartData || {
              metrics: (metricHealthSummary || []).map(function(item) {
                return { key: item.key, label: item.label };
              }),
              series: [{
                key: 'current',
                label: '当前范围',
                color: '#0f172a',
                fillColor: 'rgba(15, 23, 42, 0.12)',
                dasharray: 'none',
                strokeWidth: 3,
                visible: true,
                values: (metricHealthSummary || []).map(function(item) { return Number(item.score || 0); })
              }]
            };
            const radarMetrics = radarData.metrics || [];
            const radarSeries = radarData.series || [];
            const radarCx = 160;
            const radarCy = 160;
            const radarRadius = 110;
            function buildRadarPolygon(values) {
              return radarMetrics.map(function(metric, index) {
                const angle = (-Math.PI / 2) + (Math.PI * 2 * index / Math.max(1, radarMetrics.length));
                const score = Math.max(0, Math.min(100, Number((values && values[index]) || 0)));
                const length = radarRadius * score / 100;
                const x = radarCx + Math.cos(angle) * length;
                const y = radarCy + Math.sin(angle) * length;
                return x.toFixed(1) + ',' + y.toFixed(1);
              }).join(' ');
            }
          %>
          <div class="radar-card-head">
            <div class="radar-toggle-list">
              <% radarSeries.forEach(function(series) { %>
                <button
                  type="button"
                  class="radar-toggle <%= series.visible === false ? '' : 'is-active' %>"
                  data-radar-toggle="<%= series.key %>"
                  aria-pressed="<%= series.visible === false ? 'false' : 'true' %>"
                  style="--radar-toggle-color:<%= series.color %>;"
                >
                  <span class="radar-toggle-swatch" style="background:<%= series.color %>;"></span>
                  <span><%= series.label %></span>
                </button>
              <% }) %>
            </div>
          </div>
          <svg class="radar-svg" viewBox="0 0 320 320" role="img" aria-label="班级体能结构雷达图">
            <% for (let ring = 1; ring <= 4; ring++) { %>
              <polygon class="radar-ring" points="<%= buildRadarPolygon(radarMetrics.map(function() { return ring * 25; })) %>"></polygon>
            <% } %>
            <% radarMetrics.forEach(function(item, i) {
              const angle = (-Math.PI / 2) + (Math.PI * 2 * i / Math.max(1, radarMetrics.length));
              const axisX = radarCx + Math.cos(angle) * radarRadius;
              const axisY = radarCy + Math.sin(angle) * radarRadius;
              const lx = radarCx + Math.cos(angle) * (radarRadius + 20);
              const ly = radarCy + Math.sin(angle) * (radarRadius + 20);
            %>
              <line class="radar-axis" x1="<%= radarCx %>" y1="<%= radarCy %>" x2="<%= axisX.toFixed(1) %>" y2="<%= axisY.toFixed(1) %>"></line>
              <text class="radar-label" x="<%= lx.toFixed(1) %>" y="<%= ly.toFixed(1) %>"><%= item.label %></text>
            <% }) %>
            <% radarSeries.forEach(function(series) { %>
              <g class="radar-series <%= series.key === 'current' ? 'radar-series-current' : 'radar-series-reference' %><%= series.visible === false ? ' is-hidden' : '' %>" data-radar-series="<%= series.key %>">
                <polygon
                  class="radar-series-shape"
                  points="<%= buildRadarPolygon(series.values || []) %>"
                  style="fill:<%= series.fillColor || 'transparent' %>;stroke:<%= series.color %>;stroke-width:<%= series.strokeWidth || 2 %>;stroke-dasharray:<%= series.dasharray && series.dasharray !== 'none' ? series.dasharray : 'none' %>;"
                ></polygon>
                <% if (series.key === 'current') { %>
                  <% radarMetrics.forEach(function(item, i) {
                    const angle = (-Math.PI / 2) + (Math.PI * 2 * i / Math.max(1, radarMetrics.length));
                    const score = Math.max(0, Math.min(100, Number(((series.values || [])[i]) || 0)));
                    const length = radarRadius * score / 100;
                    const x = radarCx + Math.cos(angle) * length;
                    const y = radarCy + Math.sin(angle) * length;
                  %>
                    <circle class="radar-series-dot" cx="<%= x.toFixed(1) %>" cy="<%= y.toFixed(1) %>" r="4" style="fill:<%= series.color %>;"></circle>
                  <% }) %>
                <% } %>
              </g>
            <% }) %>
          </svg>
        </div>
        <div class="trend-card">
          <h4>班级训练建议</h4>
          <div class="narrative-list">
            <% (metricNeedTrainingSummary || []).forEach(function(item) { %>
              <details class="narrative-item fitness-detail-card">
                <summary>
                  <strong><%= item.label %></strong>
