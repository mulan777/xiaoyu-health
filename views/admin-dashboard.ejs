<%- include('partials/header', { pageClass: 'admin-page' + (isReadonly ? ' readonly-mode' : '') }) %>

<section class="admin-hero card shell-hero <%= activePanel !== 'overview' ? 'admin-hero-compact' : '' %>">
  <div>
    <div class="eyebrow"><%= currentUser.roleDisplayName || "管理后台" %></div>
    <h1>你好，<%= currentUser.name %></h1>
    <p>统一管理幼儿、体测与场地预约。左侧模块切换，顶部导航直达核心功能。</p>
  </div>
  <div class="admin-hero-actions">
    <div class="status-chip"><%= isReadonly ? "只读模式" : "系统运行正常" %></div>
    <a class="btn secondary" href="/logout">退出登录</a>
  </div>
</section>

<% if (message) { %>
  <div class="alert success"><%= message %></div>
<% } %>
<% if (isReadonly) { %>
  <div class="alert" style="background:#fff3cd;color:#856404;border:1px solid #ffc107;">只读模式：当前角色为只读参观账号，无法进行任何修改操作。</div>
<% } %>

<% const pageQuery = (typeof query !== 'undefined' && query) ? query : {}; %>
<% function buildQuery(pairs) { return pairs.filter(function(pair) { return pair[1] !== undefined && pair[1] !== null && String(pair[1]) !== ''; }).map(function(pair) { return encodeURIComponent(pair[0]) + '=' + encodeURIComponent(String(pair[1])); }).join('&'); } %>
<% var childKeywordRaw = String(pageQuery.childKeyword || '').trim(); %>
<% var childKeyword = childKeywordRaw.toLowerCase(); %>
<% var childClassFilter = String(pageQuery.childClassId || ''); %>
<% var childPaginationData = (typeof childPagination !== 'undefined' && childPagination) ? childPagination : { currentPage: 1, totalPages: 1, total: 0, startIndex: 0, endIndex: 0, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1, pageSize: 10 }; %>
<% var childPageSize = childPaginationData.pageSize || 10; %>
<% var childPageQueryBase = 'panel=children' + (childKeywordRaw ? '&childKeyword=' + encodeURIComponent(childKeywordRaw) : '') + (childClassFilter ? '&childClassId=' + encodeURIComponent(childClassFilter) : '') + '&pageSize=' + encodeURIComponent(String(childPageSize)); %>
<% var selectedAttentionTags = []; %>

<div class="admin-layout shell-layout">
  <aside class="admin-sidebar card shell-sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-title">后台导航</div>
      <div class="sidebar-subtitle-mobile">点击分组可折叠展开</div>
    </div>

    <div class="sidebar-menu shell-menu nav-group-menu">
      <% 
        // 1. 📊 态势与感知
        const monitorItems = [
          {perm:'ops.overview', panel:'overview', label:'工作台概览', icon:'📊'},
          {perm:'data.fitness', href:'/screen', target:'_blank', label:'全园感知大屏 ↗', icon:'🖥️', badge:'新窗口'},
          {perm:'data.bands', href:'/admin/bands', label:'手环健康监测', icon:'⌚'}
        ].filter(i => hasPerm(i.perm));

        // 2. 🏃 体测与关怀
        const careItems = [
          {perm:'data.fitness', href:'/admin/fitness', label:'体测数据管理', icon:'🏃'},
          {perm:'booking.attention', panel:'attention', label:'重点关注管理', icon:'❤️'}
        ].filter(i => hasPerm(i.perm));

        // 3. 🏫 基础与教务
        const eduItems = [
          {perm:'data.classes', panel:'classes', label:'班级管理', icon:'🏫'},
          {perm:'data.children', panel:'children', label:'幼儿档案管理', icon:'👶'},
          {perm:'booking.venues', href:'/admin/venues', label:'场地预约管理', icon:'📅'}
        ].filter(i => hasPerm(i.perm));

        // 4. ⚙ 系统与权限
        const systemItems = [
          {perm:'data.users', panel:'users', label:'用户管理', icon:'👤'},
          ...(hasPerm('admin.roles') ? [{perm:'admin.roles', panel:'roles', label:'角色权限管理', icon:'🛡️'}] : []),
          {perm:'ops.site', panel:'ai', label:'AI 智能接入', icon:'🤖'},
          {perm:'ops.site', panel:'site', label:'站点配置', icon:'⚙️'},
          {perm:'ops.logs', panel:'logs', label:'系统日志', icon:'📜'}
        ].filter(i => hasPerm(i.perm));
      %>

      <% if (monitorItems.length) { %>
      <div class="nav-group nav-group-card <%= activeGroup === 'monitor' ? 'active is-expanded' : '' %>" data-group="monitor">
        <button type="button" class="main-nav-header <%= activeGroup === 'monitor' ? 'active' : '' %>" onclick="toggleNavGroup(this)">
          <span class="main-nav-title">态势与感知</span>
          <span class="nav-group-count"><%= monitorItems.length %></span>
          <span class="nav-chevron"></span>
        </button>
        <div class="nav-submenu">
          <% monitorItems.forEach(i => { %>
            <% if (i.href) { %>
              <a class="sidebar-link sub-nav-link nav-link-card <%= i.badge ? 'nav-link-badge-wrap' : '' %>" href="<%= i.href %>" <%= i.target ? 'target="' + i.target + '"' : '' %>>
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } else { %>
              <a class="sidebar-link sub-nav-link <%= activePanel === i.panel ? 'active' : '' %>" href="/admin?panel=<%= i.panel %>">
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } %>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (careItems.length) { %>
      <div class="nav-group nav-group-card <%= activeGroup === 'care' ? 'active is-expanded' : '' %>" data-group="care">
        <button type="button" class="main-nav-header <%= activeGroup === 'care' ? 'active' : '' %>" onclick="toggleNavGroup(this)">
          <span class="main-nav-title">体测与关怀</span>
          <span class="nav-group-count"><%= careItems.length %></span>
          <span class="nav-chevron"></span>
        </button>
        <div class="nav-submenu">
          <% careItems.forEach(i => { %>
            <% if (i.href) { %>
              <a class="sidebar-link sub-nav-link nav-link-card" href="<%= i.href %>">
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } else { %>
              <a class="sidebar-link sub-nav-link <%= activePanel === i.panel ? 'active' : '' %>" href="/admin?panel=<%= i.panel %>">
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } %>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (eduItems.length) { %>
      <div class="nav-group nav-group-card <%= activeGroup === 'edu' ? 'active is-expanded' : '' %>" data-group="edu">
        <button type="button" class="main-nav-header <%= activeGroup === 'edu' ? 'active' : '' %>" onclick="toggleNavGroup(this)">
          <span class="main-nav-title">基础与教务</span>
          <span class="nav-group-count"><%= eduItems.length %></span>
          <span class="nav-chevron"></span>
        </button>
        <div class="nav-submenu">
          <% eduItems.forEach(i => { %>
            <% if (i.href) { %>
              <a class="sidebar-link sub-nav-link nav-link-card" href="<%= i.href %>">
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } else { %>
              <a class="sidebar-link sub-nav-link <%= activePanel === i.panel ? 'active' : '' %>" href="/admin?panel=<%= i.panel %>">
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } %>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (systemItems.length) { %>
      <div class="nav-group nav-group-card <%= activeGroup === 'system' ? 'active is-expanded' : '' %>" data-group="system">
        <button type="button" class="main-nav-header <%= activeGroup === 'system' ? 'active' : '' %>" onclick="toggleNavGroup(this)">
          <span class="main-nav-title">系统与权限</span>
          <span class="nav-group-count"><%= systemItems.length %></span>
          <span class="nav-chevron"></span>
        </button>
        <div class="nav-submenu">
          <% systemItems.forEach(i => { %>
            <% if (i.href) { %>
              <a class="sidebar-link sub-nav-link nav-link-card" href="<%= i.href %>">
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } else { %>
              <a class="sidebar-link sub-nav-link <%= activePanel === i.panel ? 'active' : '' %>" href="/admin?panel=<%= i.panel %>">
                <span class="sub-nav-dot"></span>
                <span><%= i.label %></span>
              </a>
            <% } %>
          <% }); %>
        </div>
      </div>
      <% } %>
    </div>
  </aside>

  <div class="admin-main shell-main">
<% if (activePanel === 'overview') { %>
    <section id="overview-panel" class="admin-panel is-active">
      <div class="panel-heading">
        <div>
          <div class="eyebrow">概览</div>
          <h2>工作台概览</h2>
          <p>系统当前运行状态与核心数据。</p>
        </div>
      </div>

      <section class="stats-grid overview-stats admin-data-stats">
        <div class="card stat-card"><div class="stat-label">用户总数</div><div class="stat-number"><%= counts.total_users %></div><div class="muted">启用中 <%= counts.enabled_users %></div></div>
        <div class="card stat-card"><div class="stat-label">班级总数</div><div class="stat-number"><%= counts.total_classes %></div><div class="muted">启用中 <%= counts.enabled_classes %></div></div>
        <div class="card stat-card"><div class="stat-label">幼儿档案</div><div class="stat-number"><%= counts.total_children %></div><div class="muted">启用中 <%= counts.enabled_children %></div></div>
        <div class="card stat-card"><div class="stat-label">重点关注幼儿</div><div class="stat-number"><%= counts.attention_children || 0 %></div><div class="muted">管理员发布提醒对象</div></div>
      </section>

      <section class="card admin-analytics-card">
        <div class="admin-analytics-copy">
          <div class="eyebrow">趋势分析已同步</div>
          <h3>Admin 现在可以从全园视角查看生长趋势、体测趋势和幼儿纵向对比。</h3>
          <p>体测管理页已支持全园 / 年级 / 班级 / 个人维度，点击幼儿姓名可打开身高、体重、BMI 与体测得分趋势面板。</p>
          <div class="admin-analytics-actions">
            <a class="btn primary" href="/admin/fitness">进入体测趋势看板</a>
            <a class="btn secondary" href="/admin/fitness?view=all">查看全园对比</a>
          </div>
        </div>
        <div class="admin-analytics-visual" aria-label="Admin 趋势能力预览">
          <svg viewBox="0 0 520 250" role="img" aria-label="Admin 生长和体测趋势示意图">
            <g class="admin-analytics-grid"><line x1="30" y1="42" x2="492" y2="42"/><line x1="30" y1="90" x2="492" y2="90"/><line x1="30" y1="138" x2="492" y2="138"/><line x1="30" y1="186" x2="492" y2="186"/></g>
            <path class="admin-analytics-line blue" d="M34 178 C84 142 120 154 168 116 C224 72 268 96 316 62 C374 22 424 44 490 28"/>
            <path class="admin-analytics-line orange" d="M34 194 C96 164 132 172 188 132 C248 88 292 128 348 92 C408 54 444 78 490 56"/>
            <path class="admin-analytics-line purple" d="M34 150 C96 126 124 138 176 104 C234 68 284 74 334 86 C396 100 436 64 490 72"/>
            <g class="admin-analytics-bars"><rect x="70" y="126" width="18" height="72"/><rect x="128" y="98" width="18" height="100"/><rect x="186" y="116" width="18" height="82"/><rect x="244" y="76" width="18" height="122"/><rect x="302" y="88" width="18" height="110"/><rect x="360" y="54" width="18" height="144"/></g>
          </svg>
          <div class="admin-analytics-legend"><span><i class="blue"></i>综合得分</span><span><i class="orange"></i>生长趋势</span><span><i class="purple"></i>项目对比</span></div>
        </div>
      </section>

      <div class="panel-grid overview-grid">
        <div class="card">
          <h3>当前可做的管理操作</h3>
          <div class="feature-list compact-list">
            <div class="feature-item"><h3>站点管理</h3><p>维护站点名称、副标题、首页主标题和移动端提示。</p></div>
            <div class="feature-item"><h3>用户 / 班级</h3><p>支持教师账号、班级信息、多教师绑定与批量处理。</p></div>
            <div class="feature-item"><h3>幼儿档案</h3><p>支持性别、出生日期、重点关注对象与原因。</p></div>
            <div class="feature-item"><h3>体测 + 场地预约</h3><p>体测数据全流程 + 小班独立 / 中大班共享的预约场地体系。</p></div>
          </div>
        </div>

        <div class="card">
          <h3>使用提醒</h3>
          <div class="tips compact">
            <div>1. 左侧先按三类管理切换，展开后再进入对应子功能。</div>
            <div>2. 重点关注幼儿由管理员统一维护，教师端只读提醒。</div>
            <div>3. 场地预约开放时间统一配置，教师端自动倒计时。</div>
            <div>4. 小班独立显示玩法；中班和大班共用同一显示与玩法入口。</div>
          </div>
        </div>
      </div>
    </section>
<% } else if (activePanel === 'site') { %>
    <section id="site-panel" class="admin-panel is-active">
      <div class="panel-heading"><div><div class="eyebrow">站点管理</div><h2>站点名称与首页内容</h2><p>维护站点基础信息与首页展示内容。</p></div></div>
      <div class="panel-grid">
        <div class="card">
          <h3>站点设置</h3>
          <form method="post" action="/admin/settings" class="form-grid">
            <label><span>站点名称</span><input type="text" name="siteName" value="<%= settings.siteName || '' %>" /></label>
            <label><span>副标题</span><input type="text" name="subtitle" value="<%= settings.subtitle || '' %>" /></label>
            <label><span>首页主标题</span><input type="text" name="heroTitle" value="<%= settings.heroTitle || '' %>" /></label>
            <label><span>首页说明</span><textarea name="heroDesc" rows="3"><%= settings.heroDesc || '' %></textarea></label>
            <label><span>移动端提示</span><textarea name="mobileHint" rows="2"><%= settings.mobileHint || '' %></textarea></label>
            <label><span>后台公告</span><textarea name="adminNotice" rows="2"><%= settings.adminNotice || '' %></textarea></label>
            <label class="setting-check-row">
              <input type="checkbox" name="venueRecommendationEnabled" value="1" <%= String(settings.venueRecommendationEnabled || '1') === '1' ? 'checked' : '' %> />
              <span>开启教师端场地智能推荐</span>
              <small>关闭后，教师预约页不再显示最优/次优区域推荐。</small>
            </label>
            <button class="btn primary full" type="submit">保存站点设置</button>
          </form>
        </div>

        <div class="card">
          <h3>首页内容维护</h3>
          <form method="post" action="/admin/content" class="form-grid">
            <% for (let i = 0; i < 8; i++) { %>
              <label><span>亮点标题 <%= i + 1 %></span><input type="text" name="featureTitle<%= i + 1 %>" value="<%= content.features[i] ? content.features[i].title : '' %>" /></label>
              <label><span>亮点描述 <%= i + 1 %></span><textarea name="featureDesc<%= i + 1 %>" rows="2"><%= content.features[i] ? content.features[i].desc : '' %></textarea></label>
            <% } %>
            <% for (let i = 0; i < 6; i++) { %>
              <label><span>快捷入口名称 <%= i + 1 %></span><input type="text" name="quickLinkName<%= i + 1 %>" value="<%= content.quickLinks[i] ? content.quickLinks[i].name : '' %>" /></label>
              <label><span>快捷入口路径 <%= i + 1 %></span><input type="text" name="quickLinkPath<%= i + 1 %>" value="<%= content.quickLinks[i] ? content.quickLinks[i].path : '' %>" /></label>
            <% } %>
            <button class="btn primary full" type="submit">保存首页内容</button>
          </form>
        </div>
      </div>
    </section>
<% } else if (activePanel === 'ai') { %>
    <section id="ai-panel" class="admin-panel is-active">
      <div class="panel-heading">
        <div>
          <div class="eyebrow">AI 接入</div>
          <h2>大模型服务配置</h2>
          <p>支持 OpenAI 兼容协议的国产大模型（DeepSeek、通义、智谱、Kimi、豆包等），随时可替换 URL、密钥与模型。密钥仅服务端保存，页面仅显示掩码。</p>
        </div>
      </div>
      <% const ai = aiSettings || {}; %>
      <div class="panel-grid">
        <div class="card">
          <h3>接入设置</h3>
          <form method="post" action="/admin/ai/settings" class="form-grid" id="ai-settings-form">
            <label class="setting-check-row">
              <input type="checkbox" name="aiEnabled" value="1" <%= String(ai.aiEnabled || '0') === '1' ? 'checked' : '' %> />
              <span>启用 AI 智能分析</span>
              <small>关闭后，“AI 生成报告”按钮会提示未启用。</small>
            </label>
            <label><span>供应商名称</span><input type="text" name="aiProviderName" value="<%= ai.aiProviderName || '' %>" placeholder="如 DeepSeek / 通义 / 智谱 / Kimi" /></label>
            <label><span>接口 Base URL</span><input type="text" name="aiBaseUrl" value="<%= ai.aiBaseUrl || '' %>" placeholder="https://api.deepseek.com/v1" /><small class="muted">填到 /v1 即可，系统会自动拼接 /chat/completions。</small></label>
            <label>
              <span>API Key</span>
              <input type="password" name="aiApiKey" value="<%= ai.aiApiKeyMasked || '' %>" autocomplete="new-password" placeholder="<%= ai.aiApiKeyPresent ? '如不修改请保留掩码' : '请填入以 sk- 开头的密钥' %>" />
              <small class="muted">密钥不会在页面上明文返回。如需清空请勾选下方“清空密钥”。</small>
            </label>
            <label class="setting-check-row">
              <input type="checkbox" name="clearApiKey" value="1" />
              <span>清空当前密钥</span>
            </label>
            <label><span>模型名称</span><input type="text" name="aiModel" value="<%= ai.aiModel || '' %>" placeholder="如 deepseek-reasoner / deepseek-chat / qwen-plus" /><small class="muted">带思维链推荐：deepseek-reasoner；快速输出选 deepseek-chat。</small></label>
            <label><span>最大输出 Token</span><input type="number" name="aiMaxTokens" value="<%= ai.aiMaxTokens || '0' %>" min="0" max="32000" /><small class="muted">填 0 表示不限制（交给模型默认上限），适合思维链型模型。</small></label>
            <label><span>温度 Temperature</span><input type="number" name="aiTemperature" value="<%= ai.aiTemperature || '0.6' %>" step="0.1" min="0" max="2" /><small class="muted">deepseek-reasoner 不支持温度参数，但填了不会报错。</small></label>
            <label><span>超时（毫秒）</span><input type="number" name="aiTimeoutMs" value="<%= ai.aiTimeoutMs || '600000' %>" min="5000" max="1800000" /><small class="muted">现为“空闲超时”，收到任何数据即重置。思维链型建议 600000（10分钟）以上。</small></label>
            <label><span>系统提示词</span><textarea name="aiSystemPrompt" rows="3"><%= ai.aiSystemPrompt || '' %></textarea><small class="muted">作为 system role 传给模型。</small></label>
            <div class="action-row" style="display:flex;gap:8px;flex-wrap:wrap;">
              <button class="btn primary" type="submit">保存 AI 接入设置</button>
              <button class="btn" type="button" id="ai-test-btn">测试连通性</button>
            </div>
            <div id="ai-test-result" class="muted" style="min-height:1.4em;"></div>
          </form>
        </div>
        <div class="card">
          <h3>使用说明</h3>
          <ul style="line-height:1.8;">
            <li>平台使用 <strong>OpenAI 兼容 Chat Completions</strong> 协议。只要另一个供应商提供该协议的对话接口，换上 Base URL、Key、模型名即可。</li>
            <li>常见参考：<br/>
              · DeepSeek：<code>https://api.deepseek.com/v1</code> · 模型 <code>deepseek-chat</code><br/>
              · 通义千问：<code>https://dashscope.aliyuncs.com/compatible-mode/v1</code> · 模型 <code>qwen-plus</code><br/>
              · 智谱 GLM：<code>https://open.bigmodel.cn/api/paas/v4</code> · 模型 <code>glm-4-air</code><br/>
              · Moonshot Kimi：<code>https://api.moonshot.cn/v1</code> · 模型 <code>moonshot-v1-8k</code></li>
            <li>修改后点击“测试连通性”，可验证接口是否可调用。</li>
            <li>在「体测数据管理」页面，顶部「AI 智能分析」按钮会调用该模型生成报告。</li>
          </ul>
          <% if (ai.aiApiKeyPresent) { %>
            <p class="muted">当前密钥：<code><%= ai.aiApiKeyMasked %></code></p>
          <% } else { %>
            <p class="alert warn" style="padding:8px 12px;border-radius:8px;">尚未配置密钥，所以 AI 智能分析不会生效。</p>
          <% } %>
        </div>
      </div>
      <script>
        (function() {
          var btn = document.getElementById('ai-test-btn');
          var resultBox = document.getElementById('ai-test-result');
          if (!btn || !resultBox) return;
          btn.addEventListener('click', function() {
            resultBox.textContent = '正在请求 AI 接口……';
            fetch('/admin/ai/test', { credentials: 'same-origin', headers: { 'X-Requested-With': 'fetch' } })
              .then(function(r) { return r.json(); })
              .then(function(d) {
                if (d && d.ok) {
                  resultBox.textContent = '✅ 连通成功，模型：' + (d.model || '') + '，响应示例：' + (d.sample || '');
                } else {
                  resultBox.textContent = '❌ ' + ((d && d.message) || '调用失败');
                }
              })
              .catch(function(err) { resultBox.textContent = '❌ ' + (err && err.message || err); });
          });
        })();
      </script>
    </section>
<% } else if (activePanel === 'users') { %>
    <section id="user-panel" class="admin-panel is-active" data-ajax-panel="users">
      <% const userKeywordRaw = String(pageQuery.userKeyword || '').trim(); %>
      <% const userKeyword = userKeywordRaw.toLowerCase(); %>
      <% const userClassFilter = String(pageQuery.userClassId || ''); %>
      <% const filteredUsers = users.filter(function(user) {
           const haystack = [user.name, user.username, user.class_name, user.role === 'admin' ? '管理员' : '教师'].join(' ').toLowerCase();
           const matchKeyword = !userKeyword || haystack.includes(userKeyword);
           const matchClass = !userClassFilter || String(user.class_id || '') === userClassFilter;
           return matchKeyword && matchClass;
         }); %>
      <% const userPaginationData = userPagination || { currentPage: 1, totalPages: 1, total: filteredUsers.length, startIndex: filteredUsers.length ? 1 : 0, endIndex: filteredUsers.length, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1 }; %>
      <% const userPageSize = userPaginationData.pageSize || 10; %>
      <% const pagedUsers = filteredUsers.slice((userPaginationData.currentPage - 1) * userPageSize, userPaginationData.currentPage * userPageSize); %>
      <% const userPageQueryBase = 'panel=users' + (userKeywordRaw ? '&userKeyword=' + encodeURIComponent(userKeywordRaw) : '') + (userClassFilter ? '&userClassId=' + encodeURIComponent(userClassFilter) : '') + '&pageSize=' + encodeURIComponent(String(userPageSize)); %>
      <div class="panel-heading"><div><div class="eyebrow">用户管理</div><h2>教师与管理员账号管理</h2><p>支持单个新增、模板下载、Excel 导入导出和批量操作。</p></div></div>
      <div class="management-layout">
        <div class="management-side">
          <% if (typeof hasPerm === 'function' && hasPerm('data.users.create') && !isReadonly) { %>
          <div class="card">
            <div class="section-head"><h3>新增用户</h3></div>
            <form method="post" action="/admin/users/add" class="form-grid">
              <input type="hidden" name="userKeyword" value="<%= userKeywordRaw %>" />
              <input type="hidden" name="userClassId" value="<%= userClassFilter %>" />
              <label><span>姓名</span><input type="text" name="name" placeholder="例如：王老师" required /></label>
              <label><span>用户名</span><input type="text" name="username" placeholder="例如：wanglaoshi" required /></label>
              <label><span>密码</span><input type="text" name="password" placeholder="请设置初始密码" required /></label>
              <label><span>角色</span><select name="role"><% (roles || []).forEach(r => { %><option value="<%= r.name %>" <%= r.name === 'user' ? 'selected' : '' %>><%= r.display_name %></option><% }); %></select></label>
              <label><span>生日</span><input type="date" name="birthDate" /></label>
              <label><span>绑定班级（教师可选）</span><select name="classId"><option value="">暂不绑定</option><% classes.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %>（<%= gradeLabel(item.grade_level) %>）</option><% }) %></select></label>
              <button class="btn primary full" type="submit">新增用户</button>
            </form>
          </div>
          <% } %>
          <div class="card">
            <div class="section-head"><h3>导入 / 导出</h3></div>
            <div class="toolbar-links stacked-links"><% if (typeof hasPerm === 'function' && hasPerm('data.users.import') && !isReadonly) { %><a class="btn small" href="/admin/users/template">下载导入模板</a><% } %><% if (typeof hasPerm === 'function' && hasPerm('data.users.export') && !isReadonly) { %><a class="btn small" href="/admin/users/export?<%= buildQuery([['userKeyword', userKeywordRaw], ['userClassId', userClassFilter]]) %>">导出用户</a><% } %></div>
            <% if (typeof hasPerm === 'function' && hasPerm('data.users.import') && !isReadonly) { %>
            <div class="import-box no-top-margin">
              <h3>批量导入用户</h3>
              <form method="post" action="/admin/users/import" enctype="multipart/form-data" class="form-grid"><input type="file" name="file" accept=".xlsx,.xls,.csv" required /><button class="btn primary full" type="submit">上传并导入</button></form>
              <div class="muted">模板字段：姓名、用户名、密码、角色、班级、生日。生日兼容 2021-10-17 / 2021/10/17。导入时若班级不存在，会自动新增。</div>
            </div>
            <% } %>
          </div>
        </div>
        <div class="management-main">
          <div class="card full-height-card">
            <div class="section-head"><h3>用户列表</h3><div class="muted no-margin">支持按姓名/用户名搜索、编辑资料与重置密码</div></div>
            <form method="get" action="/admin" class="filter-toolbar">
              <input type="hidden" name="panel" value="users" />
              <div class="filter-row filter-row-wide">
                <input type="search" name="userKeyword" value="<%= userKeywordRaw %>" placeholder="搜索姓名 / 用户名 / 班级" />
                <select name="pageSize">
                  <option value="10" <%= userPageSize === 10 ? 'selected' : '' %>>每页 10 条</option>
                  <option value="20" <%= userPageSize === 20 ? 'selected' : '' %>>每页 20 条</option>
                  <option value="50" <%= userPageSize === 50 ? 'selected' : '' %>>每页 50 条</option>
                </select>
                <select name="userClassId">
                  <option value="">全部班级</option>
                  <% classes.forEach(function(item) { %>
                    <option value="<%= item.id %>" <%= userClassFilter === String(item.id) ? 'selected' : '' %>><%= item.name %>（<%= gradeLabel(item.grade_level) %>）</option>
                  <% }) %>
                </select>
                <button class="btn" type="submit">筛选</button>
                <a class="btn" href="/admin?panel=users">重置</a>
              </div>
            </form>
            <div class="muted" style="margin:10px 0 14px;">当前筛选结果：<strong><%= userPaginationData.total %></strong> 人，当前显示第 <strong><%= userPaginationData.startIndex || 0 %></strong> - <strong><%= userPaginationData.endIndex || 0 %></strong> 条</div>
            <form method="post" action="/admin/users/batch" class="batch-toolbar" id="users-batch-form">
              <input type="hidden" name="userKeyword" value="<%= userKeywordRaw %>" />
              <input type="hidden" name="userClassId" value="<%= userClassFilter %>" />
              <input type="hidden" name="userPage" value="<%= userPaginationData.currentPage %>" />
              <input type="hidden" name="pageSize" value="<%= userPageSize %>" />
              <% if (typeof hasPerm === 'function' && (hasPerm('data.users.edit') || hasPerm('data.users.delete')) && !isReadonly) { %>
              <div class="batch-row">
                <select name="batchAction" required><option value="enable">批量启用</option><option value="disable">批量禁用</option><option value="delete">批量删除</option><option value="setClass">批量设置班级</option><option value="clearClass">批量清空班级</option></select>
                <select name="batchClassId"><option value="">选择目标班级（仅设置班级时使用）</option><% classes.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select>
                <button class="btn primary" type="submit">执行批量操作</button>
              </div>
              <% } %>
            </form>
            <div class="table-wrap">
                <table class="data-table admin-table">
                  <thead><tr><th class="checkbox-cell">选择</th><th>姓名</th><th>用户名</th><th>角色</th><th>生日</th><th>班级</th><th>状态</th><th>操作</th></tr></thead>
                  <tbody>
                    <% pagedUsers.forEach(function(user) { %>
                      <tr>
                        <td class="checkbox-cell"><input type="checkbox" name="selectedIds" value="<%= user.id %>" form="users-batch-form" /></td>
                        <td><strong><%= user.name %></strong></td>
                        <td><%= user.username %></td>
                        <td><%= user.role_display_name || (user.role === 'admin' ? '管理员' : '教师') %></td>
                        <td><%= user.birth_date ? formatDateOnly(user.birth_date) : '-' %></td>
                        <td><%= user.class_name || '-' %></td>
                        <td><span class="status-badge <%= user.enabled ? 'ok' : 'off' %>"><%= user.enabled ? '启用中' : '已禁用' %></span></td>
                        <td>
                          <div class="action-col compact-actions">
                            <% if (typeof hasPerm === 'function' && hasPerm('data.users.edit') && !isReadonly) { %>
                            <details class="inline-editor-card">
                              <summary class="btn small primary">编辑</summary>
                              <form method="post" action="/admin/users/<%= user.id %>/edit" class="form-grid compact-inline-form inline-edit-panel">
                                <input type="hidden" name="userKeyword" value="<%= userKeywordRaw %>" />
                                <input type="hidden" name="userClassId" value="<%= userClassFilter %>" />
                                <input type="hidden" name="userPage" value="<%= userPaginationData.currentPage %>" />
                                <input type="hidden" name="pageSize" value="<%= userPageSize %>" />
                                <label><span>姓名</span><input type="text" name="name" value="<%= user.name || '' %>" required /></label>
                                <label><span>账号</span><input type="text" name="username" value="<%= user.username || '' %>" required /></label>
                                <label><span>角色</span><select name="role"><% (roles || []).forEach(r => { %><option value="<%= r.name %>" <%= user.role === r.name ? 'selected' : '' %>><%= r.display_name %></option><% }); %></select></label>
                                <label><span>生日</span><input type="date" name="birthDate" value="<%= user.birth_date ? formatDateOnly(user.birth_date) : '' %>" /></label>
                                <label><span>绑定班级</span><select name="classId"><option value="">暂不绑定</option><% classes.forEach(function(item) { %><option value="<%= item.id %>" <%= String(user.class_id || '') === String(item.id) ? 'selected' : '' %>><%= item.name %>（<%= gradeLabel(item.grade_level) %>）</option><% }) %></select></label>
                                <label><span>重置密码（可选）</span><input type="text" name="password" placeholder="留空则不修改" /></label>
                                <div class="tool-row"><button class="btn small primary" type="submit">保存编辑</button></div>
                              </form>
                            </details>
                            <% } %>
                            <% if (typeof hasPerm === 'function' && hasPerm('data.users.edit') && !isReadonly) { %>
                            <form method="post" action="/admin/users/<%= user.id %>/toggle" class="inline-form">
                              <input type="hidden" name="userKeyword" value="<%= userKeywordRaw %>" />
                              <input type="hidden" name="userClassId" value="<%= userClassFilter %>" />
                              <input type="hidden" name="userPage" value="<%= userPaginationData.currentPage %>" />
                              <input type="hidden" name="pageSize" value="<%= userPageSize %>" />
                              <button class="btn small" type="submit" <%= user.username === 'admin' ? 'disabled' : '' %>><%= user.enabled ? '禁用' : '启用' %></button>
                            </form>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                    <% if (!userPaginationData.total) { %>
                      <tr><td colspan="8"><div class="empty-state">没有匹配的用户，请调整搜索条件。</div></td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
              <% if (userPaginationData.totalPages > 1) { %>
                <% const userWindowStart = Math.max(1, userPaginationData.currentPage - 2); %>
                <% const userWindowEnd = Math.min(userPaginationData.totalPages, userPaginationData.currentPage + 2); %>
                <div class="pagination-bar">
                  <% if (userPaginationData.hasPrev) { %><a class="pagination-link pagination-nav" href="/admin?<%= userPageQueryBase %>&userPage=<%= userPaginationData.prevPage %>">上一页</a><% } %>
                  <% if (userWindowStart > 1) { %>
                    <a class="pagination-link <%= userPaginationData.currentPage === 1 ? 'active' : '' %>" href="/admin?<%= userPageQueryBase %>&userPage=1">1</a>
                    <% if (userWindowStart > 2) { %><span class="pagination-ellipsis">…</span><% } %>
                  <% } %>
                  <% for (let pageNo = userWindowStart; pageNo <= userWindowEnd; pageNo++) { %>
                    <a class="pagination-link <%= userPaginationData.currentPage === pageNo ? 'active' : '' %>" href="/admin?<%= userPageQueryBase %>&userPage=<%= pageNo %>"><%= pageNo %></a>
                  <% } %>
                  <% if (userWindowEnd < userPaginationData.totalPages) { %>
                    <% if (userWindowEnd < userPaginationData.totalPages - 1) { %><span class="pagination-ellipsis">…</span><% } %>
                    <a class="pagination-link <%= userPaginationData.currentPage === userPaginationData.totalPages ? 'active' : '' %>" href="/admin?<%= userPageQueryBase %>&userPage=<%= userPaginationData.totalPages %>"><%= userPaginationData.totalPages %></a>
                  <% } %>
                  <% if (userPaginationData.hasNext) { %><a class="pagination-link pagination-nav" href="/admin?<%= userPageQueryBase %>&userPage=<%= userPaginationData.nextPage %>">下一页</a><% } %>
                </div>
              <% } %>
          </div>
        </div>
      </div>
    </section>
<% } else if (activePanel === 'classes') { %>
    <section id="class-panel" class="admin-panel is-active">
      <%
        const safeClasses = Array.isArray(classes) ? classes : [];
        const totalClasses = safeClasses.length;
        const totalChildren = safeClasses.reduce((sum, c) => sum + (Number(c.child_count) || 0), 0);
        const smallCount = safeClasses.filter(c => c.grade_level === 'small').length;
        const middleCount = safeClasses.filter(c => c.grade_level === 'middle').length;
        const largeCount = safeClasses.filter(c => c.grade_level === 'large').length;
        const enabledCount = safeClasses.filter(c => c.enabled).length;
      %>
      <div class="panel-heading modern-heading">
        <div>
          <div class="eyebrow">教务管理 · 班级体系</div>
          <h2>班级管理</h2>
          <p class="heading-sub">集中管理园所年级架构、班级基础信息、容纳指标及带班教师配置（最多支持3位带班老师）。</p>
        </div>
        <div class="heading-actions">
          <% if (typeof hasPerm === 'function' && hasPerm('data.classes.create') && !isReadonly) { %>
            <button type="button" class="btn primary add-class-trigger-btn" onclick="openClassModal('add')">
              <span class="btn-icon">＋</span> 新增班级
            </button>
          <% } %>
        </div>
      </div>

      <!-- 顶部统计概览指标卡 -->
      <div class="classes-metrics-grid">
        <div class="metric-card">
          <div class="metric-info">
            <span class="metric-label">班级总数</span>
            <span class="metric-val"><%= totalClasses %><small> 个</small></span>
          </div>
          <div class="metric-tag tag-blue">启用 <%= enabledCount %></div>
        </div>
        <div class="metric-card">
          <div class="metric-info">
            <span class="metric-label">在册幼儿</span>
            <span class="metric-val"><%= totalChildren %><small> 人</small></span>
          </div>
          <div class="metric-tag tag-green">全园总计</div>
        </div>
        <div class="metric-card">
          <div class="metric-info">
            <span class="metric-label">小班架构</span>
            <span class="metric-val"><%= smallCount %><small> 个班</small></span>
          </div>
          <div class="metric-tag tag-orange">托小阶段</div>
        </div>
        <div class="metric-card">
          <div class="metric-info">
            <span class="metric-label">中大班架构</span>
            <span class="metric-val"><%= middleCount + largeCount %><small> 个班</small></span>
          </div>
          <div class="metric-tag tag-purple">中班<%= middleCount %> · 大班<%= largeCount %></div>
        </div>
      </div>

      <!-- 主卡片：含现代筛选与数据表格 -->
      <div class="card modern-table-card">
        <div class="table-toolbar">
          <div class="toolbar-left">
            <div class="search-input-wrap">
              <span class="search-icon">🔍</span>
              <input type="text" id="classSearchInput" class="table-search-input" placeholder="按班级名称、教师姓名快速搜索..." oninput="filterClassesTable()" />
            </div>
            <div class="filter-select-wrap">
              <select id="classGradeFilter" class="table-filter-select" onchange="filterClassesTable()">
                <option value="">全部年级</option>
                <option value="small">小班</option>
                <option value="middle">中班</option>
                <option value="large">大班</option>
              </select>
            </div>
            <div class="filter-select-wrap">
              <select id="classStatusFilter" class="table-filter-select" onchange="filterClassesTable()">
                <option value="">全部状态</option>
                <option value="1">启用中</option>
                <option value="0">已停用</option>
              </select>
            </div>
          </div>
          <div class="toolbar-right" style="display:flex;align-items:center;gap:12px;">
            <div class="page-size-selector" style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:#64748b;">
              <span>每页</span>
              <select id="classPageSizeSelect" class="table-filter-select" style="height:32px;padding:4px 8px;font-size:12px;" onchange="changeClassPageSize(this.value)">
                <option value="10" selected>10 条</option>
                <option value="15">15 条</option>
                <option value="20">20 条</option>
                <option value="all">全部</option>
              </select>
            </div>
            <span class="filter-count-badge" id="classFilteredCount">共 <%= totalClasses %> 个班级</span>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table modern-class-table" id="classesDataTable">
            <thead>
              <tr>
                <th style="width: 140px;">班级名称</th>
                <th style="width: 100px;">所属年级</th>
                <th>带班教师</th>
                <th style="width: 110px; text-align: center;">幼儿人数</th>
                <th style="width: 100px; text-align: center;">班级容量</th>
                <th>班级描述</th>
                <th style="width: 90px; text-align: center;">状态</th>
                <th style="width: 150px; text-align: right;">操作</th>
              </tr>
            </thead>
            <tbody>
              <% if (!safeClasses.length) { %>
                <tr><td colspan="8"><div class="empty-state">暂无班级数据，请点击右上角新增班级</div></td></tr>
              <% } else { %>
                <% safeClasses.forEach(function(item) { %>
                  <%
                    const gradeClass = item.grade_level === 'large' ? 'grade-large' : (item.grade_level === 'middle' ? 'grade-middle' : 'grade-small');
                    const teachers = (item.teacher_names || '').split('、').filter(Boolean);
                  %>
                  <tr class="class-data-row" 
                      data-id="<%= item.id %>"
                      data-name="<%= item.name %>"
                      data-grade="<%= item.grade_level %>"
                      data-capacity="<%= item.capacity || 0 %>"
                      data-description="<%= item.description || '' %>"
                      data-enabled="<%= item.enabled ? 1 : 0 %>"
                      data-teachers="<%= item.teacher_names || '' %>"
                      data-teacher-ids="<%= item.teacher_ids || '' %>">
                    <td>
                      <div class="class-name-cell">
                        <span class="class-avatar-badge <%= gradeClass %>"><%= (item.name || '').slice(0, 1) %></span>
                        <strong class="class-title"><%= item.name %></strong>
                        <span class="grade-pill <%= gradeClass %> mobile-grade-inline" style="display:none;"><%= gradeLabel(item.grade_level) %></span>
                      </div>
                    </td>
                    <td>
                      <span class="grade-pill <%= gradeClass %>"><%= gradeLabel(item.grade_level) %></span>
                    </td>
                    <td>
                      <% if (!teachers.length) { %>
                        <span class="teacher-empty-tag">未分配教师</span>
                      <% } else { %>
                        <div class="teacher-tags-group">
                          <% teachers.forEach(function(tName, idx) { %>
                            <span class="teacher-tag"><%= idx === 0 ? '👑 ' : '' %><%= tName %></span>
                          <% }) %>
                        </div>
                      <% } %>
                    </td>
                    <td style="text-align: center;">
                      <span class="child-count-pill <%= Number(item.child_count) > 0 ? 'has-children' : 'no-children' %>">
                        <%= item.child_count || 0 %> 人
                      </span>
                    </td>
                    <td style="text-align: center;">
                      <span class="capacity-pill"><%= item.capacity ? item.capacity + ' 人' : '不限' %></span>
                    </td>
                    <td>
                      <span class="class-desc-cell" title="<%= item.description || '' %>">
                        <%= item.description || '—' %>
                      </span>
                    </td>
                    <td style="text-align: center;">
                      <span class="status-badge <%= item.enabled ? 'ok' : 'off' %>">
                        <%= item.enabled ? '启用中' : '已停用' %>
                      </span>
                    </td>
                    <td style="text-align: right;">
                      <div class="table-row-actions">
                        <% if (typeof hasPerm === 'function' && hasPerm('data.classes.edit') && !isReadonly) { %>
                          <button type="button" class="btn small action-btn-edit" onclick="openClassModal('edit', this)">
                            编辑
                          </button>
                          <form method="post" action="/admin/classes/<%= item.id %>/toggle" class="inline-form" onsubmit="return confirm('确定要<%= item.enabled ? '停用' : '启用' %>【<%= item.name %>】吗？');">
                            <button type="submit" class="btn small <%= item.enabled ? 'action-btn-danger' : 'action-btn-success' %>">
                              <%= item.enabled ? '停用' : '启用' %>
                            </button>
                          </form>
                        <% } else { %>
                          <span class="muted text-small">只读权限</span>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- 班级分页控制条 -->
        <div class="table-pagination-bar" id="classPaginationBar" style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-top:1px solid #edf2f7;background:#fafbfc;border-radius:0 0 16px 16px;">
          <div class="pagination-info" id="classPaginationInfo" style="font-size:13px;color:#64748b;">
            正在计算分页...
          </div>
          <div class="pagination-controls" id="classPaginationControls" style="display:flex;align-items:center;gap:6px;">
          </div>
        </div>
      </div>

      <!-- 现代弹窗 Modal：新增 / 编辑班级 -->
      <div id="classActionModal" class="modal-overlay" style="display: none;" onclick="if(event.target === this) closeClassModal()">
        <div class="modal-box class-modal-dialog">
          <div class="modal-header">
            <div class="modal-title-wrap">
              <h3 id="classModalTitle">编辑班级</h3>
              <p class="modal-subtitle" id="classModalSubtitle">请完善班级档案与带班教师配置</p>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeClassModal()" title="关闭">✕</button>
          </div>
          
          <form id="classActionForm" method="post" action="/admin/classes/add" class="class-modal-form">
            <input type="hidden" name="classKeyword" value="" />
            <input type="hidden" name="classGradeLevel" value="" />
            
            <div class="modal-form-body">
              <div class="form-row-2col">
                <div class="form-field">
                  <label for="modalClassName">班级名称 <span class="required-star">*</span></label>
                  <input type="text" id="modalClassName" name="name" placeholder="例如：大一班" required class="modern-input" />
                </div>
                <div class="form-field">
                  <label for="modalGradeLevel">所属年级 <span class="required-star">*</span></label>
                  <select id="modalGradeLevel" name="gradeLevel" required class="modern-input">
                    <option value="small">小班</option>
                    <option value="middle">中班</option>
                    <option value="large">大班</option>
                  </select>
                </div>
              </div>

              <div class="form-row-2col">
                <div class="form-field">
                  <label for="modalCapacity">班级容量限制（人）</label>
                  <input type="number" id="modalCapacity" name="capacity" min="0" value="0" placeholder="0 表示不设上限" class="modern-input" />
                  <span class="field-hint">填 0 为不限制幼儿容量</span>
                </div>
                <div class="form-field">
                  <label for="modalDescription">班级寄语 / 描述</label>
                  <input type="text" id="modalDescription" name="description" placeholder="例如：阳光运动示范班" class="modern-input" />
                  <span class="field-hint">用于班级档案备注</span>
                </div>
              </div>

              <div class="teacher-slot-section">
                <div class="slot-section-title">
                  <span>带班教师配置</span>
                  <span class="slot-hint">支持绑定最多 3 位教师，第 1 位为主班主任</span>
                </div>
                <div class="teacher-slots-grid">
                  <div class="slot-field">
                    <label><span>👑 主班主任</span></label>
                    <select name="teacherIds" class="modern-input teacher-slot-select" id="slotTeacher1">
                      <option value="">请选择主班主任</option>
                      <% teacherOptions.forEach(function(teacher) { %>
                        <option value="<%= teacher.id %>"><%= teacher.name %>（<%= teacher.username %>）</option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="slot-field">
                    <label><span>班主任2（可选）</span></label>
                    <select name="teacherIds" class="modern-input teacher-slot-select" id="slotTeacher2">
                      <option value="">暂不设置班主任2</option>
                      <% teacherOptions.forEach(function(teacher) { %>
                        <option value="<%= teacher.id %>"><%= teacher.name %>（<%= teacher.username %>）</option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="slot-field">
                    <label><span>班主任3（可选）</span></label>
                    <select name="teacherIds" class="modern-input teacher-slot-select" id="slotTeacher3">
                      <option value="">暂不设置班主任3</option>
                      <% teacherOptions.forEach(function(teacher) { %>
                        <option value="<%= teacher.id %>"><%= teacher.name %>（<%= teacher.username %>）</option>
                      <% }) %>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="modal-footer">
              <button type="button" class="btn modern-btn-cancel" onclick="closeClassModal()">取消</button>
              <button type="submit" class="btn primary modern-btn-submit" id="classSubmitBtn">确定保存</button>
            </div>
          </form>
        </div>
      </div>
    </section>
<% } else if (activePanel === 'children') { %>
    <section id="child-panel" class="admin-panel is-active" data-ajax-panel="children">
      <% const childKeywordRaw = String(pageQuery.childKeyword || '').trim(); %>
      <% const childKeyword = childKeywordRaw.toLowerCase(); %>
      <% const childClassFilter = String(pageQuery.childClassId || ''); %>
      <% const safeChildren = Array.isArray(children) ? children : []; %>
      <% const filteredChildren = safeChildren.filter(function(child) {
           const haystack = [child.name, child.gender, child.class_name].join(' ').toLowerCase();
           const matchKeyword = !childKeyword || haystack.includes(childKeyword);
           const matchClass = !childClassFilter || String(child.class_id || '') === childClassFilter;
           return matchKeyword && matchClass;
         }); %>
      <% const childPaginationData = (typeof childPagination !== 'undefined' && childPagination) ? childPagination : { currentPage: 1, totalPages: 1, total: filteredChildren.length, startIndex: filteredChildren.length ? 1 : 0, endIndex: filteredChildren.length, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1 }; %>
      <% const childPageSize = childPaginationData.pageSize || 10; %>
      <% const pagedChildren = filteredChildren.slice((childPaginationData.currentPage - 1) * childPageSize, childPaginationData.currentPage * childPageSize); %>
      <% const childPageQueryBase = 'panel=children' + (childKeywordRaw ? '&childKeyword=' + encodeURIComponent(childKeywordRaw) : '') + (childClassFilter ? '&childClassId=' + encodeURIComponent(childClassFilter) : '') + '&pageSize=' + encodeURIComponent(String(childPageSize)); %>
      <div class="panel-heading"><div><div class="eyebrow">幼儿档案管理</div><h2>幼儿基础档案</h2><p>这里维护班级归属、姓名、性别、出生日期等基础信息。动态的临时关注状态请到“重点关注管理”里维护。</p></div></div>
      <div class="management-layout">
        <div class="management-side">
          <% if (typeof hasPerm === 'function' && hasPerm('data.children.create') && !isReadonly) { %>
          <div class="card">
            <div class="section-head"><h3>新增幼儿档案</h3></div>
            <form method="post" action="/admin/children/add" class="form-grid">
              <input type="hidden" name="childKeyword" value="<%= childKeywordRaw %>" />
              <input type="hidden" name="childClassId" value="<%= childClassFilter %>" />
              <input type="hidden" name="childPage" value="<%= childPaginationData.currentPage %>" />
              <input type="hidden" name="pageSize" value="<%= childPageSize %>" />
              <label><span>所属班级</span><select name="classId" required><option value="">请选择班级</option><% classes.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %>（<%= gradeLabel(item.grade_level) %>）</option><% }) %></select></label>
              <label><span>幼儿姓名</span><input type="text" name="name" placeholder="例如：小明" required /></label>
              <label><span>性别</span><select name="gender"><option value="男">男</option><option value="女">女</option></select></label>
              <label><span>出生日期</span><input type="date" name="birthDate" /></label>
              <button class="btn primary full" type="submit">新增幼儿档案</button>
            </form>
          </div>
          <% } %>
          <div class="card">
            <div class="section-head"><h3>导入 / 导出</h3></div>
            <div class="toolbar-links stacked-links"><% if (typeof hasPerm === 'function' && hasPerm('data.children.import') && !isReadonly) { %><a class="btn small" href="/admin/children/template">下载导入模板</a><% } %><% if (typeof hasPerm === 'function' && hasPerm('data.children.export') && !isReadonly) { %><a class="btn small" href="/admin/children/export?<%= buildQuery([['childKeyword', childKeywordRaw], ['childClassId', childClassFilter]]) %>">导出幼儿</a><% } %></div>
            <% if (typeof hasPerm === 'function' && hasPerm('data.children.import') && !isReadonly) { %>
            <div class="import-box no-top-margin">
              <h3>批量导入幼儿</h3>
              <form method="post" action="/admin/children/import" enctype="multipart/form-data" class="form-grid"><input type="file" name="file" accept=".xlsx,.xls,.csv" required /><button class="btn primary full" type="submit">上传并导入</button></form>
              <div class="muted">模板基础字段：班级、幼儿姓名、性别、出生日期。出生日期兼容 2021-10-17 / 2021/10/17。扩展字段仍兼容：需要关注、关注原因。</div>
            </div>
            <% } %>
          </div>
        </div>
        <div class="management-main">
          <div class="card full-height-card">
            <div class="section-head"><h3>幼儿档案列表</h3><div class="muted no-margin">支持按姓名搜索，并按班级筛选</div></div>
            <form method="get" action="/admin" class="filter-toolbar">
              <input type="hidden" name="panel" value="children" />
              <div class="filter-row filter-row-wide">
                <input type="search" name="childKeyword" value="<%= childKeywordRaw %>" placeholder="搜索幼儿姓名 / 性别 / 班级" />
                <select name="pageSize">
                  <option value="10" <%= childPageSize === 10 ? 'selected' : '' %>>每页 10 条</option>
                  <option value="20" <%= childPageSize === 20 ? 'selected' : '' %>>每页 20 条</option>
                  <option value="50" <%= childPageSize === 50 ? 'selected' : '' %>>每页 50 条</option>
                </select>
                <select name="childClassId">
                  <option value="">全部班级</option>
                  <% classes.forEach(function(item) { %>
                    <option value="<%= item.id %>" <%= childClassFilter === String(item.id) ? 'selected' : '' %>><%= item.name %>（<%= gradeLabel(item.grade_level) %>）</option>
                  <% }) %>
                </select>
                <button class="btn" type="submit">筛选</button>
                <a class="btn" href="/admin?panel=children">重置</a>
              </div>
            </form>
            <div class="muted" style="margin:10px 0 14px;">当前筛选结果：<strong><%= childPaginationData.total %></strong> 人，当前显示第 <strong><%= childPaginationData.startIndex || 0 %></strong> - <strong><%= childPaginationData.endIndex || 0 %></strong> 条</div>
            <form method="post" action="/admin/children/batch" class="batch-toolbar" id="children-batch-form">
              <input type="hidden" name="childKeyword" value="<%= childKeywordRaw %>" />
              <input type="hidden" name="childClassId" value="<%= childClassFilter %>" />
              <input type="hidden" name="childPage" value="<%= childPaginationData.currentPage %>" />
              <input type="hidden" name="pageSize" value="<%= childPageSize %>" />
              <% if (typeof hasPerm === 'function' && (hasPerm('data.children.edit') || hasPerm('data.children.delete')) && !isReadonly) { %><div class="batch-row"><select name="batchAction" required><option value="enable">批量启用</option><option value="disable">批量禁用</option><option value="delete">批量删除</option><option value="moveClass">批量调整班级</option></select><select name="batchClassId"><option value="">选择目标班级（仅调整班级时使用）</option><% classes.forEach(function(item) { %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select><button class="btn primary" type="submit">执行批量操作</button></div><% } %>
            </form>
            <div class="table-wrap">
                <table class="data-table admin-table">
                  <thead><tr><th class="checkbox-cell">选择</th><th>班级</th><th>幼儿姓名</th><th>性别</th><th>出生日期</th><th>状态</th><th>创建时间</th><th>操作</th></tr></thead>
                  <tbody>
                    <% pagedChildren.forEach(function(child) { %>
                      <tr>
                        <td class="checkbox-cell"><input type="checkbox" name="selectedIds" value="<%= child.id %>" form="children-batch-form" /></td>
                        <td><%= child.class_name || '-' %></td>
                        <td><strong><a class="child-compare-link" data-child-id="<%= child.id %>" data-child-name="<%= child.name %>" role="button" tabindex="0"><%= child.name %></a></strong></td>
                        <td><%= child.gender || '-' %></td>
                        <td><%= child.birth_date ? formatDateOnly(child.birth_date) : '-' %></td>
                        <td><span class="status-badge <%= child.enabled ? 'ok' : 'off' %>"><%= child.enabled ? '启用中' : '已禁用' %></span></td>
                        <td><%= child.created_at ? new Date(child.created_at).toLocaleString('zh-CN', { hour12: false }) : '-' %></td>
                        <td>
                          <div class="action-col compact-actions">
                            <form method="post" action="/admin/children/<%= child.id %>/toggle" class="inline-form">
                              <input type="hidden" name="childKeyword" value="<%= childKeywordRaw %>" />
                              <input type="hidden" name="childClassId" value="<%= childClassFilter %>" />
                              <input type="hidden" name="childPage" value="<%= childPaginationData.currentPage %>" />
                              <input type="hidden" name="pageSize" value="<%= childPageSize %>" />
                              <button class="btn small" type="submit"><%= child.enabled ? '禁用' : '启用' %></button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                    <% if (!childPaginationData.total) { %>
                      <tr><td colspan="8"><div class="empty-state">没有匹配的幼儿档案，请调整搜索条件。</div></td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
              <% if (childPaginationData.totalPages > 1) { %>
                <% const childWindowStart = Math.max(1, childPaginationData.currentPage - 2); %>
                <% const childWindowEnd = Math.min(childPaginationData.totalPages, childPaginationData.currentPage + 2); %>
                <div class="pagination-bar">
                  <% if (childPaginationData.hasPrev) { %><a class="pagination-link pagination-nav" href="/admin?<%= childPageQueryBase %>&childPage=<%= childPaginationData.prevPage %>">上一页</a><% } %>
                  <% if (childWindowStart > 1) { %>
                    <a class="pagination-link <%= childPaginationData.currentPage === 1 ? 'active' : '' %>" href="/admin?<%= childPageQueryBase %>&childPage=1">1</a>
                    <% if (childWindowStart > 2) { %><span class="pagination-ellipsis">…</span><% } %>
                  <% } %>
                  <% for (let pageNo = childWindowStart; pageNo <= childWindowEnd; pageNo++) { %>
                    <a class="pagination-link <%= childPaginationData.currentPage === pageNo ? 'active' : '' %>" href="/admin?<%= childPageQueryBase %>&childPage=<%= pageNo %>"><%= pageNo %></a>
                  <% } %>
                  <% if (childWindowEnd < childPaginationData.totalPages) { %>
                    <% if (childWindowEnd < childPaginationData.totalPages - 1) { %><span class="pagination-ellipsis">…</span><% } %>
                    <a class="pagination-link <%= childPaginationData.currentPage === childPaginationData.totalPages ? 'active' : '' %>" href="/admin?<%= childPageQueryBase %>&childPage=<%= childPaginationData.totalPages %>"><%= childPaginationData.totalPages %></a>
                  <% } %>
                  <% if (childPaginationData.hasNext) { %><a class="pagination-link pagination-nav" href="/admin?<%= childPageQueryBase %>&childPage=<%= childPaginationData.nextPage %>">下一页</a><% } %>
                </div>
              <% } %>
          </div>
        </div>
      </div>
    </section>
<% } else if (activePanel === 'logs') { %>
    <section id="log-panel" class="admin-panel is-active" data-ajax-panel="logs">
      <div class="panel-heading"><div><div class="eyebrow">日志记录</div><h2>关键操作审计日志</h2><p>所有时间统一按北京时间展示。支持按操作人、动作类型、日期筛选，并按每页 10 条分页。</p></div></div>
      <div class="logs-grid">
        <div class="card log-card-main">
          <div class="section-head"><h3>关键操作审计</h3><div class="muted no-margin">当前共 <%= logs && logs.pagination ? logs.pagination.total : 0 %> 条</div></div>
          <form method="get" action="/admin" class="filter-toolbar audit-filter-toolbar">
            <input type="hidden" name="panel" value="logs" />
            <div class="filter-row filter-row-wide audit-filter-row">
              <select name="logActor">
                <option value="">全部操作人</option>
                <% (logs.actorOptions || []).forEach(function(actor) { %>
                  <option value="<%= actor %>" <%= logs.filters && logs.filters.actor === actor ? 'selected' : '' %>><%= actor %></option>
                <% }) %>
              </select>
              <select name="logAction">
                <option value="">全部动作类型</option>
                <% (logs.actionOptions || []).forEach(function(action) { %>
                  <option value="<%= action %>" <%= logs.filters && logs.filters.action === action ? 'selected' : '' %>><%= action %></option>
                <% }) %>
              </select>
              <input type="date" name="logDate" value="<%= logs.filters && logs.filters.date ? logs.filters.date : '' %>" />
              <button class="btn" type="submit">筛选</button>
              <a class="btn" href="/admin?panel=logs">重置</a>
            </div>
          </form>
          <div class="table-wrap">
            <table class="data-table admin-table">
              <thead><tr><th>时间</th><th>操作人</th><th>动作</th><th>对象</th><th>状态</th><th>详情</th></tr></thead>
              <tbody>
                <% (logs && logs.audit || []).forEach(function(item) { %>
                  <tr>
                    <td class="audit-time-cell"><div class="audit-time-text"><%= item.timeLabel || '-' %></div></td>
                    <td><%= item.actorLabel || '-' %></td>
                    <td><span class="status-badge" style="background:<%= item.event === 'fitness_record_deleted' ? '#fdecea' : '#eef3ff' %>;color:<%= item.event === 'fitness_record_deleted' ? '#c62828' : '#1f4fd6' %>;"><%= item.actionLabel || '-' %></span></td>
                    <td class="audit-target-cell"><div class="audit-target-text" style="<%= item.event === 'fitness_record_deleted' ? 'font-weight:700;color:#b42318;' : '' %>"><%= item.targetLabel || '-' %></div></td>
                    <td><%= item.status || '-' %></td>
                    <td class="audit-detail-cell"><pre class="audit-detail-text" style="<%= item.event === 'fitness_record_deleted' ? 'background:#fff1f0;border:1px solid #f5c2c0;color:#8a1c1c;font-weight:700;' : '' %>"><%= item.detailLabel || '-' %></pre></td>
                  </tr>
                <% }) %>
                <% if (!(logs && logs.audit && logs.audit.length)) { %><tr><td colspan="6"><div class="empty-state">当前筛选条件下暂无审计日志</div></td></tr><% } %>
              </tbody>
            </table>
          </div>
          <% if (logs && logs.pagination && logs.pagination.totalPages > 1) { %>
            <% const pageQuerySuffix = (logs.filters && logs.filters.actor ? '&logActor=' + encodeURIComponent(logs.filters.actor) : '') + (logs.filters && logs.filters.action ? '&logAction=' + encodeURIComponent(logs.filters.action) : '') + (logs.filters && logs.filters.date ? '&logDate=' + encodeURIComponent(logs.filters.date) : ''); %>
            <div class="pagination-bar">
              <% if (logs.pagination.currentPage > 1) { %>
                <a class="pagination-link pagination-nav" href="/admin?panel=logs&logPage=<%= logs.pagination.currentPage - 1 %><%= pageQuerySuffix %>">上一页</a>
              <% } %>
              <% for (let pageNo = 1; pageNo <= logs.pagination.totalPages; pageNo++) { %>
                <a class="pagination-link <%= logs.pagination.currentPage === pageNo ? 'active' : '' %>" href="/admin?panel=logs&logPage=<%= pageNo %><%= pageQuerySuffix %>"><%= pageNo %></a>
              <% } %>
              <% if (logs.pagination.currentPage < logs.pagination.totalPages) { %>
                <a class="pagination-link pagination-nav" href="/admin?panel=logs&logPage=<%= logs.pagination.currentPage + 1 %><%= pageQuerySuffix %>">下一页</a>
              <% } %>
            </div>
          <% } %>
        </div>

      </div>
    </section>
<% } else if (activePanel === 'attention') { %>
    <section id="attention-panel" class="admin-panel is-active" data-ajax-panel="attention">
      <% const attentionKeywordRaw = String(pageQuery.attentionKeyword || '').trim(); %>
      <% const attentionKeyword = attentionKeywordRaw.toLowerCase(); %>
      <% const attentionClassFilter = String(pageQuery.attentionClassId || ''); %>
      <% const attentionStatusFilter = String(pageQuery.attentionStatus || 'all'); %>
      <% const safeAttentionChildren = Array.isArray(children) ? children : []; %>
      <% const filteredAttentionChildren = safeAttentionChildren.filter(function(child) {
           const haystack = [child.name, child.class_name, child.gender, child.attention_reason, child.attention_tags].join(' ').toLowerCase();
           const matchKeyword = !attentionKeyword || haystack.includes(attentionKeyword);
           const matchClass = !attentionClassFilter || String(child.class_id || '') === attentionClassFilter;
           const status = String(child.attention_status || (child.needs_attention ? 'active' : 'normal'));
           const matchStatus = attentionStatusFilter === 'all'
             ? true
             : attentionStatusFilter === 'active'
               ? status === 'active'
               : attentionStatusFilter === 'scheduled'
                 ? status === 'scheduled'
                 : attentionStatusFilter === 'expired'
                   ? status === 'expired'
                   : status === 'normal';
           return matchKeyword && matchClass && matchStatus;
         }); %>
      <% const attentionPaginationData = (typeof attentionPagination !== 'undefined' && attentionPagination) ? attentionPagination : { currentPage: 1, totalPages: 1, total: filteredAttentionChildren.length, startIndex: filteredAttentionChildren.length ? 1 : 0, endIndex: filteredAttentionChildren.length, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1 }; %>
      <% const attentionPageSize = attentionPaginationData.pageSize || 10; %>
      <% const pagedAttentionChildren = filteredAttentionChildren.slice((attentionPaginationData.currentPage - 1) * attentionPageSize, attentionPaginationData.currentPage * attentionPageSize); %>
      <% const requestedAttentionChildId = String(pageQuery.attentionChildId || ''); %>
      <% const attentionPageQueryBase = 'panel=attention' + (attentionKeywordRaw ? '&attentionKeyword=' + encodeURIComponent(attentionKeywordRaw) : '') + (attentionClassFilter ? '&attentionClassId=' + encodeURIComponent(attentionClassFilter) : '') + (attentionStatusFilter ? '&attentionStatus=' + encodeURIComponent(attentionStatusFilter) : '') + (requestedAttentionChildId ? '&attentionChildId=' + encodeURIComponent(requestedAttentionChildId) : '') + '&pageSize=' + encodeURIComponent(String(attentionPageSize)); %>
      <% const selectedAttentionChild = filteredAttentionChildren.find(function(child) { return String(child.id) === requestedAttentionChildId; }) || filteredAttentionChildren[0] || null; %>
      <% const selectedAttentionStart = selectedAttentionChild && selectedAttentionChild.attention_start_date ? formatDateOnly(selectedAttentionChild.attention_start_date) : (today || ''); %>
      <% const selectedAttentionEnd = selectedAttentionChild && selectedAttentionChild.attention_end_date ? formatDateOnly(selectedAttentionChild.attention_end_date) : ''; %>
      <% const selectedAttentionVest = selectedAttentionChild && selectedAttentionChild.attention_vest_type === 'red' ? 'red' : (selectedAttentionChild && selectedAttentionChild.attention_vest_type === 'green' ? 'green' : 'yellow'); %>
      <% const quickAttentionTags = ['咳嗽', '感冒恢复期', '扭伤擦伤', '情绪波动', '减少跑跳', '避免对抗', '观察体力', '补水提醒']; %>
      <% const selectedAttentionTags = selectedAttentionChild ? String(selectedAttentionChild.attention_tags || '').split(',').map(function(item) { return item.trim(); }).filter(Boolean) : []; %>
      <% const selectedAttentionExtraTags = selectedAttentionTags.filter(function(tag) { return !quickAttentionTags.includes(tag); }).join(','); %>
      <div class="panel-heading"><div><div class="eyebrow">重点关注管理</div><h2>动态重点关注提醒</h2><p>这里单独维护当天或近期需要重点照看的幼儿，例如咳嗽、扭伤、情绪不稳、刚恢复运动等。情况恢复后可随时取消。</p></div></div>
      <div class="panel-grid">
        <div class="card stat-card">
          <div class="stat-label">当前生效中的重点关注人数</div>
          <div class="stat-number"><%= counts.attention_children || 0 %></div>
          <div class="muted">教师端首页与场地预约页都会读取这里的动态提醒。</div>
        </div>
        <div class="card">
          <h3>使用建议</h3>
          <div class="tips compact">
            <div>1. 先用搜索框快速定位幼儿，再在上方统一维护，不在每行后面堆操作按钮。</div>
            <div>2. 可以设置开始/结束日期，方便提前录入和自动失效。</div>
            <div>3. 快捷标签建议配合关注原因一起写，教师端会同步看到。</div>
          </div>
        </div>
      </div>
      <div class="card full-height-card">
        <div class="section-head"><h3>重点关注名单维护</h3><div class="muted no-margin">支持搜索、班级筛选、状态筛选，点选下方幼儿后统一编辑</div></div>
        <form method="get" action="/admin" class="filter-toolbar">
          <input type="hidden" name="panel" value="attention" />
          <div class="filter-row filter-row-attention">
            <input type="search" name="attentionKeyword" value="<%= attentionKeywordRaw %>" placeholder="搜索幼儿姓名 / 班级 / 原因 / 标签" />
            <select name="pageSize">
              <option value="10" <%= attentionPageSize === 10 ? 'selected' : '' %>>每页 10 条</option>
              <option value="20" <%= attentionPageSize === 20 ? 'selected' : '' %>>每页 20 条</option>
              <option value="50" <%= attentionPageSize === 50 ? 'selected' : '' %>>每页 50 条</option>
            </select>
            <select name="attentionClassId">
              <option value="">全部班级</option>
              <% classes.forEach(function(item) { %>
                <option value="<%= item.id %>" <%= attentionClassFilter === String(item.id) ? 'selected' : '' %>><%= item.name %>（<%= gradeLabel(item.grade_level) %>）</option>
              <% }) %>
            </select>
            <select name="attentionStatus">
              <option value="all" <%= attentionStatusFilter === 'all' ? 'selected' : '' %>>全部状态</option>
              <option value="active" <%= attentionStatusFilter === 'active' ? 'selected' : '' %>>当前生效</option>
              <option value="scheduled" <%= attentionStatusFilter === 'scheduled' ? 'selected' : '' %>>未开始</option>
              <option value="expired" <%= attentionStatusFilter === 'expired' ? 'selected' : '' %>>已过期</option>
              <option value="normal" <%= attentionStatusFilter === 'normal' ? 'selected' : '' %>>未设置重点关注</option>
            </select>
            <button class="btn" type="submit">筛选</button>
            <a class="btn" href="/admin?panel=attention">重置</a>
          </div>
        </form>
        <div class="muted" style="margin:10px 0 14px;">当前筛选结果：<strong><%= filteredAttentionChildren.length %></strong> 人</div>

        <div class="attn-panel-grid">
        <div class="attention-editor-card">
          <% if (!selectedAttentionChild) { %>
            <div class="empty-state" style="padding:24px 0;">点击右侧列表选择幼儿</div>
          <% } else { %>
            <div class="attn-ed-header">
              <span class="attn-ed-name" id="attentionEditorName"><%= selectedAttentionChild.name %></span>
              <span class="attn-ed-meta" id="attentionEditorMeta"><%= selectedAttentionChild.class_name || '未分班' %><%= selectedAttentionChild.gender ? ' · ' + selectedAttentionChild.gender : '' %></span>
              <% const initialStatusLabel = selectedAttentionChild.attention_status === 'active' ? '生效中' : selectedAttentionChild.attention_status === 'scheduled' ? '未开始' : selectedAttentionChild.attention_status === 'expired' ? '已过期' : '正常'; %>
              <% const initialStatusClass = selectedAttentionChild.attention_status === 'active' ? 'warn' : selectedAttentionChild.attention_status === 'normal' ? 'ok' : 'info'; %>
              <span class="status-badge <%= initialStatusClass %>" id="attentionEditorStatusBadge" style="margin-left:auto;"><%= initialStatusLabel %></span>
            </div>
            <form method="post" action="/admin/children/attention/save" class="attn-ed-form" id="attentionEditorForm">
                <input type="hidden" name="childId" id="attentionEditorChildId" value="<%= selectedAttentionChild.id %>" />
                <input type="hidden" name="attentionKeyword" value="<%= attentionKeywordRaw %>" />
                <input type="hidden" name="attentionClassId" value="<%= attentionClassFilter %>" />
                <input type="hidden" name="attentionStatus" value="<%= attentionStatusFilter %>" />
                <input type="hidden" name="attentionPage" value="<%= attentionPaginationData.currentPage %>" />
                <input type="hidden" name="pageSize" value="<%= attentionPageSize %>" />
                <label class="attn-ed-field"><span>关注</span><select name="needsAttention" id="attentionEditorNeedsAttention"><option value="0" <%= selectedAttentionChild.attention_marked ? '' : 'selected' %>>否</option><option value="1" <%= selectedAttentionChild.attention_marked ? 'selected' : '' %>>是</option></select></label>
                <label class="attn-ed-field"><span>马甲</span><select name="attentionVestType" id="attentionEditorVestType"><option value="yellow" <%= selectedAttentionVest === 'yellow' ? 'selected' : '' %>>黄马甲</option><option value="green" <%= selectedAttentionVest === 'green' ? 'selected' : '' %>>绿马甲</option><option value="red" <%= selectedAttentionVest === 'red' ? 'selected' : '' %>>红马甲</option></select></label>
                <label class="attn-ed-field"><span>开始</span><input type="date" name="attentionStartDate" id="attentionEditorStartDate" value="<%= selectedAttentionStart %>" /></label>
                <label class="attn-ed-field"><span>结束</span><input type="date" name="attentionEndDate" id="attentionEditorEndDate" value="<%= selectedAttentionEnd %>" /></label>
                <label class="attn-ed-field attn-ed-wide"><span>原因</span><input type="text" name="attentionReason" id="attentionEditorReason" placeholder="例如：咳嗽，减少跑跳" value="<%= selectedAttentionChild.attention_reason || '' %>" /></label>
                <label class="attn-ed-field attn-ed-wide"><span>标签</span>
                  <select id="attentionTagPicker">
                    <option value="">选择标签…</option>
                    <% quickAttentionTags.forEach(function(tag) { %>
                      <option value="<%= tag %>"><%= tag %></option>
                    <% }) %>
                  </select>
                  <div class="attn-tag-pills" id="attentionTagPills"></div>
                  <div id="attentionTagHiddenInputs"></div>
                </label>
                <label class="attn-ed-field attn-ed-wide"><span>补充标签</span><input type="text" name="attentionTagsExtra" id="attentionEditorTagsExtra" value="<%= selectedAttentionExtraTags %>" placeholder="多个用逗号分隔" /></label>
                <div class="attn-ed-actions attn-ed-wide">
                  <button class="btn primary" type="submit">保存</button>
                </div>
              </form>
              <form method="post" action="/admin/children/attention/clear" class="inline-form attention-clear-form" id="attentionClearForm" style="margin-top:0;">
                <input type="hidden" name="childId" id="attentionClearChildId" value="<%= selectedAttentionChild.id %>" />
                <input type="hidden" name="attentionKeyword" value="<%= attentionKeywordRaw %>" />
                <input type="hidden" name="attentionClassId" value="<%= attentionClassFilter %>" />
                <input type="hidden" name="attentionStatus" value="<%= attentionStatusFilter %>" />
                <input type="hidden" name="attentionPage" value="<%= attentionPaginationData.currentPage %>" />
                <input type="hidden" name="pageSize" value="<%= attentionPageSize %>" />
                <button class="btn" type="submit" id="attentionClearButton" <%= selectedAttentionChild.attention_marked ? '' : 'disabled' %>>取消关注</button>
              </form>
          <% } %>
        </div>

        <div>
        <div class="muted" style="margin:0 0 10px;">点击任意一行切换上方编辑对象</div>
        <div class="table-wrap">
          <table class="data-table admin-table attention-table">
            <thead><tr><th class="checkbox-cell">当前</th><th>班级</th><th>幼儿姓名</th><th>状态</th><th>有效期</th><th>标签</th><th>关注原因</th></tr></thead>
            <tbody>
              <% pagedAttentionChildren.forEach(function(child) { %>
                <% const childStart = child.attention_start_date ? formatDateOnly(child.attention_start_date) : ''; %>
                <% const childEnd = child.attention_end_date ? formatDateOnly(child.attention_end_date) : ''; %>
                <% const childTags = String(child.attention_tags || '').split(',').map(function(item) { return item.trim(); }).filter(Boolean); %>
                <% const childStatusLabel = child.attention_status === 'active' ? '生效中' : child.attention_status === 'scheduled' ? '未开始' : child.attention_status === 'expired' ? '已过期' : '正常'; %>
                <% const childStatusClass = child.attention_status === 'active' ? 'warn' : child.attention_status === 'normal' ? 'ok' : 'info'; %>
                <tr class="attention-row <%= selectedAttentionChild && selectedAttentionChild.id === child.id ? 'is-selected' : '' %>"
                    data-child-id="<%= child.id %>"
                    data-name="<%= child.name %>"
                    data-class-name="<%= child.class_name || '' %>"
                    data-gender="<%= child.gender || '' %>"
                    data-needs-attention="<%= child.attention_marked ? '1' : '0' %>"
                    data-attention-reason="<%= child.attention_reason || '' %>"
                    data-attention-start-date="<%= childStart %>"
                    data-attention-end-date="<%= childEnd %>"
                    data-attention-tags="<%= child.attention_tags || '' %>"
                    data-attention-vest-type="<%= child.attention_vest_type === 'red' ? 'red' : (child.attention_vest_type === 'green' ? 'green' : 'yellow') %>"
                    data-attention-status="<%= child.attention_status || 'normal' %>"
                    tabindex="0">
                  <td class="checkbox-cell"><input type="radio" class="attention-row-radio" name="attentionRowSelector" <%= selectedAttentionChild && selectedAttentionChild.id === child.id ? 'checked' : '' %> /></td>
                  <td><%= child.class_name || '-' %></td>
                  <td><strong><a class="child-compare-link" data-child-id="<%= child.id %>" data-child-name="<%= child.name %>" role="button" tabindex="0"><%= child.name %></a></strong></td>
                  <td><span class="status-badge <%= childStatusClass %>"><%= childStatusLabel %></span></td>
                  <td><%= child.attention_marked ? ((childStart || '即日起') + ' ~ ' + (childEnd || '长期')) : '-' %></td>
                  <td>
                    <% if (childTags.length) { %>
                      <div class="tag-list compact-tag-list">
                        <% childTags.forEach(function(tag) { %><span class="tag-pill"><%= tag %></span><% }) %>
                      </div>
                    <% } else { %>
                      <span class="muted">-</span>
                    <% } %>
                  </td>
                  <td style="max-width:240px;white-space:normal;"><%= child.attention_reason || '-' %></td>
                </tr>
              <% }) %>
              <% if (!filteredAttentionChildren.length) { %>
                <tr><td colspan="7"><div class="empty-state">当前筛选条件下没有幼儿记录。</div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% if (attentionPaginationData.totalPages > 1) { %>
          <% const attentionWindowStart = Math.max(1, attentionPaginationData.currentPage - 2); %>
          <% const attentionWindowEnd = Math.min(attentionPaginationData.totalPages, attentionPaginationData.currentPage + 2); %>
          <div class="pagination-bar">
            <% if (attentionPaginationData.hasPrev) { %><a class="pagination-link pagination-nav" href="/admin?<%= attentionPageQueryBase %>&attentionPage=<%= attentionPaginationData.prevPage %>">上一页</a><% } %>
            <% if (attentionWindowStart > 1) { %>
              <a class="pagination-link <%= attentionPaginationData.currentPage === 1 ? 'active' : '' %>" href="/admin?<%= attentionPageQueryBase %>&attentionPage=1">1</a>
              <% if (attentionWindowStart > 2) { %><span class="pagination-ellipsis">…</span><% } %>
            <% } %>
            <% for (let pageNo = attentionWindowStart; pageNo <= attentionWindowEnd; pageNo++) { %>
              <a class="pagination-link <%= attentionPaginationData.currentPage === pageNo ? 'active' : '' %>" href="/admin?<%= attentionPageQueryBase %>&attentionPage=<%= pageNo %>"><%= pageNo %></a>
            <% } %>
            <% if (attentionWindowEnd < attentionPaginationData.totalPages) { %>
              <% if (attentionWindowEnd < attentionPaginationData.totalPages - 1) { %><span class="pagination-ellipsis">…</span><% } %>
              <a class="pagination-link <%= attentionPaginationData.currentPage === attentionPaginationData.totalPages ? 'active' : '' %>" href="/admin?<%= attentionPageQueryBase %>&attentionPage=<%= attentionPaginationData.totalPages %>"><%= attentionPaginationData.totalPages %></a>
            <% } %>
            <% if (attentionPaginationData.hasNext) { %><a class="pagination-link pagination-nav" href="/admin?<%= attentionPageQueryBase %>&attentionPage=<%= attentionPaginationData.nextPage %>">下一页</a><% } %>
          </div>
        <% } %>
      </div>
      </div>
      </div>
    </section>
  </div>
</div>

<% } else if (activePanel === 'roles') { %>
    <section id="roles-panel" class="admin-panel is-active">
      <div class="panel-heading"><div><div class="eyebrow">角色权限管理</div><h2>角色与权限配置</h2><p>管理系统角色、分配权限、复制已有角色快速创建新角色。系统内置角色不可删除。</p></div></div>

      <div class="management-layout">
        <div class="management-side">
          <!-- 新建角色 -->
          <div class="card">
            <div class="section-head"><h3>新建角色</h3></div>
            <form method="post" action="/admin/roles/add" class="form-grid">
              <label><span>角色标识（英文小写）</span><input type="text" name="name" placeholder="如 health_teacher" required pattern="[a-z0-9_-]+" /></label>
              <label><span>显示名称</span><input type="text" name="displayName" placeholder="如 保健老师" required /></label>
              <label><span>基于已有角色</span>
                <select id="roleTemplate" onchange="applyRoleTemplate(this.value)">
                  <option value="">— 从零开始 —</option>
                  <% (roles || []).forEach(function(r) { var rp = typeof r.permissions === 'string' ? r.permissions : JSON.stringify(r.permissions || []); %><option value="<%= r.id %>" data-perms="<%= rp.replace(/\"/g, '&quot;') %>" data-readonly="<%= r.is_readonly ? '1' : '' %>"><%= r.display_name %></option><% }); %>
                </select>
              </label>
              <label style="display:flex;align-items:center;gap:8px;">
                <input type="checkbox" name="isReadonly" value="1" id="newRoleReadonly" />
                <span>只读模式（禁止所有写操作）</span>
              </label>
              <details class="perm-accordion">
                <summary class="perm-accordion-toggle">展开权限配置 <span class="perm-accordion-count" id="newRolePermCount">已选 0 项</span></summary>
                <div class="perm-accordion-body">
                  <% (allPermissions || []).forEach(function(group) { %>
                    <div class="perm-group">
                      <div class="perm-group-header"><%= group.group %></div>
                      <% group.items.forEach(function(mod) { %>
                        <div class="perm-module">
                          <div class="perm-module-name"><%= mod.label %></div>
                          <div class="perm-module-actions">
                            <label class="perm-chip"><input type="checkbox" name="permissions" value="<%= mod.key %>" class="perm-all" data-module="<%= mod.key %>" /><span>全部</span></label>
                            <% if (mod.actions) { mod.actions.forEach(function(act) { %>
                              <label class="perm-chip"><input type="checkbox" name="permissions" value="<%= act.key %>" class="perm-action" data-parent="<%= mod.key %>" /><span><%= act.label %></span></label>
                            <% }); } %>
                          </div>
                        </div>
                      <% }); %>
                    </div>
                  <% }); %>
                </div>
              </details>
              <button class="btn primary full" type="submit">创建角色</button>
            </form>
          </div>
        </div>

        <div class="management-main">
          <!-- 现有角色列表 -->
          <div class="card full-height-card">
            <div class="section-head"><h3>现有角色</h3><div class="muted no-margin">共 <%= (roles || []).length %> 个角色</div></div>
            <%
              var allRolesList = roles || [];
              function buildPermItems(role) {
                var perms = typeof role.permissions === 'string' ? JSON.parse(role.permissions) : (role.permissions || []);
                var items = [];
                (allPermissions || []).forEach(function(group) {
                  (group.items || []).forEach(function(mod) {
                    if (perms.indexOf(mod.key) >= 0) { items.push(mod.label); }
                    else if (mod.actions) {
                      var acts = mod.actions.filter(function(a) { return perms.indexOf(a.key) >= 0; }).map(function(a) { return a.label; });
                      if (acts.length) items.push(mod.label + '·' + acts.join('/'));
                    }
                  });
                });
                role._permItems = items;
                role._perms = perms;
              }
              allRolesList.forEach(buildPermItems);
            %>
            <div class="role-card-grid">
              <% allRolesList.forEach(function(role) { var permItems = role._permItems; var perms = role._perms; %>
                <div class="role-card">
                  <div class="role-card-header">
                    <div>
                      <div class="role-card-name"><%= role.display_name %></div>
                      <div class="role-card-id"><%= role.name %></div>
                    </div>
                    <div style="display:flex;gap:6px;align-items:center;">
                      <span class="status-badge <%= role.is_readonly ? 'off' : 'ok' %>"><%= role.is_readonly ? '只读' : '可写' %></span>
                      <span class="tag-pill" style="font-size:11px;"><%= role.is_system ? '内置' : '自定义' %></span>
                    </div>
                  </div>
                  <div class="role-card-perms">
                    <% if (permItems.length) { permItems.forEach(function(l) { %><span class="perm-tag"><%= l %></span><% }); } else { %><span class="muted">无权限</span><% } %>
                  </div>
                  <div class="role-card-meta">
                    <span>使用中：<strong><%= role.user_count || 0 %></strong> 人</span>
                  </div>
                  <div class="role-card-actions">
                    <% if (role.name !== 'admin') { %>
                      <details class="inline-editor-card">
                        <summary class="btn small primary">编辑</summary>
                        <form method="post" action="/admin/roles/<%= role.id %>/edit" class="form-grid compact-inline-form inline-edit-panel" style="margin-top:12px;">
                          <label><span>显示名称</span><input type="text" name="displayName" value="<%= role.display_name %>" required /></label>
                          <details class="perm-accordion">
                            <summary class="perm-accordion-toggle">展开权限配置 <span class="perm-accordion-count">已选 <%= perms.length %> 项</span></summary>
                            <div class="perm-accordion-body">
                              <% (allPermissions || []).forEach(function(group) { %>
                                <div class="perm-group">
                                  <div class="perm-group-header"><%= group.group %></div>
                                  <% group.items.forEach(function(mod) { %>
                                    <div class="perm-module">
                                      <div class="perm-module-name small"><%= mod.label %></div>
                                      <div class="perm-module-actions">
                                        <label class="perm-chip"><input type="checkbox" name="permissions" value="<%= mod.key %>" class="perm-all" data-module="<%= mod.key %>" <%= perms.indexOf(mod.key) >= 0 ? 'checked' : '' %> /><span>全部</span></label>
                                        <% if (mod.actions) { mod.actions.forEach(function(act) { %>
                                          <label class="perm-chip"><input type="checkbox" name="permissions" value="<%= act.key %>" class="perm-action" data-parent="<%= mod.key %>" <%= perms.indexOf(act.key) >= 0 ? 'checked' : '' %> /><span><%= act.label %></span></label>
                                        <% }); } %>
                                      </div>
                                    </div>
                                  <% }); %>
                                </div>
                              <% }); %>
                            </div>
                          </details>
                          <label style="display:flex;align-items:center;gap:6px;"><input type="checkbox" name="isReadonly" value="1" <%= role.is_readonly ? 'checked' : '' %> /><span>只读</span></label>
                          <div class="tool-row"><button class="btn small primary" type="submit">保存</button></div>
                        </form>
                      </details>
                    <% } %>
                    <details class="inline-editor-card">
                      <summary class="btn small">复制</summary>
                      <form method="post" action="/admin/roles/<%= role.id %>/clone" class="form-grid compact-inline-form inline-edit-panel" style="margin-top:12px;">
                        <label><span>新角色标识</span><input type="text" name="name" placeholder="如 deputy_principal" required pattern="[a-z0-9_-]+" /></label>
                        <label><span>新显示名称</span><input type="text" name="displayName" placeholder="如 副园长" required /></label>
                        <div class="tool-row"><button class="btn small primary" type="submit">复制创建</button></div>
                      </form>
                    </details>
                    <% if (role.name !== 'admin') { %>
                      <form method="post" action="/admin/roles/<%= role.id %>/delete" style="display:inline;" onsubmit="return confirm('<%= (role.user_count || 0) > 0 ? ('该角色下仍有 ' + role.user_count + ' 个账号，请先迁移后再删除') : ('确认删除角色 ' + role.display_name + '？') %>')">
                        <button class="btn small" type="submit" style="color:#ff3b30;" <%= (role.user_count || 0) > 0 ? 'disabled title="请先迁移该角色下账号"' : '' %>>删除</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </section>
<% } %>

</div>
</div>

<script>
(function () {
  window.bindAdminAttentionPanel = function () {
    const rows = Array.from(document.querySelectorAll('.attention-row'));
    const form = document.getElementById('attentionEditorForm');
    if (!form || !rows.length) return;

    const quickTags = ['咳嗽', '感冒恢复期', '扭伤擦伤', '情绪波动', '减少跑跳', '避免对抗', '观察体力', '补水提醒'];
    const childIdInput = document.getElementById('attentionEditorChildId');
    const clearChildIdInput = document.getElementById('attentionClearChildId');
    const nameNode = document.getElementById('attentionEditorName');
    const metaNode = document.getElementById('attentionEditorMeta');
    const classChip = document.getElementById('attentionEditorClassChip');
    const genderChip = document.getElementById('attentionEditorGenderChip');
    const statusBadge = document.getElementById('attentionEditorStatusBadge');
    const needsAttentionField = document.getElementById('attentionEditorNeedsAttention');
    const startDateField = document.getElementById('attentionEditorStartDate');
    const endDateField = document.getElementById('attentionEditorEndDate');
    const vestField = document.getElementById('attentionEditorVestType');
    const reasonField = document.getElementById('attentionEditorReason');
    const tagsExtraField = document.getElementById('attentionEditorTagsExtra');
    const clearButton = document.getElementById('attentionClearButton');
    const tagPicker = document.getElementById('attentionTagPicker');
    const tagPillsBox = document.getElementById('attentionTagPills');
    const tagHiddenBox = document.getElementById('attentionTagHiddenInputs');
    var selectedTags = [];
    function renderTagPills() {
      tagPillsBox.innerHTML = selectedTags.map(function(t) {
        return '<span class="attn-pill">' + t + ' <span class="attn-pill-x" data-tag="' + t + '">&times;</span></span>';
      }).join('');
      tagHiddenBox.innerHTML = selectedTags.map(function(t) {
        return '<input type="hidden" name="attentionTags" value="' + t + '">';
      }).join('');
      // reset picker
      if (tagPicker) tagPicker.value = '';
    }
    if (tagPicker) tagPicker.addEventListener('change', function() {
      var v = this.value; if (!v || selectedTags.indexOf(v) !== -1) return;
      selectedTags.push(v); renderTagPills();
    });
    if (tagPillsBox) tagPillsBox.addEventListener('click', function(e) {
      var x = e.target.closest('.attn-pill-x'); if (!x) return;
      selectedTags = selectedTags.filter(function(t) { return t !== x.dataset.tag; }); renderTagPills();
    });
    // init from the selected table row so the panel can be safely extracted into a partial
    var initialRow = rows.find(function (row) {
      var radio = row.querySelector('.attention-row-radio');
      return row.classList.contains('is-selected') || (radio && radio.checked);
    }) || rows[0];
    selectedTags = initialRow ? parseTags(initialRow.dataset.attentionTags || '') : [];
    renderTagPills();

    function statusText(status) {
      if (status === 'active') return '生效中';
      if (status === 'scheduled') return '未开始';
      if (status === 'expired') return '已过期';
      return '正常';
    }

    function statusClass(status) {
      if (status === 'active') return 'warn';
      if (status === 'normal') return 'ok';
      return 'info';
    }

    function parseTags(value) {
      return String(value || '')
        .split(',')
        .map(function (item) { return item.trim(); })
        .filter(Boolean);
    }

    function applyRow(row) {
      rows.forEach(function (item) {
        item.classList.toggle('is-selected', item === row);
        const radio = item.querySelector('.attention-row-radio');
        if (radio) radio.checked = item === row;
      });

      const childId = row.dataset.childId || '';
      const className = row.dataset.className || '未分班';
      const gender = row.dataset.gender || '';
      const status = row.dataset.attentionStatus || 'normal';
      const tags = parseTags(row.dataset.attentionTags);

      if (childIdInput) childIdInput.value = childId;
      if (clearChildIdInput) clearChildIdInput.value = childId;
      if (nameNode) nameNode.textContent = row.dataset.name || '';
      if (metaNode) metaNode.textContent = [className, gender].filter(Boolean).join(' · ') || '未分班';
      if (classChip) classChip.textContent = className;
      if (genderChip) {
        genderChip.textContent = gender;
        genderChip.style.display = gender ? '' : 'none';
      }
      if (statusBadge) {
        statusBadge.textContent = statusText(status);
        statusBadge.className = 'status-badge ' + statusClass(status);
      }
      if (needsAttentionField) needsAttentionField.value = row.dataset.needsAttention === '1' ? '1' : '0';
      if (startDateField) startDateField.value = row.dataset.attentionStartDate || '';
      if (endDateField) endDateField.value = row.dataset.attentionEndDate || '';
      if (vestField) vestField.value = row.dataset.attentionVestType === 'red' ? 'red' : (row.dataset.attentionVestType === 'green' ? 'green' : 'yellow');
      if (reasonField) reasonField.value = row.dataset.attentionReason || '';
      if (tagsExtraField) tagsExtraField.value = tags.filter(function (tag) { return !quickTags.includes(tag); }).join(',');
      selectedTags = tags.slice(); renderTagPills();
      if (clearButton) clearButton.disabled = row.dataset.needsAttention !== '1';
    }

    rows.forEach(function (row) {
      if (row.dataset.ajaxAttentionBound === '1') return;
      row.dataset.ajaxAttentionBound = '1';
      row.addEventListener('click', function (event) {
        if (event.target.closest('input, button, a, textarea, select')) return;
        applyRow(row);
      });
      row.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          applyRow(row);
        }
      });
      const radio = row.querySelector('.attention-row-radio');
      if (radio) {
        radio.addEventListener('change', function () {
          applyRow(row);
        });
      }
    });
  };

  if (window.bindAdminAttentionPanel) window.bindAdminAttentionPanel();
})();
</script>


<script>
(function () {
  function replacePanelFromHtml(html, panelName) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const incoming = doc.querySelector('[data-ajax-panel="' + panelName + '"]');
    const current = document.querySelector('[data-ajax-panel="' + panelName + '"]');
    if (incoming && current) current.outerHTML = incoming.outerHTML;
  }
  async function loadIntoPanel(url, panelName, push) {
    const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' }, credentials: 'same-origin' });
    if (!res.ok) { window.location.href = url; return; }
    const html = await res.text();
    replacePanelFromHtml(html, panelName);
    if (push) window.history.pushState({ panelName: panelName, url: url }, '', url);
    bindAjaxPagination();
    if (window.bindAdminAttentionPanel) window.bindAdminAttentionPanel();
  }
  function bindAjaxPagination() {
    document.querySelectorAll('[data-ajax-panel] .pagination-link').forEach(function (link) {
      if (link.dataset.ajaxBound === '1') return;
      link.dataset.ajaxBound = '1';
      link.addEventListener('click', function (event) {
        const panel = event.currentTarget.closest('[data-ajax-panel]');
        if (!panel) return;
        event.preventDefault();
        const panelName = panel.getAttribute('data-ajax-panel');
        loadIntoPanel(event.currentTarget.href, panelName, true).catch(function () { window.location.href = event.currentTarget.href; });
      });
    });
  }
  window.addEventListener('popstate', function () {
    const active = document.querySelector('[data-ajax-panel].is-active');
    if (!active) return;
    const panelName = active.getAttribute('data-ajax-panel');
    loadIntoPanel(window.location.href, panelName, false).catch(function () { window.location.reload(); });
  });
  bindAjaxPagination();
})();

  window.applyRoleTemplate = function(roleId) {
    var form = document.querySelector('form[action="/admin/roles/add"]');
    if (!form) return;
    var allBoxes = form.querySelectorAll('input[name="permissions"]');
    var readonlyBox = document.getElementById('newRoleReadonly');
    if (!roleId) {
      allBoxes.forEach(function(cb) { cb.checked = false; });
      if (readonlyBox) readonlyBox.checked = false;
      return;
    }
    var opt = document.querySelector('#roleTemplate option[value="' + roleId + '"]');
    if (!opt) return;
    try { var perms = JSON.parse(opt.dataset.perms || '[]'); } catch(e) { return; }
    allBoxes.forEach(function(cb) { cb.checked = perms.indexOf(cb.value) >= 0; });
    if (readonlyBox) readonlyBox.checked = opt.dataset.readonly === '1';
  };
  document.addEventListener('change', function(e) {
    var cb = e.target;
    if (!cb.classList || (!cb.classList.contains('perm-all') && !cb.classList.contains('perm-action'))) return;
    var form = cb.closest('form');
    if (!form) return;
    if (cb.classList.contains('perm-all')) {
      var mod = cb.dataset.module;
      form.querySelectorAll('.perm-action[data-parent="' + mod + '"]').forEach(function(s) { s.checked = cb.checked; });
    }
    if (cb.classList.contains('perm-action')) {
      var parent = cb.dataset.parent;
      var allCb = form.querySelector('.perm-all[data-module="' + parent + '"]');
      var subs = form.querySelectorAll('.perm-action[data-parent="' + parent + '"]');
      if (allCb) allCb.checked = Array.from(subs).every(function(s) { return s.checked; });
    }
  });

  // Permission count updater
  function updatePermCount() {
    document.querySelectorAll('.perm-accordion').forEach(function(acc) {
      var count = acc.querySelectorAll('input[name="permissions"]:checked').length;
      var span = acc.querySelector('.perm-accordion-count');
      if (span) span.textContent = '已选 ' + count + ' 项';
    });
  }
  document.addEventListener('change', function(e) {
    if (e.target.name === 'permissions') updatePermCount();
  });
  updatePermCount();
</script>

<script>
(function () {
  function enhanceClassTeacherForm(form) {
    if (!form || form.dataset.teacherSlotsEnhanced === '1') return;
    var teacherSelects = form.querySelectorAll('select[name="teacherIds"]');
    if (!teacherSelects.length) return;

    var primarySelect = teacherSelects[0];
    var primaryLabel = primarySelect.closest('label');
    if (!primaryLabel) return;

    var teacherIds = String(form.dataset.teacherIds || '')
      .split(',')
      .map(function (item) { return item.trim(); })
      .filter(Boolean)
      .slice(0, 3);

    form.dataset.teacherSlotsEnhanced = '1';
    primarySelect.value = teacherIds[0] || primarySelect.value || '';

    var primaryTitle = primaryLabel.querySelector('span');
    if (primaryTitle) primaryTitle.textContent = '主班老师';

    var secondaryLabel = primaryLabel.cloneNode(true);
    var secondaryTitle = secondaryLabel.querySelector('span');
    var secondarySelect = secondaryLabel.querySelector('select[name="teacherIds"]');
    if (!secondarySelect) return;

    if (secondaryTitle) secondaryTitle.textContent = '副班老师（可选）';
    if (secondarySelect.options.length) {
      secondarySelect.options[0].textContent = '暂不设置副班老师';
    }
    secondarySelect.value = teacherIds[1] || '';
    primaryLabel.insertAdjacentElement('afterend', secondaryLabel);
  }

  enhanceClassTeacherForm(document.querySelector('form[action="/admin/classes/add"]'));
  document.querySelectorAll('form[action^="/admin/classes/"][action$="/edit"]').forEach(enhanceClassTeacherForm);
})();
</script>

<script>
(function () {
  function normalizeClassTeacherSlots(form) {
    if (!form || form.dataset.teacherSlotsNormalized === '1') return;
    var labels = Array.from(form.querySelectorAll('select[name="teacherIds"]'))
      .map(function (select) { return select.closest('label'); })
      .filter(Boolean);
    if (!labels.length) return;

    form.dataset.teacherSlotsNormalized = '1';

    function applySlotText(label, index) {
      if (!label) return;
      var title = label.querySelector('span');
      var select = label.querySelector('select[name="teacherIds"]');
      if (title) title.textContent = index === 0 ? '班主任1' : ('班主任' + (index + 1) + '（可选）');
      if (select && select.options.length) {
        select.options[0].textContent = index === 0 ? '请选择班主任1' : ('暂不设置班主任' + (index + 1));
      }
    }

    labels.forEach(function (label, index) {
      applySlotText(label, index);
    });

    var teacherIds = String(form.dataset.teacherIds || '')
      .split(',')
      .map(function (item) { return item.trim(); })
      .filter(Boolean)
      .slice(0, 3);

    while (labels.length < 3) {
      var baseLabel = labels[0];
      if (!baseLabel) break;
      var extraLabel = baseLabel.cloneNode(true);
      var extraSelect = extraLabel.querySelector('select[name="teacherIds"]');
      if (!extraSelect) break;
      extraSelect.value = '';
      labels[labels.length - 1].insertAdjacentElement('afterend', extraLabel);
      labels.push(extraLabel);
    }

    labels.slice(0, 3).forEach(function (label, index) {
      applySlotText(label, index);
      var select = label.querySelector('select[name="teacherIds"]');
      if (select) select.value = teacherIds[index] || select.value || '';
    });
  }

  normalizeClassTeacherSlots(document.querySelector('form[action="/admin/classes/add"]'));
  document.querySelectorAll('form[action^="/admin/classes/"][action$="/edit"]').forEach(normalizeClassTeacherSlots);
})();

(function() {
  function svgLine(points, color, width, dash) {
    return '<polyline points="' + points.map(function(p) { return p.x.toFixed(1) + ',' + p.y.toFixed(1); }).join(' ') + '" fill="none" stroke="' + color + '" stroke-width="' + (width || 2) + '" stroke-linejoin="round"' + (dash ? ' stroke-dasharray="' + dash + '"' : '') + '/>';
  }
  function svgDot(cx, cy, r, color) {
    return '<circle cx="' + cx.toFixed(1) + '" cy="' + cy.toFixed(1) + '" r="' + (r || 3.5) + '" fill="' + color + '"/>';
  }
  function renderGrowthChart(records) {
    var W = 500, H = 280, padL = 50, padR = 30, padT = 20, padB = 35;
    var iW = W - padL - padR, iH = H - padT - padB;
    var heightVals = records.map(function(r) { return r.heightCm; }).filter(function(v) { return v != null; });
    var weightVals = records.map(function(r) { return r.weightKg; }).filter(function(v) { return v != null; });
    var bmiVals = records.map(function(r) { return r.bmi; }).filter(function(v) { return v != null; });
    var hMin = Math.min.apply(null, heightVals.length ? heightVals : [0]) || 0;
    var hMax = Math.max.apply(null, heightVals.length ? heightVals : [0]) || 100;
    var hRange = hMax - hMin || 20;
    hMin -= hRange * 0.15; hMax += hRange * 0.15; hRange = hMax - hMin;
    var allW = weightVals.concat(bmiVals);
    var wMin = Math.min.apply(null, allW.length ? allW : [0]) || 0;
    var wMax = Math.max.apply(null, allW.length ? allW : [0]) || 30;
    var wRange = wMax - wMin || 10;
    wMin -= wRange * 0.15; wMax += wRange * 0.15; wRange = wMax - wMin;
    var parts = [];
    parts.push('<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="\u751f\u957f\u66f2\u7ebf">');
    for (var i = 0; i <= 4; i++) {
      var gy = padT + iH * i / 4;
      parts.push('<line x1="' + padL + '" y1="' + gy.toFixed(1) + '" x2="' + (padL + iW) + '" y2="' + gy.toFixed(1) + '" stroke="#e2e8f0" stroke-width="1"/>');
    }
    for (var i = 0; i <= 4; i++) {
      var valH = hMax - (hMax - hMin) * i / 4;
      var ly = padT + iH * i / 4;
      parts.push('<text x="' + (padL - 6) + '" y="' + (ly + 4).toFixed(1) + '" fill="#f97316" font-size="10" text-anchor="end">' + valH.toFixed(0) + '</text>');
    }
    for (var i = 0; i <= 4; i++) {
      var valW = wMax - (wMax - wMin) * i / 4;
      var ry = padT + iH * i / 4;
      parts.push('<text x="' + (padL + iW + 6) + '" y="' + (ry + 4).toFixed(1) + '" fill="#8b5cf6" font-size="10" text-anchor="start">' + valW.toFixed(1) + '</text>');
    }
    records.forEach(function(r, idx) {
      var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
      var label = r.testDate ? r.testDate.slice(5) : '';
      parts.push('<text x="' + x + '" y="' + (H - 6) + '" fill="#94a3b8" font-size="10" text-anchor="middle">' + label + '</text>');
    });
    var makeLine = function(records, valueKey, color, width, dash, useWMin) {
      var points = [];
      var rng = useWMin ? wRange : hRange;
      var vmin = useWMin ? wMin : hMin;
      records.forEach(function(r, idx) {
        var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
        var val = r[valueKey];
        if (val != null) points.push({ x: x, y: padT + iH - (val - vmin) / rng * iH });
      });
      if (!points.length) return;
      parts.push(svgLine(points, color, width, dash));
      points.forEach(function(p) { parts.push(svgDot(p.x, p.y, width > 2 ? 4 : 3, color)); });
    };
    makeLine(records, 'heightCm', '#f97316', 2.5, null, false);
    makeLine(records, 'weightKg', '#8b5cf6', 2.5, null, true);
    makeLine(records, 'bmi', '#ec4899', 2, '5,3', true);
    parts.push('</svg>');
    return '<div class="compare-growth-legend"><span class="compare-legend-item"><span class="compare-legend-dot" style="background:#f97316;"></span>\u8eab\u9ad8(cm)</span><span class="compare-legend-item"><span class="compare-legend-dot" style="background:#8b5cf6;"></span>\u4f53\u91cd(kg)</span><span class="compare-legend-item"><span class="compare-legend-dot" style="background:#ec4899;"></span>BMI</span></div>' + parts.join('\\n');
  }
  function renderFitnessChart(records) {
    var W = 500, H = 280, padL = 45, padR = 20, padT = 20, padB = 35;
    var iW = W - padL - padR, iH = H - padT - padB;
    var metrics = [
      { key: 'gripScore', label: '\u63e1\u529b', color: '#ef4444' },
      { key: 'jumpScore', label: '\u8df3\u8fdc', color: '#f97316' },
      { key: 'sitScore', label: '\u4f53\u524d\u5c48', color: '#eab308' },
      { key: 'djumpScore', label: '\u53cc\u811a\u8df3', color: '#22c55e' },
      { key: 'obstacleScore', label: '\u969c\u788c\u8dd1', color: '#06b6d4' },
      { key: 'balanceScore', label: '\u5e73\u8861\u6728', color: '#8b5cf6' }
    ];
    var allVals = [];
    metrics.forEach(function(m) { records.forEach(function(r) { if (r[m.key] != null) allVals.push(r[m.key]); }); });
    var yMin = allVals.length ? Math.min(0, Math.min.apply(null, allVals)) : 0;
    var yMax = allVals.length ? Math.max(100, Math.max.apply(null, allVals)) : 100;
    var yRange = yMax - yMin || 100;
    var parts = [];
    parts.push('<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="\u4f53\u6d4b\u5f97\u5206\u8d8b\u52bf">');
    for (var i = 0; i <= 4; i++) {
      var gy = padT + iH * i / 4;
      parts.push('<line x1="' + padL + '" y1="' + gy.toFixed(1) + '" x2="' + (padL + iW) + '" y2="' + gy.toFixed(1) + '" stroke="#e2e8f0" stroke-width="1"/>');
      var yval = yMax - (yMax - yMin) * i / 4;
      parts.push('<text x="' + (padL - 6) + '" y="' + (gy + 4).toFixed(1) + '" fill="#94a3b8" font-size="10" text-anchor="end">' + yval.toFixed(0) + '</text>');
    }
    if (yMin <= 60 && yMax >= 60) {
      var ref60y = padT + iH - (60 - yMin) / yRange * iH;
      parts.push('<line x1="' + padL + '" y1="' + ref60y.toFixed(1) + '" x2="' + (padL + iW) + '" y2="' + ref60y.toFixed(1) + '" stroke="#fca5a5" stroke-width="1" stroke-dasharray="4,4"/>');
    }
    records.forEach(function(r, idx) {
      var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
      parts.push('<text x="' + x + '" y="' + (H - 6) + '" fill="#94a3b8" font-size="10" text-anchor="middle">' + (r.testDate ? r.testDate.slice(5) : '') + '</text>');
    });
    metrics.forEach(function(m) {
      var points = [];
      records.forEach(function(r, idx) {
        var x = padL + (records.length <= 1 ? iW / 2 : iW * idx / Math.max(1, records.length - 1));
        if (r[m.key] != null) points.push({ x: x, y: padT + iH - (r[m.key] - yMin) / yRange * iH });
      });
      if (points.length >= 1) {
        parts.push(svgLine(points, m.color, 2));
        points.forEach(function(p) { parts.push(svgDot(p.x, p.y, 3, m.color)); });
      }
    });
    parts.push('</svg>');
    var legend = '<div class="compare-fitness-legend">';
    metrics.forEach(function(m) { legend += '<span class="compare-legend-item"><span class="compare-legend-dot" style="background:' + m.color + ';"></span>' + m.label + '</span>'; });
    legend += '</div>';
    return legend + parts.join('\\n');
  }
  function renderRatingTimeline(records) {
    var classMap = { '\u4f18\u79c0': 'rating-excellent', '\u826f\u597d': 'rating-good', '\u5408\u683c': 'rating-pass', '\u4e0d\u5408\u683c': 'rating-fail' };
    var parts = ['<span class="timeline-label">\u5386\u53f2\u8bc4\u7ea7\uff1a</span>'];
    records.forEach(function(r, idx) {
      if (idx > 0) parts.push('<span class="compare-rating-arrow">&rarr;</span>');
      var label = (r.testDate || '').slice(0, 10) + ' ' + (r.rating || '-');
      var cls = classMap[r.rating] || '';
      parts.push('<span class="compare-rating-pill ' + cls + '">' + label + '</span>');
    });
    return '<div class="compare-rating-timeline">' + parts.join('') + '</div>';
  }
  function renderDataTable(records) {
    var cols = [
      { key: 'testDate', label: '\u6d4b\u8bd5\u65e5\u671f', fmt: function(v) { return v ? v.slice(0,10) : '-'; } },
      { key: 'heightCm', label: '\u8eab\u9ad8' }, { key: 'weightKg', label: '\u4f53\u91cd' }, { key: 'bmi', label: 'BMI' },
      { key: 'gripScore', label: '\u63e1\u529b\u5206' }, { key: 'jumpScore', label: '\u8df3\u8fdc\u5206' },
      { key: 'sitScore', label: '\u4f53\u524d\u5c48\u5206' }, { key: 'djumpScore', label: '\u53cc\u811a\u8df3\u5206' },
      { key: 'obstacleScore', label: '\u969c\u788c\u8dd1\u5206' }, { key: 'balanceScore', label: '\u5e73\u8861\u6728\u5206' },
      { key: 'totalScore', label: '\u7efc\u5408\u5f97\u5206' }, { key: 'rating', label: '\u8bc4\u7ea7' }
    ];
    var th = cols.map(function(c) { return '<th>' + c.label + '</th>'; }).join('');
    var rows = records.map(function(r) {
      var tds = cols.map(function(c) {
        var val = r[c.key]; if (c.fmt) val = c.fmt(val);
        return '<td>' + (val != null ? val : '-') + '</td>';
      }).join('');
      return '<tr>' + tds + '</tr>';
    }).join('');
    return '<div class="compare-data-table-wrap"><table class="compare-data-table"><thead><tr>' + th + '</tr></thead><tbody>' + rows + '</tbody></table></div>';
  }
  var comparePanelLoading = false;
  window.openChildComparePanel = function(el, childId, childName, noFetch) {
    if (comparePanelLoading) return;
    var overlay = document.getElementById('childCompareOverlay');
    var titleEl = document.getElementById('compareChildTitle');
    var metaEl = document.getElementById('compareChildMeta');
    var body = document.getElementById('comparePanelBody');
    if (noFetch) return;
    titleEl.textContent = childName + ' \u00b7 \u7eb5\u5411\u5bf9\u6bd4';
    metaEl.textContent = '\u52a0\u8f7d\u4e2d...';
    body.innerHTML = '<div class="compare-panel-loading">\u52a0\u8f7d\u4e2d...</div>';
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    comparePanelLoading = true;
    fetch('/admin/fitness/compare/' + childId)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (!data.ok) { body.innerHTML = '<div class="compare-panel-loading" style="color:#ef4444;">' + (data.message || '\u83b7\u53d6\u6570\u636e\u5931\u8d25') + '</div>'; comparePanelLoading = false; return; }
        var child = data.child || {};
        var records = data.records || [];
        metaEl.textContent = (child.gender || '?') + ' \u00b7 ' + (child.birthDate || '?') + ' \u51fa\u751f \u00b7 \u5171 ' + records.length + ' \u6b21\u4f53\u6d4b';
        if (records.length === 0) { body.innerHTML = '<div class="compare-panel-loading">\u8be5\u5e7c\u513f\u6682\u65e0\u4f53\u6d4b\u8bb0\u5f55</div>'; comparePanelLoading = false; return; }
        var growthSection = '<div class="compare-chart-card"><h4>\u8eab\u9ad8 / \u4f53\u91cd / BMI \u8d8b\u52bf</h4>' + renderGrowthChart(records) + '</div>';
        var fitnessSection = '<div class="compare-chart-card"><h4>\u4f53\u6d4b\u5f97\u5206\u8d8b\u52bf</h4>' + renderFitnessChart(records) + '</div>';
        var chartsRow = '<div class="compare-charts-row">' + growthSection + fitnessSection + '</div>';
        body.innerHTML = chartsRow + renderRatingTimeline(records) + '<h4 style="margin:0 0 10px;color:#334155;">\u5386\u53f2\u8bb0\u5f55\u660e\u7ec6</h4>' + renderDataTable(records);
        comparePanelLoading = false;
      })
      .catch(function(err) { body.innerHTML = '<div class="compare-panel-loading" style="color:#ef4444;">\u52a0\u8f7d\u5f02\u5e38\uff1a' + err.message + '</div>'; comparePanelLoading = false; });
  };
  window.closeChildComparePanel = function() {
    var overlay = document.getElementById('childCompareOverlay');
    if (overlay) overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  };
  document.addEventListener('click', function(e) {
    var link = e.target.closest('.child-compare-link');
    if (!link) return;
    e.preventDefault();
    var childId = link.getAttribute('data-child-id');
    var childName = link.getAttribute('data-child-name') || '\u5e7c\u513f';
    if (!childId) return;
    openChildComparePanel(link, Number(childId), childName);
  });
  document.addEventListener('keydown', function(e) {
    var overlay = document.getElementById('childCompareOverlay');
    if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) {
      closeChildComparePanel();
    }
  });
})();

</script>


