<script>
// 班级表格实时搜索与年级/状态筛选
var currentClassPage = 1;
var classPageSize = 10;
var matchingClassRows = [];

function changeClassPageSize(val) {
  if (val === 'all') {
    classPageSize = 9999;
  } else {
    classPageSize = parseInt(val, 10) || 10;
  }
  currentClassPage = 1;
  renderClassPagination();
}

function goToClassPage(page) {
  currentClassPage = page;
  renderClassPagination();
}

function filterClassesTable() {
  var searchInput = document.getElementById('classSearchInput');
  var gradeFilter = document.getElementById('classGradeFilter');
  var statusFilter = document.getElementById('classStatusFilter');
  var countBadge = document.getElementById('classFilteredCount');

  var query = (searchInput ? searchInput.value : '').trim().toLowerCase();
  var grade = gradeFilter ? gradeFilter.value : '';
  var status = statusFilter ? statusFilter.value : '';

  var allRows = Array.from(document.querySelectorAll('#classesDataTable tbody tr.class-data-row'));
  matchingClassRows = [];

  allRows.forEach(function(row) {
    var name = (row.getAttribute('data-name') || '').toLowerCase();
    var rowGrade = row.getAttribute('data-grade') || '';
    var teachers = (row.getAttribute('data-teachers') || '').toLowerCase();
    var rowEnabled = row.getAttribute('data-enabled') || '';

    var matchQuery = !query || name.indexOf(query) !== -1 || teachers.indexOf(query) !== -1;
    var matchGrade = !grade || rowGrade === grade;
    var matchStatus = !status || rowEnabled === status;

    if (matchQuery && matchGrade && matchStatus) {
      matchingClassRows.push(row);
    } else {
      row.style.display = 'none';
    }
  });

  if (countBadge) {
    countBadge.textContent = '共 ' + matchingClassRows.length + ' 个班级';
  }

  currentClassPage = 1;
  renderClassPagination();
}

function renderClassPagination() {
  var total = matchingClassRows.length;
  var totalPages = Math.max(1, Math.ceil(total / classPageSize));
  if (currentClassPage > totalPages) currentClassPage = totalPages;
  if (currentClassPage < 1) currentClassPage = 1;

  var startIndex = (currentClassPage - 1) * classPageSize;
  var endIndex = startIndex + classPageSize;

  matchingClassRows.forEach(function(row, idx) {
    if (idx >= startIndex && idx < endIndex) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });

  // 更新左下角信息
  var infoEl = document.getElementById('classPaginationInfo');
  if (infoEl) {
    if (total === 0) {
      infoEl.textContent = '暂无符合条件的班级';
    } else {
      var displayEnd = Math.min(endIndex, total);
      infoEl.textContent = '显示第 ' + (startIndex + 1) + ' 至 ' + displayEnd + ' 项，共 ' + total + ' 个班级';
    }
  }

  // 渲染翻页按钮
  var controlsEl = document.getElementById('classPaginationControls');
  if (controlsEl) {
    if (totalPages <= 1) {
      controlsEl.innerHTML = '';
      return;
    }

    var html = '';
    // 上一页
    html += '<button type="button" class="btn small" style="padding:4px 10px;font-size:12px;border-radius:6px;" ' + (currentClassPage <= 1 ? 'disabled style="opacity:0.4;cursor:not-allowed;"' : 'onclick="goToClassPage(' + (currentClassPage - 1) + ')"') + '>上一页</button>';

    // 页码
    for (var p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= currentClassPage - 1 && p <= currentClassPage + 1)) {
        var isCurrent = (p === currentClassPage);
        html += '<button type="button" class="btn small ' + (isCurrent ? 'primary' : '') + '" style="min-width:30px;padding:4px 8px;font-size:12px;border-radius:6px;' + (isCurrent ? 'font-weight:bold;' : '') + '" onclick="goToClassPage(' + p + ')">' + p + '</button>';
      } else if (p === currentClassPage - 2 || p === currentClassPage + 2) {
        html += '<span style="color:#94a3b8;font-size:12px;padding:0 2px;">...</span>';
      }
    }

    // 下一页
    html += '<button type="button" class="btn small" style="padding:4px 10px;font-size:12px;border-radius:6px;" ' + (currentClassPage >= totalPages ? 'disabled style="opacity:0.4;cursor:not-allowed;"' : 'onclick="goToClassPage(' + (currentClassPage + 1) + ')"') + '>下一页</button>';

    controlsEl.innerHTML = html;
  }
}

// 页面加载完成或初始化时执行初次分页
document.addEventListener('DOMContentLoaded', function() {
  if (document.getElementById('classesDataTable')) {
    filterClassesTable();
  }
});
if (document.getElementById('classesDataTable')) {
  filterClassesTable();
}

// 打开新增 / 编辑班级模态弹窗
function openClassModal(mode, triggerBtn) {
  var modal = document.getElementById('classActionModal');
  var form = document.getElementById('classActionForm');
  var title = document.getElementById('classModalTitle');
  var subtitle = document.getElementById('classModalSubtitle');
  var submitBtn = document.getElementById('classSubmitBtn');

  if (!modal || !form) return;

  var nameInput = document.getElementById('modalClassName');
  var gradeSelect = document.getElementById('modalGradeLevel');
  var capacityInput = document.getElementById('modalCapacity');
  var descInput = document.getElementById('modalDescription');
  var slot1 = document.getElementById('slotTeacher1');
  var slot2 = document.getElementById('slotTeacher2');
  var slot3 = document.getElementById('slotTeacher3');

  if (mode === 'add') {
    title.textContent = '新增班级';
    subtitle.textContent = '填写班级基本信息，并可同时指派带班班主任';
    submitBtn.textContent = '立即新增';
    form.action = '/admin/classes/add';

    nameInput.value = '';
    gradeSelect.value = 'small';
    capacityInput.value = '0';
    descInput.value = '';
    if (slot1) slot1.value = '';
    if (slot2) slot2.value = '';
    if (slot3) slot3.value = '';
  } else if (mode === 'edit' && triggerBtn) {
    var row = triggerBtn.closest('.class-data-row');
    if (!row) return;

    var classId = row.getAttribute('data-id');
    var className = row.getAttribute('data-name') || '';
    var grade = row.getAttribute('data-grade') || 'small';
    var capacity = row.getAttribute('data-capacity') || '0';
    var description = row.getAttribute('data-description') || '';
    var teacherIds = (row.getAttribute('data-teacher-ids') || '').split(',').map(function(s){return s.trim();}).filter(Boolean);

    title.textContent = '编辑班级 · ' + className;
    subtitle.textContent = '修改班级名称、年级归属、容纳容量及带班教师配置';
    submitBtn.textContent = '保存更改';
    form.action = '/admin/classes/' + classId + '/edit';

    nameInput.value = className;
    gradeSelect.value = grade;
    capacityInput.value = capacity;
    descInput.value = description;

    if (slot1) slot1.value = teacherIds[0] || '';
    if (slot2) slot2.value = teacherIds[1] || '';
    if (slot3) slot3.value = teacherIds[2] || '';
  }

  modal.style.display = 'flex';
  document.body.classList.add('modal-open');
  setTimeout(function() {
    if (nameInput) nameInput.focus();
  }, 100);
}

function closeClassModal() {
  var modal = document.getElementById('classActionModal');
  if (modal) {
    modal.style.display = 'none';
  }
  document.body.classList.remove('modal-open');
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeClassModal();
  }
});
</script>
