<%- include('partials/header') %>
<link rel="stylesheet" href="/static/exercise-focus-v2.css?v=<%= cssVersion %>">
<%
 const selectedClass=classes.find(c=>Number(c.id)===classId);
 const newUrl=(m,view='write')=>base+'?'+new URLSearchParams({week:w,classId:String(m.class_id||classId),...(view==='write'?{childId:String(m.child_id)}:{}),view});
 const exportUrl=base+'/export?'+new URLSearchParams({week:w,...(classId?{classId:String(classId)}:{})});
 const tabUrl=view=>url({view});
%>
<div class="ef-app" data-view="<%= pageView %>">
  <header class="ef-page-header"><div><a class="ef-back" href="<%= teacher?'/user?view=attention':'/admin?panel=attention' %>">重点关注 /</a><h1>每周锻炼监测</h1></div><div class="ef-header-actions"><% if(members.some(m=>m.active)||records.length){ %><a class="ef-button ef-primary" href="<%= exportUrl %>">导出 Excel 原表</a><% } %><a class="ef-back ef-desktop-only" href="<%= teacher?'/user/bands':'/admin/bands' %>">手环健康监测</a></div></header>
  <div class="ef-toolbar"><div class="ef-week-nav"><a href="<%= url({week:new Date(new Date(w+'T00:00:00Z').getTime()-7*86400000).toISOString().slice(0,10)}) %>" aria-label="上一周">‹</a><span><%= w.slice(5).replace('-','月') %>日 — <%= weekEnd.slice(5).replace('-','月') %>日</span><a href="<%= url({week:new Date(new Date(w+'T00:00:00Z').getTime()+7*86400000).toISOString().slice(0,10)}) %>" aria-label="下一周">›</a><form method="get" action="<%= base %>" id="ef-week-form"><% if(classId){ %><input type="hidden" name="classId" value="<%= classId %>"><% } %><label class="ef-date-picker"><span>选周</span><input type="date" name="week" value="<%= w %>" aria-label="选择日期定位周次" id="ef-week-input"></label><noscript><button class="ef-button" type="submit">查看</button></noscript></form></div><div class="ef-week-summary"><% if(selectedClass){ %><span><%= selectedClass.name %></span><% } %><span>关注 <b><%= activeMembers.length %></b> 人</span><span>观察 <b><%= records.length %></b> 条</span><span>沟通 <b><%= records.filter(r=>r.data.communication).length %></b> 条</span></div></div>
  <% if(!teacher){ %><nav class="ef-class-tabs" aria-label="班级"><a class="<%= !classId?'active':'' %>" href="<%= base %>?week=<%= w %>">全部班级</a><% classes.forEach(c=>{ %><a class="<%= Number(c.id)===classId?'active':'' %>" href="<%= base %>?week=<%= w %>&classId=<%= c.id %>"><%= c.name %><%= enabled.includes(Number(c.id))?'':' · 历史' %></a><% }); %></nav><% } %>
  <% if(message){ %><div class="ef-notice" role="status"><%= message %></div><% } %>
  <% if(isReadonly){ %><div class="ef-readonly">只读模式 · 可查看和导出</div><% } %>
  <% if(pageView==='overview'){ %>
    <section class="ef-panel ef-overview"><div class="ef-section-heading"><h2>班级关注与跟进</h2><span class="ef-muted">人数由各班按实际情况选择</span></div><table class="ef-class-table"><thead><tr><th>班级</th><th>本周关注</th><th>监测记录</th><th>已记录沟通</th><th>尚未记录沟通</th><th></th></tr></thead><tbody><% classStats.forEach(c=>{ %><tr><td><strong><%= c.name %></strong></td><td data-label="关注"><%= c.focusCount %> 人</td><td data-label="观察"><%= c.recordCount %> 条</td><td data-label="沟通"><%= c.communicationCount %> 条</td><td data-label="待补"><span class="<%= c.pendingCount?'ef-pending':'ef-muted' %>"><%= c.pendingCount?c.pendingCount+' 条':'—' %></span></td><td><a class="ef-text-button" href="<%= base %>?week=<%= w %>&classId=<%= c.id %>&view=<%= c.recordCount?'history':'list' %>"><%= c.recordCount?'查看记录':'查看名单' %> →</a></td></tr><% }); %></tbody></table></section>
    <section class="ef-panel ef-overview-records"><div class="ef-section-heading"><h2>最近观察与教师沟通</h2><span class="ef-muted">本周 · 最新在前</span></div><%- include('partials/exercise-records-v2',{displayRecords:records.slice(0,8)}) %></section>
  <% }else{ %>
    <div class="ef-workspace">
      <aside class="ef-panel ef-roster <%= pageView==='list'?'ef-roster-open':'' %>"><div class="ef-section-heading"><h2>本周关注 <span class="ef-count"><%= activeMembers.length %></span></h2><% if(canWrite){ %><button class="ef-text-button" type="button" data-open-dialog="ef-roster-dialog"><%= activeMembers.length?'调整名单':'选择幼儿' %></button><% } %></div>
        <div class="ef-member-list"><% members.filter(m=>m.active||Number(m.record_count)).forEach(m=>{ const editable=m.active&&canWrite; %><div class="ef-member <%= Number(m.child_id)===childId&&pageView==='write'?'active':'' %>"><div class="ef-avatar"><%= m.display_name.slice(0,1) %></div><div class="ef-member-info"><strong><%= m.display_name %></strong><span><%= m.active?(Number(m.record_count)?m.record_count+' 条观察':'待填写'):'已取消关注 · '+m.record_count+' 条记录' %></span></div><a class="ef-member-action" href="<%= editable?newUrl(m):tabUrl('history') %>"><%= editable?'填写':'查看' %></a></div><% }); %></div>
        <% if(!members.some(m=>m.active||Number(m.record_count))){ %><div class="ef-empty"><p>本周还没有选择关注幼儿</p><span>按实际需要选择，也可以不选。</span><% if(canWrite){ %><button type="button" class="ef-button ef-primary" data-open-dialog="ef-roster-dialog">选择本周幼儿</button><% } %></div><% } %>
        <p class="ef-roster-help">人数自定，允许不选。<br>取消关注仍保留已有记录。</p>
        <nav class="ef-roster-nav"><a class="<%= pageView==='list'?'active':'' %>" href="<%= tabUrl('list') %>">本周名单</a><a class="<%= pageView==='history'?'active':'' %>" href="<%= tabUrl('history') %>">历史记录 <span><%= records.length %></span></a></nav>
      </aside>
      <div class="ef-content">
      <% if(pageView==='write'&&selectedMember){ %>
        <section class="ef-panel ef-editor" id="ef-editor"><div class="ef-editor-head"><div class="ef-person"><div class="ef-avatar"><%= selectedMember.display_name.slice(0,1) %></div><div><h2><%= selectedMember.display_name %></h2><span><%= selectedMember.class_name %> · <%= editing?'编辑观察记录':'新增观察记录' %></span></div></div><div class="ef-editor-links"><button class="ef-text-button ef-mobile-only" type="button" data-open-dialog="ef-child-dialog">换一位</button><a class="ef-text-button" href="<%= tabUrl('history') %>">历史记录</a></div></div>
        <form method="post" action="<%= base %>/record" id="ef-record-form" data-base="<%= base %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="classId" value="<%= classId %>"><input type="hidden" name="week" value="<%= w %>"><input type="hidden" name="childId" value="<%= childId %>"><input type="hidden" name="recordId" value="<%= editing?editing.id:'' %>"><input type="hidden" name="recordRevision" value="<%= editing?editing.revision:'' %>">
          <fieldset <%= canWrite?'':'disabled' %>>
            <div class="ef-time-fields"><label><span>观察日期</span><input type="date" name="date" min="<%= w %>" max="<%= weekEnd %>" value="<%= date %>" required></label><label><span>开始时间</span><input type="time" name="start" value="<%= editing?editing.start_time:'' %>" required></label><label><span>结束时间</span><input type="time" name="end" value="<%= editing?editing.end_time:'' %>" required></label></div>
            <div class="ef-heart-strip"><div class="ef-heart-icon" aria-hidden="true">♡</div><div id="ef-metrics" role="status"><% if(editing){const h=editing.metrics; %><strong><%= h.avg==null?(h.reason||'暂无心率数据'):(h.avg+' 次/分') %></strong><span><%= h.sample_count?'时段平均 · 最低 '+h.min+' / 最高 '+h.max+' · '+h.sample_count+' 次采样':'手环自动带入，缺失数据不记为 0' %></span><% }else{ %><strong>填写活动时段，自动查询心率</strong><span>保存时自动带入该时段平均值</span><% } %></div><button type="button" class="ef-text-button" id="ef-refresh">查询</button></div>
            <% if(editing){ %><label class="ef-refresh-label"><input type="checkbox" name="refreshMetrics" value="1" id="ef-refresh-save">保存时重新读取心率</label><% } %>
            <div class="ef-form-tabs" role="tablist" aria-label="观察表单"><button type="button" role="tab" id="ef-tab-activity" aria-controls="ef-panel-activity" aria-selected="true" data-form-tab="activity">活动情况<span data-filled="activity"></span></button><button type="button" role="tab" id="ef-tab-observe" aria-controls="ef-panel-observe" aria-selected="false" data-form-tab="observe">现场观察<span data-filled="observe"></span></button><button type="button" role="tab" id="ef-tab-talk" aria-controls="ef-panel-talk" aria-selected="false" data-form-tab="talk">教师沟通<span data-filled="talk"></span></button></div>
            <% const formTabs=[{key:'activity',section:'活动情况'},{key:'observe',section:'活动中监测'},{key:'talk',section:'活动后监测'}];formTabs.forEach(tab=>{ %>
            <section id="ef-panel-<%= tab.key %>" role="tabpanel" aria-labelledby="ef-tab-<%= tab.key %>" class="ef-form-panel" <%= tab.key!=='activity'?'hidden':'' %>>
              <% if(tab.key==='activity'){ %><div class="ef-staff-fields"><label>检查者<input name="inspector" maxlength="80" value="<%= data.inspector||'' %>" placeholder="检查者姓名"></label><label>带班教师<input name="teacher" maxlength="80" value="<%= data.teacher||'' %>" placeholder="带班教师姓名"></label><label>保育员<input name="caregiver" maxlength="80" value="<%= data.caregiver||'' %>" placeholder="保育员姓名"></label></div><% } %>
              <% if(tab.key==='talk'){ %><div class="ef-talk-field"><label for="ef-communication">教师沟通</label><span class="ef-muted">沟通时间、对象、观察反馈、调整措施与后续跟进</span><textarea id="ef-communication" name="communication" rows="5" maxlength="6000" placeholder="记录本次沟通情况，可稍后补充……"><%= data.communication||'' %></textarea></div><h3 class="ef-after-title">活动后观察</h3><% } %>
              <div class="ef-observation-grid"><% groups.filter(g=>g.section===tab.section).forEach(g=>{ %><div class="ef-choice-group" data-group="<%= g.key %>"><div class="ef-choice-title"><span><%= ({attention:'注意力',interest:'参与兴趣',participation:'参与范围'})[g.key]||g.label %><% if(g.multi){ %><small>多选</small><% } %></span><button type="button" class="ef-clear" data-clear-group="<%= g.key %>" aria-label="清除<%= g.label %>">清除</button></div><div class="ef-choices" role="group" aria-label="<%= g.label %>"><% g.options.forEach(opt=>{const checked=g.multi?(Array.isArray(data[g.key])&&data[g.key].includes(opt)):data[g.key]===opt; %><label><input type="<%= g.multi?'checkbox':'radio' %>" name="<%= g.key %>" value="<%= opt %>" <%= checked?'checked':'' %>><span><%= opt %></span></label><% }); %></div></div><% }); %></div>
              <% if(tab.key==='talk'){ %><div class="ef-talk-field"><label for="ef-notes">补充观察</label><textarea id="ef-notes" name="notes" rows="2" maxlength="3000" placeholder="其他器材、其他反应或需要补充的情况"><%= data.notes||'' %></textarea></div><% } %>
            </section><% }); %>
            <div class="ef-save-bar"><span>未观察的项目可留空</span><div><button type="submit" class="ef-button ef-secondary" name="action" value="save">保存记录</button><% if(nextMember){ %><button type="submit" class="ef-button ef-primary" name="action" value="next">保存并下一位 →</button><% } %></div></div>
          </fieldset>
        </form></section>
      <% }else if(pageView==='history'){ %><section class="ef-panel ef-history"><div class="ef-section-heading"><h2>观察与教师沟通</h2><% if(canWrite&&activeMembers.length){ %><a class="ef-text-button" href="<%= newUrl(activeMembers[0]) %>">＋ 新增记录</a><% } %></div><%- include('partials/exercise-records-v2',{displayRecords:records}) %></section>
      <% }else{ %><section class="ef-panel ef-list-intro"><h2>选择本周关注幼儿</h2><p>选择幼儿后填写活动观察，心率按活动时段自动带入。</p><div class="ef-list-steps"><div><span>1</span><strong>按周选人</strong><p>自由勾选，不限制人数</p></div><div><span>2</span><strong>点选观察</strong><p>活动、现场表现分组填写</p></div><div><span>3</span><strong>记录沟通</strong><p>补充跟进，导出 Excel 原表</p></div></div><% if(activeMembers.length&&canWrite){ %><a class="ef-button ef-primary" href="<%= newUrl(activeMembers[0]) %>">开始填写 →</a><% }else if(canWrite){ %><button type="button" class="ef-button ef-primary" data-open-dialog="ef-roster-dialog">选择本周幼儿</button><% } %></section><% } %>
      </div>
    </div>
    <nav class="ef-mobile-nav" aria-label="锻炼监测导航"><a class="<%= pageView==='list'?'active':'' %>" href="<%= tabUrl('list') %>"><span>☷</span>本周名单</a><a class="<%= pageView==='write'?'active':'' %>" href="<%= activeMembers.length&&canWrite?newUrl(activeMembers[0]):tabUrl('list') %>"><span>＋</span>填写观察</a><a class="<%= pageView==='history'?'active':'' %>" href="<%= tabUrl('history') %>"><span>◷</span>历史记录</a></nav>
  <% } %>
  <% if(canWrite){ %><dialog id="ef-roster-dialog" class="ef-dialog"><div class="ef-dialog-heading"><div><h2>本周关注名单</h2><span><%= selectedClass?selectedClass.name:'' %> · <%= w %></span></div><button type="button" class="ef-close" data-close-dialog aria-label="关闭名单">×</button></div><p class="ef-muted">人数自定，也可以不选。已有观察记录会保留。</p><form method="post" action="<%= base %>/selection" id="ef-selection-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="classId" value="<%= classId %>"><input type="hidden" name="week" value="<%= w %>"><input type="hidden" name="revision" value="<%= revision %>"><input type="search" id="ef-search" placeholder="搜索幼儿" aria-label="搜索幼儿"><div class="ef-checkbox-list"><% roster.forEach(ch=>{ %><label class="ef-child-option" data-name="<%= ch.display_name %>"><input type="checkbox" name="childIds" value="<%= ch.id %>" <%= members.some(m=>Number(m.child_id)===Number(ch.id)&&m.active)?'checked':'' %>><span><%= ch.display_name %><small><%= ch.historical?'历史名单':'' %></small></span></label><% }); %></div><div class="ef-dialog-actions"><span id="ef-selection-count" role="status">已选择 <%= activeMembers.length %> 人</span><button type="submit" class="ef-button ef-primary">保存本周名单</button></div></form></dialog><% } %>
  <% if(selectedMember){ %><dialog id="ef-child-dialog" class="ef-dialog ef-child-dialog"><div class="ef-dialog-heading"><h2>切换幼儿</h2><button type="button" class="ef-close" data-close-dialog aria-label="关闭">×</button></div><div class="ef-switch-children"><% activeMembers.forEach(m=>{ %><a href="<%= newUrl(m) %>"><div class="ef-avatar"><%= m.display_name.slice(0,1) %></div><span><%= m.display_name %></span><span class="ef-muted"><%= m.record_count?m.record_count+' 条观察':'待填写' %> →</span></a><% }); %></div></dialog><% } %>
</div>
<script src="/static/exercise-focus-v2.js?v=<%= cssVersion %>" defer></script>
<%- include('partials/footer') %>
