<%- include('partials/header') %>

<%
  const isAlert = viewType === 'alert';
  const title = pageTitle || (isAlert ? '心率警报' : '健康日报');
  const eyebrow = isAlert ? '心率超标报警' : '每日健康日报';
  const icon = isAlert ? '⚠️' : '📊';
  const latestCardBg = isAlert ? '#fff6f6' : '#f6f8fa';
  const latestCardBorder = isAlert ? '1px solid #ffd7d7' : 'none';
  const latestLabel = isAlert ? '最新警报' : '最新日报';
  const historyLabel = isAlert ? '历史警报' : '历史日报';
%>
<section class="container" style="max-width:960px;margin:28px auto 60px;padding:0 16px;">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:18px;">
    <div>
      <div style="font-size:12px;color:#8a94a6;margin-bottom:4px;"><%= eyebrow %></div>
      <h1 style="margin:0;font-size:24px;color:#1a1a2e;"><%= icon %> <%= title %></h1>
    </div>
    <div style="font-size:12.5px;color:#8a94a6;background:#fff;border:1px solid #e5eaf0;border-radius:20px;padding:6px 14px;">
      当前查看人：<strong><%= currentUser ? (currentUser.name || currentUser.username) : '未登录' %></strong>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr;gap:16px;">
    <!-- 最新一条 -->
    <div style="background:#fff;border-radius:14px;border:1px solid #e5eaf0;box-shadow:0 2px 10px rgba(30,41,59,.05);padding:20px;min-width:0;">
      <h3 style="margin:0 0 10px;font-size:15px;color:#1a1a2e;">📄 <%= latestLabel %></h3>
      <% if (latest) { %>
      <p style="margin:0 0 10px;font-size:12.5px;color:#8a94a6;">
        <% if (isAlert) { %><%= latest.created_at %><% } else { %><%= latest.ref_id %> · <%= latest.created_at %><% } %>
        · <%= latest.wx_errcode === 0 ? '✅ 推送成功' : ('❌ ' + String(latest.wx_errmsg || latest.wx_errcode)) %>
      </p>
      <pre style="background:<%= latestCardBg %>;<%= latestCardBorder ? 'border:' + latestCardBorder + ';' : '' %>padding:14px;border-radius:10px;white-space:pre-wrap;word-break:break-all;overflow-wrap:anywhere;font-size:13px;line-height:1.7;margin:0;"><%= latest.content || '' %></pre>
      <% } else { %>
      <p style="margin:0;font-size:13px;color:#8a94a6;">暂无<%= title %>记录。</p>
      <% } %>
    </div>

    <!-- 历史列表 -->
    <div style="background:#fff;border-radius:14px;border:1px solid #e5eaf0;box-shadow:0 2px 10px rgba(30,41,59,.05);padding:20px;min-width:0;">
      <h3 style="margin:0 0 12px;font-size:15px;color:#1a1a2e;">🗂️ <%= historyLabel %></h3>
      <% if (history.length) { %>
        <% history.forEach(function(r) { %>
        <details style="border:1px solid #e5eaf0;border-radius:10px;padding:10px 14px;margin-bottom:10px;word-break:break-all;">
          <summary style="cursor:pointer;font-weight:600;font-size:13.5px;color:#334155;">
            <% if (isAlert) { %><%= r.created_at %> · <%= r.wx_errcode === 0 ? '✅' : '❌' %> <%= r.title %><% } else { %><%= r.ref_id %> · <%= r.wx_errcode === 0 ? '✅' : '❌' %> <%= r.wx_errmsg || r.wx_errcode %><% } %>
          </summary>
          <pre style="background:#f6f8fa;padding:12px;border-radius:8px;white-space:pre-wrap;word-break:break-all;overflow-wrap:anywhere;font-size:12.5px;line-height:1.6;margin-top:8px;"><%= r.content || '' %></pre>
        </details>
        <% }); %>
      <% } else { %>
      <p style="margin:0;font-size:13px;color:#8a94a6;">暂无历史<%= title %>。</p>
      <% } %>
    </div>
  </div>

  <p style="margin-top:16px;font-size:12px;color:#aab4c4;text-align:center;">本页为只读查看页，数据由系统推送时留档</p>
</section>

<%- include('partials/footer') %>