<%- include('partials/header', { pageClass: 'admin-page' + (typeof isReadonly !== 'undefined' && isReadonly ? ' readonly-mode' : '') }) %>


<%
  const activeFilters = filters || {};
  const dateOptions = Array.isArray(fitnessRecordDates) ? fitnessRecordDates : [];
  const selectedDetailBatchDateValue = (typeof selectedBatchDate !== 'undefined' && selectedBatchDate) ? selectedBatchDate : ((dateOptions[0] && dateOptions[0].label) || '');
  const selectedAnalysisBatchDateValue = (activeFilters.batchDate || ((dateOptions[1] && dateOptions[1].label) || ''));
  const ratingOptions = ['', '优秀', '良好', '合格', '不合格'];
  function buildQuery(pairs) {
    return pairs
      .filter(function(pair) { return pair[1] !== undefined && pair[1] !== null && String(pair[1]) !== ''; })
      .map(function(pair) { return encodeURIComponent(pair[0]) + '=' + encodeURIComponent(String(pair[1])); })
      .join('&');
  }
  const scopePairs = [
    ['view', viewMode || 'all'],
    ['childId', childId || ''],
    ['classId', classId || ''],
    ['gradeLevel', gradeLevel || '']
  ];
  const filterPairs = [
    ['batchDate', selectedAnalysisBatchDateValue || ''],
    ['detailBatchDate', selectedDetailBatchDateValue || ''],
    ['keyword', activeFilters.keyword || ''],
    ['rating', activeFilters.rating || ''],
    ['sortField', activeFilters.sortField || 'test_date'],
    ['sortOrder', activeFilters.sortOrder || 'desc']
  ];
  const sortOptions = [
    ['test_date', '测试日期'],
    ['child_name', '幼儿姓名'],
    ['height_score', '身高分'],
    ['bmi_score', 'BMI分'],
    ['grip_score', '握力分'],
    ['jump_score', '跳远分'],
    ['sit_score', '体前屈分'],
    ['djump_score', '双脚跳分'],
    ['obstacle_score', '障碍跑分'],
    ['balance_score', '平衡木分'],
    ['total_score', '综合得分']
  ];
  const fitnessPaginationData = fitnessPagination || { currentPage: 1, totalPages: 1, total: allRecordsCount || records.length, startIndex: records.length ? 1 : 0, endIndex: records.length, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1 };
  const paginationFilterPairs = filterPairs.concat([['page', fitnessPaginationData.currentPage]]);
  const viewBaseQuery = buildQuery(scopePairs);
  const currentViewHref = '/admin/fitness' + (viewBaseQuery ? '?' + viewBaseQuery : '');
  const exportQuery = buildQuery(scopePairs.concat(filterPairs));
  const exportHref = '/admin/fitness/export' + (exportQuery ? '?' + exportQuery : '');
  const selectedChildIdText = childId ? String(childId) : '';
  const currentFullHref = '/admin/fitness' + (buildQuery(scopePairs.concat(paginationFilterPairs)) ? '?' + buildQuery(scopePairs.concat(paginationFilterPairs)) : '');
  const editQueryBase = buildQuery(scopePairs.concat(paginationFilterPairs));
  const currentScopeLabel = viewMode === 'child'
    ? '当前为个人视图，可继续按评级 / 日期筛选该幼儿数据'
    : viewMode === 'class'
      ? '当前为班级视图，可继续按关键词 / 评级 / 日期缩小范围'
      : viewMode === 'grade'
        ? '当前为年级视图，可继续按关键词 / 评级 / 日期缩小范围'
        : '当前为全园视图，可先筛选再导出';
%>

<section class="admin-hero card">
  <div>
    <div class="eyebrow">体测数据管理</div>
    <h1><%= title %></h1>
    <p>录入体测数据后，系统自动计算 BMI、各项得分、综合得分和评级。支持按个人 / 班级 / 年级 / 全园查看、筛选和导出。</p>
  </div>
  <div class="admin-hero-actions">
    <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.view')) { %>
      <button type="button" class="btn primary" id="ai-fitness-report-btn" data-export-href="<%= exportHref %>">🤖 AI 智能分析报告</button>
    <% } %>
    <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.export') && !isReadonly) { %><a class="btn primary" href="<%= exportHref %>">导出当前筛选结果</a><% } %>
    <a class="btn" href="/admin">← 返回后台</a>
  </div>
</section>

<!-- AI 智能分析报告弹窗 -->
<div id="ai-fitness-modal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:9999;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;">
  <div style="width:min(880px,100%);background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.25);overflow:hidden;display:flex;flex-direction:column;max-height:calc(100vh - 80px);">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e2e8f0;background:#f8fafc;">
      <div>
        <div style="font-size:13px;color:#64748b;letter-spacing:.05em;">AI 智能分析报告</div>
        <div id="ai-modal-title" style="font-size:18px;font-weight:600;color:#0f172a;">正在调用大模型……</div>
        <div id="ai-modal-meta" style="font-size:12px;color:#94a3b8;margin-top:2px;"></div>
      </div>
      <div style="display:flex;gap:8px;">
        <button type="button" class="btn small" id="ai-modal-copy" style="display:none;">复制全文</button>
        <button type="button" class="btn small" id="ai-modal-download" style="display:none;">📄 下载 Markdown</button>
        <button type="button" class="btn small" id="ai-modal-stop">中断</button>
        <button type="button" class="btn small" id="ai-modal-close">关闭</button>
      </div>
    </div>
    <div id="ai-modal-error" style="display:none;padding:12px 20px;color:#b91c1c;background:#fef2f2;border-bottom:1px solid #fecaca;"></div>
    <details id="ai-modal-reasoning-wrap" style="display:none;border-bottom:1px solid #e2e8f0;background:#f8fafc;">
      <summary style="padding:10px 20px;cursor:pointer;font-size:13px;color:#475569;">🧠 思维链（展开查看模型思考过程）<span id="ai-modal-reasoning-count" style="color:#94a3b8;font-weight:normal;margin-left:6px;"></span></summary>
      <div id="ai-modal-reasoning" style="padding:0 20px 16px 20px;font-size:13px;color:#64748b;line-height:1.7;white-space:pre-wrap;max-height:240px;overflow:auto;background:#f8fafc;"></div>
    </details>
    <div id="ai-modal-body" style="padding:20px;line-height:1.8;color:#1e293b;font-size:15px;white-space:pre-wrap;overflow:auto;"></div>
    <div id="ai-modal-status" style="padding:8px 20px;font-size:12px;color:#94a3b8;border-top:1px solid #e2e8f0;background:#f8fafc;">准备中……</div>
  </div>
</div>

<script>
(function() {
  var trigger = document.getElementById('ai-fitness-report-btn');
  if (!trigger) return;
  var modal = document.getElementById('ai-fitness-modal');
  var titleEl = document.getElementById('ai-modal-title');
  var metaEl = document.getElementById('ai-modal-meta');
  var bodyEl = document.getElementById('ai-modal-body');
  var statusEl = document.getElementById('ai-modal-status');
  var errorEl = document.getElementById('ai-modal-error');
  var stopBtn = document.getElementById('ai-modal-stop');
  var closeBtn = document.getElementById('ai-modal-close');
  var copyBtn = document.getElementById('ai-modal-copy');
  var downloadBtn = document.getElementById('ai-modal-download');
  var reasoningWrap = document.getElementById('ai-modal-reasoning-wrap');
  var reasoningEl = document.getElementById('ai-modal-reasoning');
  var reasoningCountEl = document.getElementById('ai-modal-reasoning-count');
  var es = null;
  var collected = '';
  var reasoningCollected = '';
  var streamFinished = false;

  function buildSseUrl() {
    var exportHref = trigger.getAttribute('data-export-href') || '/admin/fitness';
    var qs = '';
    var idx = exportHref.indexOf('?');
    if (idx >= 0) qs = exportHref.slice(idx);
    return '/admin/fitness/ai-report' + qs;
  }

  function openModal() {
    collected = '';
    reasoningCollected = '';
    streamFinished = false;
    bodyEl.textContent = '';
    reasoningEl.textContent = '';
    reasoningWrap.style.display = 'none';
    reasoningWrap.open = true;
    if (reasoningCountEl) reasoningCountEl.textContent = '';
    errorEl.style.display = 'none';
    errorEl.textContent = '';
    metaEl.textContent = '';
    statusEl.textContent = '连接中……';
    titleEl.textContent = '正在调用大模型……';
    copyBtn.style.display = 'none';
    downloadBtn.style.display = 'none';
    stopBtn.disabled = false;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (es) { try { es.close(); } catch(e){} es = null; }
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

  stopBtn.addEventListener('click', function() {
    if (es) { try { es.close(); } catch(e){} es = null; }
    statusEl.textContent = '已手动中断。';
    stopBtn.disabled = true;
    if (collected) { copyBtn.style.display = ''; downloadBtn.style.display = ''; }
  });
  copyBtn.addEventListener('click', function() {
    if (!collected) return;
    try {
      navigator.clipboard.writeText(collected).then(function(){
        statusEl.textContent = '✅ 已复制全文。';
      }, function(){
        statusEl.textContent = '❌ 复制失败，请手动选择复制。';
      });
    } catch(e) {
      statusEl.textContent = '❌ 当前浏览器不支持一键复制。';
    }
  });
  downloadBtn.addEventListener('click', function() {
    if (!collected) return;
    try {
      var titleText = (titleEl.textContent || 'AI体质报告').trim();
      var ts = new Date();
      var pad = function(n){ return n < 10 ? '0' + n : '' + n; };
      var stamp = ts.getFullYear() + pad(ts.getMonth()+1) + pad(ts.getDate()) + '-' + pad(ts.getHours()) + pad(ts.getMinutes());
      var header = '# AI 体质分析报告 - ' + titleText + '\n\n> 生成时间：' + ts.toLocaleString('zh-CN') + '\n>\n> ' + (metaEl.textContent || '') + '\n\n---\n\n';
      var blob = new Blob([header + collected], { type: 'text/markdown;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'AI体质报告-' + titleText.replace(/[\\\/:*?"<>|]/g, '_') + '-' + stamp + '.md';
      document.body.appendChild(a);
      a.click();
      setTimeout(function(){ document.body.removeChild(a); URL.revokeObjectURL(url); }, 300);
      statusEl.textContent = '✅ 报告已下载。';
    } catch(e) {
      statusEl.textContent = '❌ 下载失败：' + (e && e.message || e);
    }
  });

  trigger.addEventListener('click', function() {
    openModal();
    var url = buildSseUrl();
    es = new EventSource(url, { withCredentials: true });
    es.addEventListener('meta', function(e) {
      try {
        var data = JSON.parse(e.data);
        titleEl.textContent = data.scope || 'AI 体质分析报告';
        metaEl.textContent = '样本 '+ (data.recordsCount || 0) +' 条·' + new Date(data.generatedAt).toLocaleString('zh-CN');
        statusEl.textContent = '正在生成，内容会逐段出现……';
      } catch(err) {}
    });
    es.addEventListener('reasoning', function(e) {
      try {
        var data = JSON.parse(e.data);
        if (data && data.content) {
          if (!reasoningCollected) {
            reasoningWrap.style.display = '';
            statusEl.textContent = '🧠 模型正在思考（展开“思维链”可看过程）……';
          }
          reasoningCollected += data.content;
          reasoningEl.textContent = reasoningCollected;
          reasoningEl.scrollTop = reasoningEl.scrollHeight;
          if (reasoningCountEl) reasoningCountEl.textContent = '· ' + reasoningCollected.length + ' 字';
        }
      } catch(err) {}
    });
    es.addEventListener('delta', function(e) {
      try {
        var data = JSON.parse(e.data);
        if (data && data.content) {
          if (!collected && reasoningCollected) {
            statusEl.textContent = '✅ 思考完成，正在输出报告……';
          }
          collected += data.content;
          bodyEl.textContent = collected;
          bodyEl.scrollTop = bodyEl.scrollHeight;
        }
      } catch(err) {}
    });
    es.addEventListener('error', function(e) {
      var msg = '';
      try { var data = JSON.parse(e.data); msg = data && data.message || ''; } catch(err) {}
      if (msg) {
        errorEl.style.display = '';
        errorEl.textContent = msg;
      }
    });
    es.addEventListener('done', function(e) {
      streamFinished = true;
      try {
        var data = JSON.parse(e.data);
        if (data && data.ok) {
          var extra = data.reasoningLength ? '，思维链 ' + data.reasoningLength + ' 字' : '';
          statusEl.textContent = '✅ 生成完成，正文 ' + (data.length || collected.length) + ' 字' + extra + '。';
          copyBtn.style.display = '';
          downloadBtn.style.display = '';
        } else {
          statusEl.textContent = '❌ 未能完成。';
          if (collected) { copyBtn.style.display = ''; downloadBtn.style.display = ''; }
        }
      } catch(err) {}
      stopBtn.disabled = true;
      if (es) { try { es.close(); } catch(err){} es = null; }
    });
    es.onerror = function() {
      // 正常结束后 EventSource 会触发 onerror，只有未完成才提示
      if (streamFinished) return;
      if (!collected && !reasoningCollected) {
        errorEl.style.display = '';
        errorEl.textContent = errorEl.textContent || '连接中断或接口异常，请检查后台 AI 接入设置。';
      } else {
        statusEl.textContent = '⚠️ 连接中断（已接收部分内容）';
      }
    };
  });
})();
</script>

<% if (message) { %>
  <div class="alert success"><%= message %></div>
<% } %>
<% if (error) { %>
  <div class="alert error"><%= error %></div>
<% } %>

<div class="admin-layout">
  <aside class="admin-sidebar card">
    <div class="sidebar-brand">
      <div class="sidebar-title">体测导航</div>
    </div>
    <nav class="fitness-nav" aria-label="体测导航">
      <a class="fitness-nav-root <%= viewMode === 'all' ? 'active' : '' %>" href="/admin/fitness?view=all">全园数据</a>
      <% ['small', 'middle', 'large'].forEach(function(gl) { 
           const gradeClasses = (classes || [])
             .filter(function(cls) { return cls.grade_level === gl; })
             .slice()
             .sort(function(a, b) {
               function extractOrder(name) {
                 const raw = String(name || '');
                 const chineseMap = { '一': 1, '二': 2, '三': 3, '四': 4, '五': 5, '六': 6, '七': 7, '八': 8, '九': 9, '十': 10 };
                 const matchNum = raw.match(/[0-9]+/);
                 if (matchNum) return Number(matchNum[0]);
                 const matchCn = raw.match(/[一二三四五六七八九十]/);
                 if (matchCn) return chineseMap[matchCn[0]] || 999;
                 return 999;
               }
               const ao = extractOrder(a.name);
               const bo = extractOrder(b.name);
               if (ao !== bo) return ao - bo;
               return String(a.name || '').localeCompare(String(b.name || ''), 'zh-Hans-CN');
             });
           const gradeActive = (viewMode === 'grade' && gradeLevel === gl) || (viewMode === 'class' && gradeClasses.some(function(cls) { return String(cls.id) === String(classId); })); %>
        <section class="fitness-nav-group <%= gradeActive ? 'open' : '' %>">
          <a class="fitness-nav-grade-link <%= gradeActive ? 'active' : '' %>" href="/admin/fitness?view=grade&gradeLevel=<%= gl %>">
            <span class="fitness-nav-grade-title"><%= gradeLabel(gl) %>年级</span>
            <span class="fitness-nav-grade-meta">
              <span class="fitness-nav-count"><%= gradeClasses.length %></span>
              <span class="fitness-nav-chevron" aria-hidden="true"><%= gradeActive ? '▾' : '▸' %></span>
            </span>
          </a>
          <% if (gradeActive && gradeClasses.length) { %>
            <div class="fitness-nav-classes" style="display:flex;flex-direction:column;gap:10px;">
              <% gradeClasses.forEach(function(cls) { %>
                <a class="fitness-nav-class <%= (viewMode === 'class' && String(classId) === String(cls.id)) ? 'active' : '' %>" style="display:block;width:100%;box-sizing:border-box;" href="/admin/fitness?view=class&classId=<%= cls.id %>"><%= cls.name %></a>
              <% }) %>
            </div>
          <% } %>
        </section>
      <% }) %>
    </nav>
    <div class="sidebar-footer muted" style="margin-top:16px;">
      <div class="toolbar-links stacked-links">
        <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.export') && !isReadonly) { %><a class="btn small primary" href="<%= exportHref %>">导出当前筛选结果</a><% } %>
        <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.import') && !isReadonly) { %><a class="btn small" href="/admin/fitness/template">下载体测导入模板</a><% } %>
      </div>
      <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.import') && !isReadonly) { %>
      <form method="post" action="/admin/fitness/import" enctype="multipart/form-data" style="margin-top:10px;">
        <input type="hidden" name="currentView" value="<%= viewMode %>" />
        <input type="hidden" name="currentChildId" value="<%= childId || '' %>" />
        <input type="hidden" name="currentClassId" value="<%= classId || '' %>" />
        <input type="hidden" name="currentGradeLevel" value="<%= gradeLevel || '' %>" />
        <input type="hidden" name="currentKeyword" value="<%= activeFilters.keyword || '' %>" />
        <input type="hidden" name="currentRating" value="<%= activeFilters.rating || '' %>" />
        <input type="hidden" name="currentDateFrom" value="<%= activeFilters.dateFrom || '' %>" />
        <input type="hidden" name="currentDateTo" value="<%= activeFilters.dateTo || '' %>" />
        <input type="file" name="file" accept=".xlsx,.xls,.csv" required style="font-size:13px;" />
        <button class="btn small primary" type="submit" style="margin-top:6px;">批量导入体测数据</button>
      </form>
      <% } %>
    </div>
  </aside>

  <div class="admin-main" data-ajax-panel="admin-fitness-main">
    <!-- 统计卡片 -->
    <section class="stats-grid overview-stats" style="margin-bottom:20px;">
      <div class="card stat-card">
        <div class="stat-label">所选批次记录条数</div>
        <div class="stat-number"><%= allRecordsCount || 0 %></div>
        <div class="muted" style="margin-top:6px;"><%= selectedDetailBatchDateValue || '-' %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">最新批次分析平均综合得分</div>
        <div class="stat-number"><%= avgScore || '-' %></div>
        <form method="get" action="/admin/fitness" class="admin-analysis-batch-form" style="margin-top:8px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
          <% scopePairs.forEach(function(pair) { if (pair[1]) { %><input type="hidden" name="<%= pair[0] %>" value="<%= pair[1] %>" /><% } }) %>
          <input type="hidden" name="detailBatchDate" value="<%= selectedDetailBatchDateValue || '' %>" />
          <select name="batchDate" style="max-width:150px;">
            <option value="">对比批次</option>
            <% dateOptions.forEach(function(item) { %><option value="<%= item.label %>" <%= selectedAnalysisBatchDateValue === item.label ? 'selected' : '' %>><%= item.label %></option><% }) %>
          </select>
          <button class="btn small" type="submit">筛选批次</button>
        </form>
      </div>
      <% (ratingSummary || []).forEach(function(item) { %>
        <div class="card stat-card">
          <div class="stat-label"><%= item.label %></div>
          <div class="stat-number" style="color:<%= item.label === '优秀' ? '#34c759' : item.label === '良好' ? '#0071e3' : item.label === '合格' ? '#ff9f0a' : '#ff3b30' %>;"><%= item.count %></div>
          <div class="muted" style="margin-top:6px;">占比 <%= item.percent %>%</div>
        </div>
      <% }) %>
    </section>

    <section class="card chart-card" style="margin-bottom:20px;">
      <div class="section-head">
        <div>
          <h3>体能结构雷达图</h3>
          <div class="muted no-margin">用雷达图展示当前范围内各单项能力健康度（100% - 需提升占比）</div>
        </div>
      </div>
      <div class="visual-grid">
        <div class="radar-card" data-radar-root>
          <%
            const radarData = radarChartData || {
              metrics: (metricHealthSummary || []).map(function(item) {
                return { key: item.key, label: item.label };
              }),
              series: [{
                key: 'current',
                label: '当前范围',
                color: '#0f172a',
                fillColor: 'rgba(15, 23, 42, 0.12)',
                dasharray: 'none',
                strokeWidth: 3,
                visible: true,
                values: (metricHealthSummary || []).map(function(item) { return Number(item.score || 0); })
              }]
            };
            const radarMetrics = radarData.metrics || [];
            const radarSeries = radarData.series || [];
            const radarCx = 160;
            const radarCy = 160;
            const radarRadius = 110;
            function buildRadarPolygon(values) {
              return radarMetrics.map(function(metric, index) {
                const angle = (-Math.PI / 2) + (Math.PI * 2 * index / Math.max(1, radarMetrics.length));
                const score = Math.max(0, Math.min(100, Number((values && values[index]) || 0)));
                const length = radarRadius * score / 100;
                const x = radarCx + Math.cos(angle) * length;
                const y = radarCy + Math.sin(angle) * length;
                return x.toFixed(1) + ',' + y.toFixed(1);
              }).join(' ');
            }
          %>
          <div class="radar-card-head">
            <div class="radar-toggle-list">
              <% radarSeries.forEach(function(series) { %>
                <button
                  type="button"
                  class="radar-toggle <%= series.visible === false ? '' : 'is-active' %>"
                  data-radar-toggle="<%= series.key %>"
                  aria-pressed="<%= series.visible === false ? 'false' : 'true' %>"
                  style="--radar-toggle-color:<%= series.color %>;"
                >
                  <span class="radar-toggle-swatch" style="background:<%= series.color %>;"></span>
                  <span><%= series.label %></span>
                </button>
              <% }) %>
            </div>
          </div>
          <svg class="radar-svg" viewBox="0 0 320 320" role="img" aria-label="体能结构雷达图">
            <% for (let ring = 1; ring <= 4; ring++) { %>
              <polygon class="radar-ring" points="<%= buildRadarPolygon(radarMetrics.map(function() { return ring * 25; })) %>"></polygon>
            <% } %>
            <% radarMetrics.forEach(function(item, i) {
              const angle = (-Math.PI / 2) + (Math.PI * 2 * i / Math.max(1, radarMetrics.length));
              const axisX = radarCx + Math.cos(angle) * radarRadius;
              const axisY = radarCy + Math.sin(angle) * radarRadius;
              const lx = radarCx + Math.cos(angle) * (radarRadius + 20);
              const ly = radarCy + Math.sin(angle) * (radarRadius + 20);
            %>
              <line class="radar-axis" x1="<%= radarCx %>" y1="<%= radarCy %>" x2="<%= axisX.toFixed(1) %>" y2="<%= axisY.toFixed(1) %>"></line>
              <text class="radar-label" x="<%= lx.toFixed(1) %>" y="<%= ly.toFixed(1) %>"><%= item.label %></text>
            <% }) %>
            <% radarSeries.forEach(function(series) { %>
              <g class="radar-series <%= series.key === 'current' ? 'radar-series-current' : 'radar-series-reference' %><%= series.visible === false ? ' is-hidden' : '' %>" data-radar-series="<%= series.key %>">
                <polygon
                  class="radar-series-shape"
                  points="<%= buildRadarPolygon(series.values || []) %>"
                  style="fill:<%= series.fillColor || 'transparent' %>;stroke:<%= series.color %>;stroke-width:<%= series.strokeWidth || 2 %>;stroke-dasharray:<%= series.dasharray && series.dasharray !== 'none' ? series.dasharray : 'none' %>;"
                ></polygon>
                <% if (series.key === 'current') { %>
                  <% radarMetrics.forEach(function(item, i) {
                    const angle = (-Math.PI / 2) + (Math.PI * 2 * i / Math.max(1, radarMetrics.length));
                    const score = Math.max(0, Math.min(100, Number(((series.values || [])[i]) || 0)));
                    const length = radarRadius * score / 100;
                    const x = radarCx + Math.cos(angle) * length;
                    const y = radarCy + Math.sin(angle) * length;
                  %>
                    <circle class="radar-series-dot" cx="<%= x.toFixed(1) %>" cy="<%= y.toFixed(1) %>" r="4" style="fill:<%= series.color %>;"></circle>
                  <% }) %>
                <% } %>
              </g>
            <% }) %>
          </svg>
        </div>
        <div class="trend-card">
          <h4>单项提升建议</h4>
          <div class="narrative-list">
            <% (metricNeedTrainingSummary || []).forEach(function(item) { %>
              <details class="narrative-item fitness-detail-card">
                <summary>
                  <strong><%= item.label %></strong>
                  <span class="muted" style="margin-left:8px;"><%= item.count %> / <%= item.total %> 人需重点跟进</span>
                </summary>
                <div><%= item.narrative %></div>
                <div class="muted" style="margin-top:6px;">对应人员：
                  <% if (item.nameLinks && item.nameLinks.length) { %>
                    <% item.nameLinks.forEach(function(link) { const quick = (childQuickLookup && childQuickLookup[link.name]) || null; %>
                      <button type="button" class="btn small" style="margin:4px 6px 0 0;" onclick='openChildFitnessModal(<%- JSON.stringify(quick || { childName: link.name }) %>)'><%= link.name %></button>
                    <% }) %>
                  <% } else { %>
                    暂无
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <section class="card chart-card" style="margin-bottom:20px;">
      <div class="section-head">
        <div>
          <h3>体测趋势波形图</h3>
          <div class="muted no-margin">近 8 个测试日期综合得分均值走势，适合园所汇报展示</div>
        </div>
      </div>
      <div class="wave-chart-wrap">
        <% const trendItems = trendSummary || []; const chartWidth = 760; const chartHeight = 220; const padX = 36; const padY = 24; const innerWidth = chartWidth - padX * 2; const innerHeight = chartHeight - padY * 2; const validTrend = trendItems.filter(function(item) { return item.avgScore != null; }); const minScore = validTrend.length ? Math.min.apply(null, validTrend.map(function(item) { return Number(item.avgScore); })) : 0; const maxScore = validTrend.length ? Math.max.apply(null, validTrend.map(function(item) { return Number(item.avgScore); })) : 100; const scoreGap = Math.max(1, maxScore - minScore); %>
        <svg class="wave-chart-svg" viewBox="0 0 760 220" role="img" aria-label="体测趋势波形图">
          <line class="wave-grid" x1="36" y1="24" x2="36" y2="196"></line>
          <line class="wave-grid" x1="36" y1="196" x2="724" y2="196"></line>
          <% let points = []; %>
          <% trendItems.forEach(function(item, index) { const x = trendItems.length <= 1 ? padX : padX + innerWidth * index / Math.max(1, trendItems.length - 1); const y = item.avgScore == null ? (padY + innerHeight) : (padY + innerHeight - ((Number(item.avgScore) - minScore) / scoreGap) * innerHeight); points.push(x.toFixed(1) + ',' + y.toFixed(1)); %>
            <circle class="wave-point" cx="<%= x.toFixed(1) %>" cy="<%= y.toFixed(1) %>" r="4"></circle>
            <text class="wave-label" x="<%= x.toFixed(1) %>" y="210"><%= (item.label || '').slice(5) %></text>
            <% if (item.avgScore != null) { %><text class="wave-value" x="<%= x.toFixed(1) %>" y="<%= (y - 10).toFixed(1) %>"><%= item.avgScore %></text><% } %>
          <% }) %>
          <% if (points.length) { %><polyline class="wave-line" points="<%= points.join(' ') %>"></polyline><% } %>
        </svg>
      </div>
    </section>

    <section class="card" style="margin-bottom:20px;">
      <div class="section-head">
        <div>
          <h3>单项需锻炼分析</h3>
          <div class="muted no-margin">按当前范围统计各项目得分低于 60 分的幼儿占比</div>
        </div>
      </div>
      <div class="stats-grid overview-stats">
