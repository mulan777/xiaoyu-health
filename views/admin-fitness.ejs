<%- include('partials/header', { pageClass: 'admin-page' + (typeof isReadonly !== 'undefined' && isReadonly ? ' readonly-mode' : '') }) %>

<style>
  /* P1-4: 冻结体测明细表前4列（班级/姓名/性别/测试日期）
     宽度与 sticky left 偏移必须严格累加一致，否则列会互相遮挡 */
  .data-table th:nth-child(1), .data-table td:nth-child(1) { width: 76px; min-width: 76px; max-width: 76px; position: sticky; left: 0; z-index:2; background:inherit; }
  .data-table th:nth-child(2), .data-table td:nth-child(2) { width: 76px; min-width: 76px; max-width: 76px; position: sticky; left: 76px; z-index:2; background:inherit; }
  .data-table th:nth-child(3), .data-table td:nth-child(3) { width: 48px; min-width: 48px; max-width: 48px; position: sticky; left: 152px; z-index:2; background:inherit; }
  .data-table th:nth-child(4), .data-table td:nth-child(4) { width: 96px; min-width: 96px; max-width: 96px; position: sticky; left: 200px; z-index:2; background:inherit; }
  /* 第4列右侧加分隔阴影，明确冻结区边界 */
  .data-table th:nth-child(4), .data-table td:nth-child(4) { box-shadow: 2px 0 0 0 rgba(15,23,42,0.06); }
  .data-table thead th:nth-child(1),
  .data-table thead th:nth-child(2),
  .data-table thead th:nth-child(3),
  .data-table thead th:nth-child(4) { z-index: 4; background: #f9fafb; }
  .data-table tbody td:nth-child(1),
  .data-table tbody td:nth-child(2),
  .data-table tbody td:nth-child(3),
  .data-table tbody td:nth-child(4) { z-index: 1; background: #ffffff; }
  .data-table tbody tr:nth-child(even) td:nth-child(1),
  .data-table tbody tr:nth-child(even) td:nth-child(2),
  .data-table tbody tr:nth-child(even) td:nth-child(3),
  .data-table tbody tr:nth-child(even) td:nth-child(4) { background: #f9fafb; }
  .data-table tbody tr:hover td:nth-child(1),
  .data-table tbody tr:hover td:nth-child(2),
  .data-table tbody tr:hover td:nth-child(3),
  .data-table tbody tr:hover td:nth-child(4) { background: #f3f4f6; }
  @media (prefers-color-scheme: dark) {
    .data-table thead th:nth-child(1),
    .data-table thead th:nth-child(2),
    .data-table thead th:nth-child(3),
    .data-table thead th:nth-child(4) { background: #0f172a; }
    .data-table tbody td:nth-child(1),
    .data-table tbody td:nth-child(2),
    .data-table tbody td:nth-child(3),
    .data-table tbody td:nth-child(4) { background: #1e293b; }
    .data-table tbody tr:nth-child(even) td:nth-child(1),
    .data-table tbody tr:nth-child(even) td:nth-child(2),
    .data-table tbody tr:nth-child(even) td:nth-child(3),
    .data-table tbody tr:nth-child(even) td:nth-child(4) { background: #1a2332; }
    .data-table tbody tr:hover td:nth-child(1),
    .data-table tbody tr:hover td:nth-child(2),
    .data-table tbody tr:hover td:nth-child(3),
    .data-table tbody tr:hover td:nth-child(4) { background: #334155; }
  }

.pagination-ellipsis { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; padding: 0 6px; font-size: 13px; color: #94a3b8; }

/* 雷达图限制最大宽度 */
.radar-card .radar-svg { max-width: 380px; margin: 0 auto; }

/* 约束趋势图 SVG 最大宽度，避免在宽屏上过度拉伸 */
.chart-card .wave-chart-wrap svg { max-width: 760px; width: 100%; height: auto; display: block; margin: 0 auto; }

/* 趋势双栏：电脑端左右并排，手机端上下堆叠 */
.fitness-trends-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
.fitness-trends-row .fitness-trend-col { margin-bottom: 0 !important; min-width: 0; }
.fitness-trends-row .fitness-trend-col .wave-chart-wrap svg { max-width: 100%; }
@media (max-width: 1024px) {
  .fitness-trends-row { grid-template-columns: 1fr; }
  .fitness-trends-row .fitness-trend-col { margin-bottom: 20px !important; }
}

@media (max-width: 640px) {
  /* 手机端：只冻结 班级 + 姓名 两列，其余横向滚动 */
  .data-table th:nth-child(3), .data-table td:nth-child(3),
  .data-table th:nth-child(4), .data-table td:nth-child(4) { position: static !important; box-shadow: none !important; }
  .data-table th:nth-child(1), .data-table td:nth-child(1) { position: sticky; left: 0; width:64px; min-width:64px; max-width:64px; z-index:2; }
  .data-table th:nth-child(2), .data-table td:nth-child(2) { position: sticky; left: 64px; width:72px; min-width:72px; max-width:72px; z-index:2; box-shadow: 2px 0 0 0 rgba(15,23,42,0.06); }
  .data-table { min-width: 900px !important; }
}
</style>


<%
  const activeFilters = filters || {};
  const dateOptions = Array.isArray(fitnessRecordDates) ? fitnessRecordDates : [];
  const selectedDetailBatchDateValue = (typeof selectedBatchDate !== 'undefined' && selectedBatchDate) ? selectedBatchDate : ((dateOptions[0] && dateOptions[0].label) || '');
  const selectedAnalysisBatchDateValue = (activeFilters.batchDate || ((dateOptions[1] && dateOptions[1].label) || ''));
  const ratingOptions = ['', '优秀', '良好', '合格', '不合格'];
  function buildQuery(pairs) {
    return pairs
      .filter(function(pair) { return pair[1] !== undefined && pair[1] !== null && String(pair[1]) !== ''; })
      .map(function(pair) { return encodeURIComponent(pair[0]) + '=' + encodeURIComponent(String(pair[1])); })
      .join('&');
  }
  const scopePairs = [
    ['view', viewMode || 'all'],
    ['childId', childId || ''],
    ['classId', classId || ''],
    ['gradeLevel', gradeLevel || '']
  ];
  const filterPairs = [
    ['batchDate', selectedAnalysisBatchDateValue || ''],
    ['detailBatchDate', selectedDetailBatchDateValue || ''],
    ['keyword', activeFilters.keyword || ''],
    ['rating', activeFilters.rating || ''],
    ['sortField', activeFilters.sortField || 'test_date'],
    ['sortOrder', activeFilters.sortOrder || 'desc']
  ];
  const sortOptions = [
    ['test_date', '测试日期'],
    ['child_name', '幼儿姓名'],
    ['height_score', '身高分'],
    ['bmi_score', 'BMI分'],
    ['grip_score', '握力分'],
    ['jump_score', '跳远分'],
    ['sit_score', '体前屈分'],
    ['djump_score', '双脚跳分'],
    ['obstacle_score', '障碍跑分'],
    ['balance_score', '平衡木分'],
    ['total_score', '综合得分']
  ];
  const fitnessPaginationData = fitnessPagination || { currentPage: 1, totalPages: 1, total: allRecordsCount || records.length, startIndex: records.length ? 1 : 0, endIndex: records.length, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1 };
  const paginationFilterPairs = filterPairs.concat([['page', fitnessPaginationData.currentPage]]);
  const viewBaseQuery = buildQuery(scopePairs);
  const currentViewHref = '/admin/fitness' + (viewBaseQuery ? '?' + viewBaseQuery : '');
  const exportQuery = buildQuery(scopePairs.concat(filterPairs));
  const exportHref = '/admin/fitness/export' + (exportQuery ? '?' + exportQuery : '');
  const selectedChildIdText = childId ? String(childId) : '';
  const currentFullHref = '/admin/fitness' + (buildQuery(scopePairs.concat(paginationFilterPairs)) ? '?' + buildQuery(scopePairs.concat(paginationFilterPairs)) : '');
  const editQueryBase = buildQuery(scopePairs.concat(paginationFilterPairs));
  const currentScopeLabel = viewMode === 'child'
    ? '当前为个人视图，可继续按评级 / 日期筛选该幼儿数据'
    : viewMode === 'class'
      ? '当前为班级视图，可继续按关键词 / 评级 / 日期缩小范围'
      : viewMode === 'grade'
        ? '当前为年级视图，可继续按关键词 / 评级 / 日期缩小范围'
        : '当前为全园视图，可先筛选再导出';
%>

