        <label><span>排序字段</span>
          <select name="sortField">
            <% sortOptions.forEach(function(item) { %>
              <option value="<%= item[0] %>" <%= (activeFilters.sortField || 'test_date') === item[0] ? 'selected' : '' %>><%= item[1] %></option>
            <% }) %>
          </select>
        </label>
        <label><span>排序方式</span>
          <select name="sortOrder">
            <option value="desc" <%= (activeFilters.sortOrder || 'desc') === 'desc' ? 'selected' : '' %>>从大到小 / 最新优先</option>
            <option value="asc" <%= (activeFilters.sortOrder || 'desc') === 'asc' ? 'selected' : '' %>>从小到大 / 最早优先</option>
          </select>
        </label>
        <div class="tool-row full-row">
          <button class="btn" type="submit">应用筛选</button>
          <a class="btn" href="<%= currentViewHref %>">重置筛选</a>
          <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.export') && !isReadonly) { %><a class="btn small primary" href="<%= exportHref %>">导出当前筛选结果</a><% } %>
        </div>
      </form>
      <form method="get" action="/admin/fitness" class="form-grid fitness-filter-form" style="grid-template-columns: minmax(260px, 1.4fr) auto; align-items:end; margin-bottom:14px;">
        <input type="hidden" name="view" value="child" />
        <label><span>快速查看某个幼儿</span>
          <select name="childId">
            <option value="">请选择幼儿</option>
            <% allChildren.forEach(function(ch) { %>
              <option value="<%= ch.id %>" <%= selectedChildIdText === String(ch.id) ? 'selected' : '' %>><%= ch.class_name ? ch.class_name + ' - ' : '' %><%= ch.name %><%= ch.gender ? '(' + ch.gender + ')' : '' %></option>
            <% }) %>
          </select>
        </label>
        <button class="btn" type="submit">查看该幼儿记录</button>
      </form>
      <div class="section-head">
        <div>
          <h2>体测记录明细</h2>
          <div class="muted no-margin">所选批次 <strong><%= selectedDetailBatchDateValue || '-' %></strong> 明细：共 <%= allRecordsCount || 0 %> 条记录，每页 10 条</div>
        </div>
        <div class="toolbar-links">
          <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.export') && !isReadonly) { %><a class="btn small primary" href="<%= exportHref %>">导出当前筛选结果</a><% } %>
        </div>
      </div>

      <% if (!records.length) { %>
        <div class="empty-state">暂无体测记录。请通过上方表单录入，或下载模板后批量导入。</div>
      <% } else { %>
        <div class="table-wrap">
          <table class="data-table admin-table" style="min-width:1200px;">
            <thead>
              <tr>
                <th>班级</th>
                <th>姓名</th>
                <th>性别</th>
                <th>测试日期</th>
                <th>身高</th>
                <th>身高分</th>
                <th>体重</th>
                <th>BMI</th>
                <th>BMI分</th>
                <th>握力</th>
                <th>握力分</th>
                <th>跳远</th>
                <th>跳远分</th>
                <th>体前屈</th>
                <th>体前屈分</th>
                <th>双脚跳</th>
                <th>双脚跳分</th>
                <th>障碍跑</th>
                <th>障碍跑分</th>
                <th>平衡木</th>
                <th>平衡木分</th>
                <th>综合得分</th>
                <th>评级</th>
                <th class="col-actions">操作</th>
              </tr>
            </thead>
            <tbody>
              <% records.forEach(function(r) { %>
                <tr>
                  <td><%= r.class_name || '-' %></td>
                  <td><strong><a class="child-compare-link" data-child-id="<%= r.child_id %>" data-child-name="<%= r.child_name %>" role="button" tabindex="0"><%= r.child_name %></a></strong></td>
                  <td><%= r.gender || '-' %></td>
                  <td><%= r.test_date ? formatDateOnly(r.test_date) : '-' %></td>
                  <td><%= r.height_cm ?? '-' %></td>
                  <td><%= r.height_score ?? '-' %></td>
                  <td><%= r.weight_kg ?? '-' %></td>
                  <td><%= r.bmi ?? '-' %></td>
                  <td><%= r.bmi_score ?? '-' %></td>
                  <td><%= r.grip_kg ?? '-' %></td>
                  <td><%= r.grip_score ?? '-' %></td>
                  <td><%= r.long_jump_cm ?? '-' %></td>
                  <td><%= r.jump_score ?? '-' %></td>
                  <td><%= r.sit_reach_cm ?? '-' %></td>
                  <td><%= r.sit_score ?? '-' %></td>
                  <td><%= r.double_jump_sec ?? '-' %></td>
                  <td><%= r.djump_score ?? '-' %></td>
                  <td><%= r.obstacle_run_sec ?? '-' %></td>
                  <td><%= r.obstacle_score ?? '-' %></td>
                  <td><%= r.balance_beam_sec ?? '-' %></td>
                  <td><%= r.balance_score ?? '-' %></td>
                  <td><strong><%= r.total_score ?? '-' %></strong></td>
                  <td>
                    <% if (r.rating === '优秀') { %><span class="status-badge ok"><%= r.rating %></span>
                    <% } else if (r.rating === '良好') { %><span class="status-badge" style="background:#e8f1fd;color:#0071e3;"><%= r.rating %></span>
                    <% } else if (r.rating === '合格') { %><span class="status-badge" style="background:#fff8e1;color:#f09300;"><%= r.rating %></span>
                    <% } else if (r.rating === '不合格') { %><span class="status-badge" style="background:#fce8e8;color:#ff3b30;"><%= r.rating %></span>
                    <% } else { %>-<% } %>
                  </td>
                  <td>
                    <div class="record-actions">
                      <a class="btn small" href="/admin/fitness?view=child&childId=<%= r.child_id %>" title="查看该幼儿所有体测记录">查看</a>
                      <button class="btn small primary" type="button" title="修正这条记录" onclick="openFitnessEditModal({id:<%= r.id %>,className:'<%= (r.class_name || '').replace(/'/g,"\\'") %>',childName:'<%= (r.child_name || '').replace(/'/g,"\\'") %>',testDate:'<%= r.test_date ? formatDateOnly(r.test_date) : '' %>',heightCm:<%= r.height_cm ?? 'null' %>,weightKg:<%= r.weight_kg ?? 'null' %>,gripKg:<%= r.grip_kg ?? 'null' %>,longJumpCm:<%= r.long_jump_cm ?? 'null' %>,sitReachCm:<%= r.sit_reach_cm ?? 'null' %>,doubleJumpSec:<%= r.double_jump_sec ?? 'null' %>,obstacleRunSec:<%= r.obstacle_run_sec ?? 'null' %>,balanceBeamSec:<%= r.balance_beam_sec ?? 'null' %>})">修正</button>
                      <% if (typeof hasPerm === 'function' && hasPerm('data.fitness.delete') && !isReadonly) { %>
                        <form method="post" action="/admin/fitness/<%= r.id %>/delete" onsubmit="return confirm('确定删除 <%= r.child_name %> 在 <%= r.test_date ? formatDateOnly(r.test_date) : '-' %> 的体测记录吗？删除后不可恢复。');" style="margin:0;display:inline-flex;">
                          <input type="hidden" name="currentView" value="<%= viewMode %>" />
                          <input type="hidden" name="currentChildId" value="<%= childId || '' %>" />
                          <input type="hidden" name="currentClassId" value="<%= classId || '' %>" />
                          <input type="hidden" name="currentGradeLevel" value="<%= gradeLevel || '' %>" />
                          <input type="hidden" name="currentKeyword" value="<%= activeFilters.keyword || '' %>" />
                          <input type="hidden" name="currentRating" value="<%= activeFilters.rating || '' %>" />
                          <input type="hidden" name="currentDateFrom" value="<%= activeFilters.dateFrom || '' %>" />
                          <input type="hidden" name="currentDateTo" value="<%= activeFilters.dateTo || '' %>" />
                          <input type="hidden" name="currentSortField" value="<%= activeFilters.sortField || 'test_date' %>" />
                          <input type="hidden" name="currentSortOrder" value="<%= activeFilters.sortOrder || 'desc' %>" />
                          <input type="hidden" name="currentPage" value="<%= fitnessPaginationData.currentPage || 1 %>" />
                          <button class="btn small danger" type="submit" title="删除这条记录">删除</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="muted" style="margin-top:10px;">当前显示第 <strong><%= fitnessPaginationData.startIndex || 0 %></strong> - <strong><%= fitnessPaginationData.endIndex || 0 %></strong> 条</div>
        <% if (fitnessPaginationData.totalPages > 1) { %>
          <div class="pagination-bar">
            <% if (fitnessPaginationData.hasPrev) { %><a class="pagination-link pagination-nav" href="/admin/fitness?<%= buildQuery(scopePairs.concat(filterPairs)) %>&page=<%= fitnessPaginationData.prevPage %>">上一页</a><% } %>
            <%
              var cp = fitnessPaginationData.currentPage || 1;
              var tp = fitnessPaginationData.totalPages || 1;
              var startP = Math.max(1, cp - 3);
              var endP = Math.min(tp, cp + 3);
              if (startP > 1) { %><span class="pagination-ellipsis">…</span><% }
              for (var pageNo = startP; pageNo <= endP; pageNo++) {
            %>
              <a class="pagination-link <%= cp === pageNo ? 'active' : '' %>" href="/admin/fitness?<%= buildQuery(scopePairs.concat(filterPairs)) %>&page=<%= pageNo %>"><%= pageNo %></a>
            <% }
              if (endP < tp) { %><span class="pagination-ellipsis">…</span><% }
            %>
            <% if (fitnessPaginationData.hasNext) { %><a class="pagination-link pagination-nav" href="/admin/fitness?<%= buildQuery(scopePairs.concat(filterPairs)) %>&page=<%= fitnessPaginationData.nextPage %>">下一页</a><% } %>
          </div>
        <% } %>
      <% } %>
    </div><!-- /collapse-body -->
    </div>
  </div>
</div>

<script>
(function () {
  function bindRadarToggles(root) {
    (root || document).querySelectorAll('[data-radar-root]').forEach(function (card) {
      // 2026-09-08: ECharts 化雷达由 initAdminCharts 绑定 toggle（legend 联动），
      // 此处跳过避免新旧两个 click 监听互相抵消（合格/良好/优秀永远加不上）。
      if (card.querySelector('.radar-chart-el')) return;
      card.querySelectorAll('[data-radar-toggle]').forEach(function (button) {
        if (button.dataset.radarBound === '1') return;
        button.dataset.radarBound = '1';
        button.addEventListener('click', function () {
          var key = button.getAttribute('data-radar-toggle');
          if (!key) return;
          var isActive = button.classList.toggle('is-active');
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          card.querySelectorAll('[data-radar-series="' + key + '"]').forEach(function (seriesNode) {
            seriesNode.classList.toggle('is-hidden', !isActive);
          });
        });
      });
    });
  }
  function replacePanelFromHtml(html, selector) {
    var panel = document.querySelector(selector);
    var wasOpen = panel && panel.querySelector('.collapse-body.open') !== null;
    var parser = new DOMParser();
    var doc = parser.parseFromString(html, 'text/html');
    var incoming = doc.querySelector(selector);
    var current = document.querySelector(selector);
    if (incoming && current) {
      current.outerHTML = incoming.outerHTML;
      // restore collapse open state
      if (wasOpen) {
        var b = document.querySelector(selector + ' .collapse-body');
        var t = document.querySelector(selector + ' .collapse-trigger');
        if (b) b.classList.add('open');
        if (t) t.classList.add('open');
      }
    }
  }
  function showPanelLoading(selector) {
    var panel = document.querySelector(selector);
    if (!panel) return;
    if (panel.querySelector('.ajax-loading-overlay')) return;
    var ov = document.createElement('div');
    ov.className = 'ajax-loading-overlay';
    ov.innerHTML = '<div class="ajax-spinner"></div><div class="ajax-loading-text">加载中…</div>';
    // panel 需相对定位才能承载遮罩
    var cs = getComputedStyle(panel);
    if (cs.position === 'static') panel.style.position = 'relative';
    panel.appendChild(ov);
  }
  function hidePanelLoading(selector) {
    var panel = document.querySelector(selector);
    if (!panel) return;
    var ov = panel.querySelector('.ajax-loading-overlay');
    if (ov) ov.parentNode.removeChild(ov);
  }
  async function loadFitnessRecords(url, push) {
    showPanelLoading('[data-ajax-panel="fitness-records"]');
    try {
      const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' }, credentials: 'same-origin' });
      if (!res.ok) { window.location.href = url; return; }
      const html = await res.text();
      replacePanelFromHtml(html, '[data-ajax-panel="fitness-records"]');
      if (push) window.history.pushState({ kind: 'fitness-records', url: url }, '', url);
      bindFitnessPagination();
    } catch (err) {
      window.location.href = url;
    } finally {
      hidePanelLoading('[data-ajax-panel="fitness-records"]');
    }
  }
  async function loadAdminFitnessMain(url, push) {
    showPanelLoading('[data-ajax-panel="admin-fitness-main"]');
    try {
      const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' }, credentials: 'same-origin' });
      if (!res.ok) { window.location.href = url; return; }
      const html = await res.text();
      replacePanelFromHtml(html, '[data-ajax-panel="admin-fitness-main"]');
      if (window.initAdminCharts) window.initAdminCharts();
      if (push) window.history.pushState({ kind: 'admin-fitness-main', url: url }, '', url);
      bindFitnessPagination();
    } catch (err) {
      window.location.href = url;
    } finally {
      hidePanelLoading('[data-ajax-panel="admin-fitness-main"]');
    }
  }
  function scrollToFitnessPanel() {
    const panel = document.querySelector('[data-ajax-panel="fitness-records"]');
    if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function bindFitnessPagination() {
    document.querySelectorAll('form.admin-analysis-batch-form').forEach(function (form) {
      if (form.dataset.ajaxBound === '1') return;
      form.dataset.ajaxBound = '1';
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        const action = form.getAttribute('action') || window.location.pathname;
        const url = new URL(action, window.location.origin);
        const formData = new FormData(form);
        formData.forEach(function (value, key) {
          if (value !== null && String(value) !== '') url.searchParams.set(key, String(value));
        });
        loadAdminFitnessMain(url.toString(), true).catch(function () { window.location.href = url.toString(); });
      });
    });
    document.querySelectorAll('[data-ajax-panel="fitness-records"] .pagination-link').forEach(function (link) {
      if (link.dataset.ajaxBound === '1') return;
      link.dataset.ajaxBound = '1';
      link.addEventListener('click', function (event) {
        event.preventDefault();
        loadFitnessRecords(event.currentTarget.href, true).catch(function () { window.location.href = event.currentTarget.href; });
      });
    });
    document.querySelectorAll('[data-ajax-panel="fitness-records"] form.fitness-filter-form').forEach(function (form) {
      if (form.dataset.ajaxBound === '1') return;
      form.dataset.ajaxBound = '1';
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        const action = form.getAttribute('action') || window.location.pathname;
        const url = new URL(action, window.location.origin);
        const formData = new FormData(form);
        formData.forEach(function (value, key) {
          if (value !== null && String(value) !== '') url.searchParams.set(key, String(value));
        });
        loadFitnessRecords(url.toString(), true).catch(function () { window.location.href = url.toString(); });
      });
    });
    bindRadarToggles(document.querySelector('[data-ajax-panel="admin-fitness-main"]') || document.querySelector('[data-ajax-panel="fitness-records"]'));
  }
  window.addEventListener('popstate', function () {
    if (!document.querySelector('[data-ajax-panel="fitness-records"]')) return;
    loadFitnessRecords(window.location.href, false).catch(function () { window.location.reload(); });
  });
  bindRadarToggles(document);
  bindFitnessPagination();
})();

window.toggleCollapse = function(el) { el.classList.toggle("open"); var b = el.nextElementSibling; if (b && b.classList.contains("collapse-body")) b.classList.toggle("open"); };

// 体测导航：年级标题点击 = 下拉展开/收起（纯前端，不刷新页面）
document.addEventListener("click", function(e) {
  var btn = e.target.closest("[data-grade-toggle]");
  if (!btn) return;
  e.preventDefault();
  var group = btn.closest(".fitness-nav-group");
  if (!group) return;
  var willOpen = !group.classList.contains("open");
  group.classList.toggle("open", willOpen);
  btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
});

function openChildFitnessModal(data) {
  var overlay = document.getElementById('childFitnessOverlay');
  var title = document.getElementById('childFitnessTitle');
  var meta = document.getElementById('childFitnessMeta');
  var scores = document.getElementById('childFitnessScores');
  var train = document.getElementById('childFitnessTraining');
  var viewBtn = document.getElementById('childFitnessViewBtn');
  if (!overlay) return;
  var birthText = data && data.birthDate ? String(data.birthDate).slice(0, 10) : '-';
  title.textContent = (data && data.childName) || '幼儿体测详情';
  meta.innerHTML = '班级：' + ((data && data.className) || '-')
    + '　|　性别：' + ((data && data.gender) || '-')
    + '　|　出生日期：' + birthText
    + '<br>最近体测：' + ((data && data.testDate) || '-')
    + '　|　综合得分：' + ((data && data.totalScore) || '-')
    + '　|　评级：' + ((data && data.rating) || '-');
  scores.innerHTML = [
    '身高：' + ((data && data.heightCm) || '-') + ' cm',
    '体重：' + ((data && data.weightKg) || '-') + ' kg',
    'BMI：' + ((data && data.bmi) || '-'),
    '握力：' + ((data && data.gripKg) || '-') + ' kg（' + ((data && data.gripScore) || '-') + '分）',
    '立定跳远：' + ((data && data.longJumpCm) || '-') + ' cm（' + ((data && data.jumpScore) || '-') + '分）',
    '坐位体前屈：' + ((data && data.sitReachCm) || '-') + ' cm（' + ((data && data.sitScore) || '-') + '分）',
    '双脚连续跳：' + ((data && data.doubleJumpSec) || '-') + ' 秒（' + ((data && data.djumpScore) || '-') + '分）',
    '15米绕障碍跑：' + ((data && data.obstacleRunSec) || '-') + ' 秒（' + ((data && data.obstacleScore) || '-') + '分）',
    '走平衡木：' + ((data && data.balanceBeamSec) || '-') + ' 秒（' + ((data && data.balanceScore) || '-') + '分）'
  ].map(function (line) { return '<div style="margin:6px 0;">' + line + '</div>'; }).join('');
  train.textContent = data && data.needTraining && data.needTraining.length ? '建议重点加强：' + data.needTraining.join('、') : '当前暂无明显薄弱项';
  if (viewBtn) viewBtn.href = data && data.childId ? '/admin/fitness?view=child&childId=' + encodeURIComponent(String(data.childId)) : '/admin/fitness';
  _modalChildData = data;
  overlay.style.display = 'flex';
}
var _modalChildData = null;
function closeChildFitnessModal() {
  var overlay = document.getElementById('childFitnessOverlay');
  if (overlay) overlay.style.display = 'none';
}
</script>

<div id="childFitnessOverlay" class="modal-overlay" style="display:none;" onclick="if(event.target===this) closeChildFitnessModal()">
  <div class="modal-box" style="width:min(92vw,680px);max-height:86vh;overflow:auto;">
    <div class="modal-header" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
      <div>
        <h3 id="childFitnessTitle" style="margin:0;">幼儿体测详情</h3>
        <div id="childFitnessMeta" class="muted" style="margin-top:8px;"></div>
      </div>
      <button class="modal-close" type="button" onclick="closeChildFitnessModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="card" style="margin-bottom:12px;">
        <div class="section-head"><h3>最近一次体测</h3></div>
        <div id="childFitnessScores"></div>
      </div>
      <div class="card">
        <div class="section-head"><h2>训练建议</h2></div>
        <div id="childFitnessTraining" class="muted"></div>
      </div>
      <div class="toolbar-links" style="margin-top:16px;">
        <a id="childFitnessViewBtn" class="btn primary" href="/admin/fitness">查看完整记录</a>
        <button class="btn" type="button" onclick="if(_modalChildData&&_modalChildData.childId){closeChildFitnessModal();openChildComparePanel(null,_modalChildData.childId,_modalChildData.childName)}">查看纵向对比</button>
        <button class="btn" type="button" onclick="closeChildFitnessModal()">关闭</button>
      </div>
    </div>
  </div>
</div>

<!-- 修正体测记录弹框 -->
<div id="fitnessEditOverlay" class="venue-editor-overlay" onclick="closeFitnessEditModal()"></div>
<div id="fitnessEditDrawer" class="venue-editor-drawer" style="width:480px;">
  <div class="venue-editor-header">
    <h3 id="fitnessEditTitle">修正体测记录</h3>
    <button class="btn small" type="button" onclick="closeFitnessEditModal()">✕ 关闭</button>
  </div>
  <div class="venue-editor-body">
    <div id="fitnessEditMeta" class="muted" style="margin-bottom:12px;"></div>
    <form id="fitnessEditForm" method="post" action="" class="form-grid" style="grid-template-columns:1fr 1fr;gap:10px;">
      <input type="hidden" name="currentView" value="<%= viewMode %>" />
      <input type="hidden" name="currentChildId" value="<%= childId || '' %>" />
      <input type="hidden" name="currentClassId" value="<%= classId || '' %>" />
      <input type="hidden" name="currentGradeLevel" value="<%= gradeLevel || '' %>" />
      <input type="hidden" name="currentKeyword" value="<%= activeFilters.keyword || '' %>" />
      <input type="hidden" name="currentRating" value="<%= activeFilters.rating || '' %>" />
      <input type="hidden" name="currentDateFrom" value="<%= activeFilters.dateFrom || '' %>" />
      <input type="hidden" name="currentDateTo" value="<%= activeFilters.dateTo || '' %>" />
      <label><span>测试日期</span><input type="date" name="testDate" id="fEditTestDate" required /></label>
      <label><span>身高(CM)</span><input type="number" name="heightCm" id="fEditHeight" step="0.1" required /></label>
      <label><span>体重(KG)</span><input type="number" name="weightKg" id="fEditWeight" step="0.01" required /></label>
      <label><span>握力(KG)</span><input type="number" name="gripKg" id="fEditGrip" step="0.01" required /></label>
      <label><span>立定跳远(CM)</span><input type="number" name="longJumpCm" id="fEditJump" step="0.1" required /></label>
      <label><span>坐位体前屈(CM)</span><input type="number" name="sitReachCm" id="fEditSit" step="0.1" required /></label>
      <label><span>双脚连续跳(秒)</span><input type="number" name="doubleJumpSec" id="fEditDJump" step="0.01" required /></label>
      <label><span>15米绕障碍跑(秒)</span><input type="number" name="obstacleRunSec" id="fEditObstacle" step="0.01" required /></label>
      <label><span>走平衡木(秒)</span><input type="number" name="balanceBeamSec" id="fEditBalance" step="0.01" required /></label>
      <div style="grid-column:1/-1;margin-top:8px;"><button class="btn primary full" type="submit">保存修正并重新计算</button></div>
    </form>
  </div>
</div>


